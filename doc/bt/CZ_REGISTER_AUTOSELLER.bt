#include "inc/common.bt"

typedef struct
{
    int classId;
    int index;
    int price;
    int amount;
    int i1;
    byte unk1[260];
}
AutoSellerItem <optimize=false, read=readAutoSellerItem>;

string readAutoSellerItem(AutoSellerItem& v)
{
    string result;
    SPrintf(result, "%d, %d for %d each", v.classId, v.amount, v.price);
    return result;
}

typedef struct
{
    int classId;
    int index;
    int price;
    int skillLevel;
    int i1;
    byte unk1[256];
}
AutoSellerSkillItem <optimize=false, read=readAutoSellerSkillItem>;

string readAutoSellerSkillItem(AutoSellerSkillItem& v)
{
    string result;
    SPrintf(result, "%d for %d each", v.classId, v.price);
    return result;
}

ClientHeaderDynamic header;

char shopName[64];
int count; // -1 = close shop
int group; // see packeteffects.xml, PersonalShop = 270065, 690006 = RepairShop
int skillId;

if (count > 0)
{
    if (skillId == 0)
        AutoSellerItem items[count];
    else
        AutoSellerSkillItem skillItems[count];
}

// Only shops that can be opened to others - Refreshment Table, Spell Shop
if (!FEof())
    int shared; // 0 = owner, 1 = guild, 2 = everyone