# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "[Storage Keeper] Rita"
msgstr "[Хранительница] Рита"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Rita"
msgstr "Рита"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Hello! Can I help you store your items?"
msgstr "Здравствуйте! Могу ли я помочь вам разместить ваши вещи?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Personal Storage"
msgstr "Личное хранилище"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Team Storage"
msgstr "Хранилище команды"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Save Spawn Location"
msgstr "Сохранить место появления"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Cancel"
msgstr "Отмена"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Your location has been saved!"
msgstr "Ваше местоположение сохранено!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "[Item Merchant] Mirina"
msgstr "[Продавец товара] Мирина"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Mirina"
msgstr "Мирина"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Care for some potions or helpful consumables?{nl}Buy at Mirina's shop today!"
msgstr "Хотите приобрести зелья или полезные предметы потребления?{nl}Покупайте их в магазине Мирины уже сегодня!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Mirina's shop at your service~"
msgstr "Магазин Мирины к вашим услугам~"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "[Equipment Merchant] Dunkel"
msgstr "[Торговец оборудованием] Дункель"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Dunkel"
msgstr "Дункель"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Take a look around at your own pace without feeling anxious."
msgstr "Осмотрись в удобном для вас темпе, я не спешу."

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Weapons"
msgstr "Оружие"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Armor"
msgstr "Броня"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "[Accessory Merchant] Ronesa"
msgstr "[Продавец аксессуаров] Ронеса"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Ronesa"
msgstr "Ронеса"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "While you're here, do you need anything?{nl}I've got some hard-to-find stuff."
msgstr "Раз уж вы здесь, может, вам что-нибудь нужно?{nl}У меня есть кое-что, что трудно найти."

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Welcome.{nl}Only hard-to-find stuff here."
msgstr "Добро пожаловать.{nl}Здесь можно найти редкие штуки!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "[Blacksmith]{nl}Zaras"
msgstr "[Кузнец]{nl}Зарас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "[Companion Trader] Christina"
msgstr "[Трейдер-напарник] Кристина"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Christina"
msgstr "Кристина"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Adopt Companion"
msgstr "Приручить спутника"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Buy Pet Food"
msgstr "Купить корм для домашних животных"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Leave"
msgstr "Покинуть"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_klaipe.cs
msgid "Statue of Goddess Ausrine"
msgstr "Статуя богини Аусрине"

# ============================================================================
# Fedimian NPCs (c_fedimian.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Statue of Goddess Vakarine"
msgstr "Статуя богини Вакарине"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "[Item Merchant] Muras"
msgstr "[Продавец товара] Мурас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Muras"
msgstr "Мурас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "H-Hello there! C-Can I help you with some good consumables?"
msgstr "З-Здравствуйте! М-Могу ли я помочь вам с выбором хороших расходных материалов?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "O-Oh, hi. W-Welcome to my humble shop."
msgstr "О-о, привет. Д-добро пожаловать в мою скромную лавку."

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "[Storage Keeper] Zadan"
msgstr "[Хранитель] Задан"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Zadan"
msgstr "Задан"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Looking for a place to store your items safely? I'm just the guy."
msgstr "Ищете место, где можно было бы надежно хранить свои вещи? Я — именно тот, кто вам нужен."

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "[Equipment Merchant] Yorgis"
msgstr "[Торговец оборудованием] Йоргис"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Welcome! Only the best quality equipments around here!"
msgstr "Добро пожаловать! У нас только оборудование самого высокого качества!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "[Blacksmith]{nl}Anna"
msgstr "[Кузнец]{nl}Анна"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "[Accessory Merchant] Joana"
msgstr "[Продавец аксессуаров] Джоана"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Joana"
msgstr "Джоана"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_fedimian.cs
msgid "Accessories~! Everyone loves good looking jewelry!"
msgstr "Аксессуары~! Все любят красивые украшения!"

# ============================================================================
# Orsha NPCs (c_orsha.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "[Equipment Merchant] Jura"
msgstr "[Торговец оборудованием] Юра"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Jura"
msgstr "Юра"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Welcome! What kind of equipment are you looking for?"
msgstr "Добро пожаловать! Какое оборудование вы ищете?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "[Item Merchant] Alf"
msgstr "[Продавец товара] Альф"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Alf"
msgstr "Альф"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Looking for potions or other useful items? You've come to the right place!"
msgstr "Ищете зелья или другие полезные предметы? Вы попали по адресу!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Welcome to Alf's shop. What can I get for you today?"
msgstr "Добро пожаловать в магазин Альфа. Чем я могу вам помочь сегодня?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "[Accessory Merchant] Jurus"
msgstr "[Продавец аксессуаров] Юрус"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Jurus"
msgstr "Юрус"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Welcome to my accessory shop. I have some rare and unique items you might be interested in."
msgstr "Добро пожаловать в мой магазин аксессуаров. У меня есть несколько редких и уникальных вещей, которые, возможно, вас заинтересуют."

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Greetings! Looking for something to enhance your style and power?"
msgstr "Привет! Ищете что-нибудь, что поможет вам подчеркнуть свой стиль и силу?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "[Storage Keeper] Aisah"
msgstr "[Хранительница] Айса"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Aisah"
msgstr "Айса"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Welcome to Orsha's storage. How may I assist you?"
msgstr "Добро пожаловать в склад в Орше. Чем могу помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "[Blacksmith]{nl}Ilanai"
msgstr "[Кузнец]{nl}Иланай"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "[Companion Trader] Toras"
msgstr "[Трейдер-партнер] Торас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Toras"
msgstr "Торас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/c_orsha.cs
msgid "Lv1 Treasure Chest"
msgstr "Сундук с сокровищами ур. 1"

# ============================================================================
# Klaipeda Quests (c_klaipe_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Withered Branch"
msgstr "Увядшая ветка"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "A dying and burnt branch with blackened, withering leaves. The corruption has taken hold of the vegetation."
msgstr "Умирающая и обожженная ветка с почерневшими, увядающими листьями. Гниение охватило растительность."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've already collected a branch from this location."
msgstr "Вы уже забрали ветку из этого места."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Collecting branch..."
msgstr "Сбор веток..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Branches collected: {0}/5"
msgstr "Собранные ветки: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "All branches collected! Return to Elara."
msgstr "Все ветки собраны! Вернуться в Элару."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "[Caravan Master] Marcus"
msgstr "[Руководитель каравана] Маркус"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Marcus"
msgstr "Маркус"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Ah, traveler! Welcome to Klaipeda. We're working hard to rebuild after the war, but it's been... challenging."
msgstr "Ах, путешественник! Добро пожаловать в Клайпеду. Мы усердно трудимся, чтобы восстановить город после войны, но это... непросто."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The roads are no longer safe. Monsters roam freely, and our supply caravans can't get through without proper protection."
msgstr "Дороги больше не безопасны. Монстры свободно бродят по ним, и наши караваны с провизией не могут пройти без надлежащей защиты."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Would you be willing to help escort a supply caravan? The pay is modest, but you'd be helping our city recover."
msgstr "Не могли бы вы помочь сопроводить караван с грузами? Оплата скромная, но вы тем самым поможете нашему городу восстановиться."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Excellent! Head to the western road and clear out the monsters. We need at least 5 of each of them gone before the caravan can safely pass."
msgstr "Отлично! Отправляйтесь на западную дорогу и уничтожьте монстров. Чтобы караван смог безопасно пройти, нужно уничтожить по крайней мере по 5 монстров каждого вида."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Be careful out there. These aren't ordinary beasts - some say they're tainted by lingering demon magic from the war."
msgstr "Будьте осторожны. Это не обычные звери — некоторые говорят, что они заражены остатками демонической магии, оставшейся после войны."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "I understand. It's dangerous work. If you change your mind, I'll be here organizing our supply efforts."
msgstr "Понимаю. Это опасная работа. Если ты передумаешь, я буду здесь и займусь организацией поставок."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Keep up the good work! The western road is particularly dangerous near the forest edge. Watch your back out there."
msgstr "Продолжайте в том же духе! Западная дорога особенно опасна вблизи опушки леса. Будьте осторожны там."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Fantastic work! The road is clear, and our caravan just reported safe passage!"
msgstr "Отличная работа! Дорога свободна, и наш автопоезд только что сообщил, что благополучно прошел!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've earned this reward, and more importantly, you've helped dozens of families who depend on these supplies."
msgstr "Вы заслужили эту награду, а главное — помогли десяткам семей, для которых эти предметы первой необходимости имеют жизненно важное значение."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Thanks to you, our supply lines are much safer. You're always welcome in Klaipeda, friend."
msgstr "Благодаря тебе наши пути снабжения стали гораздо безопаснее. Ты всегда желанный гость в Клайпеде, друг."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "If you're looking for more work, you might check with Elara near the river. She's been dealing with some... unusual problems."
msgstr "Если вы ищете дополнительную работу, попробуйте обратиться к Эларе, которая живет у реки. У неё возникли некоторые… необычные проблемы."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "[River Warden] Elara"
msgstr "[Речной страж] Элара"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Elara"
msgstr "Элара"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "This river is the main water source for the residents of Klaipeda. Without it, the city cannot survive."
msgstr "Эта река является основным источником воды для жителей Клайпеды. Без неё город не сможет выжить."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "What brings you to the riverside?"
msgstr "Что привело вас на берег реки?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Can I help?"
msgstr "Могу я чем-нибудь помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Tell me more about the river"
msgstr "Расскажи мне поподробнее о реке"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Just passing through"
msgstr "Просто проездом"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You would help? Thank the goddesses! The corruption is spreading and we need to act quickly."
msgstr "Ты поможешь? Слава богиням! Загрязнение распространяется, и нам нужно действовать быстро."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Can you help me by removing corrupted tree branches from the river? They're scattered along the riverbanks and need to be cleared."
msgstr "Не могли бы вы помочь мне убрать с реки поврежденные ветки деревьев? Они разбросаны по берегам реки, и их нужно убрать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Thank you so much! Please remove 5 Withered Branches from different locations along the river."
msgstr "Огромное спасибо! Пожалуйста, уберите 5 увядших веток из разных мест вдоль реки."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The river used to flow crystal clear, providing fresh water for drinking, cooking, and daily life."
msgstr "Раньше вода в реке была кристально чистой и служила источником пресной воды для питья, приготовления пищи и повседневных нужд."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "But corruption from the forest upstream has been falling into the river. Corrupted tree branches and debris are poisoning our water supply."
msgstr "Но загрязнение из леса, расположенного выше по течению, попадает в реку. Загрязнённые ветки деревьев и мусор отравляют наши запасы воды."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Safe travels. Try not to drink the river water until we've cleaned it..."
msgstr "Удачного путешествия. Постарайтесь не пить воду из реки, пока мы её не очистим..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Have you collected the branches? You have {0} out of 5 so far."
msgstr "Ты уже собрал ветки? На данный момент у тебя {0} из 5."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Check the riverbanks for withered bushes and corrupted vegetation. They're the source of the contamination."
msgstr "Осмотрите берега реки на наличие засохших кустов и поражённой растительности. Именно они являются источником загрязнения."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've collected all the branches! The river is already flowing clearer!"
msgstr "Вы собрали все ветки! Вода в реке уже стала чище!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#666666}*She inspects the water, a relieved smile crossing her face*{/}"
msgstr "{#666666}*Она осматривает воду, и на её лице появляется облегчённая улыбка*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The water quality is improving already. The residents will be able to use the river safely again."
msgstr "Качество воды уже улучшается. Жители снова смогут безопасно пользоваться рекой."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've saved countless lives today. Here - take this as thanks for your help."
msgstr "Сегодня ты спас бесчисленное количество жизней. Вот — возьми это в знак благодарности за твою помощь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The river is flowing much clearer now. The residents are grateful to have clean water again."
msgstr "Теперь вода в реке стала гораздо чище. Жители рады, что у них снова появилась чистая вода."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Your help was invaluable. Without removing those corrupted branches, the water would have become completely unusable."
msgstr "Ваша помощь оказалась неоценимой. Если бы не удалить эти поврежденные ветки, вода стала бы совершенно непригодной для использования."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "[Reconstruction Coordinator] Viktor"
msgstr "[Координатор по восстановлению] Виктор"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Viktor"
msgstr "Виктор"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Every day we rebuild, and every night I count the buildings still in ruins. This city was once magnificent, you know."
msgstr "Каждый день мы восстанавливаем город, а каждую ночь я считаю здания, которые до сих пор лежат в руинах. Знаете, когда-то этот город был великолепен."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The demon war left scars on more than just the land. Entire districts were destroyed. But we'll rebuild - we must."
msgstr "Война с демонами оставила шрамы не только на земле. Целые районы были разрушены. Но мы восстановим их — мы просто обязаны это сделать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Would you like to help us rebuilding our homes?"
msgstr "Не хотели бы вы помочь нам восстановить наши дома?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "I'd like to help"
msgstr "Я хотел бы помочь"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "What do you need most?"
msgstr "Что вам нужно больше всего?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Good luck with that"
msgstr "Удачи тебе в этом"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "A volunteer! We desperately need building materials - wood planks specifically."
msgstr "Волонтер! Нам крайне нужны строительные материалы — в частности, деревянные доски."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The forests outside the city have salvageable materials, but they're monster-infested. Can you gather 20 Dry Wood for us?"
msgstr "В лесах за городом есть пригодные для использования материалы, но там полно монстров. Сможешь ли ты добыть для нас 20 единиц сухого дерева?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Wonderful! You'll find wood to the west and east of the city. Salvage what you can and bring back to me."
msgstr "Замечательно! Древесину можно найти к западу и к востоку от города. Собери всё, что сможешь, и принеси мне."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Watch out for scavenger monsters - they've made homes in the forests and don't take kindly to visitors."
msgstr "Остерегайтесь монстров-падальщиков — они обосновались в лесах и не слишком рады пришельцам."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Wood - the basic material of construction. But they're hard to come by now."
msgstr "Древесина — основной строительный материал. Но сейчас её трудно достать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The old quarries and lumber camps were overrun during the war. We'd need someone to venture out and reclaim them."
msgstr "Во время войны старые карьеры и лесозаготовительные лагеря были заброшены. Нам нужен кто-то, кто сможет отправиться туда и вернуть их в эксплуатацию."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "We rebuild with or without help. It's what we do."
msgstr "Мы восстанавливаемся — с чьей-то помощью или без нее. Это то, чем мы занимаемся."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've brought everything we need! Excellent work!"
msgstr "Вы принесли всё, что нам нужно! Отличная работа!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "With these materials, we can repair at least three houses. That's three more families with roofs over their heads."
msgstr "С помощью этих материалов мы сможем отремонтировать как минимум три дома. Это значит, что ещё три семьи получат крышу над головой."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You have my gratitude, and the gratitude of everyone in those homes."
msgstr "Я выражаю вам свою благодарность, а также благодарность всех, кто проживает в этих домах."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Thank you for gathering materials! We need 20 wood planks from Dry Woods (you have {0})."
msgstr "Спасибо за сбор материалов! Нам нужно 20 деревянных досок (у вас их {0})."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The forests are dangerous, but the materials there are essential for our recovery."
msgstr "Леса опасны, но добываемые там материалы необходимы для нашего восстановления."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The houses you helped rebuild are occupied now. I see children playing in those yards every day."
msgstr "Дома, которые вы помогли восстановить, теперь заселены. Я каждый день вижу, как дети играют в тех дворах."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "That's what reconstruction is really about - giving people their lives back."
msgstr "В этом и заключается истинный смысл восстановления — вернуть людям их жизнь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "[Merchant Guild] Anastasia"
msgstr "[Торговая гильдия] Анастасия"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Anastasia"
msgstr "Анастасия"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The Merchant Guild is working to reestablish trade routes between the three great cities."
msgstr "Торговая гильдия прилагает усилия по восстановлению торговых путей между тремя великими городами."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Klaipeda, Orsha, and Fedimian were once connected by thriving commerce. Now... we barely communicate."
msgstr "Клайпеда, Орша и Федимиан когда-то были связаны между собой оживлённой торговлей. А сейчас… мы едва общаемся."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "I need a reliable courier to deliver trade proposals to my counterparts in Orsha and Fedimian. Would you be willing to travel between the cities?"
msgstr "Мне нужен надежный курьер для доставки коммерческих предложений моим партнерам в Орше и Федимиане. Не могли бы вы совершить поездку между этими городами?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Splendid! Here are sealed letters for the guild representatives in both cities."
msgstr "Замечательно! Вот запечатанные письма для представителей гильдий в обоих городах."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Deliver them personally - don't trust these to random messengers. The future of our economy depends on reopening these trade routes."
msgstr "Доставьте их лично — не доверяйте их случайным курьерам. Будущее нашей экономики зависит от возобновления работы этих торговых путей."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "I understand. It's quite a journey. If you change your mind, the guild would compensate you well."
msgstr "Понимаю. Это довольно долгий путь. Если ты передумаешь, гильдия щедро тебя компенсирует."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've delivered both letters! The responses are... cautiously optimistic."
msgstr "Вы доставили оба письма! Отзывы… вызывают осторожный оптимизм."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Orsha is willing to resume grain shipments, and Fedimian will provide academic resources. It's a start!"
msgstr "Орша готова возобновить поставки зерна, а Федимиан предоставит ресурсы для исследований. Это уже начало!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Here's your payment, plus a bonus. You've helped lay the foundation for economic recovery across all three cities."
msgstr "Вот ваша оплата, плюс бонус. Вы помогли заложить основу для экономического восстановления во всех трёх городах."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You still need to deliver letters to both Orsha and Fedimian."
msgstr "Тебе всё ещё нужно доставить письма и в Оршу, и в Федимиан."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've delivered to Fedimian. Now deliver to the Orsha guild representative - Rose."
msgstr "Вы доставили груз в Федимиан. Теперь доставьте его представительнице Оршейской гильдии — Розе."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You've delivered to Orsha. Now deliver to the Fedimian guild representative - Anne."
msgstr "Вы доставили груз в Оршу. Теперь доставьте его представительнице гильдии в Федимиане — Анне."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Remember - deliver them personally to the guild representatives in each city."
msgstr "Не забудьте — передайте их лично представителям гильдии в каждом городе."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Thanks to your deliveries, trade is slowly resuming between our cities."
msgstr "Благодаря вашим поставкам торговля между нашими городами постепенно возобновляется."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "It'll take time to return to pre-war prosperity, but at least we're moving in the right direction."
msgstr "Чтобы вернуться к довоенному процветанию, потребуется время, но, по крайней мере, мы движемся в правильном направлении."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "[Mayor] Oswald"
msgstr "[Мэр] Освальд"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Mayor Oswald"
msgstr "Мэр Освальд"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "I've already signed the cooperation contract. Deliver it to Agatha in Fedimian."
msgstr "Я уже подписал договор о сотрудничестве. Передайте его Агате в Федимиане."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Klaipeda is ready to work with the other cities for our mutual prosperity."
msgstr "Клайпеда готова сотрудничать с другими городами ради нашего общего процветания."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "A cooperation contract from Fedimian? Let me see..."
msgstr "Договор о сотрудничестве из Федимиана? Дайте-ка посмотреть..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#666666}*He reads the contract carefully*{/}"
msgstr "{#666666}*Он внимательно читает договор*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "A Unity Summit to establish cooperation between our three cities? Interesting..."
msgstr "Совет Единства с целью налаживания сотрудничества между нашими тремя городами? Интересно..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Klaipeda has much to gain from renewed trade and cooperation. We need resources, knowledge, and allies."
msgstr "Клайпеда может извлечь большую выгоду из возобновления торговли и сотрудничества. Нам нужны ресурсы, знания и союзники."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Tell Agatha that Klaipeda accepts. We'll send our best delegates to represent our interests."
msgstr "Сообщите Агате, что Клайпеда согласна. Мы направим наших лучших делегатов для защиты наших интересов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Perhaps working together, we can all recover from this war faster."
msgstr "Возможно, объединив усилия, мы все сможем быстрее оправиться от последствий этой войны."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Unity contracts delivered: {0}/2"
msgstr "Контракты доставлены: {0}/2"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#FFD700}All contracts delivered! Return to Agatha in Fedimian.{/}"
msgstr "{#FFD700}Все контракты доставлены! Вернитесь к Агате в Федимиане.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Do you need me to sign a cooperation contract? You'll need to bring it to me first."
msgstr "Вам нужно, чтобы я подписал договор о сотрудничестве? Тогда сначала вам нужно принести его мне."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The Unity Summit was a great success. Our delegates reported productive discussions."
msgstr "Совет Единства прошел с большим успехом. Наши делегаты сообщили о плодотворных дискуссиях."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Klaipeda looks forward to working with Orsha and Fedimian for our mutual benefit."
msgstr "Клайпеда надеется на сотрудничество с Оршей и Федимианом в интересах обеих сторон."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "As Mayor of Klaipeda, I oversee the city's recovery and reconstruction efforts."
msgstr "В качестве мэра Клайпеды я курирую работу по восстановлению и реконструкции города."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "We're working hard to rebuild what the demon war destroyed."
msgstr "Мы прилагаем все усилия, чтобы восстановить то, что было разрушено в ходе войны с демонами."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "If you have business with the city, speak with our various coordinators around town."
msgstr "Если у вас есть дела с городскими властями, обратитесь к нашим координаторам, работающим в разных районах города."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "[Cursed Refugee] Aldric"
msgstr "[Проклятый беженец] Олдрик"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Aldric"
msgstr "Олдрик"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#666666}*The man is wrapped in heavy chains, his eyes haunted*{/}"
msgstr "{#666666}*Мужчина скован тяжелыми цепями, в его глазах читается страх*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Stay back... I'm dangerous. The curse... it makes me lose control when the sun sets."
msgstr "Не подходи... Я опасен. Проклятие... из-за него я теряю самообладание, когда садится солнце."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "How can I help?"
msgstr "Чем я могу помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Tell me about your curse"
msgstr "Расскажи мне о своём проклятии"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Leave him be"
msgstr "Оставь его в покое"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "A demon lord marked my village during the war. Those who survived... we carry his curse."
msgstr "Во время войны повелитель демонов наложил проклятие на мою деревню. Те, кто выжил... мы несем на себе его проклятие."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "At night, we become violent, mindless. These chains are the only thing keeping the citizens safe from me."
msgstr "Ночью мы становимся жестокими, лишенными разума. Эти цепи — единственное, что защищает горожан от меня."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You would help someone like me? I... thank you."
msgstr "Вы помогли бы такому человеку, как я? Я… спасибо вам."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "There might be a way to break the curse. In my village ruins, there's an ancient chest with a broken amulet. If you could retrieve it..."
msgstr "Возможно, есть способ снять проклятие. В руинах моей деревни находится древний сундук с разбитым амулетом. Если бы ты мог его достать..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The broken amulet absorbs dark energies - it might be able to draw out the curse from my body."
msgstr "Сломанный амулет поглощает тёмную энергию — возможно, он сможет избавить меня от проклятия."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The cursed villagers still wander the ruins. They were my neighbors once. My friends. Now they're just... shells."
msgstr "Проклятые жители деревни до сих пор бродят по руинам. Когда-то они были моими соседями. Моими друзьями. А теперь они всего лишь… пустые оболочки."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Head east from the Miner's Village. You'll find the ruins there, and the chest with the amulet. Please... hurry."
msgstr "Отправляйтесь на восток от Деревни шахтёров. Там вы найдёте руины и сундук с амулетом. Пожалуйста... поторопитесь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#666666}*He nods silently, chains rattling*{/}"
msgstr "{#666666}*Он молча кивает, и цепи звенят*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#FFFF00}*His eyes widen as he sees the broken amulet*{/}"
msgstr "{#FFFF00}*Увидев разбитый амулет, он широко раскрыл глаза*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "You found it! You actually found it! Please, place it against my chest - carefully, the curse fights back..."
msgstr "Это он! Это действительно он! Пожалуйста, прижми его к моей груди — осторожно, проклятие сопротивляется..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "{#FF0000}*As the amulet touches him, it begins to glow. Dark smoke pours from his body into the amulet. He screams in pain, then... silence*{/}"
msgstr "{#FF0000}*Как только амулет прикоснулся к нему, он начал светиться. Из его тела в амулет хлынул тёмный дым. Он закричал от боли, а затем… наступила тишина*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "It's... it's gone. The curse is broken! The amulet absorbed all the dark energy!"
msgstr "Оно... оно исчезло. Проклятие снято! Амулет поглотил всю тёмную энергию!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Thank you, stranger. You've given me my life back. Here - this was my father's. He'd want you to have it."
msgstr "Спасибо, незнакомец. Вы вернули мне жизнь. Вот — это принадлежало моему отцу. Он хотел бы, чтобы вы это взяли."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "The broken amulet should be in an ancient chest somewhere in the village ruins. Please, hurry. Every night the curse grows stronger."
msgstr "Сломанный амулет должен находиться в старинном сундуке где-то среди руин деревни. Пожалуйста, поторопитесь. С каждой ночью проклятие становится всё сильнее."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Eastwood Village is east from the Miner's Village. Look for the ruins."
msgstr "Иствуд-Виллидж находится к востоку от Деревни Шахтеров. Ищите руины."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "I'm free of the curse, but my village is still lost. Perhaps one day I'll return and help cleanse it."
msgstr "Я избавился от проклятия, но моя деревня по-прежнему находится в беде. Возможно, однажды я вернусь и помогу ей избавиться от него."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Until then, I owe you a debt I can never repay. You've given me hope when I had none."
msgstr "До тех пор я остаюсь у тебя в долгу, который никогда не смогу погасить. Ты подарил мне надежду, когда у меня её не было."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Caravan Escort"
msgstr "Сопровождение каравана"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Clear the western road of monsters so supply caravans can safely reach Klaipeda."
msgstr "Очистите западную дорогу от монстров, чтобы караваны с продовольствием могли безопасно добраться до Клайпеды."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Kill Hanamings"
msgstr "Убить Ханамингов"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Kill Kepas"
msgstr "Убить Кепы"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Kill Leaf Bugs"
msgstr "Уничтожьте жуков"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Kill Infrorocktor"
msgstr "Убить Инфророктора"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Cleansing the River"
msgstr "Очистка реки"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Help River Warden Elara by removing corrupted tree branches that are polluting Klaipeda's main water source."
msgstr "Помогите речному стражу Эларе, удалив заражённые ветки деревьев, которые загрязняют главный источник воды Клайпеды."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Collect Withered Burnt Branches"
msgstr "Соберите засохшие и обожженные ветки"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Rebuilding Klaipeda"
msgstr "Восстановление Клайпеды"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Gather wood planks from the forest monsters to help rebuild Klaipeda."
msgstr "Соберите деревянные доски у лесных монстров, чтобы помочь восстановить Клайпеду."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Collect Dry Wood"
msgstr "Соберите сухую древесину"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Reopening Trade Routes"
msgstr "Восстановление торговых путей"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Deliver trade proposals to the Merchant Guild representatives in Orsha and Fedimian."
msgstr "Передайте торговые предложения представителям Гильдии купцов в Орше и Федимиане."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Deliver letter to Orsha Merchant Guild"
msgstr "Доставить письмо в Оршанскую купеческую гильдию"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Deliver letter to Fedimian Merchant Guild"
msgstr "Доставить письмо в Гильдию купцов Федимиана"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Breaking the Curse"
msgstr "Разрушение проклятия"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Retrieve the broken amulet from Eastwood Village at east of Miner's Village to break Aldric's curse. The amulet absorbs dark energies and may be able to draw out the curse."
msgstr "Найдите сломанный амулет в деревне Иствуд, расположенной к востоку от Деревни шахтёров, чтобы снять проклятие с Олдрика. Амулет поглощает тёмную энергию и, возможно, сможет избавить его от проклятия."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_klaipe_quests.cs
msgid "Retrieve the broken amulet"
msgstr "Найди сломанный амулет"

# ============================================================================
# Orsha Quests (c_orsha_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "[Commander] Theron"
msgstr "[Командир] Терон"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Theron"
msgstr "Терон"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Orsha stands ready to coordinate with the other cities."
msgstr "Орша готова координировать свои действия с другими городами."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "A cooperation contract from Fedimian? Let me review this..."
msgstr "Договор о сотрудничестве из Федимиана? Дайте мне его посмотреть..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*He reads the contract with a stern expression*{/}"
msgstr "{#666666}*Он читает договор с суровым выражением лица*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "A Unity Summit between the three cities... Hmph. Politicians and diplomats talking instead of acting."
msgstr "Совет Единства с участием представителей трёх городов… Хм. Политики и дипломаты только и делают, что болтают, вместо того чтобы действовать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "But I suppose talking is better than fighting. Orsha needs allies, not more enemies."
msgstr "Но, пожалуй, лучше поговорить, чем воевать. Орше нужны союзники, а не новые враги."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Tell Agatha that Commander Theron accepts on behalf of Orsha. We'll send our military advisors."
msgstr "Передайте Агате, что командир Терон даёт согласие от имени Орши. Мы отправим наших военных советников."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "If nothing else, it's an opportunity to coordinate our defenses against the remaining monster threats."
msgstr "По крайней мере, это возможность скоординировать наши действия по защите от оставшихся угроз со стороны монстров."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*The grizzled commander regards you with interest*{/}"
msgstr "{#666666}*Седой командир с интересом смотрит на вас*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Recording testimonies from the war? The Grand Archive is doing important work."
msgstr "Запись свидетельств о войне? «Гранд-архив» выполняет важную работу."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Would you like to hear my account as a military commander who fought on the front lines?"
msgstr "Хотите послушать мой рассказ как военного командира, сражавшегося на передовой?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*Commander Theron speaks with military precision into the recording crystal*{/}"
msgstr "{#666666}*Командир Терон с военной точностью произносит слова в записывающий кристалл*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "'I am Commander Theron of Orsha. I led the defense of our northern borders during the demon war.'"
msgstr "«Я — командир Терон из Орши. Во время войны с демонами я возглавлял оборону наших северных границ»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "'We lost many good soldiers - friends, comrades, people I trained myself. But we held the line.'"
msgstr "«Мы потеряли много хороших солдат — друзей, товарищей, людей, которых я сам обучал. Но мы удержали позиции»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "'Orsha stands strong because we never gave up. That's what makes a true soldier.'"
msgstr "«Орша стоит на ногах, потому что мы никогда не сдавались. Именно это и делает человека настоящим солдатом»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "'The war cost us dearly, but it taught us that unity and determination can overcome even the darkest threats.'"
msgstr "«Война дорого обошлась нам, но она научила нас, что единство и решимость способны преодолеть даже самые мрачные угрозы»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "War testimonies recorded: {0}/3"
msgstr "Записанные свидетельства о войне: {0}/3"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#FFD700}All testimonies collected! Return to Grand Archivist Elwen in Fedimian.{/}"
msgstr "{#FFD700}Все свидетельства собраны! Вернитесь к главному архивариусу Элвену в Федимиане.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Make sure the Grand Archive preserves these accounts. Future generations must learn from our experiences."
msgstr "Позаботьтесь о том, чтобы «Великий архив» сохранил эти свидетельства. Будущие поколения должны извлечь уроки из нашего опыта."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I've already given my testimony. Share it with the Grand Archive."
msgstr "Я уже дал свои показания. Отправьте их в Главный архив."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Are you headed to Izoliacjia Plateau? These used to be the Orsha Military's old training grounds..."
msgstr "Собираетесь на плато Изолиачья? Раньше здесь находились старые полигоны Оршской военной части..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*The grizzled commander gazes toward the plateau with a distant look*{/}"
msgstr "{#666666}*Седой командир смотрит в сторону плато с отрешённым выражением лица*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "We held those lands for generations. Every soldier in Orsha trained there - myself included."
msgstr "Мы владели этими землями на протяжении многих поколений. Каждый солдат в Орше проходил там подготовку — в том числе и я."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "But after the demon war, we lost control. The area became overrun with monsters. Now they roam freely where our soldiers once marched."
msgstr "Но после войны с демонами мы утратили контроль. Эта местность оказалась завалена монстрами. Теперь они свободно бродят там, где когда-то маршировали наши солдаты."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I could help reclaim those lands"
msgstr "Я мог бы помочь вернуть эти земли"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Tell me about the war"
msgstr "Расскажи мне о войне"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I'll be going now"
msgstr "Я пойду уже"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*He shakes his head*{/}"
msgstr "{#666666}*Он качает головой*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Sorry, but I would need you to be stronger to handle this. You know, these monsters are dangerous."
msgstr "Извини, но тебе нужно быть сильнее, чтобы справиться с этим. Ты же знаешь, эти монстры опасны."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Come back when you're at least level 30, and we'll talk about reclaiming our lands."
msgstr "Вернись, когда достигнешь хотя бы 30-го уровня, и тогда мы поговорим о том, как вернуть наши земли."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*He clears his throat*{/}"
msgstr "{#666666}*Он прочищает горло*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Would you help me reclaim these lands? They have been overrun by monsters."
msgstr "Не поможете ли вы мне отвоевать эти земли? Их захватили монстры."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "If we could clear out the beasts, we could restore the training grounds and rebuild our military strength."
msgstr "Если бы нам удалось избавиться от этих чудовищ, мы смогли бы восстановить полигоны и восстановить нашу военную мощь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Drive back the monsters and I'll personally ensure you're rewarded for your service. Will you help?"
msgstr "Отбейте монстров, и я лично позабочусь о том, чтобы вы получили награду за свои заслуги. Вы поможете?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Excellent! Head to Izoliacjia Plateau and drive back the Yakmap and Yakmambo infesting our old training grounds."
msgstr "Отлично! Отправляйтесь на плато Изолиаччия и прогоните Якмапов и Якмамбо, заполонивших наши старые полигоны."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "When you return victorious, Orsha will be one step closer to reclaiming our heritage. Move out!"
msgstr "Когда вы вернётесь с победой, Орша станет на шаг ближе к тому, чтобы вернуть себе своё наследие. Вперед!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*His expression darkens*{/}"
msgstr "{#666666}*Его лицо омрачилось*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The demon war... we lost too many good soldiers. Friends, comrades, people I trained myself."
msgstr "Война с демонами… Мы потеряли слишком много хороших солдат. Друзей, товарищей, людей, которых я сам обучал."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "But we survived. Orsha stands strong because we never gave up. That's what makes a true soldier."
msgstr "Но мы выстояли. Орша стоит на ногах, потому что мы никогда не сдавались. Именно это и делает человека настоящим солдатом."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Dismissed! Come back when you're ready to serve."
msgstr "Уходите! Вернитесь, когда будете готовы к службе."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The training grounds aren't clear yet!"
msgstr "Места проведения тренировок пока не определены!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Yakmap eliminated: {0}/40"
msgstr "Yakmap уничтожено: {0}/40"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Yakmambo eliminated: {0}/5"
msgstr "Yakmambo уничтожено: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Our recruits depend on having safe training facilities. Get back out there!"
msgstr "Наши новобранцы нуждаются в безопасных учебных объектах. Возвращайтесь на место!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Outstanding work! The training grounds are clear and recruits are already using them again."
msgstr "Отличная работа! Учебные площадки приведены в порядок, и новобранцы уже снова на них тренируются."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You've proven yourself a capable warrior. Here - these combat techniques served me well in the war."
msgstr "Ты доказал, что ты способный воин. Вот - эти боевые приёмы очень пригодились мне на войне."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Use them wisely, and maybe you'll live as long as I have!"
msgstr "Используйте их с умом, и, может быть, вы проживете столько же, сколько я!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The Unity Summit proved useful. Our cities are coordinating defenses and sharing resources."
msgstr "Совет Единства оказался полезным. Наши города координируют меры по защите и обмениваются ресурсами."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Orsha remains strong, and now we have reliable allies. That's good tactics."
msgstr "Орша по-прежнему сильна, и теперь у нас есть надёжные союзники. Это хорошая тактика."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The recruits are training hard thanks to you. Orsha's military grows stronger every day."
msgstr "Благодаря вам новобранцы усердно тренируются. Вооружённые силы Орши с каждым днём становятся всё сильнее."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You're welcome in our ranks anytime, soldier!"
msgstr "В наших рядах тебе всегда рады, солдат!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "[Forest Warden] Miriam"
msgstr "[Лесничий] Мириам"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Miriam"
msgstr "Мириам"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The roads through the forest have become dangerous. Travelers and adventurers are being attacked by monsters."
msgstr "Дороги, пролегающие через лес, стали опасными. На путешественников и искателей приключений нападают монстры."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*She gestures toward the forest path outside the city*{/}"
msgstr "{#666666}*Она указывает на лесную тропу за пределами города*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The Woods of the Linked Bridges used to be a safe passage. Now? Dark creatures roam freely, and the ancient purifying statues have lost their power."
msgstr "Когда-то Лес Связанных Мостов был безопасным проходом. А сейчас? По нему свободно бродят мрачные существа, а древние очищающие статуи утратили свою силу."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Can we make the roads safe again?"
msgstr "Сможем ли мы снова сделать дороги безопасными?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "What are these purifying statues?"
msgstr "Что это за очищающие статуи?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "That sounds difficult"
msgstr "Это звучит сложно"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "There is a way! The ancient purifying statues blessed by the Guardian Owl still stand in the forest."
msgstr "Есть выход! В лесу до сих пор стоят древние очищающие статуи, освящённые Совой-хранителем."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "If you could pray at each of the five purifying statues, their holy power will awaken and drive back the monsters. Will you help us?"
msgstr "Если вы помолитесь у каждой из пяти очищающих статуй, их святая сила пробудится и отгонит чудовищ. Вы поможете нам?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Thank the goddesses! The five purifying statues are scattered throughout the Woods of the Linked Bridges."
msgstr "Слава богиням! Пять очищающих статуй разбросаны по всему Лесу Связанных Мостов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You'll recognize them - they're wooden statues carved in the shape of an owl. Pray at each one to energize them."
msgstr "Вы их сразу узнаете — это деревянные статуэтки в форме совы. Помолитесь у каждой из них, чтобы зарядить их энергией."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Be careful out there. The monsters have made the forest their territory."
msgstr "Будьте осторожны. Монстры захватили лес."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Long ago, our ancestors erected purifying statues throughout the forest. They were blessed by priests of the goddess Laima."
msgstr "Давным-давно наши предки установили по всему лесу очистительные статуи. Их освятили жрецы богини Лаймы."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "These statues protected travelers and kept the forest safe. But during the demon war, their holy power was drained."
msgstr "Эти статуи защищали путешественников и охраняли лес. Но во время войны с демонами их святая сила иссякла."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Now they stand dormant, and without their protection, monsters have overrun the roads."
msgstr "Теперь они находятся в состоянии покоя, и без их защиты дороги заполонили чудовища."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "It is difficult. But someone must protect our travelers. Every day, more people are hurt on those roads."
msgstr "Это сложно. Но кто-то должен защищать наших путешественников. С каждым днём на этих дорогах пострадает всё больше людей."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Have you prayed at the purifying statues? You've energized {0} out of 5 so far."
msgstr "Вы молились у статуй, дарующих очищение? На данный момент вы набрали {0} из 5 очков энергии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Look for the wooden statues carved in the shape of an owl. Offer your prayers to awaken their holy power."
msgstr "Обратите внимание на деревянные статуэтки в форме совы. Помолитесь, чтобы пробудить их священную силу."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*Her eyes light up with hope*{/}"
msgstr "{#666666}*Её глаза загораются надеждой*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I can already feel the difference! The forest feels safer, and travelers are reporting fewer monster attacks!"
msgstr "Я уже чувствую разницу! В лесу стало безопаснее, а путешественники сообщают о меньшем количестве нападений монстров!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The purifying statues are glowing with holy light again. The roads will be safe once more!"
msgstr "Очищающие статуи вновь сияют святым светом. Дороги снова станут безопасными!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Here - take this as thanks. This magical talisman will protect you from darkness. You've protected countless lives today, traveller."
msgstr "Вот — прими это в знак благодарности. Этот волшебный талисман защитит тебя от тьмы. Сегодня ты спас бесчисленное количество жизней, путешественник."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The roads through the forest are safe again! Travelers can pass without fear."
msgstr "Дороги через лес снова безопасны! Путешественники могут проходить по ним без опасений."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The purifying statues protect us once more, thanks to you."
msgstr "Благодаря вам очищающие статуи вновь защищают нас."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "[Relic Hunter] Raymond"
msgstr "[Охотник за реликвиями] Рэймонд"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Raymond"
msgstr "Рэймонд"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I'm a historian working with the Orsha military. We're searching for fragments of an ancient tombstone."
msgstr "Я историк, работающий в Оршском военном ведомстве. Мы ищем фрагменты древнего надгробного камня."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "This tombstone holds inscriptions about the old war with the demons - tactical knowledge that could be invaluable."
msgstr "На этом надгробном камне высечены надписи о давней войне с демонами — тактические знания, которые могут оказаться бесценными."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "What do you seek?"
msgstr "Что вы ищете?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Can I assist your search?"
msgstr "Могу ли я помочь вам в поиске?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Why is this tombstone important?"
msgstr "Почему это надгробие имеет такое значение?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I'll be on my way"
msgstr "Я пойду"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*He shakes his head apologetically*{/}"
msgstr "{#666666}*Он извиняюще качает головой*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I appreciate your willingness to help, but the battlefield is extremely dangerous. The corrupted monsters there would overwhelm someone of your current experience."
msgstr "Я ценю вашу готовность помочь, но поле боя чрезвычайно опасно. Искаженные монстры, обитающие там, с легкостью одолеют человека с вашим нынешним опытом."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Come back when you're at least level 15, and we can discuss this further. The Orsha military needs capable fighters for this mission."
msgstr "Вернись, когда достигнешь как минимум 15-го уровня, и тогда мы сможем обсудить это подробнее. Вооруженным силам Орши нужны способные бойцы для этой миссии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Someone willing to help preserve our military history! The Orsha command will be grateful."
msgstr "Кто-то, готовый помочь сохранить нашу военную историю! Командование Орши будет вам благодарно."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The tombstone was destroyed during the demon war, shattered into five pieces. They're scattered across the old battlefield in Nobreer Forest. Can you help me recover them?"
msgstr "Надгробный камень был разрушен во время войны с демонами и разлетелся на пять частей. Они разбросаны по старому полю битвы в лесу Нобреер. Не могли бы вы помочь мне их собрать?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Excellent! The fragments are scattered across the old battlefield south of Orsha."
msgstr "Отлично! Осколки разбросаны по старому полю сражения к югу от Орши."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The area is still dangerous - corrupted monsters guard the ruins. But the stone fragments should be recognizable among the rubble."
msgstr "Эта местность по-прежнему опасна — руины охраняют заражённые монстры. Но среди обломков должны быть заметны каменные осколки."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The tombstone belonged to a legendary commander who fought in the first demon war, centuries ago."
msgstr "Надгробный камень принадлежал легендарному полководцу, сражавшемуся в первой войне с демонами много веков назад."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The inscriptions contain battle formations, demon weaknesses, and tactical knowledge that was lost over time."
msgstr "В надписях содержатся сведения о боевых построениях, уязвимых местах демонов и тактических приёмах, утраченных с течением времени."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "With demons potentially returning, the Orsha military desperately needs this knowledge. It could save countless lives in future conflicts."
msgstr "В связи с возможным возвращением демонов военным Орши крайне необходимы эти знания. Они могут спасти бесчисленное количество жизней в будущих конфликтах."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Safe travels. If you change your mind, the military needs all the help it can get."
msgstr "Удачного пути. Если передумаете, армии нужна любая помощь, которую только можно оказать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You found them! All five fragments of the ancient tombstone!"
msgstr "Ты их нашёл! Все пять осколков древнего надгробного камня!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*He carefully examines each piece, his hands trembling with excitement*{/}"
msgstr "{#666666}*Он внимательно осматривает каждую деталь, а его руки дрожат от волнения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Remarkable! Even damaged, I can make out parts of the inscriptions. Battle formations... demon weak points... this is exactly what the military needed!"
msgstr "Потрясающе! Даже несмотря на повреждения, я могу разобрать отдельные фрагменты надписей. Боевые построения… уязвимые места демонов… это именно то, что нужно было военным!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The tombstone belonged to Commander Valen, who led Orsha's forces in the first demon war. His tactical genius saved the kingdom."
msgstr "Надгробный камень принадлежал командиру Валену, который возглавлял войска Орши во время первой войны с демонами. Его тактический гений спас королевство."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I'll work with military scholars to translate and preserve these inscriptions. This knowledge could be crucial if the demons ever return."
msgstr "Я буду сотрудничать с военными историками, чтобы перевести и сохранить эти надписи. Эти знания могут оказаться жизненно важными, если демоны когда-нибудь вернутся."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You've done Orsha a great service. The military council asked me to give you this reward. Thank you."
msgstr "Вы оказали Орше огромную услугу. Военный совет поручил мне вручить вам эту награду. Спасибо."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You've found {0} fragments so far. We need all 5 pieces to restore the tombstone's inscriptions."
msgstr "На данный момент вы нашли {0} фрагментов. Нам нужно собрать все 5 частей, чтобы восстановить надписи на надгробной плите."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Keep searching the old battlefield. The stone fragments should stand out among the debris."
msgstr "Продолжайте обыскивать старое поле сражения. Осколки камней должны быть хорошо заметны среди обломков."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The military scholars have finished translating the tombstone inscriptions. The tactical knowledge is already being incorporated into training."
msgstr "Военные исследователи завершили перевод надписей на надгробиях. Полученные сведения о тактике уже внедряются в учебный процесс."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Commander Valen's wisdom will help protect Orsha for generations to come, thanks to your help."
msgstr "Мудрость командира Валена поможет защитить Оршу на протяжении многих поколений — благодаря вашей помощи."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "[Healer] Tamara"
msgstr "[Целительница] Тамара"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Tamara"
msgstr "Тамара"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Welcome to the Orsha Infirmary. This building has been converted to treat our soldiers."
msgstr "Добро пожаловать в Оршскую полевую госпиталь. Это здание было переоборудовано для оказания медицинской помощи нашим солдатам."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*You hear coughing and groans of pain from inside the building*{/}"
msgstr "{#666666}*Изнутри здания доносятся кашель и стоны боли*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "So many wounded from the war... We're doing our best, but we're running low on medicinal herbs."
msgstr "Столько раненых в результате войны... Мы делаем всё, что в наших силах, но у нас заканчиваются лекарственные травы."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "What happened to these soldiers?"
msgstr "Что случилось с этими солдатами?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I should go"
msgstr "Мне пора"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*Her exhausted face lights up with relief*{/}"
msgstr "{#666666}*Её измученное лицо озарилось облегчением*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Bless you! Our soldiers are suffering from battle wounds, infections, and fevers."
msgstr "Будьте здоровы! Наши солдаты страдают от боевых ранений, инфекций и лихорадки."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "I need medicinal herbs to create poultices and remedies. Without them, many won't survive. Will you help gather herbs for the infirmary?"
msgstr "Мне нужны лекарственные травы для приготовления припарок и лекарств. Без них многие не выживут. Поможете ли вы собрать травы для лазарета?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Thank you! I need 5 Languid Herbs for pain relief, 5 Sweet Herbs for fever, and 5 Fragrant Herbs for infection."
msgstr "Спасибо! Мне нужно 5 «Темных трав» для снятия боли, 5 «Сладких трав» для снижения температуры и 5 «Ароматных трав» для лечения инфекции."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "These herbs grow in the forests surrounding Orsha. Some monsters carry them as well."
msgstr "Эти травы растут в лесах, окружающих Оршу. Некоторые монстры тоже носят их с собой."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Please hurry - every hour without medicine, we lose more soldiers."
msgstr "Пожалуйста, поторопитесь — с каждым часом без лекарств мы теряем всё больше солдат."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "These are our brave warriors who fought in the demon war. Battle wounds, demon corruption, festering injuries..."
msgstr "Это наши отважные воины, сражавшиеся в войне с демонами. Боевые раны, демоническое заражение, гноящиеся раны..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The military healers are overwhelmed. This building was hastily converted into an infirmary to handle the overflow."
msgstr "Военные медики не справляются с нагрузкой. Это здание в спешном порядке было переоборудовано в лазарет, чтобы принять избыток пациентов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "We're doing everything we can, but without proper herbs and medicines, I fear many won't make it."
msgstr "Мы делаем всё, что в наших силах, но без необходимых лекарственных трав и медикаментов боюсь, что многие не выживут."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "May the goddess watch over you. If you change your mind, these soldiers need all the help they can get."
msgstr "Пусть богиня хранит тебя. Если ты передумаешь, этим солдатам понадобится любая помощь, которую только можно оказать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You've brought all the herbs! Thank the goddess!"
msgstr "Ты принесла все травы! Слава богине!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*She immediately begins preparing remedies*{/}"
msgstr "{#666666}*Она сразу же приступает к приготовлению лекарств*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The Languid Herbs will ease their pain. The Sweet Herbs will break their fevers. The Fragrant Herbs will fight infection."
msgstr "«Успокаивающие травы» облегчат их боль. «Сладкие травы» снизят у них температуру. «Ароматные травы» помогут бороться с инфекцией."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "You've saved lives today. These soldiers will survive because of you."
msgstr "Сегодня вы спасли жизни. Эти солдаты останутся в живых благодаря вам."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Here - take these supplies from the military stores. The Commander approved this reward for helping our wounded."
msgstr "Вот — заберите эти припасы из военных складов. Командир одобрил эту награду за помощь нашим раненым."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Did you find the herbs? We desperately need them - soldiers are dying in there. Please hurry!"
msgstr "Вы нашли лекарственные травы? Они нам крайне нужны — там гибнут солдаты. Пожалуйста, поторопитесь!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Thanks to those herbs, many soldiers have recovered. Some are even back on duty already."
msgstr "Благодаря этим травам многие солдаты выздоровели. Некоторые из них даже уже вернулись к несению службы."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The infirmary is still crowded, but at least now I have the medicine to treat them properly."
msgstr "В лазарете по-прежнему много людей, но, по крайней мере, теперь у меня есть лекарства, чтобы оказать им надлежащую помощь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "[Merchant Guild] Rose"
msgstr "[Торговая гильдия] Роза"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Rose"
msgstr "Роуз"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Ah, a letter from the Klaipeda Guild! Let me see..."
msgstr "Ах, письмо от Клайпедской гильдии! Посмотрим..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "{#666666}*She reads the letter carefully*{/}"
msgstr "{#666666}*Она внимательно читает письмо*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Trade proposals, resource sharing, joint caravans... this is exactly what we need!"
msgstr "Торговые предложения, совместное использование ресурсов, совместные караваны… это именно то, что нам нужно!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Tell your guild master we accept. Orsha will resume grain shipments to Klaipeda starting next month."
msgstr "Сообщите главе вашего гильдии, что мы согласны. С следующего месяца Орша возобновит поставки зерна в Клайпеду."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Here's our formal response. Thank you for making this journey."
msgstr "Вот наш официальный ответ. Спасибо, что прошли этот путь вместе с нами."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Trade with Klaipeda is resuming nicely. It's good to see cooperation between our cities again."
msgstr "Торговля с Клайпедой успешно возобновляется. Приятно видеть, что сотрудничество между нашими городами снова налаживается."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "The Merchant Guild is working to restore trade networks across all three cities."
msgstr "Торговая гильдия работает над восстановлением торговых сетей, охватывающих все три города."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "War may have divided us, but commerce will bring us back together."
msgstr "Война, возможно, разделила нас, но торговля вновь объединит нас."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Reclaim the Training Grounds"
msgstr "Верните себе полигоны"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Clear monsters from Orsha's military training grounds so recruits can train safely."
msgstr "Уничтожьте монстров на военном полигоне в Орше, чтобы новобранцы могли безопасно проходить обучение."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Kill Yakmap"
msgstr "Уничтожить Yakmap"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Kill Yakmambo"
msgstr "Убить Якмамбо"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Guardians of the Forest Roads"
msgstr "Стражи лесных дорог"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Pray at the five ancient purifying statues in the Woods of the Linked Bridges to awaken their holy power and protect travelers from monster attacks."
msgstr "Помолитесь у пяти древних очищающих статуй в Лесу Связанных Мостов, чтобы пробудить их святую силу и защитить путешественников от атак монстров."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Pray at Purifying Statues"
msgstr "Молитесь у очищающих статуй"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Echoes of the Ancient War"
msgstr "Отголоски древней войны"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Recover the five fragments of an ancient tombstone containing tactical knowledge from the first demon war."
msgstr "Найдите пять осколков древнего надгробного камня, содержащего тактические знания о первой войне с демонами."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Collect Tombstone fragments"
msgstr "Собери осколки надгробных камней"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Healing the Wounded"
msgstr "Исцеление раненых"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Gather medicinal herbs for the Orsha Infirmary to treat wounded soldiers - Languid Herbs, Sweet Herbs, and Fragrant Herbs."
msgstr "Соберите лекарственные травы для Оршейской лазареты, чтобы лечить раненых солдат — вялые травы, сладкие травы и ароматные травы."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Collect Languid Herbs"
msgstr "Собери «Лангуид Хербс»"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Collect Sweet Herbs"
msgstr "Собери ароматные травы"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_orsha_quests.cs
msgid "Collect Fragrant Herbs"
msgstr "Соберите ароматные травы"

# ============================================================================
# Fedimian Quests (c_fedimian_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "[Grand Archivist] Elwen"
msgstr "[Главный архивариус] Элвен"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Elwen"
msgstr "Элвен"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Welcome to Fedimian's Grand Archive. Here we preserve the knowledge and history of our world."
msgstr "Добро пожаловать в Великий архив Федимиана. Здесь мы храним знания и историю нашего мира."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*She gestures to countless scrolls and books lining the walls*{/}"
msgstr "{#666666}*Она указывает на бесчисленные свитки и книги, выстроенные вдоль стен*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I'm compiling a comprehensive history of the demon war. Future generations must understand what happened - both the horrors and the heroism."
msgstr "Я составляю исчерпывающую историю войны с демонами. Будущие поколения должны понять, что произошло — и ужасы, и подвиги."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "How can I assist?"
msgstr "Чем я могу помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I'd like to contribute"
msgstr "Я хотел бы внести свой вклад"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "What kind of history are you compiling?"
msgstr "Какую историю вы составляете?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Just browsing"
msgstr "Просто просматриваю"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Truly? I need someone to seek out war survivors and collect their testimonies."
msgstr "Правда? Мне нужен человек, который будет разыскивать выживших в войне и собирать их свидетельства."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "There are three key witnesses I've identified. Would you be willing to interview them and record their stories?"
msgstr "Я выявил трех ключевых свидетелей. Не могли бы вы провести с ними интервью и записать их рассказы?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Wonderful! Here's a recording crystal. It will preserve their words exactly as spoken."
msgstr "Замечательно! Вот кристалл записи. Он сохранит их слова в точности так, как они были сказаны."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The witnesses are: Commander Theron in Orsha, Peregrin Lyon at Ramstis Ridge, and Wizard Silas here in Fedimian."
msgstr "Свидетелями являются: командир Терон в Орше, Перегрин Лион на хребте Рамстис и волшебник Силас здесь, в Федимиане."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Ask them about their experiences during the war. The crystal will do the rest."
msgstr "Спросите их об их переживаниях во время войны. Кристалл сделает всё остальное."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I'm gathering firsthand accounts from those who lived through the war - soldiers, civilians, survivors."
msgstr "Я собираю рассказы из первых рук от тех, кто пережил войну — солдат, мирных жителей, выживших."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Each person's story is unique. Together, they form a complete picture of what our world endured."
msgstr "История каждого человека уникальна. Вместе они составляют полную картину того, что пришлось пережить нашему миру."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "But many survivors won't come forward. They're scattered across the land, and their memories are painful."
msgstr "Но многие выжившие не решатся выступить. Они разбросаны по всей стране, а их воспоминания причиняют боль."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Feel free to browse our collection. Knowledge should be shared."
msgstr "Не стесняйтесь знакомиться с нашей коллекцией. Знаниями нужно делиться."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've collected all three testimonies! Let me review them..."
msgstr "Вы собрали все три свидетельства! Позвольте мне их проанализировать..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*She holds the crystal, tears streaming down her face as she listens*{/}"
msgstr "{#666666}*Она держит кристалл, и по её лицу текут слёзы, пока она слушает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "These stories... such pain, such courage. This is exactly what we need to preserve."
msgstr "Эти истории… столько боли, столько мужества. Именно это нам и нужно сохранить."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Future generations will learn from these accounts. They'll understand the true cost of war, and hopefully prevent another one."
msgstr "Будущие поколения извлекут уроки из этих рассказов. Они поймут, какова истинная цена войны, и, надеемся, смогут предотвратить новую."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've made an invaluable contribution to our history. Thank you."
msgstr "Вы внесли неоценимый вклад в нашу историю. Спасибо."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've collected {0} out of 3 testimonies so far."
msgstr "На данный момент вы собрали {0} из 3 отзывов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Remember: Commander Theron in Orsha, Peregrin Lyon at Ramstis Ridge, and Wizard Silas here in Fedimian."
msgstr "Запомните: командир Терон в Орше, Перегрин Лион на хребте Рамстис и волшебник Силас здесь, в Федимиане."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Your work on the War Chronicles has been invaluable. The testimonies you gathered will educate generations."
msgstr "Ваша работа над «Хрониками войны» оказалась неоценимой. Собранные вами свидетельства станут источником знаний для многих поколений."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*She pauses, studying you with keen eyes*{/}"
msgstr "{#666666}*Она делает паузу, пристально разглядывая тебя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Your dedication and trustworthiness have not gone unnoticed. I have another matter - one of great importance and sensitivity."
msgstr "Ваша преданность делу и надежность не остались незамеченными. У меня есть ещё один вопрос — очень важный и деликатный."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I'm willing to help"
msgstr "Я готов помочь"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Tell me more"
msgstr "Расскажи мне подробнее"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I'm not interested"
msgstr "Мне это неинтересно"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The Royal Mausoleum in the Ramstis region contains ancient relics from Fedimian's past."
msgstr "В Королевском мавзолее, расположенном в регионе Рамстис, хранятся древние реликвии, связанные с прошлым Федимии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Our sages have been investigating reports of a powerful relic documented by the great scholar Kepeck."
msgstr "Наши мудрецы изучают сообщения о могущественной реликвии, описанной великим учёным Кепеком."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "However, the mausoleum is sealed and filled with dangerous creatures. Only those with official permission may enter."
msgstr "Однако мавзолей опечатан и наполнен опасными существами. В него могут войти только те, кто имеет официальное разрешение."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I would entrust you with the Great King's Key - proof of your authority to enter the Royal Mausoleum. Will you venture there and recover Kepeck's Relic Memorandum?"
msgstr "Я хотел бы передать вам Ключ Великого Короля — доказательство вашей власти, позволяющее войти в Королевский мавзолей. Отважитесь ли вы отправиться туда и вернуть «Меморандум о реликвии Кепека»?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Excellent! This key proves you act with the Archive's full authority."
msgstr "Отлично! Этот ключ подтверждает, что вы действуете от имени Архива с полными полномочиями."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Travel to the Royal Mausoleum entrance in Ramstis Ridge. Show the key to the guard, and they will grant you passage."
msgstr "Отправляйтесь к входу в Королевское мавзолей на хребте Рамстис. Покажите ключ стражнику, и он пропустит вас."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Inside, search for Kepeck's Relic Memorandum - scrolls documenting a powerful relic. Be careful - the mausoleum is dangerous."
msgstr "Внутри найдите «Меморандум о реликвии Кепека» — свитки, в которых описана могущественная реликвия. Будьте осторожны — мавзолей таит опасность."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I understand. The mausoleum is perilous. Come back if you change your mind."
msgstr "Понятно. В мавзолее опасно. Вернись, если передумаешь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I understand. Should you change your mind, I'll be here."
msgstr "Понятно. Если передумаешь, я буду рядом."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've recovered Kepeck's Relic Memoranda! Let me examine them..."
msgstr "Вы нашли «Записки о реликвиях Кепека»! Позвольте мне их изучить..."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*She carefully unrolls the ancient scrolls*{/}"
msgstr "{#666666}*Она осторожно разворачивает древние свитки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Remarkable! These contain detailed descriptions of a powerful relic that could benefit all of Fedimian."
msgstr "Поразительно! В них содержатся подробные описания могущественной реликвии, которая может принести пользу всему Федимиану."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Your courage in entering the Royal Mausoleum has uncovered knowledge we thought lost forever."
msgstr "Ваша смелость, с которой вы проникли в Королевский мавзолей, позволила раскрыть знания, которые мы считали навсегда утраченными."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You have my deepest gratitude. Here - you've more than earned this reward."
msgstr "Я выражаю вам свою глубочайшую благодарность. Вот — вы более чем заслужили эту награду."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've recovered {0} out of 3 Relic Memoranda."
msgstr "Вы нашли {0} из 3 записок о реликвиях."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Search the Royal Mausoleum thoroughly. Kepeck's scrolls should be hidden within."
msgstr "Тщательно обыщите Королевское мавзолей. Свитки Кепека должны быть спрятаны где-то там."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Thanks to your efforts, we've recovered Kepeck's research on the ancient relic."
msgstr "Благодаря вашим усилиям нам удалось восстановить результаты исследований Кепека, посвященных этой древней реликвии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The Royal Mausoleum remains open to you should you wish to explore it further."
msgstr "Королевский мавзолей по-прежнему открыт для вас, если вы захотите осмотреть его подробнее."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The War Chronicles are nearly complete, thanks to your help. Scholars from across the world come to study them."
msgstr "Благодаря вашей помощи «Хроники войны» почти завершены. Ученые со всего мира приезжают, чтобы их изучать."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "History lives through those who remember and record it."
msgstr "История живет благодаря тем, кто её помнит и записывает."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "[Divine Scholar] Lysander"
msgstr "[Божественный ученый] Лисандр"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Lysander"
msgstr "Лисандр"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Welcome. I'm Lysander, devoted to restoring divine protection to our three great cities."
msgstr "Добро пожаловать. Меня зовут Лисандр, и я посвятил себя делу восстановления божественной защиты наших трёх великих городов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*His eyes burn with intense dedication*{/}"
msgstr "{#666666}*В его глазах горит яркая преданность*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The demon war left lingering corruption in Klaipeda, Orsha, and even here in Fedimian. We need purification rituals to cleanse these traces."
msgstr "Война с демонами оставила после себя следы порчи в Клайпеде, Орше и даже здесь, в Федимиане. Нам нужны ритуалы очищения, чтобы избавиться от этих следов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Tell me about the purification"
msgstr "Расскажите мне об очищении"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I see. Good luck with that."
msgstr "Понятно. Удачи тебе в этом."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Excellent! I need your help recovering ancient knowledge."
msgstr "Отлично! Мне нужна твоя помощь в восстановлении древних знаний."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Long ago, an old druid master lived here in Fedimian. He created powerful purification scrolls to cleanse demonic corruption."
msgstr "Давным-давно здесь, в Федимиане, жил старый мастер-друид. Он создал могущественные свитки очищения, способные избавлять от демонического заражения."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "These scrolls were scattered and lost during the war. I believe monsters in Ramstis Ridge have found them. Will you venture there and recover 5 purification scrolls?"
msgstr "Эти свитки были разбросаны и утеряны во время войны. Я полагаю, что их нашли чудовища в горном хребте Рамстис. Согласитесь ли вы отправиться туда и вернуть 5 свитков очищения?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Thank you! The monsters in Ramstis Ridge - particularly near the old druid's hermitage - should have the scrolls."
msgstr "Спасибо! У монстров на хребте Рамстис — особенно возле отшельнической хижины старого друида — должны быть эти свитки."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The druid master studied corruption extensively. His scrolls are our best hope for purifying the lingering demonic traces."
msgstr "Мастер-друид тщательно изучал природу порчи. Его свитки — наша лучшая надежда на очищение от оставшихся следов демонической энергии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Once you collect 5 Purification Scrolls, return to me. We'll use them to help all three cities!"
msgstr "Как только ты соберешь 5 свитков очищения, вернись ко мне. Мы используем их, чтобы помочь всем трём городам!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The old druid master was a brilliant scholar who lived in Fedimian centuries ago."
msgstr "Старый мастер-друид был выдающимся учёным, жившим в Федимии много веков назад."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "He studied demonic corruption and created purification rituals recorded on sacred scrolls."
msgstr "Он изучал демоническое осквернение и разработал ритуалы очищения, записанные в священных свитках."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "When the demon war erupted, his research became invaluable - but the scrolls were scattered and lost."
msgstr "Когда разразилась война с демонами, его исследования оказались неоценимыми — но свитки были разбросаны и утрачены."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Now we need them more than ever to cleanse what the war left behind."
msgstr "Сейчас они нужны нам как никогда, чтобы убрать то, что оставила после себя война."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The corruption won't cleanse itself. But I understand if you have other priorities."
msgstr "Коррупция сама по себе не исчезнет. Но я понимаю, если у вас есть другие приоритеты."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've recovered the purification scrolls! This is remarkable!"
msgstr "Вы нашли свитки очищения! Это просто потрясающе!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*He carefully examines the ancient parchments*{/}"
msgstr "{#666666}*Он внимательно изучает древние пергаменты*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "These are genuine! The druid master's own handwriting... his knowledge of purification magic was unmatched."
msgstr "Это подлинники! Собственный почерк мастера-друида… Его знания в области магии очищения не имели себе равных."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "With these scrolls, we can perform cleansing rituals in Klaipeda, Orsha, and Fedimian."
msgstr "С помощью этих свитков мы можем проводить ритуалы очищения в Клайпеде, Орше и Федимиане."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The demon war's corruption will finally be purged from our cities!"
msgstr "Наконец-то наши города будут очищены от пороков, принесённых войной с демонами!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've helped all three cities today. Accept this reward - you've more than earned it."
msgstr "Сегодня ты помог всем трем городам. Прими эту награду — ты более чем заслужил её."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've collected {0} out of 5 Purification Scrolls so far."
msgstr "На данный момент вы собрали {0} из 5 свитков очищения."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Search Ramstis Ridge thoroughly. The monsters there have found the old druid's lost scrolls."
msgstr "Тщательно обыщите хребет Рамстис. Монстры, обитающие там, нашли утраченные свитки старого друида."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Thanks to the purification scrolls you recovered, we've cleansed the corruption in all three cities!"
msgstr "Благодаря найденным тобой свиткам очищения нам удалось избавиться от порчи во всех трёх городах!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Klaipeda, Orsha, and Fedimian are safer now. The old druid master's legacy lives on."
msgstr "Клайпеда, Орша и Федимиан теперь стали безопаснее. Наследие старого мастера-друида живет и по сей день."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "[Peace Envoy] Agatha"
msgstr "[Посланница мира] Агата"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Agatha"
msgstr "Агата"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Klaipeda, Orsha, and Fedimian - three great cities that once worked together. Now we barely communicate."
msgstr "Клайпеда, Орша и Федимиан — три замечательных города, которые когда-то тесно сотрудничали. Сейчас мы почти не поддерживаем связь."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The war left wounds beyond the physical. Old rivalries resurfaced, trust was broken."
msgstr "Война оставила после себя не только физические раны. Вновь всплыли старые противоречия, доверие было подорвано."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "But we're stronger together. If we can't unite now, during reconstruction, how will we face the next crisis?"
msgstr "Но вместе мы сильнее. Если мы не сможем объединиться сейчас, в период восстановления, как же мы справимся со следующим кризисом?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Can the cities be unified?"
msgstr "Можно ли объединить эти города?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I want to help unite them"
msgstr "Я хочу помочь им объединиться"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "What divides them?"
msgstr "Что их разделяет?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Some things can't be fixed"
msgstr "Некоторые вещи исправить невозможно"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "A champion of unity! This is exactly what we need!"
msgstr "Поборник единства! Это именно то, что нам нужно!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I need someone to organize a Unity Summit - bring representatives from all three cities together. Will you help arrange it?"
msgstr "Мне нужен кто-нибудь, кто организует саммит Unity — соберёт представителей всех трёх городов. Не могли бы вы помочь с его организацией?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Excellent! First, deliver these cooperation contracts to the other city leaders."
msgstr "Отлично! Для начала передайте эти договоры о сотрудничестве другим руководителям городов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Visit Mayor Oswald in Klaipeda and Commander Theron in Orsha. Convince them to send delegations here to Fedimian."
msgstr "Посетите мэра Освальда в Клайпеде и командира Терона в Орше. Убедите их направить сюда, в Федимиан, свои делегации."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "It won't be easy - old grudges run deep. But if anyone can bring them together, it's someone like you - an outsider they all respect."
msgstr "Это будет нелегко — старые обиды уходят корнями глубоко. Но если кто-то и способен их примирить, то это именно ты — человек со стороны, которого все уважают."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Klaipeda focuses on commerce and rebuilding. Orsha maintains military strength and agricultural production. Fedimian pursues knowledge and diplomacy."
msgstr "Клайпеда уделяет основное внимание торговле и восстановлению. Орша поддерживает военную мощь и сельскохозяйственное производство. Федимиан стремится к знаниям и развитию дипломатии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "These different priorities create friction. Each city thinks their approach is best."
msgstr "Эти разные приоритеты приводят к конфликтам. Каждый город считает, что именно его подход является лучшим."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "But we need all three - trade, defense, and knowledge. United, we could thrive. Divided, we merely survive."
msgstr "Но нам нужны все три составляющие — торговля, оборона и знания. Объединившись, мы сможем процветать. Разделенные, мы лишь выживаем."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Perhaps you're right. But I have to try. The future of our world depends on cooperation."
msgstr "Возможно, вы правы. Но я должен попробовать. Будущее нашего мира зависит от сотрудничества."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Both Klaipeda and Orsha have signed the contracts! This is historic!"
msgstr "И Клайпеда, и Орша подписали контракты! Это историческое событие!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*The summit hall fills with representatives from all three cities*{/}"
msgstr "{#666666}*Зал для проведения саммита заполняется представителями всех трёх городов*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "It's tense at first, but as they discuss shared challenges - monsters, refugees, trade - common ground emerges."
msgstr "Сначала обстановка напряжённая, но по мере того, как они обсуждают общие проблемы — монстров, беженцев, торговлю — появляются точки соприкосновения."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "By the end, they've formalized the Mutual Aid Pact. Each city will support the others in times of need."
msgstr "В итоге они официально заключили Пакт о взаимной помощи. Каждый город будет оказывать поддержку другим городам в случае необходимости."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "This is just the beginning, but you've helped take the first step toward true unity."
msgstr "Это только начало, но вы помогли сделать первый шаг на пути к подлинному единству."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The world is safer because of what you've done today."
msgstr "Благодаря тому, что вы сделали сегодня, мир стал безопаснее."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You've delivered {0} out of 2 contracts."
msgstr "Вы выполнили {0} из 2 контрактов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Find Mayor Oswald in Klaipeda and Commander Theron in Orsha. They need to sign the cooperation contracts."
msgstr "Найдите мэра Освальда в Клайпеде и командира Терона в Орше. Им нужно подписать договоры о сотрудничестве."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The Mutual Aid Pact is working beautifully. We've already coordinated three joint operations against monster threats."
msgstr "Пакт о взаимной помощи работает просто великолепно. Мы уже провели три совместные операции по борьбе с угрозами со стороны монстров."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You proved that unity is possible. Thank you."
msgstr "Вы доказали, что единство возможно. Спасибо."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "[Merchant Guild] Anne"
msgstr "[Гильдия торговцев] Энн"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Anne"
msgstr "Анна"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You have urgent news? Please, tell me."
msgstr "У вас есть срочные новости? Пожалуйста, расскажите мне."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*She listens intently*{/}"
msgstr "{#666666}*Она внимательно слушает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The Zachariel Crossroads route is being overrun by Warleader Hogmas? This is serious!"
msgstr "Маршрут «Перекресток Захариэля» захватывает военачальник Хогмас? Это серьёзно!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "That's one of our key trade routes to Ramstis Ridge and the Royal Mausoleum. If it's compromised, we'll need to reroute all caravans."
msgstr "Это один из наших основных торговых путей, ведущих к хребту Рамстис и Королевскому мавзолею. Если он окажется перекрытым, нам придётся изменить маршрут всех караванов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Thank you for this warning. I'll inform the Guildmaster immediately and arrange for additional guards on future expeditions."
msgstr "Спасибо за это предупреждение. Я немедленно сообщу об этом главе гильдии и позабочусь о том, чтобы в будущих экспедициях было больше охранников."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#FFD700}Warning delivered! Return to Darius at Zachariel Crossroads.{/}"
msgstr "{#FFD700}Предупреждение доставлено! Вернитесь к Дариусу на Перекрестке Захариэля.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You look like you have something to say, but it seems you're still handling a situation. Come back when you're ready."
msgstr "Похоже, тебе есть что сказать, но, судя по всему, ты пока занимаешься решением какой-то проблемы. Заходи, когда будешь готов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "A letter from Klaipeda's Merchant Guild? How delightful!"
msgstr "Письмо от Клайпедской гильдии купцов? Как замечательно!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*She reads eagerly*{/}"
msgstr "{#666666}*Она увлечённо читает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Resource sharing agreements, academic exchange programs, joint ventures... this is precisely what Fedimian needs!"
msgstr "Соглашения о совместном использовании ресурсов, программы академического обмена, совместные предприятия… это именно то, что нужно «Федимиану»!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "We accept their proposal wholeheartedly. Fedimian will provide academic resources and magical research in exchange for goods."
msgstr "Мы с радостью принимаем их предложение. Федимиан предоставит академические ресурсы и результаты магических исследований в обмен на товары."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Here's our formal acceptance. Thank you for facilitating this connection!"
msgstr "Вот наше официальное согласие. Спасибо за то, что помогли нам установить этот контакт!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Trade with Klaipeda has opened wonderful opportunities. We've exchanged dozens of scholars and merchants already!"
msgstr "Торговля с Клайпедой открыла перед нами замечательные возможности. Мы уже обменялись десятками ученых и купцов!"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Fedimian's Merchant Guild specializes in knowledge trade - books, research, magical training."
msgstr "Торговая гильдия Федимиана специализируется на торговле знаниями — книгами, научными исследованиями и обучением магии."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "We may not have Orsha's food or Klaipeda's goods, but our intellectual resources are unmatched."
msgstr "У нас, может быть, и нет такой еды, как в Орше, или таких товаров, как в Клайпеде, но наши интеллектуальные ресурсы не имеют себе равных."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "[Wizard] Silas"
msgstr "[Волшебник] Сайлас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Silas"
msgstr "Сайлас"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*The air is thick with incense smoke rising from a large cauldron*{/}"
msgstr "{#666666}*Воздух наполнен дымом ладана, поднимающимся из большого котла*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I am Silas, a wizard who survived the great war. These protective wards and incense help keep the dark spirits at bay."
msgstr "Меня зовут Силас, я волшебник, переживший Великую войну. Эти защитные заклинания и благовония помогают сдерживать темных духов."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The demons may be gone, but their corruption lingers. I've learned to ward against it."
msgstr "Демоны, может, и исчезли, но их порочное влияние по-прежнему ощущается. Я научился защищаться от него."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "What knowledge do you possess?"
msgstr "Какими знаниями вы обладаете?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "What is the incense for?"
msgstr "Для чего нужны благовония?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I'll leave you to your work"
msgstr "Я оставлю вас заниматься вашей работой"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I fought in the great war as a battle wizard. I witnessed things that still haunt my dreams."
msgstr "Я сражался в Великой войне в качестве боевого волшебника. Я видел вещи, которые до сих пор преследуют меня в кошмарах."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Demons, corruption, cities burning... but I survived through knowledge and preparation."
msgstr "Демоны, коррупция, горящие города… но я выжил благодаря знаниям и подготовке."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Now I use what I learned to protect this place. The incense, the wards - they keep the darkness away."
msgstr "Теперь я использую то, чему научился, чтобы защитить это место. Ладан, обереги — они не дают тьме проникнуть сюда."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I may have survived, but I'll never forget what was lost."
msgstr "Может, я и выжил, но никогда не забуду того, что потерял."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "This incense is made from sacred herbs blessed with protective magic."
msgstr "Эти благовония изготовлены из священных трав, на которые наложена защитная магия."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "It purifies the air and repels malevolent spirits. After the war, such precautions became necessary."
msgstr "Он очищает воздух и отгоняет злых духов. После войны такие меры предосторожности стали необходимыми."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The cauldron never stops burning. As long as it does, this place remains safe from corruption."
msgstr "Котел никогда не перестает гореть. Пока он горит, это место остаётся защищённым от коррупции."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Stay vigilant. The darkness never truly rests."
msgstr "Будьте бдительны. Тьма никогда по-настоящему не успокаивается."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "My testimony is recorded. Share it with the Grand Archive."
msgstr "Мое свидетельство зафиксировано. Отправьте его в Главный архив."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "The world must know what we endured, and how we survived."
msgstr "Мир должен узнать, через что нам пришлось пройти и как мы выжили."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You need a recording crystal to preserve my testimony."
msgstr "Вам понадобится записывающий кристалл, чтобы сохранить мои показания."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "You're documenting the war for posterity? Important work."
msgstr "Вы ведете хронику войны для потомков? Важная работа."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Would you like to hear my account as a battle wizard who survived the great war?"
msgstr "Хотите послушать мой рассказ о том, как я, боевой волшебник, пережил Великую войну?"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "{#666666}*Silas speaks solemnly into the recording crystal*{/}"
msgstr "{#666666}*Сайлас торжественно произносит слова в записывающий кристалл*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "'I am Silas, battle wizard. I fought in the great war and witnessed horrors beyond imagination.'"
msgstr "«Я — Силас, боевой волшебник. Я сражался в Великой войне и был свидетелем ужасов, превосходящих всякое воображение»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "'Cities burned, people died, and demons seemed unstoppable. But we fought on with magic and steel.'"
msgstr "«Города горели, люди гибли, и казалось, что демонов ничто не может остановить. Но мы продолжали сражаться с помощью магии и стали»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "'I survived through preparation, knowledge, and protective wards. Now I use what I learned to keep the darkness at bay.'"
msgstr "«Я выжил благодаря подготовке, знаниям и защитным заклинаниям. Теперь я использую то, чему научился, чтобы сдерживать тьму»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "'The war may be over, but its corruption lingers. We must remain vigilant, always.'"
msgstr "«Война, может, и закончилась, но её последствия по-прежнему дают о себе знать. Мы должны всегда оставаться бдительными»."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "I understand. Return when you're ready to hear my account."
msgstr "Понятно. Вернись, когда будешь готов выслушать мою версию событий."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Thank you for preserving the truth in Fedimian's Grand Archive."
msgstr "Спасибо за то, что сохраняете правду в «Великом архиве» Федимиана."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Future generations will know the goddesses stood with us."
msgstr "Будущие поколения будут знать, что богини были на нашей стороне."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Chronicles of the Demon War"
msgstr "Хроники Войны демонов"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Collect testimonies from war survivors to complete the Grand Archive's historical record."
msgstr "Соберите свидетельства людей, переживших войну, чтобы дополнить исторические записи Великого архива."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Record testimony from Commander Theron in Orsha"
msgstr "Запись показаний командира Терона в Орше"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Record testimony from Peregrin Lyon in Ramstis Ridge"
msgstr "Запись показаний Перегрина Лиона в Рамстис-Ридж"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Record testimony from Wizard Silas in Fedimian"
msgstr "Запись показаний волшебника Силаса в Федимиане"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Ancient Purification"
msgstr "Древнее очищение"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Recover lost purification scrolls from monsters in Ramstis Ridge to help cleanse demonic corruption."
msgstr "Найдите у монстров на хребте Рамстис утраченные свитки очищения, чтобы помочь избавиться от демонического заражения."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Collect Purification Scrolls from monsters in Ramstis Ridge"
msgstr "Собирайте свитки очищения у монстров на хребте Рамстис"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Path to Unity"
msgstr "Путь к единству"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Organize a summit between the three great cities to establish cooperation and mutual aid."
msgstr "Организовать встречу на высшем уровне между тремя великими городами с целью налаживания сотрудничества и взаимопомощи."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Deliver invitation to Mayor Oswald in Klaipeda"
msgstr "Доставить приглашение мэру Освальду в Клайпеде"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Deliver invitation to Commander Theron in Orsha"
msgstr "Доставьте приглашение командиру Терону в Оршу"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Royal Mausoleum Expedition"
msgstr "Экспедиция к Королевскому мавзолею"

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Recover Kepeck's Relic Memoranda from the dangerous Royal Mausoleum to aid the Grand Archive's research."
msgstr "Извлеките «Записки о реликвиях Кепека» из опасного Королевского мавзолея, чтобы помочь Великому архиву в его исследованиях."

#: packages/laima/scripts/zone/content/laima/npcs/cities/quests/c_fedimian_quests.cs
msgid "Collect Relic Memoranda from the Ancient Pedestals"
msgstr "Соберите записки о реликвиях с древних пьедесталов"

# ============================================================================
# Woods of the Linked Bridges Quests (f_siauliai_15_re_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Scout] Milda"
msgstr "[Разведчик] Милда"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Milda"
msgstr "Мильда"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A scout crouches near a patch of withered vegetation, examining toxic residue*{/}"
msgstr "{#666666}*Разведчик приседает возле участка засохшей растительности, изучая токсичные остатки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The contamination is spreading faster than I anticipated. I've been tracking the poison's source throughout this region."
msgstr "Заражение распространяется быстрее, чем я предполагал. Я отслеживаю источник яда по всей этой местности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "These woods are becoming increasingly hazardous. The corrupted creatures are carriers - spreading toxins with every movement."
msgstr "Эти леса становятся всё более опасными. Одержимые существа являются переносчиками — они распространяют токсины с каждым своим движением."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I can help deal with the corrupted creatures"
msgstr "Я могу помочь справиться с этими извращёнными существами"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "What's causing the contamination?"
msgstr "Что является причиной загрязнения?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I should go"
msgstr "Мне пора"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She stands, her hand moving to her weapon*{/}"
msgstr "{#666666}*Она встает, и её рука тянется к оружию*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Another capable fighter? Good. We need more people taking action."
msgstr "Еще один способный боец? Отлично. Нам нужно больше людей, готовых действовать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Jukopus, Kepas, and Pokubu - they've all become vectors for the corruption. Every one of them spreads poison through this region."
msgstr "Юкопус, Кепас и Покубу — все они стали проводниками коррупции. Каждый из них разносит яд по всему региону."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "We need to cull the infected population before the contamination overwhelms the entire forest. I can offer you a proper weapon - a soldier's iron club - if you help thin their numbers. Are you in?"
msgstr "Нам нужно истребить заражённых, пока зараза не охватила весь лес. Я могу предложить тебе подходящее оружие — солдатскую железную дубинку — если ты поможешь сократить их число. Согласен?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Excellent. Hunt down the corrupted Jukopus, poisoned Kepas, and infected Pokubu throughout these woods."
msgstr "Отлично. Выследите в этих лесах коррумпированных Джукопусов, отравленных Кепасов и заражённых Покубу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Come back when you've made a significant impact on their numbers. The club will be waiting for you."
msgstr "Вернись, когда тебе удастся существенно улучшить их показатели. Клуб будет ждать тебя."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She gestures toward the forest*{/}"
msgstr "{#666666}*Она указывает на лес*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "After the demon war, residual dark energy saturated these lands. When the guardian owl's protection weakened, that corruption took root."
msgstr "После войны с демонами эти земли пропитались остаточной тёмной энергией. Когда защита совы-хранителя ослабла, эта порча укоренилась."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Now it's infecting the wildlife, turning ordinary creatures into toxic threats. If we don't contain it, this entire region could become uninhabitable."
msgstr "Теперь вирус поражает диких животных, превращая обычных существ в токсичную угрозу. Если мы не сдержим его, весь этот регион может стать непригодным для проживания."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I've been scouting the affected zones, mapping contamination levels. But studying it isn't enough - we need to actively cull the infected creatures."
msgstr "Я обследовал заражённые зоны и составлял карту уровней заражённости. Но одного изучения недостаточно — нам нужно активно уничтожать заражённых существ."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She returns to examining the ground*{/}"
msgstr "{#666666}*Она снова начинает осматривать землю*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Watch yourself in these woods. The poison doesn't discriminate - it affects everyone."
msgstr "Будьте осторожны в этих лесах. Яд не делает исключений — он действует на всех."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Still culling the infected creatures?"
msgstr "Все еще уничтожаете зараженных существ?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Keep at it. Every infected creature eliminated slows the contamination's spread."
msgstr "Не сдавайтесь. Каждое уничтоженное зараженное существо замедляет распространение заражения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She looks up from her field notes, impressed*{/}"
msgstr "{#666666}*Она поднимает глаза от своих полевых записей, явно впечатлённая*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Excellent work. I've been monitoring the contamination levels, and they're already starting to stabilize in some areas."
msgstr "Отличная работа. Я слежу за уровнями загрязнения, и в некоторых районах они уже начинают стабилизироваться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You've proven yourself capable. Here - take this soldier's short bow. It's a solid weapon, and you've earned it."
msgstr "Ты доказал, что достоин этого. Вот — возьми этот солдатский короткий лук. Это надежное оружие, и ты его заслужил."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She hands you a well-crafted short bow*{/}"
msgstr "{#666666}*Она протягивает вам красиво выполненный небольшой лук*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "With fighters like you helping to contain this threat, we might actually reclaim these woods."
msgstr "Если такие бойцы, как ты, будут помогать сдерживать эту угрозу, у нас действительно может получиться вернуть эти леса."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The culling operation you conducted made a real difference. Contamination readings have improved in several zones."
msgstr "Проведённая вами операция по отбору животных дала реальные результаты. Показатели загрязнённости улучшились в нескольких зонах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "With continued effort, we might be able to reclaim these woods from the poison's grip."
msgstr "Если мы не будем сдаваться, то, возможно, нам удастся освободить эти леса от гнета яда."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Merchant] Alfred"
msgstr "[Продавец] Альфред"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Alfred"
msgstr "Альфред"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A disheveled merchant sits on a crate, head in his hands*{/}"
msgstr "{#666666}*Растрепанный купец сидит на ящике, обхватив голову руками*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Ruined... I'm completely ruined..."
msgstr "Я в полном отчаянии... Я совершенно разбит..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "My caravan was attacked by those blasted poisoned Kepas! They scattered my goods everywhere!"
msgstr "На мой караван напали эти проклятые отравленные кепы! Они разбросали мои товары повсюду!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I can help recover your goods"
msgstr "Я могу помочь вам вернуть ваш груз"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "What were you transporting?"
msgstr "Что вы перевозили?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Maybe you should hire guards"
msgstr "Может быть, вам стоит нанять охранников?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He looks you over skeptically*{/}"
msgstr "{#666666}*Он скептически оглядывает тебя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "No offense, friend, but those Kepas are tougher than they look. You'd need to be at least level 3 to handle them safely."
msgstr "Не в обиду, друг, но эти Кепы опаснее, чем кажутся. Чтобы справиться с ними без риска, тебе нужно быть как минимум 3-го уровня."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Come back when you're stronger, and I'll still need the help."
msgstr "Вернись, когда станешь сильнее — мне тогда всё ещё понадобится твоя помощь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He jumps to his feet*{/}"
msgstr "{#666666}*Он вскакивает на ноги*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You'd do that? Oh, thank the goddess!"
msgstr "Ты бы так поступил? О, слава богине!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "My goods are scattered all over this area. Those poisoned Kepas probably dragged some of it around. Can you recover what you can find?"
msgstr "Мои вещи разбросаны по всей этой местности. Эти отравленные кепы, наверное, разнесли часть из них. Можешь ли ты собрать всё, что удастся найти?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Thank you! Look for scattered crates and packages. The Kepas might have taken some of it too."
msgstr "Спасибо! Поищите разбросанные ящики и посылки. Возможно, часть вещей забрали и кепы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Bring me back 8 packages and I can salvage at least part of my business!"
msgstr "Принесите мне 8 посылок, и я смогу спасти хотя бы часть своего бизнеса!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Medicinal herbs, cloth, tools... supplies for the villages around Orsha."
msgstr "Лекарственные травы, ткань, инструменты… припасы для деревень в окрестностях Орши."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Nothing fancy, but it's my livelihood. Without those goods, I can't pay my debts."
msgstr "Ничего особенного, но это мой заработок. Без этого товара я не смогу погасить свои долги."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "My family will starve if I don't recover something from this disaster."
msgstr "Моя семья умрёт с голоду, если мне не удастся что-нибудь спасти из этой катастрофы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He laughs bitterly*{/}"
msgstr "{#666666}*Он горько смеётся*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hire guards? With what money? I spent everything I had on this shipment!"
msgstr "Нанять охранников? На какие деньги? Я потратил все, что у меня было, на эту партию товара!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I gambled it all on one big delivery and lost. That's the merchant's life for you."
msgstr "Я поставил всё на одну крупную поставку и проиграл. Такова уж жизнь торговца."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He eagerly examines the packages*{/}"
msgstr "{#666666}*Он с нетерпением рассматривает посылки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You found them! Let me see... yes, yes! These are still in good condition!"
msgstr "Ты их нашёл! Дай-ка посмотрю… да, да! Они всё ещё в хорошем состоянии!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He starts counting quickly*{/}"
msgstr "{#666666}*Он начинает быстро считать*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This is enough to save my business! I can still make my deliveries, pay my debts... oh, thank you!"
msgstr "Этого достаточно, чтобы спасти мой бизнес! Я всё ещё смогу осуществлять доставку, погасить долги... О, спасибо!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Here, please accept this reward. You've saved my family from ruin."
msgstr "Вот, пожалуйста, примите эту награду. Вы спасли мою семью от гибели."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Still looking for my goods? Please keep searching."
msgstr "Все еще ищете мои товары? Продолжайте поиски."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Please hurry - the longer they're out there, the more damaged they'll become."
msgstr "Пожалуйста, поторопитесь — чем дольше они будут там лежать, тем больше повредятся."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Thanks to you, my business survived. I've been making deliveries again!"
msgstr "Благодаря вам мой бизнес выжил. Я снова начал осуществлять доставку!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Next time I'll definitely hire guards before traveling through these woods."
msgstr "В следующий раз я обязательно найму охранников, прежде чем отправляться в путь через этот лес."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Hermit] Torsten"
msgstr "[Отшельник] Торстен"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Torsten"
msgstr "Торстен"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*An old hermit sits outside his cabin, watching the forest*{/}"
msgstr "{#666666}*Старый отшельник сидит у входа в свою хижину и наблюдает за лесом*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hm. Another traveler. Don't see many people out here in this remote spot."
msgstr "Хм. Еще один путешественник. В этом отдалённом месте нечасто встретишь людей."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Though I suppose the boars have been acting strange lately. More aggressive. Almost... corrupted."
msgstr "Хотя, пожалуй, кабаны в последнее время ведут себя как-то странно. Стали более агрессивными. Почти... как будто их что-то осквернило."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I could investigate for you"
msgstr "Я мог бы разобраться в этом для вас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "What do you mean by corrupted?"
msgstr "Что вы имеете в виду под словом «поврежденный»?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Why do you live so far from town?"
msgstr "Почему ты живешь так далеко от города?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He nods slowly*{/}"
msgstr "{#666666}*Он медленно кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "So you're a fighter, eh? Good. The forest needs people willing to face the darkness."
msgstr "Так ты боец, да? Хорошо. Лесу нужны люди, готовые противостоять тьме."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt the corrupted Pokubu and the Pokuborn. If enough of them are culled, maybe the corruption will slow its spread. Will you do this?"
msgstr "Охотьтесь на заражённых Покубу и Покуборнов. Если их уничтожить достаточное количество, возможно, распространение заразы замедлится. Вы готовы это сделать?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Good. Hunt the Pokubu throughout these woods. The Pokuborn especially - they're the most dangerous."
msgstr "Хорошо. Охотьтесь на покубу по всему этому лесу. Особенно на покуборнов — они самые опасные."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "When you're done, return here. I have something that might help protect you in the future."
msgstr "Когда закончишь, вернись сюда. У меня есть кое-что, что может помочь тебе защититься в будущем."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Pokubu - the boars that roam these woods. They've always been territorial, but lately they've become violent."
msgstr "Покубу — кабаны, обитающие в этих лесах. Они всегда были территориальными животными, но в последнее время стали агрессивными."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Their eyes glow with dark energy. Some - the Pokuborn - have darker hides and are far more aggressive."
msgstr "Их глаза светятся тёмной энергией. Некоторые из них — покуборны — имеют более тёмную кожу и гораздо более агрессивны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I've lived in these woods for thirty years. I know when something's unnatural."
msgstr "Я живу в этих лесах уже тридцать лет. Я знаю, когда что-то не так."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I came out here to escape people and their politics. Cities, armies, wars... all that noise."
msgstr "Я уехал сюда, чтобы уйти от людей и их политики. Города, армии, войны… весь этот шум."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Out here, it's just me, the trees, and the beasts. Or at least it used to be peaceful."
msgstr "Здесь только я, деревья и звери. По крайней мере, раньше здесь было спокойно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "But even in isolation, the world's problems find you eventually."
msgstr "Но даже в изоляции проблемы этого мира рано или поздно настигнут тебя."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Still hunting the corrupted boars?"
msgstr "Все еще охотишься на зараженных кабанов?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Be careful out there. The Pokuborn are particularly vicious."
msgstr "Будьте осторожны. Покуборны особенно жестоки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He stands and inspects you carefully*{/}"
msgstr "{#666666}*Он встает и внимательно разглядывает тебя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You did it. I can already sense the forest feels... calmer. Less corrupted energy in the air."
msgstr "Ты справился. Я уже чувствую, что в лесу стало… спокойнее. В воздухе меньше загрязнённой энергии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He retrieves a piece of leather armor from his cabin*{/}"
msgstr "{#666666}*Он достает из своей каюты часть кожаных доспехов*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This is an armor I crafted with the leather from these monsters."
msgstr "Это доспехи, которые я изготовил из кожи этих монстров."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You've earned it. Thank you for helping maintain the balance in these woods."
msgstr "Ты это заслужил. Спасибо, что помогаешь поддерживать равновесие в этих лесах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The boars have been calmer lately. The corruption's influence is weakening, thanks to you."
msgstr "В последнее время кабаны стали вести себя спокойнее. Благодаря тебе влияние коррупции ослабевает."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Keep that armor close. It'll serve you well against dark forces."
msgstr "Держи эту броню под рукой. Она хорошо тебе пригодится в борьбе с темными силами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Soldier] Henrik"
msgstr "[Солдат] Хенрик"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Henrik"
msgstr "Хенрик"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A sturdy soldier stands near the bridge, examining rubble and debris*{/}"
msgstr "{#666666}*Рядом с мостом стоит крепкий солдат, осматривающий обломки и мусор*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hmm... these bridges are shedding rubble. The war took its toll on the infrastructure."
msgstr "Хм... с этих мостов сыплется щебень. Война нанесла серьезный ущерб инфраструктуре."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I'm Henrik, sent from Orsha to assess the damage and plan reconstruction efforts. These linked bridges are vital for supply routes and trade."
msgstr "Меня зовут Хенрик, меня направили из Орши для оценки ущерба и планирования восстановительных работ. Эти соединенные между собой мосты имеют жизненно важное значение для путей снабжения и торговли."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "How can I help?"
msgstr "Чем я могу помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "What's your assessment?"
msgstr "Как вы это оцениваете?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Good luck with that"
msgstr "Удачи тебе в этом"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He looks up from his plans*{/}"
msgstr "{#666666}*Он поднимает глаза от своих чертежей*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You'd help with the survey? That would speed things up considerably."
msgstr "Вы не могли бы помочь с опросом? Это значительно ускорило бы процесс."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Beekeeper] Greta"
msgstr "[Пчеловод] Грета"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Greta"
msgstr "Грета"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*An elderly woman stands among empty beehives*{/}"
msgstr "{#666666}*Пожилая женщина стоит среди пустых ульев*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "My bees... they're all gone..."
msgstr "Мои пчелы... их больше нет..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This was once the most productive bee farm in all of Orsha. Now look at it. Empty. Silent."
msgstr "Когда-то это была самая урожайная пасека во всей Орше. А теперь посмотрите на неё. Пусто. Тихо."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Maybe I can help"
msgstr "Может быть, я смогу помочь"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "What happened to your bees?"
msgstr "Что случилось с вашими пчелами?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "That's unfortunate"
msgstr "Это очень жаль"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A spark of hope appears in her eyes*{/}"
msgstr "{#666666}*В её глазах зажигается искра надежды*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You... you would help an old beekeeper?"
msgstr "Ты... ты помог бы пожилому пчеловоду?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I've heard there are special flowers growing wild in the forest - Moonbells, Sunpetals, Honeydew blooms..."
msgstr "Я слышал, что в лесу в диком виде растут особые цветы — «лунные колокольчики», «солнечные лепестки», «медовые цветы»..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The kind of flowers that bees absolutely love. If I could get some of those flowers, I could use them to lure wild bees back to my farm!"
msgstr "Цветы, которые пчелы просто обожают. Если бы мне удалось раздобыть такие цветы, я бы использовал их, чтобы привлечь диких пчел обратно на свою ферму!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Would you gather those bee-attracting flowers for me? I need at least 5 bunches to have a chance of luring the bees back."
msgstr "Не могли бы вы собрать для меня эти цветы, которые привлекают пчел? Мне нужно как минимум 5 букетов, чтобы у меня был шанс заманить пчел обратно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Oh, thank you! Look for colorful flower patches throughout the forest."
msgstr "О, спасибо! Ищите яркие цветочные полянки по всему лесу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Gather 5 bunches of those special flowers and bring them back to me."
msgstr "Собери 5 букетов этих особенных цветов и принеси их мне."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "With those flowers near my hives, maybe... just maybe... the bees will return to these woods."
msgstr "Если эти цветы будут расти рядом с моими ульями, то, может быть… только может быть… пчелы вернутся в эти леса."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She gazes toward the forest*{/}"
msgstr "{#666666}*Она смотрит в сторону леса*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "After the war, corruption spread throughout these woods. The air became toxic."
msgstr "После войны коррупция распространилась по всем этим лесам. Воздух стал ядовитым."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The bees... they couldn't survive here. Some died. Most fled to cleaner lands."
msgstr "Пчелы... они не смогли выжить здесь. Некоторые погибли. Большинство улетело в более чистые места."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "But I've heard reports of wild flowers blooming in certain spots - flowers that bees love."
msgstr "Но я слышал, что в некоторых местах зацвели полевые цветы — те самые, которые так любят пчелы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I tried to stay, hoping they'd return. But hope fades with each empty sunrise."
msgstr "Я пытался остаться, надеясь, что они вернутся. Но надежда угасает с каждым пустым рассветом."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She nods sadly*{/}"
msgstr "{#666666}*Она грустно кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Yes... unfortunate. But such is life after war. We lose the things we love."
msgstr "Да... печально. Но такова жизнь после войны. Мы теряем то, что любим."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She clasps your hands gratefully*{/}"
msgstr "{#666666}*Она с благодарностью сжимает твои руки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You gathered them! All five bunches of bee-attracting flowers!"
msgstr "Ты собрал их! Все пять пучков цветов, привлекающих пчел!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*She carefully arranges the flowers around her beehives*{/}"
msgstr "{#666666}*Она аккуратно расставляет цветы вокруг своих ульев*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Almost immediately, you hear a faint buzzing in the distance*{/}"
msgstr "{#666666}*Почти сразу же вдали слышится слабое жужжание*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Listen! Do you hear that? Bees! Wild bees are already coming to investigate!"
msgstr "Послушай! Слышишь? Пчелы! Дикие пчелы уже летят посмотреть, что тут происходит!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You've given me something I'd lost - hope. Hope that someday, these hives will be full of life again."
msgstr "Ты вернул мне то, что я потерял, — надежду. Надежду на то, что когда-нибудь эти ульи снова наполнятся жизнью."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Thank you, dear traveler. Please, take this. It's not much, but it's offered with a grateful heart."
msgstr "Спасибо, дорогой путешественник. Пожалуйста, возьмите это. Это не много, но я дарю это от всего сердца."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Have you found the bee-attracting flowers? You have {0} out of 5 bunches."
msgstr "Ты уже нашёл цветы, привлекающие пчёл? У тебя {0} из 5 букетов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Look for colorful flower patches throughout the forest - places where the corruption hasn't taken hold."
msgstr "Обратите внимание на яркие цветочные полянки, разбросанные по всему лесу, — места, где порча ещё не укоренилась."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I can hear bees buzzing around the hives again! A few have even started building new colonies!"
msgstr "Я снова слышу, как пчелы жужжат вокруг ульев! Некоторые из них даже начали создавать новые колонии!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "It'll take time to rebuild what was lost, but you've given me that chance. Thank you."
msgstr "Чтобы восстановить то, что было утрачено, понадобится время, но вы дали мне такую возможность. Спасибо."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Farmer] Morku"
msgstr "[Фермер] Морку"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Morku"
msgstr "Морку"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A weathered farmer stares at an empty plot of land*{/}"
msgstr "{#666666}*Потрепанный жизнью фермер пристально смотрит на пустой участок земли*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Nothing grows anymore. Nothing at all."
msgstr "Ничто больше не растёт. Совсем ничего."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I've tried everything - new seeds, fertilizer, prayers. But the soil is dead. Corrupted."
msgstr "Я перепробовал всё — новые семена, удобрения, молитвы. Но почва мертва. Она испорчена."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Perhaps I can help"
msgstr "Возможно, я смогу помочь"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "What corrupted your farm?"
msgstr "Что привело к гибели вашей фермы?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Maybe you should move"
msgstr "Может, тебе стоит переехать?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He looks at you with tired eyes*{/}"
msgstr "{#666666}*Он смотрит на тебя усталыми глазами*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Help? I don't know if anyone can help. But..."
msgstr "Помогите? Не знаю, сможет ли кто-нибудь помочь. Но..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "There's a legend about an ancient stone golem. A guardian that watches over a sacred monument north of here."
msgstr "Существует легенда о древнем каменном големе — страже, охраняющем священный памятник к северу отсюда."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "They say the golem can grant blessings to purify corrupted land. It's probably just a story, but... I'm desperate. Would you seek out the Stone Guardian and ask for its blessing?"
msgstr "Говорят, что голем может даровать благословение, очищающее осквернённую землю. Наверное, это всего лишь легенда, но… я в отчаянии. Не могли бы вы найти Каменного Стража и попросить у него благословения?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Stone Guardian is north of here, deep in the forest. Look for a giant carved stone head - the golem stands watch over it."
msgstr "Каменный Страж находится к северу отсюда, глубоко в лесу. Ищите гигантскую высеченную каменную голову — голем стоит на страже у неё."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "If the legends are true... maybe it will help us. Please, try."
msgstr "Если легенды правдивы… может быть, это нам поможет. Пожалуйста, попробуй."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "After the war, dark energy seeped into the ground. Poisoned everything."
msgstr "После войны тёмная энергия проникла в землю. Она отравила всё."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "My crops withered. My animals died. Even the weeds won't grow here anymore."
msgstr "Мой урожай засох. Мои животные погибли. Здесь уже даже сорняки не растут."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This farm has been in my family for four generations. Now it's just... dead earth."
msgstr "Эта ферма принадлежит моей семье уже четыре поколения. А теперь это просто… мёртвая земля."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He clenches his fists*{/}"
msgstr "{#666666}*Он сжимает кулаки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Move? And abandon four generations of family history? Never."
msgstr "Переехать? И бросить историю своей семьи, насчитывающую четыре поколения? Ни за что."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I'll die on this land before I give up on it."
msgstr "Я скорее умру на этой земле, чем откажусь от неё."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*His eyes widen*{/}"
msgstr "{#666666}*Его глаза расширились*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "That glow... is that... the Stone Guardian's purified essence?!"
msgstr "Это сияние… это… очищенная сущность Каменного Стража?!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He kneels reverently*{/}"
msgstr "{#666666}*Он благоговейно опускается на колени*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You actually received it! The ancient guardian acknowledged you!"
msgstr "Ты действительно получил его! Древний страж признал тебя!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Please, may I... may I apply this to my farm?"
msgstr "Позвольте, можно ли... можно ли применить это на моей ферме?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He carefully spreads the purified essence across his empty field*{/}"
msgstr "{#666666}*Он аккуратно распределяет очищенную эссенцию по своему пустому полю*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The soil begins to glow faintly, the corruption visibly receding*{/}"
msgstr "{#666666}*Почва начинает слабо светиться, а порча заметно отступает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "It's working! The land... it's healing! After all this time, there's finally hope!"
msgstr "Это сработало! Земля… она восстанавливается! После стольких лет наконец-то появилась надежда!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He looks at you with tears in his eyes*{/}"
msgstr "{#666666}*Он смотрит на тебя со слезами на глазах*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Thank you. Thank you for giving me back my future."
msgstr "Спасибо. Спасибо за то, что вернули мне будущее."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Have you found the Stone Guardian? It should be west of here, deeper in the forest."
msgstr "Ты уже нашёл Каменного Стража? Он должен быть к западу отсюда, глубже в лесу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Look for a giant carved stone head monument - the golem stands watch over it."
msgstr "Обратите внимание на гигантский памятник в виде высеченной из камня головы — голем стоит на страже у него."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He's working in his field, where small green shoots are beginning to emerge*{/}"
msgstr "{#666666}*Он работает на своём поле, где начинают появляться маленькие зелёные ростки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Look! Real crops! Growing in my soil again!"
msgstr "Смотрите! Настоящие урожаи! Они снова растут на моей земле!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Stone Guardian's blessing worked. The corruption is gone, the land is healing!"
msgstr "Благословение Каменного Стража подействовало. Порча исчезла, земля восстанавливается!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I'll never forget what you've done for me and my family."
msgstr "Я никогда не забуду того, что вы сделали для меня и моей семьи."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Ancient Guardian] Stone Golem"
msgstr "[Древний Страж] Каменный голем"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A towering stone golem stands motionless, facing an enormous carved stone head*{/}"
msgstr "{#666666}*Высоченный каменный голем стоит неподвижно, обратившись лицом к огромной резной каменной голове*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The ancient monument is covered in glowing runes. The golem seems to be guarding it reverently*{/}"
msgstr "{#666666}*Древний памятник покрыт светящимися рунами. Голем, похоже, благоговейно охраняет его*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's eyes glow faintly as it gazes at the stone head*{/}"
msgstr "{#666666}*Глаза голема слабо светятся, когда он смотрит на каменную голову*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The blessing... has been granted. Take it... to the farmer."
msgstr "Благословение... даровано. Отнеси его... фермеру."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem gestures toward the monument*{/}"
msgstr "{#666666}*Голем указывает на памятник*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You have proven yourself... worthy. Approach the monument... and pray."
msgstr "Ты доказал, что... достоин. Подойди к памятнику... и помолись."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's eyes ignite with blue light as you approach*{/}"
msgstr "{#666666}*Когда ты приближаешься, глаза голема загораются голубым светом*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Mortal... you disturb... the sacred monument."
msgstr "Смертный… ты оскверняешь… священный памятник."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*It turns its massive stone head toward you*{/}"
msgstr "{#666666}*Оно поворачивает свою массивную каменную голову в вашу сторону*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I have stood... for centuries. Guarding this place... since before the demon war ended."
msgstr "Я стою здесь... уже целые века. Охраняю это место... ещё с тех пор, как закончилась война с демонами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Tell me... did you witness... the great war between goddesses and demons?"
msgstr "Скажи мне… ты был свидетелем… той великой войны между богинями и демонами?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Yes, I fought in the demon war"
msgstr "Да, я сражался в войне с демонами"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "No, I came after the war ended"
msgstr "Нет, я приехал уже после окончания войны"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I don't remember much about it"
msgstr "Я об этом почти ничего не помню"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's eyes dim slightly*{/}"
msgstr "{#666666}*Глаза голема слегка померкли*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Deception... I sense no war-weariness in your soul. You lie to impress me."
msgstr "Обман... Я не чувствую в твоей душе никакой усталости от войны. Ты лжёшь, чтобы произвести на меня впечатление."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The monument's blessing... is not for deceivers. Leave."
msgstr "Освящение памятника… не для обманщиков. Уходите."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem nods slowly*{/}"
msgstr "{#666666}*Голем медленно кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Truthful... good. The young should not carry... the burdens of old wars."
msgstr "Правда... хорошо. Молодежь не должна нести... бремя старых войн."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*It gestures toward the massive stone head monument behind it*{/}"
msgstr "{#666666}*Оно указывает на огромный каменный монумент в виде головы, стоящий позади него*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This monument... honors the Earth Goddess. Many seek its power... but few deserve it."
msgstr "Этот памятник… посвящён Богине Земли. Многие ищут его силу… но лишь немногие достойны её."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem studies you carefully*{/}"
msgstr "{#666666}*Голем внимательно изучает тебя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Uncertain... evasive. You seek to hide something... or simply speak carelessly."
msgstr "Неуверенно... уклончиво. Ты пытаешься что-то скрыть... или просто говоришь неосторожно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I cannot grant blessings... to those who do not speak clearly. Return when you know your truth."
msgstr "Я не могу даровать благословения… тем, кто не выражается ясно. Вернись, когда поймёшь свою истину."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Why do you seek... the monument's blessing?"
msgstr "Почему ты ищешь… благословения памятника?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "To prove I am worthy of such power"
msgstr "Чтобы доказать, что я достоин такой силы"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Because I need its power for myself"
msgstr "Потому что мне нужна эта сила для себя"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "To help a farmer whose land is corrupted"
msgstr "Чтобы помочь фермеру, чья земля пострадала от загрязнения"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's eyes flicker with disappointment*{/}"
msgstr "{#666666}*В глазах голема мелькнуло разочарование*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Pride... ambition. You seek validation... not healing."
msgstr "Гордость… амбиции. Ты ищешь признания… а не исцеления."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The blessing is not... a trophy for your collection. Leave."
msgstr "Это благословение — не... трофей для вашей коллекции. Уходите."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's entire form seems to harden*{/}"
msgstr "{#666666}*Кажется, что весь голем становится тверже*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Selfishness... greed. Your soul harbors darkness."
msgstr "Эгоизм… жадность. В твоей душе таится тьма."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The monument's blessing... would be wasted on you. Begone."
msgstr "Освящение памятника… для тебя было бы напрасным. Убирайся."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's eyes glow brighter*{/}"
msgstr "{#666666}*Глаза голема светятся ещё ярче*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Compassion... selflessness. You seek to heal... not to take."
msgstr "Сострадание… бескорыстие. Ты стремишься исцелять… а не брать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Morku's suffering... yes... I sense it from here. His land cries out... poisoned by war's remnants."
msgstr "Страдания Морку… да… я чувствую их даже отсюда. Его земля взывает… отравленная последствиями войны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "One final question... Where do you come from, stranger?"
msgstr "И последний вопрос... Откуда ты, незнакомец?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I am just a wandering traveler"
msgstr "Я всего лишь странник"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "From Orsha, the military stronghold"
msgstr "Из Орши, военной крепости"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "From Goddess Laima's Maple Leaf Sanctuary"
msgstr "Из святилища «Кленовый лист» богини Лаймы"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem pauses, as if sensing something*{/}"
msgstr "{#666666}*Голем замирает, словно что-то почувствовав*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Wanderer... perhaps. But I sense... something more. A divine touch upon your soul."
msgstr "Странник… возможно. Но я чувствую… нечто большее. Божественное прикосновение к твоей душе."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "No matter. Your intentions are pure... that is what matters."
msgstr "Неважно. У тебя благие намерения… вот что главное."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem considers your words*{/}"
msgstr "{#666666}*Голем обдумывает твои слова*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Orsha... strong warriors. Good hearts. The land remembers... their sacrifices."
msgstr "Орша… отважные воины. Добрые сердца. Земля помнит… их жертвы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You carry their spirit... that is enough."
msgstr "Ты несешь в себе их дух… этого достаточно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem's entire form seems to brighten*{/}"
msgstr "{#666666}*Кажется, что весь голем становится ярче*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Laima... the merciful goddess. She who creates sanctuary... for the lost and weary."
msgstr "Лайма… милосердная богиня. Та, кто дарует убежище… заблудшим и уставшим."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You are one of her Otherworlders... summoned to help heal this broken world."
msgstr "Ты — один из её обитателей Иного мира… призванный помочь исцелить этот разбитый мир."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Then you are... exactly who should receive... this blessing."
msgstr "Тогда вы — именно тот человек, который должен получить… это благословение."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem places a massive hand on the stone head monument*{/}"
msgstr "{#666666}*Голем кладет свою огромную руку на каменный памятник в виде головы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You have proven yourself... worthy. Your heart is pure... your intentions noble."
msgstr "Ты доказал, что... достоин. Твое сердце чисто... твои намерения благородны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Earth Goddess... hears the pleas of those who suffer. And she answers... through those like you."
msgstr "Богиня Земли… слышит мольбы страдающих. И она отвечает… через таких, как ты."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The golem steps aside, revealing the glowing monument*{/}"
msgstr "{#666666}*Голем отступает в сторону, открывая вид на сияющий памятник*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Approach the monument... and offer your prayer. The goddess... will answer."
msgstr "Подойдите к памятнику… и вознесите молитву. Богиня… ответит вам."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#FFD700}The golem has granted you permission. Approach the monument and pray.{/}"
msgstr "{#FFD700}Голем дал вам разрешение. Подойдите к памятнику и помолитесь.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Sacred Monument"
msgstr "Священный памятник"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*An enormous stone head carved with ancient runes. Its eyes seem to watch you*{/}"
msgstr "{#666666}*Огромная каменная голова, украшенная древними рунами. Кажется, что её глаза следят за тобой*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The monument's blessing has already been granted*{/}"
msgstr "{#666666}*Благословение памятника уже дано*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The monument is protected by the stone golem. You must prove yourself worthy first*{/}"
msgstr "{#666666}*Памятник охраняется каменным големом. Сначала вам нужно доказать, что вы достойны*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Praying before the monument..."
msgstr "Молитва у памятника..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The runes on the monument begin to glow brilliantly*{/}"
msgstr "{#666666}*Руны на памятнике начинают ярко светиться*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Divine energy flows from the monument, forming a crystalline essence*{/}"
msgstr "{#666666}*Из памятника струится божественная энергия, образуя кристаллическую сущность*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The purified essence floats gently into your hands*{/}"
msgstr "{#666666}*Очищенная эссенция нежно опускается в ваши руки*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*You feel the Earth Goddess's blessing upon you*{/}"
msgstr "{#666666}*Ты чувствуешь, как благословение Богини Земли опускается на тебя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#FFD700}Received Purified Essence! Return to Morku.{/}"
msgstr "{#FFD700}Получена очищенная эссенция! Вернуться в Морку.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Your prayer was interrupted. The monument waits patiently*{/}"
msgstr "{#666666}*Ваша молитва была прервана. Памятник терпеливо ждёт*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Purifying Statue"
msgstr "Очищающая статуя"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The statue glows with holy light, warding off evil creatures*{/}"
msgstr "{#666666}*Статуя сияет святым светом, отгоняя злых существ*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Your prayer has already awakened this guardian. The road here is safe."
msgstr "Ваша молитва уже разбудила этого стража. Дорога сюда безопасна."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Praying..."
msgstr "Молитва..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Purifying statues awakened: {0}/5"
msgstr "Пробудившиеся очищающие статуи: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#FFD700}All statues awakened! The forest roads are protected. Return to Miriam in Orsha.{/}"
msgstr "{#FFD700}Все статуи пробудились! Лесные дороги под защитой. Вернитесь к Мириам в Оршу.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Your prayer was interrupted. The statue remains dormant."
msgstr "Ваша молитва была прервана. Статуя по-прежнему безмолвна."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*An ancient wooden statue carved in the shape of an Owl. Its holy power lies dormant*{/}"
msgstr "{#666666}*Древняя деревянная статуэтка, вырезанная в форме совы. Её священная сила пока дремлет*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The statue once protected travelers on this road, but its blessing has faded."
msgstr "Когда-то эта статуя охраняла путешественников на этой дороге, но её благословение утратило свою силу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Holy light bursts from the statue! The Guardian's blessing awakens!*{/}"
msgstr "{#666666}*Из статуи извергается святой свет! Пробуждается благословение Стража!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The statue comes alive with divine energy. Monsters nearby flee from its radiance."
msgstr "Статуя наполняется божественной энергией. Находящиеся поблизости чудовища бегут от её сияния."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*A weathered wooden guardian stands watch over the eastern road*{/}"
msgstr "{#666666}*Потертый от времени деревянный страж стоит на страже у восточной дороги*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The statue's divine protection has long since faded. Monsters roam freely here."
msgstr "Божественная защита этой статуи уже давно утрачена. Здесь свободно бродят чудовища."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The Guardian's power flows through the statue! Light banishes the shadows!*{/}"
msgstr "{#666666}*Сила Стража пронизывает статую! Свет изгоняет тьму!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The guardian awakens. This path is under divine protection once more."
msgstr "Хранитель пробуждается. Этот путь вновь находится под божественной защитой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The southern guardian stands silent and dark, its blessing dormant*{/}"
msgstr "{#666666}*Южный страж стоит молчаливый и мрачный, его благословение дремлет*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Without the statue's protection, this road has become treacherous."
msgstr "Без защиты статуи эта дорога стала опасной."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Sacred light erupts from the statue! The guardian's blessing returns!*{/}"
msgstr "{#666666}*Из статуи извергается священный свет! Благословение стража возвращается!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The southern road is safe once more. The goddess hears your prayers."
msgstr "Южная дорога вновь стала безопасной. Богиня услышала ваши молитвы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*An ancient guardian carved from blessed wood stands watch over the western approach*{/}"
msgstr "{#666666}*Древний страж, вырезанный из освящённого дерева, стоит на страже у западного подхода*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Its holy power has faded. Travelers on this road are no longer safe."
msgstr "Его святая сила угасла. Путешественникам на этой дороге больше не безопасно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Divine power surges through the statue! The guardian awakens with radiant light!*{/}"
msgstr "{#666666}*Божественная сила пронизывает статую! Страж пробуждается в сиянии света!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The western road is blessed once more. Your prayers have been answered."
msgstr "Западная дорога вновь обрела благословение. Ваши молитвы были услышаны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*The greatest of the five guardians stands at the forest crossroads. Once, this statue's blessing protected the entire forest network of roads*{/}"
msgstr "{#666666}*Величайший из пяти стражей стоит на лесном перекрестке. Когда-то благословение этой статуи защищало всю сеть лесных дорог*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "But now it stands dark and silent. Without its power, no road is truly safe."
msgstr "Но сейчас он стоит мрачный и безмолвный. Без его силы ни одна дорога не может считаться по-настоящему безопасной."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*Brilliant holy light explodes from the statue! The Guardian's full blessing returns!*{/}"
msgstr "{#666666}*Из статуи вырывается ослепительный святой свет! Полное благословение Стража возвращается!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The forest roads are completely safe now. Your devotion has restored what was lost."
msgstr "Лесные дороги теперь абсолютно безопасны. Ваша преданность помогла восстановить то, что было утрачено."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*You've already inspected this rubble pile*{/}"
msgstr "{#666666}*Вы уже осмотрели эту кучу обломков*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Inspecting rubble..."
msgstr "Осмотр завалов..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Rubble piles inspected: {0}/6"
msgstr "Проверено количество куч щебня: {0}/6"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#FFD700}All rubble piles inspected! Return to Soldier Henrik.{/}"
msgstr "{#FFD700}Все груды обломков проверены! Вернитесь к солдату Хенрику.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Inspection cancelled."
msgstr "Проверка отменена."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Bee-Attracting Flowers"
msgstr "Цветы, привлекающие пчел"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "A beautiful patch of colorful wildflowers. Bees would love these."
msgstr "Прекрасный участок, усыпанный разноцветными полевыми цветами. Пчелам это наверняка понравится."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You've already gathered flowers from this patch."
msgstr "Вы уже собирали цветы на этом участке."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Gathering flowers..."
msgstr "Сбор цветов..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Bee-attracting flowers collected: {0}/5"
msgstr "Собранные цветы, привлекающие пчел: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "All flowers collected! Return to Beekeeper Greta."
msgstr "Все цветы собраны! Вернись к пчеловодке Грете."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Cleansing the Corrupted Air"
msgstr "Очищение загрязнённого воздуха"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Cull the infected creatures spreading poison throughout the woods to help Scout Milda contain the contamination."
msgstr "Уничтожьте заражённых существ, распространяющих яд по всему лесу, чтобы помочь разведчице Милде сдержать распространение заражения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt corrupted Jukopus"
msgstr "Хант подкупил Джукопуса"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt poisoned Kepas"
msgstr "Хант отравил Кепаса"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt infected Pokubu"
msgstr "Охота на заражённого Покубу"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Lost Caravan"
msgstr "«Потерянный караван»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Recover loose packages from the poisoned Kepas."
msgstr "Соберите разбросанные посылки у отравленных кепасов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Recover Loose Packages"
msgstr "Собирать разбросанные посылки"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Merchant] Alfred"
msgstr "[Продавец] Альфред"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Hermit's Discovery"
msgstr "Открытие Отшельника"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt corrupted boars to slow the spread of corruption in the forest."
msgstr "Охотьтесь на заражённых кабанов, чтобы замедлить распространение заразы в лесу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt corrupted Pokubu"
msgstr "Хант подкупил Покубу"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Hunt Pokuborn"
msgstr "Хант Покуборн"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Hermit] Torsten"
msgstr "[Отшельник] Торстен"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Reconstructing the Bridges"
msgstr "Восстановление мостов"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Inspect rubble piles coming off the deteriorating bridges to help assess the damage for reconstruction efforts."
msgstr "Осмотрите груды обломков, обрушившиеся с разрушающихся мостов, чтобы помочь оценить масштаб повреждений в целях проведения восстановительных работ."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Inspect the rubble piles"
msgstr "Осмотрите кучи обломков"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Soldier] Henrik"
msgstr "[Солдат] Хенрик"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Beekeeper's Hope"
msgstr "«Надежда пчеловода»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Gather bee-attracting flowers from around the forest to help Beekeeper Greta lure wild bees back to her farm."
msgstr "Собери цветы, привлекающие пчел, по всему лесу, чтобы помочь пчеловодке Грете заманить диких пчел обратно на свою ферму."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Collect bee-attracting flowers"
msgstr "Соберите цветы, привлекающие пчел"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Beekeeper] Greta"
msgstr "[Пчеловод] Грета"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Seeds of Hope"
msgstr "«Семена надежды»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Seek out the ancient stone golem guardian and request its blessing to purify Morku's corrupted farmland."
msgstr "Найдите древнего каменного голема-хранителя и попросите его благословения, чтобы очистить заражённые сельскохозяйственные угодья Морку."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Seek the Stone Golem's blessing"
msgstr "Попросите благословения у каменного голема"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "[Farmer] Morku"
msgstr "[Фермер] Морку"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I need someone to inspect the rubble piles coming off the bridges - this will help us assess which areas need the most urgent repairs. Can you handle that?"
msgstr "Мне нужен человек, который осмотрит груды обломков, свалившиеся с мостов — это поможет нам определить, какие участки требуют наиболее срочного ремонта. Вы сможете этим заняться?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Excellent. Follow the main road through the Woods of the Linked Bridges and inspect each rubble pile you find."
msgstr "Отлично. Идите по главной дороге через Лес Связанных Мостов и осмотрите каждую кучу обломков, которую встретите."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "There's another bridge further south - follow the road and you'll find more rubble piles along the way."
msgstr "Чуть южнее есть ещё один мост — следуйте по дороге, и по пути вы увидите ещё несколько куч обломков."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Once you've inspected all the rubble piles, report back to me. We'll use your findings to prioritize reconstruction efforts."
msgstr "Как только вы осмотрите все завалы, доложите мне. Мы будем использовать ваши выводы для определения приоритетов в работах по восстановлению."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He rolls out a worn map of the forest*{/}"
msgstr "{#666666}*Он разворачивает потертую карту леса*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Multiple bridges connect this entire region - built generations ago by Master Siauliai."
msgstr "Весь этот регион соединяют многочисленные мосты, построенные много поколений назад мастером Шяуляй."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "After the demon war, we lost contact with this area. The bridges are deteriorating - rubble and debris falling from the supports."
msgstr "После войны с демонами мы потеряли связь с этой местностью. Мосты приходят в негодность — с опор сыплются обломки и мусор."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Without proper bridges, Orsha's supply routes are cut off. Villages remain isolated. Commerce has ground to a halt."
msgstr "Без надлежащих мостов пути снабжения Орши перекрыты. Деревни остаются отрезанными от внешнего мира. Торговля пришла в полный застой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "We need to survey the damage before we can begin reconstruction work."
msgstr "Прежде чем приступить к восстановительным работам, нам необходимо оценить масштабы ущерба."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He returns to his construction plans*{/}"
msgstr "{#666666}*Он возвращается к своим строительным планам*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Right. This is Orsha military business anyway. Safe travels."
msgstr "Верно. В любом случае, это дело Орши. Удачного пути."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He straightens up, eager for your report*{/}"
msgstr "{#666666}*Он выпрямляется, с нетерпением ожидая твоего отчета*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You've inspected all the rubble piles? Give me your assessment!"
msgstr "Вы осмотрели все кучи обломков? Поделитесь своим мнением!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*You provide detailed reports on the damage at each location*{/}"
msgstr "{#666666}*Вы предоставляете подробные отчеты об ущербе по каждому месту*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He makes notes on his plans*{/}"
msgstr "{#666666}*Он делает заметки о своих планах*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This is excellent intelligence. Now I know exactly which bridges need the most urgent repairs."
msgstr "Это отличная разведывательная информация. Теперь я точно знаю, какие мосты нуждаются в самом срочном ремонте."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I can take this back to Orsha and get reconstruction approved immediately. We'll have work crews out here within the week."
msgstr "Я могу отвезти это в Оршу и сразу же добиться одобрения реконструкции. Уже в течение недели сюда прибудут рабочие бригады."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Here - take this soldier's iron club as payment for your survey work. Orsha thanks you for helping reconnect the region!"
msgstr "Вот — возьмите эту железную дубинку солдата в качестве оплаты за вашу работу по съемке местности. Орша благодарит вас за помощь в восстановлении связи в регионе!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "How's the survey going? Keep looking for more rubble piles to inspect."
msgstr "Как проходит обследование? Продолжайте искать новые кучи обломков для осмотра."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Follow the main road through the forest. Remember, there's another bridge further south - keep following the road."
msgstr "Идите по главной дороге через лес. Не забудьте, что чуть южнее есть ещё один мост — продолжайте идти по дороге."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He's reviewing construction schedules*{/}"
msgstr "{#666666}*Он изучает графики строительства*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Thanks to your survey, reconstruction has been approved. Work crews are already repairing the most damaged bridges."
msgstr "Благодаря результатам вашего опроса проект реконструкции был одобрен. Рабочие бригады уже приступили к ремонту наиболее повреждённых мостов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Within a few months, all the linked bridges will be fully restored. Commerce and travel will return to normal."
msgstr "В течение нескольких месяцев все соединяющие мосты будут полностью восстановлены. Торговля и транспортное сообщение вернутся в нормальное русло."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The Pokubu - the boars that roam these woods. They've always been territorial, but lately they've become violent."
msgstr "Покубу — кабаны, обитающие в этих лесах. Они всегда были территориальными животными, но в последнее время стали агрессивными."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Their eyes glow with dark energy. Some - the Pokuborn - have darker hides and are far more aggressive."
msgstr "Их глаза светятся тёмной энергией. Некоторые из них — покуборны — имеют более тёмную кожу и гораздо более агрессивны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I've lived in these woods for thirty years. I know when something's unnatural."
msgstr "Я живу в этих лесах уже тридцать лет. Я знаю, когда что-то не так."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "I came out here to escape people and their politics. Cities, armies, wars... all that noise."
msgstr "Я уехал сюда, чтобы уйти от людей и их политики. Города, армии, войны… весь этот шум."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Out here, it's just me, the trees, and the beasts. Or at least it used to be peaceful."
msgstr "Здесь только я, деревья и звери. По крайней мере, раньше здесь было спокойно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "But even in isolation, the world's problems find you eventually."
msgstr "Но даже в изоляции проблемы этого мира рано или поздно настигнут тебя."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Still hunting the corrupted boars?"
msgstr "Все еще охотишься на зараженных кабанов?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Be careful out there. The Pokuborn are particularly vicious."
msgstr "Будьте осторожны. Покуборны особенно жестоки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He stands and inspects you carefully*{/}"
msgstr "{#666666}*Он встает и внимательно разглядывает тебя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You did it. I can already sense the forest feels... calmer. Less corrupted energy in the air."
msgstr "Ты справился. Я уже чувствую, что в лесу стало… спокойнее. В воздухе меньше загрязнённой энергии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "{#666666}*He retrieves a piece of leather armor from his cabin*{/}"
msgstr "{#666666}*Он достает из своей каюты часть кожаных доспехов*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "This is an armor I crafted with the leather from these monsters."
msgstr "Это доспехи, которые я изготовил из кожи этих монстров."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "You've earned it. Thank you for helping maintain the balance in these woods."
msgstr "Ты это заслужил. Спасибо, что помогаешь поддерживать равновесие в этих лесах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "The boars have been calmer lately. The corruption's influence is weakening, thanks to you."
msgstr "В последнее время кабаны стали вести себя спокойнее. Благодаря тебе влияние коррупции ослабевает."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_15_re_quests.cs
msgid "Keep that armor close. It'll serve you well against dark forces."
msgstr "Держи эту броню под рукой. Она хорошо тебе пригодится в борьбе с темными силами."

# ============================================================================
# Paupys Crossing Quests (f_siauliai_11_re_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Guard] Borin"
msgstr "[Страж] Борин"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Borin"
msgstr "Борин"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A rain-soaked Orshan guard stands watch at the crossing, constantly swatting at blue Popolions*{/}"
msgstr "{#666666}*Промокший до нитки оршанский стражник стоит на страже у переправы, то и дело отгоняя синих пополионов*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Another day, another downpour. And these cursed Popolions won't leave me alone!"
msgstr "Очередной день — очередной ливень. А эти проклятые Пополионы никак не дают мне покоя!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I'm supposed to be watching for bandits, but I can barely keep these pests off my post."
msgstr "Я должен следить за бандитами, но с трудом удерживаю этих надоедливых тварей подальше от своего поста."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I haven't had a moment's rest since dawn. Every time I sit down, more of them swarm in."
msgstr "С самого рассвета я ни на минуту не отдыхал. Каждый раз, как только я сажусь, их становится всё больше."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I can help clear them out"
msgstr "Я могу помочь их убрать"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Why are there so many?"
msgstr "Почему их так много?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Stay strong"
msgstr "Держись"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He looks at you with hopeful eyes*{/}"
msgstr "{#666666}*Он смотрит на тебя с надеждой в глазах*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You'd do that? Thank the goddess!"
msgstr "Ты бы так поступил? Слава богине!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Just clear enough of them so I can actually do my job. Maybe then I can finally dry off this armor."
msgstr "Просто убери их подальше, чтобы я мог нормально работать. Может, тогда я наконец-то смогу высушить эту броню."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Will you help clear the Popolions from the crossing?"
msgstr "Не могли бы вы помочь очистить перекресток от Пополионов?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I appreciate this more than you know. The Popolions are everywhere - shouldn't take you long to find them."
msgstr "Я ценю это больше, чем ты можешь себе представить. Пополионы встречаются повсюду — тебе не придётся долго их искать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Come back when you've thinned their numbers."
msgstr "Вернись, когда уменьшишь их число."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He gestures toward the forest*{/}"
msgstr "{#666666}*Он указывает на лес*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The rain brings them out, or maybe it's corruption from Koru Jungle seeping this way."
msgstr "Их выманивает дождь, а может, это коррупция из джунглей Кору, просачивающаяся сюда."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Whatever the reason, they've made this crossing miserable to guard."
msgstr "Какова бы ни была причина, из-за них охранять этот переход стало настоящим мучением."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I'd clear them myself, but I can't abandon my post. Orders are orders."
msgstr "Я бы сам их убрал, но не могу покинуть свой пост. Приказ есть приказ."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He returns to watching the road, flinching as another Popolion hops past*{/}"
msgstr "{#666666}*Он снова обращает взгляд на дорогу и вздрогнул, когда мимо пропрыгнул ещё один Пополион*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Right. I'll... manage somehow."
msgstr "Ладно. Я... как-нибудь справлюсь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He stands a bit straighter, no longer constantly swatting at blue creatures*{/}"
msgstr "{#666666}*Он стоит чуть ровнее, больше не отмахиваясь от синих существ*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I noticed the difference immediately. Fewer Popolions hopping around, more time to actually guard."
msgstr "Я сразу заметил разницу. Пополионов, прыгающих вокруг, стало меньше, а времени на саму охрану — больше."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You've done me - and Orsha - a real service today. Here, take this as thanks."
msgstr "Ты сегодня оказал мне — и Орше — настоящую услугу. Вот, возьми это в знак благодарности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He hands you payment from his guard stipend*{/}"
msgstr "{#666666}*Он передает вам деньги из своего жалованья охранника*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Still fighting off those blue pests?"
msgstr "Все еще боретесь с этими синими вредителями?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "They're everywhere around here. Keep at it - every one you clear helps."
msgstr "Они здесь повсюду. Продолжай в том же духе — каждый уничтоженный противник приносит пользу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He's finally managing to dry his armor in the brief moments between rain showers*{/}"
msgstr "{#666666}*Ему наконец удаётся высушить доспехи в короткие перерывы между ливнями*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The crossing is much more manageable now. Thank you again!"
msgstr "Теперь переход стал гораздо проще. Еще раз спасибо!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Lumberjack] Kaspar"
msgstr "[Лесоруб] Каспар"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Kaspar"
msgstr "Каспар"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*An angry lumberjack gestures at scattered wood logs, several stacks conspicuously empty*{/}"
msgstr "{#666666}*Разгневанный лесоруб указывает на разбросанные по земле бревна, среди которых несколько явно пустых стопок*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "This is the third time this week! Every morning, more timber is missing!"
msgstr "Это уже третий раз за эту неделю! Каждое утро пропадает всё больше древесины!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I cut it, stack it, and by dawn - gone! Someone's stealing my livelihood!"
msgstr "Я его срезаю, складываю в стопки, а к рассвету — и нет! Кто-то крадёт моё средство к существованию!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I need someone to investigate. The guard won't help - they say I'm probably just miscounting. Miscounting!"
msgstr "Мне нужен кто-нибудь, кто бы это проверил. Охранники не хотят помогать — они говорят, что я, наверное, просто ошибся в подсчёте. Ошибся в подсчёте!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I'll investigate for you"
msgstr "Я разберусь в этом для вас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "What makes you think it's theft?"
msgstr "Почему вы считаете, что это кража?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Maybe you should guard it yourself"
msgstr "Может, тебе стоит самому это охранять?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He grabs your shoulders eagerly*{/}"
msgstr "{#666666}*Он нетерпеливо хватает тебя за плечи*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Finally! Someone who takes this seriously!"
msgstr "Наконец-то! Кто-то, кто относится к этому всерьёз!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Look around the area - check the three log piles where timber keeps vanishing."
msgstr "Осмотрите окрестности — проверьте три штабеля бревен, откуда постоянно пропадает древесина."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Examine them carefully. Maybe you'll find something I missed!"
msgstr "Внимательно их изучите. Может быть, вы найдёте что-то, что я упустил!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Will you investigate the missing timber?"
msgstr "Не могли бы вы провести расследование по делу о пропавшей древесине?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Thank you! Start by examining the three log piles. Look for any clues about what's taking my timber."
msgstr "Спасибо! Для начала осмотрите три штабеля бревен. Поищите какие-нибудь подсказки о том, кто крадет мою древесину."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The drag marks! Look at the ground - something heavy was dragged away."
msgstr "Следы от перетаскивания! Посмотрите на землю — отсюда утащили что-то тяжёлое."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "And the timing is too consistent. Every night, same amount missing."
msgstr "Да и время исчезновения слишком постоянное. Каждую ночь пропадает одинаковое количество."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "This isn't animals. This is deliberate!"
msgstr "Это не просто животные. Это сделано специально!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*His face reddens*{/}"
msgstr "{#666666}*Его лицо покраснело*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Guard it myself? I work from dawn to dusk cutting and processing!"
msgstr "Сам его охранять? Я работаю с рассвета до заката — режу и обрабатываю!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I can't stay up all night watching logs too!"
msgstr "Я тоже не могу всю ночь напролёт сидеть и просматривать логи!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He looks relieved as you approach*{/}"
msgstr "{#666666}*Когда ты подходишь, он выглядит облегчённым*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I heard the commotion! So it was Woodin all along?"
msgstr "Я слышал шум! Так это всё-таки был Вудин?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He slaps his forehead*{/}"
msgstr "{#666666}*Он хлопает себя по лбу*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Of course! The drag marks, the nighttime activity - they're building nests!"
msgstr "Конечно! Следы от перетаскивания, ночная активность — они строят гнезда!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I've been blaming bandits this whole time when it was just those cursed plants!"
msgstr "Я всё это время винил бандитов, а виноваты были всего лишь эти проклятые растения!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He laughs in relief and embarrassment*{/}"
msgstr "{#666666}*Он смеётся от облегчения и смущения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "And you've cleared out enough of them that they shouldn't be a problem anymore. Here - you've earned this!"
msgstr "И ты уже уничтожил их достаточно, так что они больше не должны представлять проблему. Вот — ты это заслужил!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Woodin! So that's what's been stealing my timber!"
msgstr "Вудин! Так вот кто крал мою древесину!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Can you clear them out? I need to make sure they don't come back for more logs."
msgstr "Можешь их убрать? Мне нужно убедиться, что они не вернутся за новыми поленьями."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Have you examined the log piles yet?"
msgstr "Вы уже осмотрели штабеля бревен?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Look for any clues about what's taking my timber!"
msgstr "Поищите какие-нибудь зацепки, чтобы выяснить, кто крадет мою древесину!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He's hammering wooden stakes into the ground around his lumber stacks*{/}"
msgstr "{#666666}*Он вбивает деревянные колья в землю вокруг своих штабелей бревен*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "These barriers should keep those Woodin away from my timber. Much appreciated, friend!"
msgstr "Эти заграждения должны удержать тех Вудинов подальше от моей древесины. Большое спасибо, друг!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Herbalist] Ruta"
msgstr "[Травник] Рута"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Ruta"
msgstr "Рута"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A herbalist crouches between trees and bushes, carefully examining rain-soaked plants*{/}"
msgstr "{#666666}*Травник приседает между деревьями и кустами, внимательно осматривая промокшие под дождём растения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Perfect conditions... absolutely perfect."
msgstr "Идеальные условия… просто идеальные."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The endless rain in Paupys Crossing creates ideal conditions for Moonlight Flowers - rare medicinal herbs."
msgstr "Бесконечные дожди в Паупис-Кроссинг создают идеальные условия для роста «лунных цветов» — редких лекарственных трав."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "They only bloom when the rain falls like this. But I can't gather them all myself - too much ground to cover."
msgstr "Они цветут только тогда, когда идет такой дождь. Но я не могу собрать их все сама — территория слишком большая."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I can help gather them"
msgstr "Я могу помочь их собрать"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "What makes these herbs special?"
msgstr "Чем же эти травы так особенны?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Good luck with your search"
msgstr "Удачи в поиске"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Her eyes light up*{/}"
msgstr "{#666666}*Ее глаза загораются*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You'd help? Wonderful!"
msgstr "Ты поможешь? Замечательно!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I need five in total. They're precious, but rare. You should find them looking around the forest. Take only what we need!"
msgstr "Мне нужно в общей сложности пять штук. Они очень ценные, но встречаются редко. Поищи их в лесу. Бери только то, что нам нужно!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Will you help gather the Moonlight Flowers?"
msgstr "Не поможете ли вы собрать «Лунные цветы»?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Take your time. The rain ensures they'll stay fresh until you return."
msgstr "Не торопитесь. Дождь позаботится о том, чтобы они остались свежими до вашего возвращения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She holds up a delicate silver-white flower*{/}"
msgstr "{#666666}*Она поднимает к лицу нежный серебристо-белый цветок*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Moonlight Flowers have incredible healing properties. They can treat wounds that normal medicine can't touch."
msgstr "«Лунные цветы» обладают невероятными целебными свойствами. С их помощью можно лечить раны, с которыми не справляется обычная медицина."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "But they only bloom during sustained rainfall, and only in specific locations. That's what makes them so valuable."
msgstr "Но они цветут только во время продолжительных дождей и только в определенных местах. Именно это делает их такими ценными."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Orsha's wounded soldiers could benefit greatly from these. That's why I'm gathering them."
msgstr "Раненым солдатам Орши это могло бы очень пригодиться. Вот почему я их собираю."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She returns to examining the plants around her hideout*{/}"
msgstr "{#666666}*Она снова начинает осматривать растения вокруг своего укрытия*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "May the rain bless your path."
msgstr "Пусть дождь благословит твой путь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She carefully takes the Moonlight Flowers from you*{/}"
msgstr "{#666666}*Она осторожно берет у тебя «Лунные цветы»*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Perfect specimens! You have a gentle touch - not a single petal damaged."
msgstr "Прекрасные экземпляры! У вас очень аккуратная рука — ни один лепесток не поврежден."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "These will help many wounded soldiers recover. You've done Orsha a great service."
msgstr "Это поможет многим раненым солдатам поправиться. Вы оказали Орше огромную услугу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She packages the flowers carefully in oiled cloth*{/}"
msgstr "{#666666}*Она аккуратно заворачивает цветы в промасленную ткань*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Please, accept this payment. Your help was invaluable."
msgstr "Пожалуйста, примите этот платеж. Ваша помощь была неоценимой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You've gathered {0} Moonlight Flowers so far. Look for the blooms in peaceful spots across the crossing."
msgstr "На данный момент вы собрали {0} лунных цветов. Ищите эти цветы в тихих уголках по всей территории переправы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "They prefer areas untouched by heavy combat - serene places where the rain falls gently."
msgstr "Они предпочитают районы, не затронутые ожесточёнными боями, — безмятежные места, где дождь идёт мягко."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She's preparing the Moonlight Flowers for transport*{/}"
msgstr "{#666666}*Она готовит «Лунные цветы» к транспортировке*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I'll be taking these to Orsha's medical tents tomorrow. Your help made all the difference."
msgstr "Завтра я отнесу их в медицинские палатки в Орше. Ваша помощь сыграла решающую роль."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Scout] Daina"
msgstr "[Разведчица] Дайна"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Daina"
msgstr "Дайна"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*An Orshan scout crouches at the cliff edge, she looks furious*{/}"
msgstr "{#666666}*Разведчица из Оршана приседает на краю обрыва, она выглядит разъярённой*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Ugh! Not again!"
msgstr "Фу! Только не снова!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She points down cliff at a blue Popolion bouncing away with something shiny in its mouth*{/}"
msgstr "{#666666}*Она указывает вниз с обрыва на голубого Пополиона, который ускакивает прочь с чем-то блестящим во рту*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I knew it! That little pest stole one of my healing potions!"
msgstr "Я так и знал! Этот маленький проказник украл одно из моих целебных зелий!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The purification crystals are down at Deer Hooves Lot, below the cliff. I need someone to check the three crystals for traces of corruption."
msgstr "Очищающие кристаллы находятся в районе «Оленьи копыта», внизу у обрыва. Мне нужен кто-нибудь, кто проверил бы эти три кристалла на наличие следов порчи."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I'll check the crystals for you"
msgstr "Я проверю кристаллы за вас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You're a soldier of Orsha, deal with it!"
msgstr "Ты солдат Орши, смирись с этим!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "That does sound annoying"
msgstr "Это действительно звучит раздражающе"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Her face lights up with relief*{/}"
msgstr "{#666666}*Её лицо озарилось облегчением*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Really? You're a lifesaver!"
msgstr "Правда? Вы мне очень помогли!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Head down to Deer Hooves Lot and inspect the three purification crystals. They're enchanted to detect corruption from Koru Jungle."
msgstr "Отправляйтесь на стоянку «Оленьи копыта» и осмотрите три кристалла очищения. Они зачарованы так, что способны обнаруживать порчу из джунглей Кору."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She glances at the Popolions and Hanaming nearby*{/}"
msgstr "{#666666}*Она бросает взгляд на стоящих поблизости Пополионов и Ханаминга*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "And while you're at it... if you happen to get rid of some of those pests down there, I'd be grateful. They've been making my work impossible."
msgstr "И раз уж ты этим занимаешься… если тебе удастся избавиться от некоторых из тех вредителей там внизу, я буду тебе очень благодарен. Они просто мешают мне работать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Will you inspect the purification crystals at Deer Hooves Lot?"
msgstr "Не могли бы вы осмотреть очищающие кристаллы на участке «Оленьи копыта»?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Thank you! The crystals should show their corruption readings when you examine them."
msgstr "Спасибо! При осмотре кристаллов должны отображаться показатели их повреждения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "And if you clear out some Popolions and Hanaming while you're there... well, that would be a nice bonus."
msgstr "А если заодно уничтожить пару Пополионов и Ханамингов… ну, это было бы приятным бонусом."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Her eyes narrow*{/}"
msgstr "{#666666}*Она прищурила глаза*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Deal with it? DEAL WITH IT?!"
msgstr "Смириться с этим? СМИРИТЬСЯ С ЭТИМ?!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I've been on this cliff for three days straight monitoring corruption spread from Koru Jungle!"
msgstr "Я уже три дня подряд нахожусь на этом утесе, наблюдая за распространением коррупции из джунглей Кору!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I can handle bandits. I can handle monsters. I can even handle demon corruption."
msgstr "Я справлюсь с бандитами. Я справлюсь с монстрами. Я справлюсь даже с демоническим заражением."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She gestures emphatically*{/}"
msgstr "{#666666}*Она выразительно жестикулирует*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "But these little THIEVES keep stealing my supplies, interrupting my sleep, and making nests in my gear!"
msgstr "Но эти маленькие ВОРЫ то и дело крадут мои припасы, мешают мне спать и вьют гнезда в моём снаряжении!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You try doing surveillance work when something keeps chewing your hair in the middle of the night!"
msgstr "Попробуй-ка вести наблюдение, когда посреди ночи что-то постоянно грызет тебе волосы!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She takes a deep breath, calming herself*{/}"
msgstr "{#666666}*Она глубоко вздыхает, пытаясь успокоиться*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "...I'm a scout, not a pest exterminator. That's not what Orsha trained me for."
msgstr "...Я разведчик, а не дезинсектор. В Орше меня учили не этому."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She sighs and swats at another Popolion hopping toward her pack*{/}"
msgstr "{#666666}*Она вздыхает и отмахивается от очередного Пополиона, прыгающего в сторону её рюкзака*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Right. I suppose I'll just... keep guard duty with one eye open from now on."
msgstr "Ладно. Пожалуй, с этого момента я буду… нести вахту, не закрывая ни одного глаза."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She's finally able to work without creatures stealing her supplies*{/}"
msgstr "{#666666}*Наконец-то она может работать, не боясь, что существа украдут её припасы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Peace at last! I can actually focus on my observations now."
msgstr "Наконец-то покой! Теперь я могу действительно сосредоточиться на своих наблюдениях."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "And the crystal readings... all showing mild traces only. Minor contamination, but not spreading rapidly."
msgstr "А результаты анализа кристаллов… все показывают лишь незначительные следы. Незначительное загрязнение, но оно не распространяется быстро."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She retrieves her stolen potion from a nearby bush where you must have dropped it*{/}"
msgstr "{#666666}*Она достаёт своё украденное зелье из ближайшего куста, куда ты, должно быть, его уронил*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Ha! Found it! Those little thieves."
msgstr "Ха! Нашла! Эти маленькие воришки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "This is valuable information for Orsha's defense planning. And I can finally sleep without guarding my hair. You've helped more than you know!"
msgstr "Это ценная информация для планирования обороны Орши. И я наконец-то смогу спать, не боясь за свои волосы. Вы помогли больше, чем думаете!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The pests are still causing trouble. A few less would make all the difference!"
msgstr "Вредители по-прежнему доставляют неприятности. Если бы их было чуть меньше, это значительно облегчило бы ситуацию!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Good, they're not bothering me as much. Now check those purification crystals for me."
msgstr "Хорошо, они уже не так сильно меня беспокоят. А теперь проверь для меня эти кристаллы очищения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*She's making detailed observations with her supplies safely secured*{/}"
msgstr "{#666666}*Она проводит тщательные наблюдения, надежно закрепив свои принадлежности*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The contamination is stable for now. And no more potion thieves! Thanks again for your help!"
msgstr "Пока что уровень загрязнения остается стабильным. И больше никаких воров зелий! Еще раз спасибо за помощь!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Commander] Uska"
msgstr "[Командир] Уска"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Uska"
msgstr "Уска"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A stern Orshan commander stands before the entrance to Ashaq Underground Prison, inspecting a glowing magical device*{/}"
msgstr "{#666666}*Суровый оршанский командир стоит у входа в подземную тюрьму Ашак, осматривая светящееся магическое устройство*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Otherworlder. Your timing is fortuitous."
msgstr "Пришелец из другого мира. Ты как раз вовремя."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "This prison holds some of the most dangerous creatures that survived the demon war. Dumaros, Wendigos - things that should never see daylight again."
msgstr "В этой тюрьме содержатся одни из самых опасных существ, переживших войну с демонами. Думарос, вендиго — существа, которые никогда больше не должны увидеть дневной свет."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The magical detection device that monitors threats from the underground cells is critical for Orsha's defense. But it hasn't been tested in months. I need someone to verify it's working properly."
msgstr "Магическое устройство обнаружения, которое отслеживает угрозы со стороны подпольных ячеек, имеет решающее значение для обороны Орши. Но его уже несколько месяцев не проверяли. Мне нужен кто-нибудь, кто проверит, исправно ли оно работает."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I'll help test the device"
msgstr "Я помогу протестировать устройство"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "What does the device detect?"
msgstr "Что обнаруживает это устройство?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Sounds dangerous"
msgstr "Звучит опасно"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He nods approvingly*{/}"
msgstr "{#666666}*Он одобрительно кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Good. I expected nothing less from someone who assists Orsha."
msgstr "Хорошо. Я и не ожидал ничего другого от человека, который помогает Орше."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I've prepared monster bait designed to lure prison creatures to the surface. Deploy it at three designated points near the detection device."
msgstr "Я подготовил приманку для монстров, предназначенную для привлечения тюремных существ на поверхность. Разместите её в трёх указанных точках рядом с устройством обнаружения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He hands you a sealed package*{/}"
msgstr "{#666666}*Он протягивает тебе запечатанную посылку*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "When the bait attracts Dumaros and Wendigos, the device should alert us. That's how we'll know it's functioning."
msgstr "Когда приманка привлечёт Думаросов и Вендиго, устройство должно подать нам сигнал. Так мы и поймём, что оно работает."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Will you test the detection device for Orsha's security?"
msgstr "Не могли бы вы протестировать устройство обнаружения для обеспечения безопасности Орши?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Deploy the bait at the detection device three times. The creatures that emerge will be dangerous - Blue Dumaros and Blue Wendigos."
msgstr "Трижды разложите приманку у устройства обнаружения. Появившиеся существа будут опасны — это Голубые Думаро и Голубые Вендиго."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Eliminate any threats that surface, then report back to me with the results."
msgstr "Устраните все возникающие угрозы, а затем доложите мне о результатах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He gestures to the glowing apparatus*{/}"
msgstr "{#666666}*Он указывает на светящееся устройство*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "This magical device was created by Orsha's war mages specifically to monitor the underground prison."
msgstr "Это волшебное устройство было создано военными магами Орши специально для наблюдения за подземной тюрьмой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "It detects movement, magical signatures, and escape attempts from the cells below. When something threatens to break free, it alerts the garrison."
msgstr "Она фиксирует движение, магические следы и попытки побега из камер, расположенных ниже. Когда что-то угрожает вырваться на свободу, она оповещает гарнизон."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Without it functioning properly, we're blind to what's happening in those depths. And that is unacceptable."
msgstr "Если она не работает должным образом, мы не имеем представления о том, что происходит в этих глубинах. А это недопустимо."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He returns to inspecting the device*{/}"
msgstr "{#666666}*Он снова приступает к осмотру устройства*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Then step aside. Orsha's defense cannot wait for the hesitant."
msgstr "Тогда отойди в сторону. Оборона Орши не будет ждать нерешительных."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He reviews notes on a tactical parchment as you approach*{/}"
msgstr "{#666666}*Когда вы подходите, он просматривает записи на тактическом пергаменте*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The device registered all three incursions. Blue Dumaros, Blue Wendigos - exactly as predicted."
msgstr "Устройство зафиксировало все три вторжения. Синие Думаросы, Синие Вендиго — всё точно так, как и предсказывали."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "More importantly, the detection alerts triggered immediately when the bait drew them near. The system is fully operational."
msgstr "Что ещё важнее, сигналы обнаружения срабатывали сразу же, как только приманка привлекала их к себе. Система находится в полной рабочей готовности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He nods with satisfaction*{/}"
msgstr "{#666666}*Он с удовлетворением кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Excellent work. You've confirmed that Orsha's early warning system for the prison remains intact."
msgstr "Отличная работа. Вы подтвердили, что система раннего оповещения в Орше, связанная с тюрьмой, по-прежнему исправна."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "This is critical intelligence for our city's defense. Here - you've earned proper compensation."
msgstr "Это чрезвычайно важная разведывательная информация для обороны нашего города. Вот — вы заслужили достойное вознаграждение."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He hands you a military-issue sword*{/}"
msgstr "{#666666}*Он протягивает тебе военный меч*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "A soldier's weapon, for someone who serves Orsha's interests well."
msgstr "Оружие солдата — для того, кто достойно служит интересам Орши."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The device has registered {0} tests so far. You need to complete all three deployment points."
msgstr "На данный момент на устройстве зарегистрировано {0} тестов. Необходимо выполнить все три этапа развертывания."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Use the bait at the detection device. Be prepared to fight whatever emerges from below."
msgstr "Используйте приманку у устройства обнаружения. Будьте готовы сразиться с тем, что появится из-под воды."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He monitors the detection device's readouts with professional vigilance*{/}"
msgstr "{#666666}*Он с профессиональной бдительностью следит за показаниями измерительного прибора*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The device continues to function perfectly. Orsha's prison remains secure. Your assistance was invaluable."
msgstr "Устройство по-прежнему работает безупречно. Тюрьма в Орше по-прежнему находится под надежной охраной. Ваша помощь оказалась неоценимой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Magical Detection Device"
msgstr "Устройство для обнаружения магии"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A complex magical apparatus hums with arcane energy, monitoring the prison depths below*{/}"
msgstr "{#666666}*Сложный магический прибор, гудящий от тайной энергии, следит за тем, что происходит в глубинах тюрьмы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*The device awaits deployment of the monster bait*{/}"
msgstr "{#666666}*Устройство ожидает установки приманки для монстра*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*You need the bait from Commander Uska to proceed*{/}"
msgstr "{#666666}*Чтобы продолжить, вам понадобится приманка от командира Уски*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*The device has completed all three detection tests. Return to Commander Uska.*{/}"
msgstr "{#666666}*Устройство прошло все три теста на обнаружение. Вернуться к командиру Уске.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Deploying monster bait..."
msgstr "Размещаем приманку для монстров..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Cancel"
msgstr "Отмена"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*The bait releases its scent. The detection device's runes flare brightly!*{/}"
msgstr "{#666666}*Приманка начинает источать запах. Руны на детекторе ярко вспыхивают!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Detection tests completed: {0}/3"
msgstr "Завершены тесты на обнаружение: {0}/3"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Creatures emerge from the prison depths!*{/}"
msgstr "{#666666}*Из глубин тюрьмы вырываются существа!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#FF6666}The device glows! Prison creatures detected!{/}"
msgstr "{#FF6666}Устройство светится! Обнаружены тюремные существа!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#FFD700}All detection tests complete! Return to Commander Uska.{/}"
msgstr "{#FFD700}Все проверки на обнаружение завершены! Вернуться к командиру Уске.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Bait deployment cancelled."
msgstr "Размещение приманки отменено."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Hermit] Lukas"
msgstr "[Отшельник] Лукас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Lukas"
msgstr "Лукас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A peaceful hermit sits cross-legged in a secluded grove, completely relaxed*{/}"
msgstr "{#666666}*Мирный отшельник сидит, скрестив ноги, в уединенной роще, полностью расслабившись*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He opens his eyes slowly as you approach, a serene smile on his face*{/}"
msgstr "{#666666}*Когда ты подходишь, он медленно открывает глаза, и на его лице играет безмятежная улыбка*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Hey there, friend. Beautiful day, isn't it?"
msgstr "Привет, друг. Прекрасный день, правда?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The rain, the quiet... it's perfect. Just perfect."
msgstr "Дождь, тишина… Просто идеально. Просто идеально."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You know, people are always rushing around. Fighting, questing, chasing rewards. But sometimes... sometimes you just need to sit. Breathe. Be."
msgstr "Знаете, люди всегда куда-то спешат. Сражаются, выполняют задания, гонятся за наградами. Но иногда… иногда просто нужно сесть. Вдохнуть. Просто быть."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "That sounds nice"
msgstr "Звучит неплохо"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "What brought you here?"
msgstr "Что привело вас сюда?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "How do you find inner peace?"
msgstr "Как обрести внутренний покой?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Any advice for staying calm?"
msgstr "Есть ли какие-нибудь советы, как сохранять спокойствие?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I should go"
msgstr "Мне пора"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*His smile widens*{/}"
msgstr "{#666666}*Его улыбка становится шире*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Right? Just... nice."
msgstr "Правда? Просто... мило."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "You want to join me? No agenda, no tasks. Just sit here with me for a bit."
msgstr "Хочешь присоединиться ко мне? Никаких планов, никаких дел. Просто посиди со мной немного."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Listen to the rain. Feel the positive energy of this grove. Let yourself relax."
msgstr "Прислушайтесь к дождю. Почувствуйте положительную энергию этой рощи. Позвольте себе расслабиться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Want to sit with me for a moment?"
msgstr "Не хочешь немного посидеть со мной?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Awesome. Just come back and talk to me when you're ready."
msgstr "Здорово. Просто вернись и поговори со мной, когда будешь готов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "No rush. Take your time."
msgstr "Не торопись. Не спеши."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He gazes peacefully at the rain*{/}"
msgstr "{#666666}*Он спокойно смотрит на дождь*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "After the war... I just couldn't do it anymore. The fighting, the stress."
msgstr "После войны... Я просто не мог больше так жить. Бои, стресс."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I needed to find balance. Inner peace. Positive energy."
msgstr "Мне нужно было обрести равновесие. Внутренний покой. Позитивную энергию."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "So I came here. This grove accepted me. Taught me to slow down."
msgstr "И вот я оказался здесь. Эта роща приняла меня. Научила меня не торопиться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Best decision I ever made."
msgstr "Лучшее решение, которое я когда-либо принимал."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He closes his eyes for a moment, breathing deeply*{/}"
msgstr "{#666666}*Он на мгновение закрывает глаза и глубоко вздыхает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Inner peace isn't something you find. It's something you allow."
msgstr "Внутренний покой — это не то, что нужно искать. Это то, чему нужно дать волю."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "We spend so much time fighting - fighting monsters, fighting fate, fighting ourselves."
msgstr "Мы тратим столько времени на борьбу — борьбу с монстрами, с судьбой, с самими собой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "But peace? Peace comes when you stop fighting. When you accept the moment as it is."
msgstr "А что же мир? Мир наступает, когда перестаёшь бороться. Когда принимаешь момент таким, каким он есть."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The rain falls. I don't fight it. I don't wish for sunshine. I just... let it be rain."
msgstr "Идет дождь. Я не сопротивляюсь ему. Я не мечтаю о солнце. Я просто… позволяю дождю идти."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "That's the secret, friend. Stop resisting what is. Just be present."
msgstr "Вот в чём секрет, друг мой. Перестань сопротивляться тому, что есть. Просто живи настоящим моментом."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He gestures to the grove around him*{/}"
msgstr "{#666666}*Он указывает на рощу вокруг себя*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Nature is the best teacher. Watch the trees - they don't stress about tomorrow's weather."
msgstr "Природа — лучший учитель. Посмотрите на деревья — они не переживают из-за того, какая будет погода завтра."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Listen to the rain - it doesn't hurry, doesn't force. It just flows."
msgstr "Прислушайтесь к дождю — он не торопится, не навязывается. Он просто льётся."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "When you feel overwhelmed, find a quiet spot. Sit down. Close your eyes."
msgstr "Когда вам становится тяжело, найдите тихое место. Сядьте. Закройте глаза."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Breathe in for four counts. Hold for four. Breathe out for four. Hold for four."
msgstr "Вдохните, считая до четырёх. Задержите дыхание на четыре. Выдохните, считая до четырёх. Задержите дыхание на четыре."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Do that a few times. Feel your heartbeat slow. Your mind clear."
msgstr "Повторите это несколько раз. Почувствуйте, как замедляется сердцебиение. Как проясняется сознание."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He smiles warmly*{/}"
msgstr "{#666666}*Он тепло улыбается*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "It's simple, but simple works. The world makes things complicated. Peace is simple."
msgstr "Это просто, но простота — залог успеха. Мир всё усложняет. Мир же прост."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He nods peacefully*{/}"
msgstr "{#666666}*Он спокойно кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "All good. May your path be peaceful, friend."
msgstr "Всё в порядке. Пусть твой путь будет мирным, друг."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He opens his eyes as you approach, smiling warmly*{/}"
msgstr "{#666666}*Он открывает глаза, когда ты подходишь, и тепло улыбается*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Hey there. How did it feel?"
msgstr "Привет. Какие ощущения?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Did you find your inner peace moment?"
msgstr "Вы нашли свой момент внутреннего покоя?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He doesn't wait for an answer, just nods knowingly*{/}"
msgstr "{#666666}*Он не дожидается ответа, а просто многозначительно кивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "I can see it in your eyes. You get it now."
msgstr "Я вижу это в твоих глазах. Теперь ты всё понял."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "That's all it takes - just a moment of being present. Of letting go."
msgstr "Вот и всё — достаточно всего лишь на мгновение сосредоточиться на настоящем. Отпустить всё."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He hands you something with a gentle smile*{/}"
msgstr "{#666666}*Он с мягкой улыбкой протягивает тебе что-то*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Thanks for sharing this time with me, friend. You're always welcome back here."
msgstr "Спасибо, что провел это время со мной, друг. Ты всегда можешь заглянуть сюда снова."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*He's returned to his meditation, completely at peace*{/}"
msgstr "{#666666}*Он снова погрузился в медитацию, полностью умиротворённый*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Welcome back. The grove is always open to you."
msgstr "С возвращением. Роща всегда открыта для вас."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Log Pile"
msgstr "Дровяная куча"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A stack of freshly cut timber logs*{/}"
msgstr "{#666666}*Стопка свежесрубленных бревен*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*You've already examined this log pile*{/}"
msgstr "{#666666}*Вы уже осмотрели эту кучу бревен*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Examining log pile..."
msgstr "Изучение штабеля бревен..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*You notice deep drag marks in the muddy ground leading away from the pile*{/}"
msgstr "{#666666}*Вы замечаете глубокие следы волочения на грязной земле, уходящие от кучи*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*The marks suggest something heavy was pulled, not carried*{/}"
msgstr "{#666666}*По следам видно, что что-то тяжёлое тянули, а не несли*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Fresh scratches mark the sides of several logs*{/}"
msgstr "{#666666}*На боках нескольких бревен видны свежие царапины*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*The scratches look almost like... claw marks? But oddly plant-like*{/}"
msgstr "{#666666}*Царапины выглядят почти как… следы когтей? Но, как ни странно, напоминают растения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Scattered wood chips and sawdust form a trail leading into the forest*{/}"
msgstr "{#666666}*Разбросанные щепа и опилки образуют тропу, ведущую в лес*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*You notice some broken twigs and disturbed vegetation nearby*{/}"
msgstr "{#666666}*Вы замечаете рядом несколько сломанных веточек и потревоженную растительность*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Log piles examined: {0}/3"
msgstr "Проверенные штабеля бревен: {0}/3"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*Suddenly, three Woodin emerge from the forest, clutching pieces of timber!*{/}"
msgstr "{#666666}*Внезапно из леса выходят трое Вудинов, сжимая в руках куски бревен!*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#FF6666}Woodin caught stealing timber!{/}"
msgstr "{#FF6666}Вудина поймали на краже древесины!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Examination cancelled."
msgstr "Экзамен отменен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Blooming Moonlight Flower"
msgstr "Цветущий лунный цветок"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A delicate silver-white flower blooms in the rain*{/}"
msgstr "{#666666}*Нежный серебристо-белый цветок расцветает под дождём*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*You've already collected a flower from this spot*{/}"
msgstr "{#666666}*Вы уже собрали цветок в этом месте*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Carefully harvesting Moonlight Flower..."
msgstr "Осторожный сбор «Лунного цветка»..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Harvested: Moonlight Flower"
msgstr "Собранный: «Лунный цветок»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Moonlight Flowers collected: {0}/5"
msgstr "Собранные «Лунные цветы»: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#FFD700}All Moonlight Flowers collected! Return to Herbalist Ruta.{/}"
msgstr "{#FFD700}Все «Лунные цветы» собраны! Вернитесь к травнице Руте.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Harvest cancelled."
msgstr "Уборка урожая отменена."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Purification Crystal"
msgstr "Очищающий кристалл"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*A purification crystal hums with faint magical energy*{/}"
msgstr "{#666666}*Кристалл очищения тихо гудит, излучая слабую магическую энергию*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*You've already inspected this purification crystal*{/}"
msgstr "{#666666}*Вы уже осмотрели этот кристалл очищения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Inspecting purification crystal..."
msgstr "Проверка очищающего кристалла..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "{#666666}*The crystal pulses softly - showing only mild traces of corruption*{/}"
msgstr "{#666666}*Кристалл мягко пульсирует — на нём видны лишь едва заметные следы повреждения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Purification Crystal {0} inspected: mild corruption traces"
msgstr "Проверен кристалл очищения {0}: обнаружены незначительные следы порчи"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Purification crystals inspected: {0}/3"
msgstr "Проверенные кристаллы для очистки: {0}/3"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "All crystals inspected. Return to Scout Daina."
msgstr "Все кристаллы проверены. Вернуться к разведчице Дайне."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Inspection cancelled."
msgstr "Проверка отменена."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Crossing Guard Duty"
msgstr "Дежурство по обеспечению безопасности переходов"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Help Guard Borin clear aggressive Popolions from the Uninhabited Crossing so he can properly watch for threats."
msgstr "Помогите стражнику Борину избавиться от агрессивных пополионов на «Необитаемом переходе», чтобы он мог должным образом следить за угрозами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Guard] Borin"
msgstr "[Страж] Борин"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Clear Popolion from the crossing"
msgstr "Уберите Пополиона с перекрестка"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "The Timber Thief Mystery"
msgstr "Тайна «Дровокрада»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Investigate who or what is stealing timber from Lumberjack Kaspar's work area by examining log piles, then deal with the culprits."
msgstr "Расследуйте, кто или что крадёт древесину с рабочей площадки лесоруба Каспара, осмотрев штабеля бревен, а затем разберитесь с виновными."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Lumberjack] Kaspar"
msgstr "[Лесоруб] Каспар"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Examine the three log piles for clues"
msgstr "Осмотрите три кучи бревен в поисках улик"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Hunt Woodin"
msgstr "Хант Вудин"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Herbal Rain Harvest"
msgstr "«Травяной дождь»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Help Herbalist Ruta gather rare Moonlight Flowers that bloom during Paupys Crossing's endless rain."
msgstr "Помогите травнице Руте собрать редкие «Лунные цветы», которые распускаются во время бесконечного дождя в Паупис-Кроссинг."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Herbalist] Ruta"
msgstr "[Травник] Рута"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Gather Moonlight Flowers from five locations"
msgstr "Соберите «Цветы лунного света» в пяти местах"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Corruption Watch"
msgstr "Наблюдение за коррупцией"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Help Scout Daina inspect the three purification crystals at Deer Hooves Lot to check for traces of corruption from Koru Jungle."
msgstr "Помогите разведчице Дайне осмотреть три кристалла очищения на участке «Оленьи копыта», чтобы проверить их на наличие следов порчи из джунглей Кору."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Scout] Daina"
msgstr "[Разведчица] Дайна"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Inspect three purification crystals at Deer Hooves Lot"
msgstr "Осмотрите три кристалла очищения на участке «Оленьи копыта»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Clear Popolion"
msgstr "Прозрачный Пополион"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Clear Hanaming"
msgstr "Очистить Ханаминг"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Detection Device Test"
msgstr "Испытание устройств обнаружения"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Help Commander Uska test the magical detection device that monitors threats from Ashaq Underground Prison by deploying monster bait to attract prison creatures."
msgstr "Помогите командиру Уске протестировать магическое устройство обнаружения, которое отслеживает угрозы, исходящие из подземной тюрьмы Ашак, — для этого нужно разложить приманку для монстров, чтобы привлечь существ из тюрьмы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Commander] Uska"
msgstr "[Командир] Уска"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Deploy monster bait at the detection device three times"
msgstr "Трижды разместите приманку для монстров у устройства обнаружения"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "A Moment of Peace"
msgstr "Миг покоя"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Join Hermit Lukas for a peaceful moment of meditation and relaxation in his secluded grove."
msgstr "Присоединяйтесь к отшельнику Лукасу, чтобы провести минуту умиротворения, медитации и расслабления в его уединенной роще."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "[Hermit] Lukas"
msgstr "[Отшельник] Лукас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_siauliai_11_re_quests.cs
msgid "Sit peacefully with Lukas"
msgstr "Посиди в тишине с Лукасом"

# ============================================================================
# Ramstis Ridge Quests (f_rokas_25_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Wanderer] Peregrin Lyon"
msgstr "[Странник] Перегрин Лион"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Peregrin Lyon"
msgstr "Перегрин Лион"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*A solitary figure stands at the mountain's peak, gazing out at the horizon*{/}"
msgstr "{#666666}*На вершине горы стоит одинокая фигура, вглядываясь в горизонт*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Ah, a visitor. I come here often to appreciate the view and the peace."
msgstr "А, гость. Я часто прихожу сюда, чтобы насладиться видом и тишиной."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "After the chaos of war, I find solace in places like this. High above the world, where the air is clear and the silence profound."
msgstr "После хаоса войны я нахожу утешение в таких местах, как это. Высоко над миром, где воздух чист, а тишина безгранична."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "What brings you to this mountain?"
msgstr "Что привело вас на эту гору?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Tell me about yourself"
msgstr "Расскажите мне о себе"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "What happened during the war?"
msgstr "Что произошло во время войны?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'll leave you to your thoughts"
msgstr "Я оставлю вас наедине с вашими мыслями"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'm just a wanderer now. During the war, I was... involved. Let's leave it at that."
msgstr "Сейчас я просто странник. Во время войны я... был вовлечён в это. Давай оставим это как есть."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "When it ended, I couldn't go back to the cities. Too much noise, too many memories."
msgstr "Когда всё закончилось, я не смог вернуться в города. Слишком много шума, слишком много воспоминаний."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "So I travel to places like this - mountaintops, quiet forests, anywhere I can find peace."
msgstr "Вот почему я путешествую по таким местам — вершинам гор, тихим лесам, везде, где можно обрести покой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Here, atop this mountain, I can breathe again."
msgstr "Здесь, на вершине этой горы, я снова могу дышать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*His expression darkens briefly*{/}"
msgstr "{#666666}*Его лицо на мгновение омрачилось*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The war taught me many things. Mostly, it taught me the value of silence and solitude."
msgstr "Война многому меня научила. Прежде всего она научила меня ценить тишину и уединение."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "When you've seen enough chaos, peace becomes sacred. This mountain gives me that."
msgstr "Когда ты насытился хаосом, покой становится чем-то священным. Эта гора дарит мне именно это."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Safe travels, friend. May you find your own peace."
msgstr "Счастливого пути, друг. Пусть ты обретешь свой внутренний покой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "My testimony is recorded. Share it with the Grand Archive."
msgstr "Мое свидетельство зафиксировано. Отправьте его в Главный архив."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Perhaps others will understand why peace is so precious."
msgstr "Возможно, другие поймут, почему мир так ценен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You need a recording crystal to preserve my testimony."
msgstr "Вам понадобится записывающий кристалл, чтобы сохранить мои показания."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You're documenting the war? I suppose someone should remember what happened."
msgstr "Вы ведёте документацию о войне? Наверное, кому-то нужно запомнить, что произошло."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Would you like to hear my perspective as someone who sought peace after the chaos?"
msgstr "Хотите узнать мою точку зрения как человека, который искал покой после хаоса?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*Peregrin speaks quietly into the recording crystal, his voice reflective*{/}"
msgstr "{#666666}*Перегрин тихо говорит в записывающий кристалл, в его голосе слышится задумчивость*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "'I am Peregrin Lyon, a wanderer. The war took everything familiar and turned it into chaos.'"
msgstr "«Я — Перегрин Лион, странник. Война отняла у меня всё привычное и превратила всё в хаос»."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "'I fought, I survived, but I couldn't return to normal life. The noise, the crowds - it was all too much.'"
msgstr "«Я боролась, я выжила, но не смогла вернуться к нормальной жизни. Шум, толпы людей — это было для меня невыносимо»."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "'So I sought places like this. Mountaintops where the world is quiet, where I can appreciate what we still have.'"
msgstr "«Поэтому я искал такие места. Вершины гор, где вокруг царит тишина, где я могу по-настоящему оценить то, что у нас ещё осталось»."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "'Peace. Silence. The view from high above. These are what I fought for, even if I didn't know it then.'"
msgstr "«Мир. Тишина. Вид с высоты. Именно за это я боролся, хотя тогда и не подозревал об этом»."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#FFD700}All testimonies collected! Return to Grand Archivist Elwen in Fedimian.{/}"
msgstr "{#FFD700}Все свидетельства собраны! Вернитесь к главному архивариусу Элвену в Федимиане.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I understand. The view will be here when you're ready."
msgstr "Понятно. Вид будет здесь, когда вы будете готовы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Thank you for preserving our stories. Maybe future generations will cherish peace as I do."
msgstr "Спасибо за то, что сохраняете наши истории. Возможно, будущие поколения будут так же дорожить миром, как и я."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He returns to gazing at the horizon*{/}"
msgstr "{#666666}*Он снова устремляет взгляд на горизонт*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Researcher] Marcus"
msgstr "[Исследователь] Маркус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Marcus"
msgstr "Маркус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Greetings, traveler. I'm from Fedimian, here to study the local wildlife."
msgstr "Привет, путешественник. Я из Федимиана, приехал сюда изучать местную дикую природу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He glances at the desert landscape*{/}"
msgstr "{#666666}*Он бросает взгляд на пустынный пейзаж*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "These chupacabras are fascinating creatures. Fox-like, docile... yet the old records claim they were once vicious monsters."
msgstr "Эти чупакабры — удивительные существа. Похожи на лис, кроткий нрав… и все же, судя по старинным записям, когда-то они были свирепыми чудовищами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "How can I help?"
msgstr "Чем я могу помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "What changed them?"
msgstr "Что их изменило?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'm not interested"
msgstr "Мне это неинтересно"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You're willing to help? Excellent! I need empirical data on their current hostility levels."
msgstr "Вы готовы помочь? Отлично! Мне нужны эмпирические данные об их текущем уровне враждебности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I understand that Felix, a colleague of mine, is... well, he's hiding behind that pillar over there. Still terrified of the old stories."
msgstr "Насколько я понимаю, Феликс, мой коллега, сейчас… ну, он прячется за той колонной. До сих пор боится старых легенд."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "He thinks they're dangerous, but I've observed them for weeks. They're harmless now!"
msgstr "Он считает, что они опасны, но я наблюдал за ними несколько недель. Сейчас они совершенно безобидны!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Would you help me prove this scientifically? I need you to engage with some chupacabras and document their behavior."
msgstr "Не могли бы вы помочь мне доказать это с научной точки зрения? Мне нужно, чтобы вы пообщались с несколькими чупакабрами и зафиксировали их поведение."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Perfect! Engage with a few desert chupacabras. Observe their reactions, their threat level."
msgstr "Отлично! Вступите в контакт с несколькими пустынными чупакабрами. Понаблюдайте за их реакциями и оцените степень угрозы, которую они представляют."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "It's unfortunate, but the only way to truly test hostility is through direct confrontation. Return when you have sufficient data."
msgstr "К сожалению, единственный способ по-настоящему проверить враждебность — это прямая конфронтация. Вернитесь, когда у вас будет достаточно данных."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "That's the mystery, isn't it? The demon war changed many things."
msgstr "В этом-то и заключается загадка, не так ли? Война с демонами многое изменила."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Perhaps the demonic influence that once corrupted them has faded. Or perhaps they've simply adapted to a peaceful world."
msgstr "Возможно, демоническое влияние, которое когда-то развратило их, ослабло. А может быть, они просто приспособились к мирной жизни."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Without proper research, we're just speculating. That's why I need data."
msgstr "Без надлежащего исследования мы лишь строим догадки. Вот почему мне нужны данные."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Safe travels then. Watch your step in the desert."
msgstr "Тогда удачного путешествия. Будьте осторожны в пустыне."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You've returned! Tell me - did they attack unprovoked? Display aggression?"
msgstr "Ты вернулся! Скажи мне — они напали без всякой причины? Проявили агрессию?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He listens intently to your report*{/}"
msgstr "{#666666}*Он внимательно слушает ваш отчет*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Interesting! They defend themselves when attacked, but show no predatory behavior. Just as I theorized!"
msgstr "Интересно! Они защищаются, когда на них нападают, но не проявляют хищнического поведения. Именно так я и предполагал!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "This data is invaluable. The old stories painted them as bloodthirsty beasts, but they're simply... creatures trying to survive."
msgstr "Эти данные имеют неоценимое значение. В старых рассказах их изображали как кровожадных чудовищ, но на самом деле это просто… существа, пытающиеся выжить."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Perhaps someone should tell Felix he can stop hiding now. Here, you've earned this for your assistance."
msgstr "Наверное, кому-нибудь стоит сказать Феликсу, что ему уже можно перестать прятаться. Вот, ты заслужил это за свою помощь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Still gathering data? Remember - I need observations from encounters with the desert chupacabras."
msgstr "Все еще собираете данные? Не забудьте — мне нужны сведения о встречах с пустынным чупакаброй."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Return when you have sufficient behavioral documentation."
msgstr "Вернитесь, когда у вас будет достаточно данных о поведении."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Your research was quite helpful! I'm compiling my findings for the Fedimian archives."
msgstr "Ваше исследование оказалось весьма полезным! Я собираю полученные данные для архива Федимиана."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Hopefully this will put old superstitions to rest. Well, once Felix stops hiding, at least."
msgstr "Надеюсь, это положит конец старым суевериям. Ну, по крайней мере, как только Феликс перестанет прятаться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Botanist] Elena"
msgstr "[Ботаник] Елена"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Elena"
msgstr "Елена"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*A woman stands carefully back from the cliff edge, studying plants in her journal*{/}"
msgstr "{#666666}*Женщина осторожно отступает от края обрыва и делает записи о растениях в свой дневник*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Well, well! Someone who can navigate those platforms!"
msgstr "Ну-ну! Вот кто-то, кто умеет ориентироваться на этих платформах!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Most people take one look at the jumping required and turn right back around."
msgstr "Большинство людей, увидев, какие прыжки для этого требуются, сразу же разворачиваются и уходят."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'm actually looking for someone acrobatic like you."
msgstr "На самом деле я ищу кого-то такого же ловкого, как ты."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "What do you need?"
msgstr "Что вам нужно?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "How did you get up here?"
msgstr "Как ты сюда забрался?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I should get going"
msgstr "Мне пора"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You see, I'm a botanist studying cliff-dwelling flora. The plants up here are unique!"
msgstr "Понимаете, я ботаник и изучаю флору, произрастающую на скалах. Растения здесь просто уникальны!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "There are specimens growing on precarious ledges near the cliff edge."
msgstr "Некоторые экземпляры растут на неустойчивых уступах у самого края обрыва."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*She points to various rocky outcroppings in the distance, careful not to look down*{/}"
msgstr "{#666666}*Она указывает на различные скалистые выступы вдали, стараясь не смотреть вниз*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'm... well, I'm a bit afraid of heights, actually. Ironic, isn't it?"
msgstr "Я... ну, на самом деле я немного боюсь высоты. Иронично, не правда ли?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Would you mind collecting some cliff blossoms for me? You clearly have the skills for it."
msgstr "Не мог бы ты собрать для меня немного цветов с утеса? У тебя, судя по всему, есть для этого все необходимые навыки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Wonderful! Look for the distinctive blue flowers growing from crevices in high places."
msgstr "Замечательно! Обратите внимание на характерные голубые цветы, растущие в щелях на возвышенностях."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "They're called Dzida Blossoms. I need six specimens for my research."
msgstr "Они называются «Цветы Дзиды». Мне нужно шесть экземпляров для моего исследования."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Be careful out there - one wrong step and... well, you know."
msgstr "Будьте осторожны — один неверный шаг, и… ну, вы сами понимаете."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*She laughs nervously*{/}"
msgstr "{#666666}*Она нервно смеётся*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Very, very carefully. And with my eyes half-closed most of the time."
msgstr "Очень, очень осторожно. И при этом большую часть времени с полузакрытыми глазами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The view is magnificent, but I try not to look down too often!"
msgstr "Вид просто великолепный, но я стараюсь не смотреть вниз слишком часто!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Safe climbing! Watch your footing out there."
msgstr "Удачного восхождения! Будьте осторожны, смотрите под ноги."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You found them! And you're still in one piece!"
msgstr "Ты их нашёл! И при этом остался целым и невредимым!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*She carefully examines the blossoms*{/}"
msgstr "{#666666}*Она внимательно рассматривает цветы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Perfect specimens! The altitude and mineral-rich rocks give them unique properties."
msgstr "Превосходные экземпляры! Высокогорные условия и богатые минералами породы придают им уникальные свойства."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "These will be invaluable for my research. Thank you for risking life and limb!"
msgstr "Они будут неоценимы для моих исследований. Спасибо, что рисковали жизнью и здоровьем!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Still searching for the Dzida Blossoms? They grow in rocky crevices at high elevations."
msgstr "Все еще ищете цветы дзида? Они растут в скальных расщелинах на больших высотах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I need six total. Be careful on those ledges!"
msgstr "Мне нужно шесть штук всего. Будьте осторожны на этих уступах!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Thanks again for the specimens! My research paper is coming along nicely."
msgstr "Еще раз спасибо за образцы! Моя научная работа продвигается неплохо."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*She's carefully pressing flowers in a journal*{/}"
msgstr "{#666666}*Она аккуратно засушивает цветы в дневнике*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Dzida Blossom"
msgstr "Цветок Дзида"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*Blue flowers grow near the cliff edge*{/}"
msgstr "{#666666}*У края обрыва растут голубые цветы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*You already collected this blossom*{/}"
msgstr "{#666666}*Вы уже собрали этот цветок*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Carefully harvesting cliff blossom..."
msgstr "Аккуратный сбор цветов скального дерева..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Cancel"
msgstr "Отмена"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Found: Blue Fragaras Petal"
msgstr "Найден: Синий лепесток Фрагараса"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#FFD700}All petals collected! Return to Elena.{/}"
msgstr "{#FFD700}Все лепестки собраны! Вернись к Елене.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Archivist] Tobias"
msgstr "[Архивариус] Тобиас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Tobias"
msgstr "Тобиас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*An elderly scholar kneels beside shattered stone monuments, sketching in a journal*{/}"
msgstr "{#666666}*Пожилой ученый стоит на коленях рядом с разбитыми каменными памятниками и делает наброски в дневнике*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "These magnificent monuments... reduced to rubble by the war."
msgstr "Эти великолепные памятники... превращенные войной в руины."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "They once told the history of this region. Treaties, battles, important figures... all carved in stone."
msgstr "Когда-то здесь рассказывали об истории этого края. Договоры, сражения, выдающиеся личности… — всё это было высечено на камне."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Now they're just broken memories."
msgstr "Теперь это всего лишь обрывки воспоминаний."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Can they be restored?"
msgstr "Их можно восстановить?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "What did they commemorate?"
msgstr "Что они отмечали?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'll leave you to your work"
msgstr "Я оставлю вас заниматься вашей работой"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Physically? No, the damage is too severe. But their knowledge can be preserved!"
msgstr "Физически? Нет, повреждения слишком серьезные. Но их знания можно сохранить!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The Fedimian Grand Archive is compiling records of everything lost in the war."
msgstr "«Великий архив Федимиана» ведёт учет всего, что было утрачено во время войны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He shows you rubbings of partial inscriptions*{/}"
msgstr "{#666666}*Он показывает вам оттиски фрагментов надписей*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "These fragments are scattered across the area. Each piece holds part of our history."
msgstr "Эти обломки разбросаны по всей территории. Каждый из них хранит часть нашей истории."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Would you help me collect stone fragments with readable inscriptions? We can't let this knowledge die."
msgstr "Не могли бы вы помочь мне собрать каменные обломки с разборчивыми надписями? Мы не можем допустить, чтобы эти знания были утрачены."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Bless you! Look for monument pieces - they'll have carved text or symbols."
msgstr "Будьте здоровы! Ищите фрагменты памятников — на них будут вырезаны надписи или символы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I need fragments from at least five different monuments to piece together the full record."
msgstr "Мне нужны фрагменты как минимум из пяти разных памятников, чтобы восстановить полную картину."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Some pieces are small, others partially buried. Check the ground carefully."
msgstr "Некоторые предметы небольшие, другие частично зарыты. Внимательно осмотрите землю."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "This was once called the Ridge of Heroes. Monuments honored those who defended Fedimian."
msgstr "Когда-то это место называли «Хребтом героев». Памятники были воздвигнуты в честь тех, кто защищал Федимиан."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "There were victory columns, peace treaties carved in archways, names of the fallen..."
msgstr "Там были триумфальные колонны, мирные договоры, высеченные на арках, имена павших..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*His voice becomes bitter*{/}"
msgstr "{#666666}*В его голосе слышится горечь*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The demons cared nothing for history. They smashed it all."
msgstr "Демоны не обращали никакого внимания на историю. Они всё разгромили."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Every day more weathering erodes what remains. Time is not on our side."
msgstr "С каждым днём оставшиеся фрагменты всё больше подвергаются воздействию атмосферных явлений. Время не на нашей стороне."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You've found them! Let me see..."
msgstr "Ты их нашёл! Дай-ка посмотрю..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He carefully examines each stone fragment*{/}"
msgstr "{#666666}*Он внимательно осматривает каждый осколок камня*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "'...treaty signed in the year...' Yes! And this one mentions Captain Valdris!"
msgstr "«...договор, подписанный в... году...» Да! И в этом упоминается капитан Валдрис!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "This fragment shows part of the victory column's base inscription..."
msgstr "На этом фрагменте видна часть надписи на постаменте победной колонны..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "With these, I can reconstruct significant portions of what was lost. The Archive will be so pleased!"
msgstr "Благодаря им я смогу восстановить значительную часть того, что было утрачено. В Архиве будут просто в восторге!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You've helped preserve history itself. Thank you, truly."
msgstr "Вы помогли сохранить саму историю. Спасибо вам, от всей души."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Still searching for monument fragments? They're scattered around this area."
msgstr "Все еще ищете обломки памятника? Они разбросаны по всей этой местности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Look for pieces of carved stone - they'll have inscriptions or symbols on them."
msgstr "Ищите куски высеченного камня — на них будут надписи или символы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I'm preparing a full report for the Grand Archive based on your findings."
msgstr "Я готовлю полный отчет для Главного архива на основе ваших выводов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "These heroes won't be forgotten. Not while we preserve their stories."
msgstr "Этих героев не забудут. Пока мы сохраняем их истории."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Broken Pillar"
msgstr "Сломанный столб"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*A piece of carved stone lies partially buried in the dirt*{/}"
msgstr "{#666666}*Кусок резного камня частично зарыт в земле*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*You already collected this fragment*{/}"
msgstr "{#666666}*Вы уже собрали этот фрагмент*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#FF6666}The ground trembles as corrupted creatures emerge!{/}"
msgstr "{#FF6666}Земля дрожит, когда появляются извращённые существа!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Carefully extracting monument fragment..."
msgstr "Осторожно извлекаем фрагмент памятника..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Found: Monument Fragment"
msgstr "Найден: фрагмент памятника"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#FFD700}All fragments collected! Return to Archivist Tobias.{/}"
msgstr "{#FFD700}Все фрагменты собраны! Вернитесь к архивариусу Тобиасу.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Paladin] Cyril"
msgstr "[Паладин] Кирилл"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Cyril"
msgstr "Кирилл"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*A Fedimian paladin stands pressed against the rocky cliff face, carefully inspecting every crack and crevice*{/}"
msgstr "{#666666}*Федимский паладин прижался к скалистому утесу и внимательно осматривает каждую трещину и щель*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "This wall... I've been examining it for days, searching for any trace of the sanctum's relics."
msgstr "Эта стена... Я уже несколько дней изучаю её, пытаясь найти хоть какой-нибудь след реликвий святилища."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He runs his hand along the rough stone, checking for anything embedded in the rock*{/}"
msgstr "{#666666}*Он проводит рукой по шероховатой поверхности камня, проверяя, не застряло ли в нём что-нибудь*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "When the Sanctum of the Eternal Light collapsed, debris scattered everywhere. Some relics may have been buried here in the rockslide."
msgstr "Когда обрушилось Святилище Вечного Света, обломки разлетелись повсюду. Некоторые реликвии, возможно, оказались погребены здесь под обвалом."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I haven't found anything in this wall yet, but the ruins behind me still need to be searched."
msgstr "Я пока ничего не нашел в этой стене, но руины позади меня ещё предстоит обыскать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "What made it special?"
msgstr "Чем это было особенным?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I should let you continue your watch"
msgstr "Я должен позволить вам продолжить дежурство"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The sanctum can never be rebuilt. But perhaps its memory can be honored."
msgstr "Святилище уже никогда не удастся восстановить. Но, возможно, можно почтить его память."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Zinutes - stone-like scorpions, dangerous but docile - have made the ruins their home."
msgstr "Зинуты — похожие на камни скорпионы, опасные, но покладистые — обитают в этих руинах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He gestures toward the collapsed walls*{/}"
msgstr "{#666666}*Он указывает на обрушившиеся стены*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "They don't attack unprovoked, but their presence prevents pilgrims from visiting. We need to clear them out."
msgstr "Они не нападают без причины, но их присутствие мешает паломникам посещать это место. Нам нужно избавиться от них."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "And if you find any holy relics among the rubble, bring them to me. We can at least preserve what remains."
msgstr "И если найдёте среди обломков какие-нибудь святые реликвии, принесите их ко мне. Мы сможем хотя бы сохранить то, что осталось."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Will you help restore access to this sacred place?"
msgstr "Поможете ли вы восстановить доступ к этому священному месту?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "May the goddesses protect you. The Zinutes are territorial - they'll defend themselves if threatened."
msgstr "Пусть богини оберегут тебя. Зинуты очень территориальны — при угрозе они будут защищаться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "As you search the ruins, look for sacred items scattered among the debris."
msgstr "Исследуя руины, ищите священные предметы, разбросанные среди обломков."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The shrines are shattered, but some relics may still be intact. Gather what you can find."
msgstr "Святилища разрушены, но некоторые реликвии, возможно, сохранились. Соберите всё, что сможете найти."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The Sanctum was built three hundred years ago, after a great plague."
msgstr "Санктум был построен триста лет назад, после великой чумы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Fedimian citizens came here to pray for healing, for protection, for lost loved ones."
msgstr "Жители Федимиана приезжали сюда, чтобы помолиться о исцелении, о защите и о потерянных близких."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*His expression becomes solemn*{/}"
msgstr "{#666666}*Его лицо принимает торжественное выражение*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "I trained here as a young squire. The Order of the Eternal Light once called this place home."
msgstr "В юности я проходил здесь обучение в качестве оруженосца. Когда-то это место было резиденцией Ордена Вечного Света."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "That order is gone now, scattered by the war. But I still honor their memory by standing watch."
msgstr "Теперь этого порядка уже нет — его разрушила война. Но я по-прежнему чту их память, неслая вахту."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He nods and returns to his vigil*{/}"
msgstr "{#666666}*Он кивает и возвращается к своему дежурству*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "May the goddesses watch over you."
msgstr "Пусть богини хранят тебя."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You've returned! The Zinutes have retreated, and the ruins are accessible once more."
msgstr "Ты вернулся! Зинуты отступили, и к руинам снова открыт доступ."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He carefully receives the sacred items*{/}"
msgstr "{#666666}*Он бережно принимает священные предметы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "These prayer beads belonged to a pilgrim from Orsha. This offering bowl was blessed by the high priest."
msgstr "Эти четки принадлежали паломнику из Орши. Эта чаша для пожертвований была освящена первосвященником."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Each piece holds memories of faith and devotion."
msgstr "Каждое изделие хранит в себе воспоминания о вере и преданности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*He holds the items with reverence*{/}"
msgstr "{#666666}*Он бережно держит эти предметы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Thank you. The Sanctum may be gone, but its spirit lives on through these remnants."
msgstr "Спасибо. «Санктум» может и исчез, но его дух продолжает жить в этих остатках."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "You've honored the memory of those who served here. The Order would be grateful."
msgstr "Вы почтили память тех, кто служил здесь. Орден будет вам благодарен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Clear the Zinutes from the sanctum ruins. "
msgstr "Очистите руины святилища от Зинутов. "

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Search the shattered shrines for sacred relics. "
msgstr "Обыщите разрушенные святилища в поисках священных реликвий. "

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Every step brings us closer to honoring what was lost."
msgstr "Каждый шаг приближает нас к тому, чтобы почтить память о том, что было утрачено."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "The sanctum's relics are now safely preserved in Fedimian's Grand Archive."
msgstr "Реликвии святилища в настоящее время надежно хранятся в Великом архиве Федимиана."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Future generations will know what stood here. Thank you, friend."
msgstr "Будущие поколения узнают, что здесь когда-то стояло. Спасибо, друг."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Shattered Shrine"
msgstr "Разрушенное святилище"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*The remains of a small shrine lie scattered among the rubble*{/}"
msgstr "{#666666}*Остатки небольшого святилища разбросаны среди обломков*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#666666}*You already searched this shrine*{/}"
msgstr "{#666666}*Вы уже искали этот храм*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Searching through shrine rubble..."
msgstr "Прочесывая завалы храма..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Found: Sacred Relic"
msgstr "Найден: священная реликвия"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "{#FFD700}All relics collected! Return to Paladin Cyril.{/}"
msgstr "{#FFD700}Все реликвии собраны! Вернитесь к паладину Кирилу.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Search cancelled."
msgstr "Поиск отменен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Desert Mysteries"
msgstr "Тайны пустыни"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Help Marcus gather data on chupacabra behavior to prove they are no longer dangerous."
msgstr "Помогите Маркусу собрать данные о поведении чупакабры, чтобы доказать, что они больше не представляют опасности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Gather behavioral data from Desert Chupacabras"
msgstr "Сбор данных о поведении пустынных чупакабр"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Heights of Dzida"
msgstr "Высоты Дзиды"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Help Elena collect rare cliff blossoms from dangerous heights around the Dzida cliffs."
msgstr "Помогите Елене собрать редкие скальные цветы на опасных высотах вокруг утесов Дзида."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Collect Blue Fragaras Petals from cliff blossoms"
msgstr "Соберите синие лепестки Фрагараса с цветущих растений на утесе"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Echoes in Stone"
msgstr "«Отголоски в камне»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Help Archivist Tobias collect monument fragments to preserve the history destroyed during the war."
msgstr "Помогите архивариусу Тобиасу собрать фрагменты памятников, чтобы сохранить историю, уничтоженную во время войны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Collect monument fragments with inscriptions"
msgstr "Соберите фрагменты памятника с надписями"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Sanctum's Memory"
msgstr "«Память Санктума»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Help Paladin Cyril restore access to the ruined sanctum by clearing Zinutes and recovering sacred relics."
msgstr "Помогите паладину Кирилу восстановить доступ к разрушенному святилищу, уничтожив зинутов и вернув священные реликвии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Defeat Zinutes near the sanctum ruins"
msgstr "Победите Зинутов возле руин святилища"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Collect sacred relics from shattered shrines"
msgstr "Соберите священные реликвии из разрушенных святынь"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Researcher] Marcus"
msgstr "[Исследователь] Маркус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Botanist] Elena"
msgstr "[Ботаник] Елена"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Archivist] Tobias"
msgstr "[Архивариус] Тобиас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "[Paladin] Cyril"
msgstr "[Паладин] Кирилл"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "War testimonies recorded: {0}/3"
msgstr "Записанные свидетельства о войне: {0}/3"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Monument fragments collected: {0}/5"
msgstr "Собранные фрагменты памятника: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Blue Fragaras Petals collected: {0}/6"
msgstr "Собранные лепестки голубого фрагараса: {0}/6"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_25_quests.cs
msgid "Sacred relics found: {0}/5"
msgstr "Найденные священные реликвии: {0}/5"

# ============================================================================
# Tiltas Valley Quests (f_rokas_28_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "[Supply Officer] Darius"
msgstr "[Специалист по снабжению] Дариус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Darius"
msgstr "Дарий"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Welcome to our supply camp, traveler. Though I must warn you - we've been having some... difficulties."
msgstr "Добро пожаловать в наш лагерь снабжения, путешественник. Хотя должен тебя предупредить — у нас возникли некоторые… трудности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*He glances nervously at the ground around the tents*{/}"
msgstr "{#666666}*Он нервно поглядывает на землю вокруг палаток*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Lauzinute scorpions aren't naturally aggressive, but there are so many of them around here that my workers keep stepping on them by accident."
msgstr "Скорпионы Лаузинуте по своей природе не агрессивны, но их здесь так много, что мои работники постоянно наступают на них случайно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Every time someone provokes one, we have incidents. Just yesterday, three of my men were stung while unloading supplies."
msgstr "Каждый раз, когда кто-то их провоцирует, происходят инциденты. Буквально вчера троих моих ребят ужалили, когда они разгружали припасы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "We need to thin out their population before someone gets seriously hurt."
msgstr "Нам нужно сократить их численность, пока кто-нибудь не пострадал по-настоящему."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I'll help clear the area"
msgstr "Я помогу очистить эту территорию"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "How dangerous are they?"
msgstr "Насколько они опасны?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Not my problem"
msgstr "Это не моя проблема"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You'd do that? Excellent! I can't spare any of my men for this - we're already short-staffed."
msgstr "Ты это сделаешь? Отлично! Я не могу выделить на это ни одного из своих людей — у нас и так не хватает персонала."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Could you reduce the Lauzinute population around our camp? We need the immediate area safer for the supply teams."
msgstr "Не могли бы вы уменьшить численность лаузинутов в окрестностях нашего лагеря? Нам нужно, чтобы непосредственная территория вокруг лагеря была более безопасной для групп снабжения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Thank you! You'll find plenty of them right around here - they've made the entire area their nesting ground."
msgstr "Спасибо! Здесь их полно — они обратили всю эту местность в свое гнездовое место."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Be careful though. While they're not aggressive by nature, they will defend themselves if provoked."
msgstr "Но будьте осторожны. Хотя по своей природе они не агрессивны, при провокации они будут защищаться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Lauzinute themselves aren't particularly deadly - their venom causes pain and swelling, but it's rarely fatal."
msgstr "Сами по себе лаузинуты не представляют особой опасности — их яд вызывает боль и отек, но редко приводит к летальному исходу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The real problem is their sheer numbers. When you're carrying heavy supplies and focused on your work, it's too easy to disturb one accidentally."
msgstr "Настоящая проблема заключается в их огромном количестве. Когда ты несешь тяжелый груз и сосредоточен на работе, очень легко случайно потревожить одного из них."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "We need fewer of them around the camp so my workers have room to operate safely."
msgstr "Нам нужно, чтобы их было меньше вокруг лагеря, чтобы у моих работников было достаточно места для безопасной работы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*He sighs*{/}"
msgstr "{#666666}*Он вздыхает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I understand. I'll keep warning my men to watch their step."
msgstr "Понятно. Я буду и дальше предупреждать своих людей, чтобы они были осторожнее."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've returned! I can already tell the difference - my workers reported far fewer sightings today."
msgstr "Ты вернулся! Я уже заметил разницу — мои работники сообщили, что сегодня наблюдений было гораздо меньше."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*He looks visibly relieved*{/}"
msgstr "{#666666}*Он выглядит явно облегчённым*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The camp is much safer now. We can actually move supplies without constantly checking the ground for scorpions."
msgstr "Теперь в лагере стало гораздо безопаснее. Мы можем перевозить припасы, не проверяя постоянно землю на наличие скорпионов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've made a real difference for the supply route between Fedimian and Klaipeda. Here, you've earned this."
msgstr "Вы внесли значительный вклад в обеспечение маршрута снабжения между Федимианом и Клайпедой. Вы заслужили это."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Lauzinute are still thick around here. You'll find them all over the area near the camp."
msgstr "В этих краях по-прежнему полно лаузинутов. Их можно встретить повсюду в окрестностях лагеря."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Thank you for your help with this."
msgstr "Спасибо за помощь в этом вопросе."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Thanks to you, supply operations have returned to normal. My workers can focus on their jobs instead of watching for scorpions."
msgstr "Благодаря вам работа службы снабжения вернулась в нормальное русло. Мои сотрудники могут сосредоточиться на своей работе, а не высматривать скорпионов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Safe travels, friend."
msgstr "Счастливого пути, друг."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "[Scout] Valeria"
msgstr "[Разведчица] Валерия"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Valeria"
msgstr "Валерия"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*A Fedimian scout stands at the cliff edge, scanning the valley with a spyglass*{/}"
msgstr "{#666666}*Федимский разведчик стоит на краю утеса и осматривает долину в подзорную трубу*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "This overlook provides the best view of Tiltas Valley. I can monitor threats from here and report to Fedimian command."
msgstr "С этой смотровой площадки открывается лучший вид на долину Тилтас. Отсюда я могу отслеживать угрозы и докладывать о них командованию Федимиана."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She lowers the spyglass and turns to you*{/}"
msgstr "{#666666}*Она опускает подзорную трубу и поворачивается к тебе*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "And right now, I'm seeing two distinct threats. Hogma Archer raiders are establishing camps in the area, and Lauzinute infestations are spreading below the cliffs."
msgstr "И сейчас я вижу две явные угрозы. Налетчики из племени «Хогома Арчер» разбивают лагеря в этом районе, а колонии лаузинутов распространяются под утесами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "This observation post is crucial for Fedimian's security, but I can't leave to deal with these threats myself."
msgstr "Этот наблюдательный пункт имеет решающее значение для безопасности Федимиана, но я не могу уйти, чтобы самостоятельно справиться с этими угрозами."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I'll handle both threats"
msgstr "Я разберусь с обеими угрозами"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "What are the Hogma doing here?"
msgstr "Что здесь делают хогмы?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I have other priorities"
msgstr "У меня есть другие приоритеты"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "A capable warrior offering assistance? This is exactly what I needed."
msgstr "Опытный воин, готовый прийти на помощь? Это именно то, что мне было нужно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Will you conduct a patrol sweep? Eliminate the Hogma Archers establishing camps, and clear the Lauzinute below the cliffs?"
msgstr "Проведёте ли вы патрульную зачистку? Уничтожите ли вы лучников Хогмы, разбивших лагеря, и очистите ли вы Лаузинуте ниже утесов?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Excellent! The Lauzinute are clustered right below this cliff - you'll find them easily."
msgstr "Отлично! Лаузинуты собрались прямо под этой скалой — вы их легко найдёте."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Hogma Archers are more spread out, establishing camps at various points around the valley. You'll need to patrol the area to find them all."
msgstr "Лучники Хогмы расположились более рассредоточенно, разбив лагеря в разных точках долины. Чтобы найти их всех, вам придётся патрулировать эту местность."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Once both threats are eliminated, return here. I'll report your success to Fedimian command."
msgstr "Как только обе угрозы будут устранены, вернитесь сюда. Я доложу о вашем успехе командованию Федимиана."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Hogma are widling warriors - brutal and territorial. They've been pushing into this area from the west."
msgstr "Хогма — дикие воины, жестокие и территориальные. Они продвигаются в эту местность с запада."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I've counted at least a dozen archers setting up defensive positions. If we don't drive them out now, they'll fortify and become a permanent threat."
msgstr "Я насчитал как минимум дюжину лучников, занимающих оборонительные позиции. Если мы не прогоним их сейчас, они укрепят свои позиции и станут постоянной угрозой."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "This valley is strategically important - it connects to the Royal Mausoleum and sits between Fedimian and the outer regions. We can't let raiders control it."
msgstr "Эта долина имеет стратегическое значение — она соединяется с Королевским мавзолеем и расположена между Федимианом и отдалёнными регионами. Мы не можем позволить налетчикам захватить её."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I understand. I'll continue monitoring from here and hope reinforcements arrive soon."
msgstr "Понятно. Я буду продолжать наблюдать за ситуацией отсюда и надеюсь, что подкрепление прибудет в ближайшее время."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've completed the patrol sweep! I've been tracking your progress from this vantage point."
msgstr "Вы завершили патрулирование! Я следил за вашим продвижением с этой наблюдательной точки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She surveys the valley with satisfaction*{/}"
msgstr "{#666666}*Она с удовлетворением оглядывает долину*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Hogma camps are abandoned, and the Lauzinute population is thinned significantly. The valley is secure - for now."
msgstr "Лагеря Хогма заброшены, а численность населения Лаузинуте значительно сократилась. Долина находится в безопасности — пока что."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I'll send word to Fedimian command that the threat has been neutralized. They'll want to know we have a capable ally in this region."
msgstr "Я сообщу командованию Федимиана, что угроза нейтрализована. Им будет интересно узнать, что у нас есть надежный союзник в этом регионе."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've done Fedimian a great service today. Accept this with our gratitude."
msgstr "Сегодня вы оказали Федимиану огромную услугу. Примите это в знак нашей благодарности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Lauzinute below the cliffs still need clearing. "
msgstr "Лаузинуте у подножия утесов ещё предстоит расчистить. "

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Hogma Archer camps are still active in the valley. "
msgstr "В долине по-прежнему действуют лагеря лучников Хогмы. "

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I'll be watching from here. Stay safe out there."
msgstr "Я буду наблюдать отсюда. Будьте осторожны там."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The valley remains secure thanks to your patrol. I continue to monitor from this position."
msgstr "Благодаря вашему патрулированию в долине сохраняется безопасность. Я продолжаю вести наблюдение с этой позиции."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Fedimian command was impressed by your efficiency. You're building quite a reputation."
msgstr "Командование Федимиана осталось под впечатлением от вашей эффективности. Вы завоевываете себе неплохую репутацию."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "[Archaeologist] Tobias"
msgstr "[Археолог] Тобиас"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*An elderly scholar examines ancient ruins near the settlement, making sketches in a worn journal*{/}"
msgstr "{#666666}*Пожилой ученый исследует древние руины недалеко от поселения, делая наброски в потрепанном дневнике*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Fascinating! These structures predate even the Royal Mausoleum. The architectural style is completely different from anything in Fedimian's archives."
msgstr "Удивительно! Эти сооружения появились ещё до постройки Королевского мавзолея. Их архитектурный стиль совершенно не похож ни на что из того, что хранится в архивах Федимиана."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*He notices you and straightens up*{/}"
msgstr "{#666666}*Он замечает тебя и выпрямляется*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Ah, forgive me. I get absorbed in my work. I'm cataloging the ancient monuments of Tiltas Valley for the Grand Archive."
msgstr "Ах, простите. Я так увлекся работой. Я занимаюсь каталогизацией древних памятников долины Тилтас для Великого архива."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "There are two particularly significant structures I've identified - one at Zibintu Hill, another at Stone Pillar Hill."
msgstr "Я выделил два особенно значимых сооружения — одно на холме Зибинту, другое — на холме Стоун-Пиллар."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "What makes them significant?"
msgstr "В чём заключается их значимость?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Good luck with your research"
msgstr "Удачи в ваших исследованиях"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You're offering to assist? Wonderful! My old legs aren't what they used to be, and these monuments are quite far apart."
msgstr "Вы предлагаете помочь? Замечательно! Мои старые ноги уже не те, что раньше, а эти памятники расположены довольно далеко друг от друга."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Would you travel to both monuments and document their inscriptions? I need rubbings or detailed observations of the carvings."
msgstr "Не могли бы вы посетить оба памятника и задокументировать их надписи? Мне нужны оттиски или подробные описания резьбы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Excellent! The first monument stands at Zibintu Hill - you'll find it to the northwest of here."
msgstr "Отлично! Первый памятник находится на холме Зибинту — он расположен к северо-западу отсюда."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The second is at Stone Pillar Hill, northeast near the Royal Mausoleum approach. Both are ancient stone structures with carved inscriptions."
msgstr "Второй находится на холме Стоун-Пиллар, к северо-востоку от подхода к Королевскому мавзолею. Оба сооружения представляют собой древние каменные постройки с высеченными надписями."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Simply examine each monument closely and document what you find. The inscriptions should still be partially legible despite weathering."
msgstr "Просто внимательно осмотрите каждый памятник и зафиксируйте свои наблюдения. Несмотря на воздействие погодных условий, надписи должны оставаться частично разборчивыми."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Return when you've investigated both sites. This discovery could rewrite our understanding of the region's history!"
msgstr "Вернитесь, когда осмотрите оба места. Это открытие может кардинально изменить наше представление об истории этого региона!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The carving style and runic patterns don't match any known Fedimian historical period."
msgstr "Стиль резьбы и рунические узоры не соответствуют ни одному из известных исторических периодов Федимии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I believe these monuments were erected by an earlier civilization - perhaps the original inhabitants before even the royal family established the mausoleum."
msgstr "Я полагаю, что эти памятники были возведены более древней цивилизацией — возможно, первоначальными жителями, ещё до того, как королевская семья построила мавзолей."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "If we can decipher the inscriptions, we might learn about the valley's true origins and why the Royal Mausoleum was built in this specific location."
msgstr "Если нам удастся расшифровать надписи, мы, возможно, узнаем о подлинном происхождении долины и о том, почему Королевский мавзолей был построен именно в этом месте."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Thank you. The work continues, slowly but steadily."
msgstr "Спасибо. Работа продолжается — медленно, но верно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've returned! Did you find both monuments?"
msgstr "Ты вернулся! Ты нашёл оба памятника?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*He listens eagerly to your descriptions*{/}"
msgstr "{#666666}*Он с большим интересом слушает твои рассказы*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Remarkable! The patterns you describe match pre-war historical records I found in damaged archives."
msgstr "Поразительно! Описанные вами узоры совпадают с довоенными историческими записями, которые я обнаружил в поврежденных архивах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "These monuments appear to mark territorial boundaries of an ancient kingdom that existed here millennia ago."
msgstr "По всей видимости, эти памятники обозначают территориальные границы древнего королевства, существовавшего здесь тысячелетия назад."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*He makes rapid notes in his journal*{/}"
msgstr "{#666666}*Он быстро делает записи в своём дневнике*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "This suggests the Royal Mausoleum wasn't just built randomly - it was placed here because this land had sacred significance long before Fedimian's royal line."
msgstr "Это позволяет предположить, что Королевский мавзолей был построен не просто так — его разместили именно здесь, поскольку эта земля имела сакральное значение задолго до появления королевского рода Федимиан."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've contributed to a major historical discovery! The Grand Archive will want to hear about this immediately."
msgstr "Вы внесли свой вклад в важное историческое открытие! «Великий архив» наверняка захочет немедленно узнать об этом."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Please, accept this reward. Your assistance has been invaluable to scholarship."
msgstr "Пожалуйста, примите эту награду. Ваша помощь оказалась неоценимой для науки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Remember - one monument at Zibintu Hill to the northwest, and one at Stone Pillar Hill to the northeast."
msgstr "Запомните: один памятник находится на холме Зибинту на северо-западе, а другой — на холме Стоун-Пиллар на северо-востоке."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Take your time examining them. The inscriptions are ancient and require careful observation."
msgstr "Не торопитесь, внимательно их изучите. Надписи очень старые, и их нужно внимательно рассматривать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Thanks to your fieldwork, I'm preparing a comprehensive report for the Grand Archive about the valley's ancient history."
msgstr "Благодаря вашей полевой работе я готовлю для Великого архива подробный отчет о древней истории долины."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Scholars will be studying these findings for years to come!"
msgstr "Ученые будут изучать эти результаты ещё долгие годы!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Ancient Monument"
msgstr "Древний памятник"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*An ancient stone monument rises from the ground, weathered by centuries but still standing*{/}"
msgstr "{#666666}*Из земли возвышается древний каменный памятник, изношенный веками, но по-прежнему стоящий на своем месте*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*You've already documented this monument*{/}"
msgstr "{#666666}*Вы уже задокументировали этот памятник*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Examining ancient inscriptions..."
msgstr "Изучение древних надписей..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Documented: {0} Monument"
msgstr "Зарегистрировано: {0} Памятник"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Monuments documented: {0}/2"
msgstr "Зарегистрированные памятники: {0}/2"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#FFD700}All monuments documented! Return to Archaeologist Tobias.{/}"
msgstr "{#FFD700}Все памятники задокументированы! Вернитесь к археологу Тобиасу.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Investigation cancelled."
msgstr "Расследование прекращено."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "[Herbalist] Linnea"
msgstr "[Травник] Линнеа"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Linnea"
msgstr "Линея"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*A Fedimian herbalist kneels beside her equipment near the mausoleum slope, examining dried plant samples*{/}"
msgstr "{#666666}*Федимская травница стоит на коленях рядом со своим оборудованием у подножия мавзолея и изучает образцы засушенных растений*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The desert climate here is harsh, but it produces some remarkably potent medicinal herbs."
msgstr "Здесь суровый пустынный климат, но именно в таких условиях растут некоторые удивительно сильные лекарственные травы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She looks up from her work and glances nervously at the mausoleum entrance*{/}"
msgstr "{#666666}*Она отрывается от работы и нервно бросает взгляд на вход в мавзолей*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I'm researching antidotes to demon corruption - the lingering effects from the war still plague many people."
msgstr "Я изучаю противоядия от демонического заражения — последствия войны до сих пор досаждают многим людям."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I've set up my research camp here in the valley, though I refuse to venture near the Royal Mausoleum itself."
msgstr "Я разбил здесь, в долине, свой исследовательский лагерь, хотя и не собираюсь приближаться к самому Королевскому мавзолею."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The herbs that grow in this valley have unique hemostatic properties that could be crucial for my work."
msgstr "Травы, растущие в этой долине, обладают уникальными кровоостанавливающими свойствами, которые могут сыграть решающую роль в моей работе."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I'll help gather herbs"
msgstr "Я помогу собрать травы"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "What kind of antidote?"
msgstr "Какое противоядие?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Why avoid the mausoleum?"
msgstr "Почему стоит избегать посещения мавзолея?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Best of luck"
msgstr "Удачи!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You're willing to help with botanical research? Perfect!"
msgstr "Вы готовы помочь в проведении ботанических исследований? Прекрасно!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I need fresh samples of Hemostasis Herb - it grows in scattered locations across the valley. Could you collect eight samples for me?"
msgstr "Мне нужны свежие образцы травы «Гемостаз» — она растёт в разных местах по всей долине. Не могли бы вы собрать для меня восемь образцов?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Wonderful! The herbs grow on small desert plants - you'll recognize them by their distinctive silvery leaves."
msgstr "Замечательно! Эти травы растут на небольших пустынных растениях — их можно узнать по характерным серебристым листьям."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I've spotted several growing sites across the valley, but be careful - some are near Lauzinute nesting areas."
msgstr "Я заметил несколько мест произрастания по всей долине, но будьте осторожны — некоторые из них находятся рядом с местами гнездования лаузинутов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She lowers her voice*{/}"
msgstr "{#666666}*Она понижает голос*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "And whatever you do, don't enter the Royal Mausoleum unprepared. The herbs in the valley are valuable enough - there's no need to risk your life in that cursed place."
msgstr "И что бы ты ни делал, ни в коем случае не входи в Королевский мавзолей, не подготовившись. Травы в долине и так достаточно ценны — нет нужды рисковать жизнью в этом проклятом месте."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Demon corruption causes internal bleeding and tissue breakdown that normal healing magic can't fully address."
msgstr "Поражение демонами вызывает внутреннее кровотечение и разрушение тканей, с которыми обычная магия исцеления не способна полностью справиться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The Hemostasis Herbs that grow here have natural properties that stop bleeding and promote cellular regeneration."
msgstr "Растущие здесь травы, способствующие остановке кровотечения, обладают природными свойствами, которые останавливают кровотечение и способствуют регенерации клеток."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Combined with purification magic, they could create an antidote that reverses corruption damage permanently."
msgstr "В сочетании с магией очищения они могли бы создать противоядие, которое навсегда устраняет урон от порчи."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "This research could save countless lives - people are still suffering from war wounds years later."
msgstr "Это исследование может спасти бесчисленное количество жизней — ведь люди продолжают страдать от военных ранений даже спустя годы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*Her expression darkens*{/}"
msgstr "{#666666}*Её лицо омрачается*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "There's a hidden entrance to the Royal Mausoleum deeper in this valley. Most people don't know it exists - and Fedimian authorities refuse to acknowledge it."
msgstr "Глубже в этой долине находится потайной вход в Королевский мавзолей. Большинство людей не знают о его существовании, а власти Федимии отказываются признавать его."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I discovered it two weeks ago with a research expedition - seven herbalists and guards, all experienced adventurers. We thought we could collect rare fungi from the upper floors."
msgstr "Я обнаружил это место две недели назад во время исследовательской экспедиции — нас было семеро: травники и охранники, все — опытные путешественники. Мы думали, что сможем собрать редкие грибы на верхних этажах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "We were wrong."
msgstr "Мы ошиблись."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She touches a scar on her arm*{/}"
msgstr "{#666666}*Она прикасается к шраму на руке*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Golems patrol the corridors - massive stone constructs that crush anything in their path. Demons lurk in the shadows. The very air is thick with corruption."
msgstr "По коридорам патрулируют големы — огромные каменные конструкции, которые сокрушают всё на своём пути. В тени притаились демоны. Сам воздух пропитан тлением."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I watched three of my colleagues fall on just the first floor. The guards managed to drag me out, but the others..."
msgstr "Я видел, как трое моих коллег упали уже на первом этаже. Охранникам удалось вытащить меня, но остальные..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She shakes her head*{/}"
msgstr "{#666666}*Она качает головой*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "I reported the entrance to the Grand Archive immediately. They... dismissed my testimony. Said the mausoleum's official entrance is sealed and that's all that matters."
msgstr "Я сразу же сообщил о входе в Большой архив. Они… отклонили мои показания. Сказали, что официальный вход в мавзолей опечатан, и это — единственное, что имеет значение."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "They don't want to admit there's an unguarded breach into one of the kingdom's most dangerous sites. Political embarrassment, I suppose."
msgstr "Они не хотят признавать, что в одном из самых опасных объектов королевства есть незащищенный проход. Полагаю, это политический конфуз."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "So the entrance remains open. Unguarded. Waiting for foolish adventurers to stumble into a death trap."
msgstr "Таким образом, вход остаётся открытым. Без охраны. В ожидании, когда какие-нибудь безрассудные искатели приключений наткнутся на смертельную ловушку."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "If you value your life, stay in the valley. The monsters here are far beyond anything you'll encounter in these fields, but at least you can run from Lauzinute and Hogmas."
msgstr "Если тебе дорога жизнь, оставайся в долине. Здешние чудовища намного страшнее всего, с чем тебе придётся столкнуться на этих полях, но зато от Лаузинуте и Хогмаса ты ещё сможешь убежать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "In the mausoleum's corridors? There's nowhere to run."
msgstr "В коридорах мавзолея? Убежать некуда."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She reaches into her pack*{/}"
msgstr "{#666666}*Она заглядывает в рюкзак*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Here, take these recovery potions. They're all I have left from the expedition. If you insist on venturing near that cursed place, at least be prepared."
msgstr "Вот, возьми эти зелья восстановления. Это всё, что у меня осталось после экспедиции. Если ты всё же настаиваешь на том, чтобы отправиться в окрестности того проклятого места, то хотя бы будь готов ко всему."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Thank you. The work continues, one plant sample at a time."
msgstr "Спасибо. Работа продолжается — мы исследуем образцы растений один за другим."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She glances toward the mausoleum again*{/}"
msgstr "{#666666}*Она снова бросает взгляд в сторону мавзолея*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "And stay away from that cursed place unless you absolutely must enter."
msgstr "И держись подальше от этого проклятого места, если только тебе не придется туда пойти по крайней необходимости."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've collected the herbs! Let me examine them..."
msgstr "Ты собрал травы! Давай я их осмотрю..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She carefully inspects each sample*{/}"
msgstr "{#666666}*Она тщательно осматривает каждый образец*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Perfect! These are excellent specimens - fresh, undamaged, and at peak potency."
msgstr "Прекрасно! Это отличные экземпляры — свежие, неповрежденные и обладающие максимальной эффективностью."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "With these, I can begin synthesizing the antidote formula. Each sample will be processed and tested carefully."
msgstr "С их помощью я смогу приступить к синтезу формулы противоядия. Каждый образец будет тщательно обработан и проверен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*She stores the herbs in protective containers*{/}"
msgstr "{#666666}*Она хранит травы в защитных контейнерах*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've contributed to potentially life-saving research. When this antidote is perfected, it will help corruption victims across all three cities."
msgstr "Вы внесли свой вклад в исследования, которые могут спасти жизни людей. Когда этот антидот будет доработан, он поможет жертвам коррупции во всех трёх городах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Please, accept this reward. You've done more than gather plants - you've given hope to those still suffering from the war."
msgstr "Пожалуйста, примите эту награду. Вы сделали гораздо больше, чем просто собрали растения — вы подарили надежду тем, кто до сих пор страдает от последствий войны."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "You've collected {0} out of 8 Hemostasis Herbs so far."
msgstr "На данный момент вы собрали {0} из 8 трав для остановки кровотечения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Look for desert plants with silvery leaves. They're scattered across the valley, though some are near dangerous areas."
msgstr "Обратите внимание на пустынные растения с серебристыми листьями. Они растут по всей долине, хотя некоторые из них находятся рядом с опасными участками."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "The antidote research is progressing well thanks to your herb samples."
msgstr "Исследования по созданию противоядия успешно продвигаются благодаря предоставленным вами образцам трав."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Soon, we'll be able to help those still suffering from demonic corruption. You should be proud of your contribution."
msgstr "Скоро мы сможем помочь тем, кто до сих пор страдает от демонического осквернения. Вы можете гордиться своим вкладом."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Hemostasis Herb Plant"
msgstr "Растение, используемое для остановки кровотечения"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*A desert plant with distinctive silvery leaves grows here*{/}"
msgstr "{#666666}*Здесь растёт пустынное растение с характерными серебристыми листьями*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#666666}*You've already gathered from this plant*{/}"
msgstr "{#666666}*Вы уже собрали урожай с этого растения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Carefully harvesting Hemostasis Herb..."
msgstr "Аккуратный сбор травы «Гемостаз»..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Found: Hemostasis Herb"
msgstr "Найден: Трава для остановки кровотечения"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Hemostasis Herbs collected: {0}/8"
msgstr "Травы для остановки кровотечения: {0}/8"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "{#FFD700}All herbs collected! Return to Herbalist Linnea.{/}"
msgstr "{#FFD700}Все травы собраны! Вернитесь к травнице Линне.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Harvest cancelled."
msgstr "Уборка урожая отменена."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Scorpion Suppression"
msgstr "Борьба со скорпионами"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Help the supply officer thin out the Lauzinute population around the camp to prevent accidents."
msgstr "Помогите офицеру по снабжению сократить численность лаузинутов в окрестностях лагеря, чтобы предотвратить несчастные случаи."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Hunt Lauzinute"
msgstr "Хант Лаузинуте"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Valley Patrol"
msgstr "«Долинный патруль»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Help the Fedimian scout eliminate threats in Tiltas Valley by clearing Hogma Archers and Lauzinute."
msgstr "Помогите разведчику Федимиана устранить угрозы в долине Тилтас, уничтожив лучников Хогмы и Лаузинуте."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Hunt Hogma Archer"
msgstr "Хант Хогма Арчер"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Monuments of the Valley"
msgstr "Памятники долины"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Document ancient monuments at Zibintu Hill and Stone Pillar Hill for the Fedimian archaeologist's research."
msgstr "Задокументировать древние памятники на холмах Зибинту и Стоун-Пиллар для исследования археолога из Федимии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Investigate ancient monuments"
msgstr "Изучить древние памятники"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Desert Herbalist"
msgstr "Травник из пустыни"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Collect Hemostasis Herbs across the valley for the Fedimian herbalist's antidote research."
msgstr "Соберите по всей долине травы, способствующие остановке кровотечения, для исследований федимийского травника по созданию противоядия."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_28_quests.cs
msgid "Collect Hemostasis Herbs"
msgstr "Соберите травы для остановки кровотечения"

# ============================================================================
# King's Plateau Quests (f_rokas_30_quests.cs)
# ============================================================================

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "[Expedition Leader] Brennan"
msgstr "[Руководитель экспедиции] Бреннан"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Brennan"
msgstr "Бреннан"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A scholarly man in worn traveling robes looks up from a collection of scattered notes*{/}"
msgstr "{#666666}*Учёный в поношенной дорожной одежде поднимает глаза от стопки разбросанных записок*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Ah, a traveler! Welcome to King's Plateau. I am Brennan, leader of this research expedition from the Fedimian Grand Archive."
msgstr "А, путешественник! Добро пожаловать на Плато Кинга. Я — Бреннан, руководитель этой исследовательской экспедиции от Великого архива Федимии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You may have noticed the perpetual darkness here. It's quite unsettling at first, but I assure you it's perfectly... well, mostly safe."
msgstr "Возможно, вы уже заметили, что здесь вечно темно. Поначалу это довольно тревожно, но уверяю вас, здесь совершенно… ну, в основном безопасно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "We've camped here to study the magical barrier surrounding the Mage's Tower. Do you see it? That faint shimmer in the distance?"
msgstr "Мы разбили здесь лагерь, чтобы изучить магический барьер, окружающий Башню Магов. Видишь? Это едва заметное мерцание вдали?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Tell me about this barrier"
msgstr "Расскажите мне об этом барьере"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Why does Fedimian care about this?"
msgstr "Почему это так важно для Федимиана?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I'm just passing through"
msgstr "Я просто проездом"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The barrier was erected centuries ago by the tower's original inhabitants - powerful mages who sealed themselves inside."
msgstr "Это преграда была возведена много веков назад первыми обитателями башни — могущественными магами, которые запечатали себя внутри."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "It warps light itself, creating this eternal night. Our instruments detect massive magical fluctuations emanating from within."
msgstr "Оно искривляет сам свет, создавая эту вечную тьму. Наши приборы фиксируют мощные магические колебания, исходящие изнутри."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He gestures toward the dark horizon*{/}"
msgstr "{#666666}*Он указывает рукой на тёмный горизонт*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "We've established research camps across the plateau, but our lead investigator, Magister Corvinus, has made the most progress."
msgstr "Мы развернули исследовательские лагеря по всему плато, но наибольших успехов добился наш ведущий исследователь, магистр Корвинус."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "He's stationed at Sviesa Altar - an ancient site with a direct view of the tower entrance."
msgstr "Он находится на посту у алтаря Свиеса — древнего места, откуда открывается прямой вид на вход в башню."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I need someone to deliver this research document to him. The data is time-sensitive and the Hogma have made travel dangerous. Would you help?"
msgstr "Мне нужен кто-нибудь, кто доставил бы ему этот исследовательский документ. Данные теряют актуальность с течением времени, а из-за Хогмы путешествовать стало опасно. Не могли бы вы помочь?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Excellent! Magister Corvinus will be expecting these. He's brilliant but... intense. Don't be put off by his manner."
msgstr "Отлично! Магистр Корвинус будет ждать их. Он блестящий человек, но… довольно резкий. Не пугайтесь его манеры поведения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You'll find him at Sviesa Altar, on the far side of the plateau. The altar predates even the Mage's Tower - Corvinus believes they're connected."
msgstr "Вы найдёте его у алтаря Свиеса, на другом конце плато. Этот алтарь появился ещё до постройки Башни Магов — Корвинус считает, что между ними есть связь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Be careful of the Hogma tribes. They've grown aggressive since we arrived."
msgstr "Будьте осторожны с племенами хогма. С момента нашего прибытия они стали более агрессивными."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Received: Research Document"
msgstr "Получено: научный документ"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Grand Archive seeks to understand all magical phenomena. This barrier represents unprecedented magical engineering."
msgstr "«Великий архив» стремится понять все магические явления. Этот барьер представляет собой беспрецедентное достижение в области магической инженерии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "If we can decipher how it works, we might learn to create protective wards for our cities - or find ways to dispel demonic corruption."
msgstr "Если нам удастся понять, как это работает, мы, возможно, научимся создавать защитные заклинания для наших городов — или найдём способы избавиться от демонического влияния."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The war left scars that normal magic cannot heal. Ancient knowledge like this could be the key to true restoration."
msgstr "Война оставила шрамы, которые обычная магия не в силах залечить. Такие древние знания могут стать ключом к подлинному восстановлению."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Magister Corvinus believes the tower holds secrets that could benefit all three cities. That's why we're here."
msgstr "Магистр Корвинус считает, что башня хранит секреты, которые могут принести пользу всем трём городам. Именно поэтому мы здесь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Safe travels, then. But if you change your mind, our expedition could use capable hands."
msgstr "Тогда удачного пути. Но если передумаешь, нашей экспедиции пригодятся твои умелые руки."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "And do speak with Magister Corvinus if you venture toward Sviesa Altar. He's the most knowledgeable person here about the tower's mysteries."
msgstr "И обязательно поговорите с магистром Корвинусом, если решите отправиться к Алтарю Свиесы. Он лучше всех здесь разбирается в тайнах башни."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Have you delivered the notes to Magister Corvinus yet? He's waiting at Sviesa Altar."
msgstr "Вы уже передали записки магистру Корвинусу? Он ждёт у алтаря Свиесы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The altar is on the far side of the plateau. Be wary of Hogma patrols."
msgstr "Алтарь находится на другом конце плато. Будьте осторожны с патрулями Хогмы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Thank you for helping us. Magister Corvinus speaks highly of your capabilities."
msgstr "Спасибо за помощь. Магистр Корвинус высоко оценивает ваши способности."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The expedition's work continues. If you wish to assist further, speak with my colleagues across the plateau."
msgstr "Работа экспедиции продолжается. Если вы хотите оказать дополнительную помощь, обратитесь к моим коллегам, работающим на плато."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "[Expedition Guard] Senna"
msgstr "[Охранник экспедиции] Сенна"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Senna"
msgstr "Сенна"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A Fedimian guard stands alert, her hand resting on her weapon*{/}"
msgstr "{#666666}*Федимская стражница стоит на страже, положив руку на оружие*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hold. You don't look like Hogma, so I won't attack first. I'm Senna, assigned to protect this expedition."
msgstr "Подожди. Ты не похож на Хогму, так что я не буду нападать первым. Я — Сенна, меня назначили охранять эту экспедицию."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*She scans the darkness around the camp*{/}"
msgstr "{#666666}*Она оглядывает темноту вокруг лагеря*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "These Hogma tribes have been a constant threat since we arrived. They seem drawn to the barrier's magic."
msgstr "С момента нашего прибытия эти племена хогма представляют собой постоянную угрозу. Похоже, их притягивает магия барьера."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Hogma Shamans are the worst. They channel some kind of dark fire magic that our scholars can barely defend against."
msgstr "Шаманы Хогма — самые страшные. Они владеют какой-то магией тёмного огня, от которой наши учёные едва ли могут защититься."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I can help thin their numbers"
msgstr "Я могу помочь сократить их число"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Why are the Hogma here?"
msgstr "Почему Хогма здесь?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Not my problem"
msgstr "Это не моя проблема"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You'd fight them? Good. We're stretched thin protecting multiple research sites."
msgstr "Ты готов с ними сражаться? Отлично. Нам приходится растягиваться на все стороны, защищая сразу несколько исследовательских объектов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Hogma Scouts coordinate their raids, and the Shamans provide magical support. Eliminate both to break their offensive. Will you do this?"
msgstr "Разведчики Хогмы координируют свои набеги, а шаманы оказывают им магическую поддержку. Уничтожьте и тех, и других, чтобы сорвать их наступление. Сможете ли вы это сделать?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Thank you. The Hogma are spread across the central plateau. You'll find plenty of both Scouts and Shamans."
msgstr "Спасибо. Хогма расселены по всему центральному плато. Там вы найдёте множество как разведчиков, так и шаманов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Shamans are more dangerous - they wield fire magic and seem to draw power from the ancient sites here."
msgstr "Шаманы гораздо опаснее — они владеют магией огня и, судя по всему, черпают силу из древних святилищ, расположенных здесь."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Return when you've culled their numbers. The expedition will be in your debt."
msgstr "Вернитесь, когда сократите их численность. Экспедиция будет вам благодарна."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Hogma are widlings - tribal warriors who've inhabited these rocky regions for generations."
msgstr "Хогма — это видлинги — племенные воины, которые на протяжении многих поколений населяют эти скалистые края."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "But something's changed. They've become more aggressive, more organized. Our scholars think the barrier's magic is affecting them."
msgstr "Но что-то изменилось. Они стали более агрессивными, более организованными. Наши учёные полагают, что на них влияет магия барьера."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Shamans especially seem drawn to the ancient monuments. They perform rituals there that make our researchers nervous."
msgstr "Шаманы, похоже, особенно тяготеют к древним памятникам. Там они проводят ритуалы, которые вызывают беспокойство у наших исследователей."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Whatever the reason, they attack our camps almost nightly. We need to push them back."
msgstr "Какова бы ни была причина, они почти каждую ночь нападают на наши лагеря. Нам нужно оттеснить их."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Suit yourself. But if you're staying on this plateau, you'll have to deal with them eventually."
msgstr "Как хочешь. Но если ты останешься на этом уровне, рано или поздно тебе придется с ними разобраться."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've done it! I can already see the difference - fewer Hogma scouts on the horizon."
msgstr "Ты справился! Я уже вижу разницу — на горизонте стало меньше разведчиков Хогмы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*She relaxes slightly for the first time*{/}"
msgstr "{#666666}*Она впервые слегка расслабляется*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The expedition can work more safely now. Our scholars can focus on research instead of watching for attacks."
msgstr "Теперь экспедиция может работать в более безопасных условиях. Наши ученые могут сосредоточиться на исследованиях, а не на том, чтобы высматривать нападения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've proven yourself a capable warrior. Take this reward - you've earned it."
msgstr "Ты доказал, что ты достойный воин. Прими эту награду — ты её заслужил."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hogma Scouts still patrol the plateau. "
msgstr "Разведчики Хогмы по-прежнему патрулируют плато. "

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hogma Shamans continue their rituals at the ancient sites."
msgstr "Шаманы хогма продолжают проводить свои ритуалы на древних святилищах."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Keep hunting. The expedition is counting on you."
msgstr "Продолжай охоту. Экспедиция рассчитывает на тебя."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Hogma have pulled back since your attack. Our researchers can work without constant fear."
msgstr "После вашего нападения хогма отступили. Наши исследователи теперь могут работать, не испытывая постоянного страха."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've done the expedition a great service."
msgstr "Вы оказали экспедиции огромную услугу."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "[Archaeologist] Marius"
msgstr "[Археолог] Мариус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Marius"
msgstr "Мариус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A scholar kneels among a collection of ancient ceramic jars, tapping them with a small mallet*{/}"
msgstr "{#666666}*Учёный стоит на коленях среди коллекции древних керамических кувшинов, постукивая по ним маленьким молоточком*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Shh! Listen... do you hear that resonance? These jars are extraordinary!"
msgstr "Тсс! Прислушайся… слышишь этот резонанс? Эти банки просто потрясающие!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He stands, brushing dust from his robes*{/}"
msgstr "{#666666}*Он встает, стряхивая пыль с одежды*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I am Marius, archaeological specialist for the expedition. These ceremonial vessels were used by the tower's builders for magical communication."
msgstr "Меня зовут Мариус, я археолог-специалист экспедиции. Эти церемониальные сосуды использовались строителями башни для магического общения."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Each jar produces a different harmonic frequency when activated. I believe the correct sequence will reveal hidden inscriptions!"
msgstr "Каждая банка при активации издает свою гармоническую частоту. Я уверен, что правильная последовательность раскроет скрытые надписи!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "What kind of inscriptions?"
msgstr "Какие надписи?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Sounds complicated"
msgstr "Звучит сложно"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Wonderful! I've identified three distinct jar types, but I need someone to help activate them in sequence."
msgstr "Замечательно! Я определил три разных типа банок, но мне нужна помощь, чтобы активировать их по порядку."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The jars are scattered around this area. Activate them in the correct order: Small, Large, Tall, Small, Large, Tall. Will you try?"
msgstr "Банки разбросаны по всей этой области. Активируйте их в правильном порядке: маленькая, большая, высокая, маленькая, большая, высокая. Попробуете?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Excellent! The jars have distinct shapes - small narrow ones, large wide ones, and tall ceremonial ones."
msgstr "Отлично! Банки имеют различные формы — маленькие узкие, большие широкие и высокие парадные."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Activate them in this sequence: Small, Large, Tall, then repeat - Small, Large, Tall."
msgstr "Активируйте их в следующей последовательности: «Маленький», «Большой», «Высокий», а затем повторите — «Маленький», «Большой», «Высокий»."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "If you make a mistake, the resonance will fade and you'll need to start over. Return to me when you've completed the sequence!"
msgstr "Если ты допустишь ошибку, резонанс исчезнет, и тебе придётся начать сначала. Вернись ко мне, когда завершишь последовательность!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Magister Corvinus will be thrilled if we can decipher these inscriptions. He believes they hold clues to entering the tower."
msgstr "Магистр Корвинус будет в восторге, если нам удастся расшифровать эти надписи. Он считает, что в них содержатся подсказки, как попасть в башню."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The tower's original builders left messages encoded in magical harmonics. When the correct sequence plays, the magic reveals hidden text."
msgstr "Первые строители башни оставили сообщения, закодированные в магических гармониках. Когда звучит правильная последовательность, магия раскрывает скрытый текст."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I've found fragments suggesting these inscriptions describe the barrier's construction - perhaps even how to bypass it."
msgstr "Я обнаружил фрагменты, позволяющие предположить, что эти надписи описывают строительство барьера — возможно, даже то, как его обойти."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Magister Corvinus at Sviesa Altar is particularly interested in anything related to entering the tower. This could be the breakthrough we need."
msgstr "Магистр Корвинус у алтаря Свиеса особенно интересуется всем, что связано с проникновением в башню. Возможно, это и есть тот прорыв, который нам нужен."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "It IS complicated. But that's what makes it fascinating! The ancient mages were true geniuses."
msgstr "Это ДЕЙСТВИТЕЛЬНО сложно. Но именно в этом и заключается вся прелесть! Древние маги были настоящими гениями."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've done it! The harmonic sequence revealed the ancient inscriptions!"
msgstr "У вас получилось! Гармоническая последовательность раскрыла тайну древних надписей!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He excitedly examines the glowing text that appeared on the jars*{/}"
msgstr "{#666666}*Он с волнением рассматривает светящийся текст, появившийся на банках*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Remarkable! These describe a 'Key of Passage' - magical fragments that can unlock the tower's entrance!"
msgstr "Поразительно! Здесь речь идет о «Ключе прохода» — магических фрагментах, способных открыть вход в башню!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "This information is invaluable! Magister Corvinus must see this immediately. I'll prepare a full report."
msgstr "Эта информация просто бесценна! Магистр Корвинус должен немедленно с этим ознакомиться. Я подготовлю полный отчет."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You have a scholar's patience and a musician's ear. Please, accept this token of the Archive's gratitude."
msgstr "У вас терпение ученого и слух музыканта. Пожалуйста, примите этот знак благодарности от Архива."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Remember the sequence: Small, Large, Tall, Small, Large, Tall."
msgstr "Запомните последовательность: маленький, большой, высокий, маленький, большой, высокий."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've activated {0} jar(s) correctly so far. Keep going!"
msgstr "На данный момент вы успешно активировали {0} jar-файла. Продолжайте!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Find the jars scattered around this area and activate them in order."
msgstr "Найдите разбросанные по этой местности кувшины и активируйте их по порядку."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The inscriptions you revealed have been transcribed and sent to the Grand Archive."
msgstr "Обнаруженные вами надписи были расшифрованы и отправлены в Главный архив."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Magister Corvinus was particularly interested in the 'Key of Passage' references. Speak with him if you haven't already."
msgstr "Магистр Корвинус проявил особый интерес к упоминаниям о «Ключе прохода». Поговорите с ним, если ещё не сделали этого."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*An ancient ceremonial jar. It seems to hum faintly with residual magic.*{/}"
msgstr "{#666666}*Древняя церемониальная ваза. Кажется, она слабо гудит, словно в ней сохранилась магия.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*The jar glows softly, its magic already activated.*{/}"
msgstr "{#666666}*Кувшин мягко светится — его магия уже активирована.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Activating jar..."
msgstr "Запуск файла jar..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FFD700}The jars resonate in perfect harmony! Ancient inscriptions glow with magical light!{/}"
msgstr "{#FFD700}Кувшины звучат в совершенной гармонии! Древние надписи сияют волшебным светом!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FFD700}Return to Archaeologist Marius!{/}"
msgstr "{#FFD700}Вернуться к археологу Мариусу!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Correct! Step {0}/6 complete. Next: {1} jar."
msgstr "Правильно! Шаг {0}/6 завершен. Далее: банка {1}."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FF6666}Wrong jar! The resonance fades... Sequence reset.{/}"
msgstr "{#FF6666}Не та банка! Резонанс затихает... Сброс последовательности.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Remember: Small, Large, Tall, Small, Large, Tall."
msgstr "Запомните: маленький, большой, высокий, маленький, большой, высокий."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Small Jar"
msgstr "Маленькая баночка"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Large Jar"
msgstr "Большой кувшин"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Tall Jar"
msgstr "Высокая банка"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "[Magister] Corvinus"
msgstr "[Магистр] Корвинус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Corvinus"
msgstr "Корвинус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A stern-faced scholar in elaborate robes looks up from ancient texts*{/}"
msgstr "{#666666}*Учёный с суровым выражением лица в богато украшенных одеждах поднимает взгляд от древних текстов*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You have something for me? Ah, Brennan's research document. Finally."
msgstr "У тебя для меня что-то есть? А, исследовательский доклад Бреннана. Наконец-то."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He takes the notes and scans them quickly*{/}"
msgstr "{#666666}*Он берёт записи и быстро просматривает их*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hmm. Brennan's measurements confirm my theories. The barrier fluctuates in predictable patterns."
msgstr "Хм. Измерения Бреннана подтверждают мои теории. Барьер колеблется по предсказуемым закономерностям."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've done well bringing these. I am Magister Corvinus, lead investigator for this expedition."
msgstr "Вы поступили правильно, принеся их. Я — Магистр Корвинус, главный исследователь этой экспедиции."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "If you're capable of navigating this plateau, perhaps you can assist me with something far more significant..."
msgstr "Если тебе удастся преодолеть этот застой, возможно, ты сможешь помочь мне в деле гораздо более важном..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A stern-faced scholar stands before an ancient altar, studying the tower visible in the distance*{/}"
msgstr "{#666666}*Учёный с суровым выражением лица стоит перед древним алтарём, вглядываясь в башню, виднеющуюся вдали*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I am Magister Corvinus. You stand at Sviesa Altar - a sacred site that predates even the Mage's Tower."
msgstr "Я — Магистр Корвинус. Вы находитесь у Алтаря Свиесы — священного места, которое появилось ещё до постройки Башни Магов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He gestures toward the shimmering barrier in the distance*{/}"
msgstr "{#666666}*Он указывает на мерцающий барьер вдали*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "For months I've studied that barrier. It's a masterwork of ancient magic - and I've finally discovered how to breach it."
msgstr "В течение нескольких месяцев я изучал этот барьер. Это шедевр древней магии — и я наконец-то обнаружил, как его преодолеть."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The tower's entrance requires a 'Key of Passage' - magical fragments scattered when the barrier activated centuries ago."
msgstr "Для входа в башню требуется «Ключ прохода» — магические осколки, разлетевшиеся при активации барьера много веков назад."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "How can I help unlock it?"
msgstr "Как я могу помочь разблокировать его?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Tell me about the tower"
msgstr "Расскажи мне об этой башне"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I have other priorities"
msgstr "У меня есть другие приоритеты"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Direct and practical. I appreciate that."
msgstr "Прямо и по делу. Мне это нравится."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Key of Passage requires two components: organic material infused with the plateau's magic, and barrier energy from the ancient monuments."
msgstr "Для создания «Ключа прохода» необходимы два компонента: органический материал, пропитанный магией плато, и энергия барьера, извлеченная из древних памятников."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Hogma have lived here for generations - their tusks have absorbed trace amounts of magical residue. And the monuments scattered across the plateau still hold barrier energy. Will you gather both?"
msgstr "Хогмы живут здесь уже много поколений — их клыки впитали в себя следовые количества магических остатков. А памятники, разбросанные по всему плато, до сих пор хранят энергию барьера. Сможете ли вы собрать и то, и другое?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Excellent. Collect Hogma Tusks from the warriors across the plateau - I'll need thirty to extract enough magical essence."
msgstr "Отлично. Собери клыки Хогмы у воинов по всему плато — мне понадобится тридцать штук, чтобы извлечь достаточное количество магической эссенции."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The monuments scattered across the plateau still resonate with barrier energy. Examine five of them to extract Destroyed Barrier Pieces."
msgstr "Памятники, разбросанные по плато, до сих пор излучают энергию барьера. Исследуйте пять из них, чтобы добыть осколки разрушенного барьера."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Return when you have both components. I'll combine them into a functional Key of Passage."
msgstr "Вернись, когда у тебя будут оба компонента. Я соединю их в действенный «Ключ прохода»."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "This will be a significant achievement - the first entry into the Mage's Tower in centuries."
msgstr "Это станет значительным достижением — первым проникновением в Башню Магов за несколько столетий."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Mage's Tower was built by an order of archmages who sought to push the boundaries of magical knowledge."
msgstr "Башня Магов была построена орденом архимагов, стремившихся расширить границы магических знаний."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "When the demon war began, they sealed themselves inside rather than fight. The barrier has held ever since."
msgstr "Когда началась война с демонами, они предпочли запереться внутри, вместо того чтобы сражаться. С тех пор барьер держится."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "What knowledge lies within? What power? The Grand Archive has theorized for generations."
msgstr "Какие знания в нём таятся? Какая сила? Великий Архив уже на протяжении многих поколений выдвигает различные теории."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Some say the mages still live, preserved by their magic. Others say only their research remains - and their guardians."
msgstr "Некоторые говорят, что маги до сих пор живы, сохранившись благодаря своей магии. Другие утверждают, что от них остались лишь их исследования — и их хранители."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Either way, what's inside could change everything we know about magic."
msgstr "В любом случае, то, что находится внутри, может перевернуть всё, что мы знаем о магии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "A pity. The secrets of the tower will remain hidden a while longer."
msgstr "Жаль. Тайны башни ещё некоторое время останутся нераскрытыми."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "But if you reconsider, I'll be here. This research is my life's work."
msgstr "Но если ты передумаешь, я буду здесь. Это исследование — дело всей моей жизни."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You have everything? Let me see..."
msgstr "У тебя всё есть? Дай-ка посмотрю..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He examines the tusks and barrier pieces with intense focus*{/}"
msgstr "{#666666}*Он с пристальным вниманием осматривает бивни и обломки ограждения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Yes... YES! The magical essence in these tusks is perfect. Combined with the barrier energy..."
msgstr "Да... ДА! Магическая сущность этих бивней просто идеальна. В сочетании с энергией барьера..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*Magical energy swirls as he works, fusing the components together*{/}"
msgstr "{#666666}*Пока он работает, вокруг него вихрятся потоки магической энергии, соединяя компоненты воедино*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "It's done. The Mage's Tower is now accessible. You've achieved what scholars dreamed of for centuries."
msgstr "Готово. Теперь Башня Мага открыта. Ты осуществил то, о чём ученые мечтали на протяжении веков."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The tower entrance lies just beyond this altar. Use caution - the guardians within will not welcome intruders."
msgstr "Вход в башню находится сразу за этим алтарём. Будьте осторожны — стражи внутри не будут рады посторонним."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've earned this reward, and more importantly, you've earned the right to explore what lies within."
msgstr "Ты заслужил эту награду, а главное — ты заслужил право узнать, что скрывается внутри."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hogma Tusks: {0}/30. Barrier Pieces: {1}/5."
msgstr "Клыки Хогмы: {0}/30. Осколки барьера: {1}/5."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Hogma across the plateau carry the tusks I need. Hunt them."
msgstr "У хогма, обитающих на плато, есть те бивни, которые мне нужны. Охотьтесь на них."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Ancient monuments still hold barrier energy. Find them and extract the residue."
msgstr "Древние памятники до сих пор хранят энергию барьера. Найдите их и извлеките остатки этой энергии."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The tower awaits you. What you find inside... that's for you to discover."
msgstr "Башня ждёт вас. А что вы найдёте внутри… это вам предстоит узнать."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I'll remain here, documenting everything. The Grand Archive will want a complete record of this achievement."
msgstr "Я останусь здесь и буду всё документировать. «Великий архив» потребует полного отчёта об этом достижении."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*An ancient stone obelisk covered in worn inscriptions. It hums faintly with residual magic.*{/}"
msgstr "{#666666}*Древний каменный обелиск, покрытый стёртыми надписями. Он слабо гудит, излучая остатки магии.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*You've already extracted the barrier energy from this monument.*{/}"
msgstr "{#666666}*Вы уже извлекли энергию барьера из этого памятника.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FF6666}Hogma guardians emerge to protect the monument!{/}"
msgstr "{#FF6666}Стражи Хогмы выходят на защиту памятника!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Extracting barrier energy..."
msgstr "Извлечение энергии барьера..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Obtained: Destroyed Barrier Piece"
msgstr "Получено: Осколок разрушенного барьера"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Barrier Pieces: {0}/5"
msgstr "Барьерные элементы: {0}/5"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FFD700}All barrier pieces collected!{/}"
msgstr "{#FFD700}Все элементы барьера собраны!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FFD700}Mage's Tower 1F is now accessible!{/}"
msgstr "{#FFD700}Теперь открыт доступ к 1-му этажу Башни Мага!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "[Cartographer] Varus"
msgstr "[Картограф] Варус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Varus"
msgstr "Варус"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A nervous scholar clutches a bundle of maps, glancing repeatedly toward a rickety bridge*{/}"
msgstr "{#666666}*Нервный ученый сжимает в руках пачку карт, то и дело поглядывая на шаткий мост*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Oh! A traveler! Please, you must help me!"
msgstr "Ой! Путешественник! Пожалуйста, вы должны мне помочь!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I'm Varus, cartographer for the expedition. I crossed that bridge to map this side of the plateau, but now..."
msgstr "Я — Варус, картограф экспедиции. Я перешёл этот мост, чтобы составить карту этой стороны плато, но теперь..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He shudders*{/}"
msgstr "{#666666}*Он вздрагивает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Now I've noticed the ropes are frayed. The planks are loose. I'm CERTAIN it wasn't like that before!"
msgstr "Теперь я заметил, что веревки изношены. Доски расшатались. Я УВЕРЕН, что раньше такого не было!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I can't cross back! But I can't stay here forever either! The expedition needs these maps!"
msgstr "Я не могу вернуться обратно! Но и оставаться здесь вечно я тоже не могу! Экспедиции нужны эти карты!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I'll investigate the bridge"
msgstr "Я осмотрю мост"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Maybe you're imagining things"
msgstr "Может быть, ты просто себе это надумываешь"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Good luck with that"
msgstr "Удачи тебе в этом"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You will? Oh, thank the goddesses!"
msgstr "Правда? О, слава богиням!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Please examine the bridge carefully. If it's been sabotaged, I need to know. Will you investigate?"
msgstr "Пожалуйста, внимательно осмотрите мост. Если его взорвали, мне нужно об этом знать. Вы проведете расследование?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Thank you! The bridge is nearby, hanging over the chasm."
msgstr "Спасибо! Мост находится неподалеку, он перекинут через пропасть."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Look for signs of deliberate damage - examine the support posts carefully. There are four of them holding the bridge."
msgstr "Обратите внимание на признаки умышленного повреждения — внимательно осмотрите опорные столбы. Мост удерживают четыре таких столба."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "And be careful! The Hogma have been lurking near the bridge lately..."
msgstr "И будьте осторожны! В последнее время в окрестностях моста часто появляются хогмы..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Imagining?! I've crossed hundreds of bridges in my career! I know when something's wrong!"
msgstr "Представляете?! За всю свою карьеру я пересек сотни мостов! Я знаю, когда что-то не так!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He takes a deep breath*{/}"
msgstr "{#666666}*Он глубоко вздыхает*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Look, I admit I'm not brave. But I'm not stupid either. That bridge has been tampered with."
msgstr "Послушай, я признаю, что я не смелый. Но я и не глупый. Этот мост кто-то подделал."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Please, just take a look. If I'm wrong, I'll admit it. But if I'm right..."
msgstr "Пожалуйста, просто взгляните. Если я ошибаюсь, я это признаю. Но если я прав..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Wait! Please! I can't..."
msgstr "Подожди! Прошу тебя! Я не могу..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He trails off, looking miserable*{/}"
msgstr "{#666666}*Он замолкает, выглядя совершенно несчастным*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Fine. I'll just... stay here. With the Hogma. In the dark. Forever."
msgstr "Ладно. Я просто… останусь здесь. С Хогмой. В темноте. Навсегда."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "You've inspected all the support posts? What did you find?"
msgstr "Вы осмотрели все опорные столбы? Что вы обнаружили?"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He listens intently as you describe the sabotage*{/}"
msgstr "{#666666}*Он внимательно слушает, как ты описываешь акт саботажа*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hogma sabotage! I knew it! Those creatures have been watching the expedition..."
msgstr "Саботаж Хогмы! Я так и знал! Эти существа следили за экспедицией..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*He practically collapses with relief*{/}"
msgstr "{#666666}*Он буквально падает от облегчения*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "But at least now we know. Thank you! I'll inform Brennan immediately."
msgstr "Но, по крайней мере, теперь мы знаем. Спасибо! Я сразу же сообщу об этом Бреннану."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Please, take this reward. You've saved my life - and probably others too!"
msgstr "Пожалуйста, примите эту награду. Вы спасли мне жизнь — и, наверное, ещё и другим тоже!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Have you examined the bridge support posts yet? You've inspected {0}/4 so far."
msgstr "Вы уже осмотрели опоры моста? На данный момент вы осмотрели {0}/4."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Check all four posts - two on each side of the bridge."
msgstr "Проверьте все четыре опоры — по две с каждой стороны моста."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "I made it back safely, thanks to you. The expedition was worried when I didn't return on schedule."
msgstr "Я благополучно вернулся, благодаря вам. Участники экспедиции забеспокоились, когда я не вернулся в назначенный срок."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Brennan has posted guards at both ends of the bridge now. No more Hogma sabotage."
msgstr "Бреннан теперь разместил охрану на обоих концах моста. Саботажу со стороны Хогмы больше не будет."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "My maps are complete - this plateau is now fully documented for the Grand Archive!"
msgstr "Мои карты готовы — это плато теперь полностью задокументировано для Великого архива!"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Bridge Post"
msgstr "Опора моста"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*A wooden support post holding up the bridge. It looks weathered but sturdy.*{/}"
msgstr "{#666666}*Деревянный опорный столб, поддерживающий мост. Он выглядит изношенным, но прочным.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*You've already inspected this support post.*{/}"
msgstr "{#666666}*Вы уже ознакомились с этой статьёй службы поддержки.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Inspecting bridge post..."
msgstr "Проверка опоры моста..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*You examine the support post closely...*{/}"
msgstr "{#666666}*Вы внимательно осматриваете опорный столб...*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The ropes have been partially cut with crude blades. This was deliberate sabotage."
msgstr "Веревки были частично перерезаны грубыми лезвиями. Это был преднамеренный саботаж."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Several bolts have been loosened. The wood shows fresh scratch marks from tools."
msgstr "Несколько болтов ослаблены. На дереве видны свежие царапины от инструментов."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hogma footprints are visible in the dust around the base. They've been here recently."
msgstr "В пыли вокруг основания видны следы хогмы. Они были здесь совсем недавно."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "A piece of Hogma cloth is caught on a splinter. Definitive evidence of their tampering."
msgstr "Кусочек ткани «Хогма» зацепился за занозу. Это — неопровержимое доказательство их вмешательства."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Bridge posts inspected: {0}/4"
msgstr "Проверено количество опор моста: {0}/4"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FFD700}All posts inspected! Return to Varus.{/}"
msgstr "{#FFD700}Все посты проверены! Вернуться к Варусу.{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#FF6666}Hogma Scouts ambush you on the bridge!{/}"
msgstr "{#FF6666}Разведчики Хогмы устроили вам засаду на мосту!{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Mage's Tower Entrance"
msgstr "Вход в Башню Мага"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "{#666666}*An invisible barrier blocks your path. Powerful magic prevents entry to the tower.*{/}"
msgstr "{#666666}*На вашем пути стоит невидимый барьер. Мощная магия преграждает путь к башне.*{/}"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The ancient seal holds firm. Perhaps Magister Corvinus at Sviesa Altar knows how to bypass this barrier..."
msgstr "Древняя печать по-прежнему крепка. Возможно, магистр Корвинус у алтаря Свиеса знает, как обойти это препятствие..."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Shadows of the Plateau"
msgstr "«Тени плато»"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Deliver Expedition Leader Brennan's research document to Magister Corvinus at Sviesa Altar."
msgstr "Доставьте исследовательский отчет руководителя экспедиции Бреннана магистру Корвинусу у алтаря Свиеса."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Deliver research document to Magister Corvinus at Sviesa Altar"
msgstr "Доставьте исследовательский документ Магистру Корвинусу у алтаря Свиеса"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Plateau Patrol"
msgstr "Патруль плато"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Eliminate Hogma Scouts and Shamans threatening the expedition camps on King's Plateau."
msgstr "Уничтожьте разведчиков и шаманов Хогмы, угрожающих лагерям экспедиции на Плато Короля."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hunt Hogma Scout"
msgstr "Разведчик Хант Хогма"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Hunt Hogma Shaman"
msgstr "Хант Хогма, шаман"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Echoes in the Jars"
msgstr "Эхо в банках"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Activate ancient ceremonial jars in the correct sequence to reveal hidden inscriptions about the Mage's Tower."
msgstr "Активируйте древние церемониальные сосуды в правильной последовательности, чтобы раскрыть скрытые надписи о Башне Мага."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Activate jars in sequence: Small, Large, Tall, Small, Large, Tall"
msgstr "Расположите банки в следующем порядке: маленькая, большая, высокая, маленькая, большая, высокая"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Unlocking the Tower"
msgstr "Разблокировка башни"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Gather Hogma Tusks and Destroyed Barrier Pieces from ancient monuments to create a Key of Passage for the Mage's Tower."
msgstr "Соберите клыки Хогмы и обломки разрушенных барьеров у древних памятников, чтобы создать Ключ прохода к Башне Мага."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Collect Hogma Tusks"
msgstr "Соберите клыки Хогмы"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Collect Destroyed Barrier Pieces from ancient monuments"
msgstr "Собирайте осколки разрушенных барьеров у древних памятников"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "The Precarious Crossing"
msgstr "Опасное пересечение"

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Investigate the sabotaged bridge for Cartographer Varus by examining all four support posts."
msgstr "Расследуйте случай с подрывом моста для картографа Варуса, осмотрев все четыре опорные столбы."

#: packages/laima/scripts/zone/content/laima/npcs/fields/quests/f_rokas_30_quests.cs
msgid "Inspect the bridge support posts"
msgstr "Осмотрите опоры моста"

# ============================================================================
# Koru Jungle Quests (f_bracken_63_1_quests.cs)
# ============================================================================

#: f_bracken_63_1_quests.cs
msgid "[Scout] Kaina"
msgstr "[Разведчик] Кайна"

#: f_bracken_63_1_quests.cs
msgid "Kaina"
msgstr "Кайна"

#: f_bracken_63_1_quests.cs
msgid "Traveler! You've arrived at Koru Jungle - but I'm afraid the entrance isn't safe."
msgstr "Путешественник! Ты прибыл в «Кору Джангл», но, боюсь, вход туда небезопасен."

#: f_bracken_63_1_quests.cs
msgid "Poison-tainted Polibu creatures have been swarming the pathway. They're making it dangerous for anyone trying to enter or leave."
msgstr "Тропу заполонили заражённые ядом существа Полибу. Из-за них прохождение этой тропы становится опасным для всех, кто пытается пройти по ней в ту или другую сторону."

#: f_bracken_63_1_quests.cs
msgid "Can you help me clear them out?"
msgstr "Не могли бы вы помочь мне их убрать?"

#: f_bracken_63_1_quests.cs
msgid "I'll clear the area"
msgstr "Я очищу территорию"

#: f_bracken_63_1_quests.cs
msgid "What caused this?"
msgstr "Что стало причиной этого?"

#: f_bracken_63_1_quests.cs
msgid "Not right now"
msgstr "Не сейчас"

#: f_bracken_63_1_quests.cs
msgid "Will you help me drive back the Polibu so travelers can pass safely?"
msgstr "Не поможете ли вы мне отогнать Полибу, чтобы путешественники могли безопасно пройти?"

#: f_bracken_63_1_quests.cs
msgid "Thank you! The Polibu spawn just ahead on the path."
msgstr "Спасибо! Полибу появляется чуть дальше по тропе."

#: f_bracken_63_1_quests.cs
msgid "Clear out about twenty of them and the entrance should be safe again."
msgstr "Уничтожьте около двадцати из них, и вход снова станет безопасным."

#: f_bracken_63_1_quests.cs
msgid "The poison corruption has been spreading through Koru Jungle for weeks now."
msgstr "Уже несколько недель ядовитая порча распространяется по джунглям Кору."

#: f_bracken_63_1_quests.cs
msgid "Wildlife that once lived peacefully here have become aggressive and tainted."
msgstr "Дикие животные, которые когда-то мирно обитали здесь, стали агрессивными и испорченными."

#: f_bracken_63_1_quests.cs
msgid "We need help pushing them back before the corruption spreads further."
msgstr "Нам нужна помощь, чтобы остановить их, пока коррупция не распространилась ещё дальше."

#: f_bracken_63_1_quests.cs
msgid "Be careful if you venture into the jungle. The poison creatures are everywhere."
msgstr "Будьте осторожны, если решите отправиться в джунгли. Ядовитые существа там повсюду."

#: f_bracken_63_1_quests.cs
msgid "You did it! The entrance is much safer now."
msgstr "У вас получилось! Теперь вход стал намного безопаснее."

#: f_bracken_63_1_quests.cs
msgid "Travelers can pass through without fear of ambush. Thank you!"
msgstr "Путешественники могут проходить здесь, не опасаясь засады. Спасибо!"

#: f_bracken_63_1_quests.cs
msgid "The Polibu are still swarming the entrance. Keep clearing them out."
msgstr "Полибу по-прежнему толпятся у входа. Продолжайте их уничтожать."

#: f_bracken_63_1_quests.cs
msgid "Thanks to you, the jungle entrance is safe again."
msgstr "Благодаря вам вход в джунгли снова стал безопасным."

#: f_bracken_63_1_quests.cs
msgid "Travelers can come and go without being attacked by those poison creatures."
msgstr "Путешественники могут приходить и уходить, не подвергаясь нападениям со стороны этих ядовитых существ."

#: f_bracken_63_1_quests.cs
msgid "[Herbalist] Ruta"
msgstr "[Травник] Рута"

#: f_bracken_63_1_quests.cs
msgid "Ruta"
msgstr "Рута"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*An elderly herbalist tends to damaged plants near a small cabin*{/}"
msgstr "{#666666}*Пожилой травник ухаживает за повреждёнными растениями возле небольшой хижины*{/}"

#: f_bracken_63_1_quests.cs
msgid "My medicinal garden... it's being destroyed!"
msgstr "Мой лекарственный сад… его уничтожают!"

#: f_bracken_63_1_quests.cs
msgid "Those four-legged Parrot creatures - they're trampling everything, spreading poison wherever they go."
msgstr "Эти четвероногие существа, похожие на попугаев, — они топчут всё на своём пути и разбрасывают яд повсюду."

#: f_bracken_63_1_quests.cs
msgid "Will you help me protect my garden?"
msgstr "Поможешь мне защитить мой сад?"

#: f_bracken_63_1_quests.cs
msgid "I'll drive them away"
msgstr "Я их прогоню"

#: f_bracken_63_1_quests.cs
msgid "What do you grow here?"
msgstr "Что вы здесь выращиваете?"

#: f_bracken_63_1_quests.cs
msgid "Good luck with that"
msgstr "Удачи тебе в этом"

#: f_bracken_63_1_quests.cs
msgid "Will you clear the Parrot creatures from around my garden?"
msgstr "Не могли бы вы избавиться от попугаев, которые обитают вокруг моего сада?"

#: f_bracken_63_1_quests.cs
msgid "Bless you! The Parrot spawn not far from here."
msgstr "Будь здоров! Попугаи появляются недалеко отсюда."

#: f_bracken_63_1_quests.cs
msgid "Drive away enough of them and they should stop trampling my herbs."
msgstr "Если прогнать их в достаточном количестве, они, наверное, перестанут топтать мои травы."

#: f_bracken_63_1_quests.cs
msgid "I cultivate rare medicinal herbs that can counteract poison and corruption."
msgstr "Я выращиваю редкие лекарственные травы, способные нейтрализовать яд и гниение."

#: f_bracken_63_1_quests.cs
msgid "But if these creatures keep trampling them, I'll lose everything I've worked for."
msgstr "Но если эти твари будут и дальше их топтать, я потеряю всё, чего добился своим трудом."

#: f_bracken_63_1_quests.cs
msgid "These herbs could help so many people suffering from the poison corruption..."
msgstr "Эти травы могли бы помочь многим людям, страдающим от ядовитого заражения..."

#: f_bracken_63_1_quests.cs
msgid "{#666666}*Returns to tending the damaged plants sadly*{/}"
msgstr "{#666666}*С грустью возвращается к уходу за повреждёнными растениями*{/}"

#: f_bracken_63_1_quests.cs
msgid "The garden is safe! I can already see the Parrot staying away."
msgstr "В саду безопасно! Я уже вижу, как попугай держится подальше."

#: f_bracken_63_1_quests.cs
msgid "Now I can focus on cultivating these herbs to help people. Thank you so much!"
msgstr "Теперь я могу сосредоточиться на выращивании этих трав, чтобы помогать людям. Огромное спасибо!"

#: f_bracken_63_1_quests.cs
msgid "Please, drive away those Parrot creatures before they destroy everything."
msgstr "Пожалуйста, прогоните этих существ-попугаев, пока они не уничтожили всё."

#: f_bracken_63_1_quests.cs
msgid "My garden is recovering nicely. The herbs will be ready to harvest soon."
msgstr "Мой сад прекрасно восстанавливается. Травы скоро будут готовы к сбору."

#: f_bracken_63_1_quests.cs
msgid "Thank you again for protecting my life's work."
msgstr "Еще раз спасибо за то, что защитили дело всей моей жизни."

#: f_bracken_63_1_quests.cs
msgid "[Engineer] Tomas"
msgstr "[Инженер] Томаш"

#: f_bracken_63_1_quests.cs
msgid "Tomas"
msgstr "Томас"

#: f_bracken_63_1_quests.cs
msgid "The jungle elevator is working, but it's showing serious wear and tear."
msgstr "Лифт в джунглях работает, но на нём заметны серьёзные следы износа."

#: f_bracken_63_1_quests.cs
msgid "I need to inspect the critical components for damage, but there's a problem..."
msgstr "Мне нужно проверить критически важные компоненты на наличие повреждений, но есть одна проблема..."

#: f_bracken_63_1_quests.cs
msgid "Poison-tainted Polibu have nested all around the machinery. I can't get close enough to work!"
msgstr "Полибу, отравленные ядом, устроили гнезда повсюду вокруг оборудования. Я не могу подойти достаточно близко, чтобы работать!"

#: f_bracken_63_1_quests.cs
msgid "Can you help me with this maintenance work?"
msgstr "Не могли бы вы помочь мне с этими ремонтными работами?"

#: f_bracken_63_1_quests.cs
msgid "I'll help clear the area"
msgstr "Я помогу очистить эту территорию"

#: f_bracken_63_1_quests.cs
msgid "What needs inspecting?"
msgstr "Что необходимо проверить?"

#: f_bracken_63_1_quests.cs
msgid "Find someone else"
msgstr "Найди кого-нибудь другого"

#: f_bracken_63_1_quests.cs
msgid "Will you clear the Polibu and inspect the elevator components for me?"
msgstr "Не могли бы вы очистить «Полибу» и проверить для меня детали лифта?"

#: f_bracken_63_1_quests.cs
msgid "Excellent! First, clear out the Polibu swarming the elevator platform."
msgstr "Отлично! Для начала расчистите лифт от Полибу, которые его заполонили."

#: f_bracken_63_1_quests.cs
msgid "Then inspect these four critical components: the gear assembly, cable anchor, support beam, and pulley system."
msgstr "Затем проверьте следующие четыре важнейших компонента: редукторный узел, крепление троса, опорную балку и систему шкивов."

#: f_bracken_63_1_quests.cs
msgid "They're located around the elevator platform. I've marked them for you."
msgstr "Они расположены вокруг лифтовой площадки. Я их для вас отметил."

#: f_bracken_63_1_quests.cs
msgid "The elevator has four critical stress points that need regular inspection:"
msgstr "В лифте имеется четыре участка, подверженных наибольшим нагрузкам, которые требуют регулярного осмотра:"

#: f_bracken_63_1_quests.cs
msgid "The gear assembly, cable anchor, support beam, and pulley system."
msgstr "Механизм передачи, крепление троса, опорная балка и система шкивов."

#: f_bracken_63_1_quests.cs
msgid "If any of them fail, the whole elevator could collapse with people inside."
msgstr "Если хотя бы один из них выйдет из строя, весь лифт может обрушиться вместе с людьми внутри."

#: f_bracken_63_1_quests.cs
msgid "I understand. It's dangerous work with those creatures around."
msgstr "Понимаю. Работать рядом с этими существами — дело опасное."

#: f_bracken_63_1_quests.cs
msgid "Wonderful! The area is clear and you've inspected all the components!"
msgstr "Замечательно! Все чисто, и вы проверили все компоненты!"

#: f_bracken_63_1_quests.cs
msgid "Let me review your reports... Yes, I can see exactly what needs repair now."
msgstr "Позвольте мне ознакомиться с вашими отчётами... Да, теперь я точно вижу, что именно нужно отремонтировать."

#: f_bracken_63_1_quests.cs
msgid "This will keep the elevator running safely. Thank you!"
msgstr "Это обеспечит безопасную работу лифта. Спасибо!"

#: f_bracken_63_1_quests.cs
msgid "Clear the Polibu from the elevator area. "
msgstr "Уберите «Полибу» из зоны лифта. "

#: f_bracken_63_1_quests.cs
msgid "Inspect the elevator components around the platform. "
msgstr "Осмотрите детали лифта, расположенные вокруг платформы. "

#: f_bracken_63_1_quests.cs
msgid "Keep working on the maintenance. {0}"
msgstr "Продолжайте заниматься техническим обслуживанием. {0}"

#: f_bracken_63_1_quests.cs
msgid "The elevator is running smoothly now. All the components are in good shape."
msgstr "Лифт сейчас работает без сбоев. Все узлы находятся в исправном состоянии."

#: f_bracken_63_1_quests.cs
msgid "Thanks for your help with the inspection!"
msgstr "Спасибо за помощь с проверкой!"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*You've already inspected this component*{/}"
msgstr "{#666666}*Вы уже проверили этот компонент*{/}"

#: f_bracken_63_1_quests.cs
msgid "{#FF6666}Poison creatures emerge from the machinery!{/}"
msgstr "{#FF6666}Из механизмов вылезают ядовитые существа!{/}"

#: f_bracken_63_1_quests.cs
msgid "Inspecting component..."
msgstr "Проверка компонента..."

#: f_bracken_63_1_quests.cs
msgid "Cancel"
msgstr "Отмена"

#: f_bracken_63_1_quests.cs
msgid "Found: {0}"
msgstr "Найдены: {0}"

#: f_bracken_63_1_quests.cs
msgid "Components inspected: {0}/4"
msgstr "Проверенные компоненты: {0}/4"

#: f_bracken_63_1_quests.cs
msgid "{#FFD700}All components inspected! Return to Tomas.{/}"
msgstr "{#FFD700}Все компоненты проверены! Вернуться к Томасу.{/}"

#: f_bracken_63_1_quests.cs
msgid "Inspection cancelled."
msgstr "Проверка отменена."

#: f_bracken_63_1_quests.cs
msgid "[Monk] Darius"
msgstr "[Монах] Дариус"

#: f_bracken_63_1_quests.cs
msgid "Darius"
msgstr "Дарий"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*A monk meditates peacefully beside the waterfall*{/}"
msgstr "{#666666}*Монах мирно медитирует у водопада*{/}"

#: f_bracken_63_1_quests.cs
msgid "Ah, a traveler. You've reached the waterfall sanctuary."
msgstr "А, путешественник. Ты добрался до святилища у водопада."

#: f_bracken_63_1_quests.cs
msgid "Long ago, this waterfall held purifying properties that countered poison and corruption."
msgstr "Давным-давно этот водопад обладал очищающими свойствами, которые противостояли яду и разложению."

#: f_bracken_63_1_quests.cs
msgid "But the demon war left its mark. The purification has weakened."
msgstr "Но война с демонами оставила свой след. Очищение ослабло."

#: f_bracken_63_1_quests.cs
msgid "Will you help me restore the waterfall's power?"
msgstr "Поможешь мне восстановить силу водопада?"

#: f_bracken_63_1_quests.cs
msgid "I'll help gather samples"
msgstr "Я помогу собрать образцы"

#: f_bracken_63_1_quests.cs
msgid "How do we restore it?"
msgstr "Как его восстановить?"

#: f_bracken_63_1_quests.cs
msgid "Not interested"
msgstr "Неинтересно"

#: f_bracken_63_1_quests.cs
msgid "Will you collect water samples from the sacred crystal formations?"
msgstr "Вы собираетесь взять пробы воды из священных кристаллических образований?"

#: f_bracken_63_1_quests.cs
msgid "Thank you. The crystal formations are scattered near this waterfall."
msgstr "Спасибо. Вокруг этого водопада разбросаны кристаллические образования."

#: f_bracken_63_1_quests.cs
msgid "Collect samples from four of them. I'll use them to study how to restore the purification."
msgstr "Собери образцы у четырёх из них. Я использую их, чтобы выяснить, как восстановить процесс очистки."

#: f_bracken_63_1_quests.cs
msgid "The waterfall once channeled divine energy through crystal formations."
msgstr "Когда-то этот водопад направлял божественную энергию через кристаллические образования."

#: f_bracken_63_1_quests.cs
msgid "Those crystals still retain traces of purifying power."
msgstr "В этих кристаллах до сих пор сохранились следы очищающей силы."

#: f_bracken_63_1_quests.cs
msgid "If I can study water samples from them, I may learn how to reawaken the waterfall's blessing."
msgstr "Если мне удастся исследовать взятые у них пробы воды, возможно, я смогу понять, как вновь пробудить благословение водопада."

#: f_bracken_63_1_quests.cs
msgid "{#666666}*Returns to meditation*{/}"
msgstr "{#666666}*Возвращается к медитации*{/}"

#: f_bracken_63_1_quests.cs
msgid "You've collected all four water samples! Excellent work."
msgstr "Вы собрали все четыре пробы воды! Отличная работа."

#: f_bracken_63_1_quests.cs
msgid "Let me examine these... Yes, I can feel the residual purifying energy."
msgstr "Позвольте мне их осмотреть... Да, я чувствую остатки очищающей энергии."

#: f_bracken_63_1_quests.cs
msgid "With these samples, I can begin the work of restoring the waterfall's blessing."
msgstr "С помощью этих образцов я могу приступить к восстановлению благословения водопада."

#: f_bracken_63_1_quests.cs
msgid "Collect water samples from the crystal formations near the waterfall."
msgstr "Соберите пробы воды из кристаллических образований возле водопада."

#: f_bracken_63_1_quests.cs
msgid "I need four samples to complete my study."
msgstr "Мне нужно четыре образца, чтобы завершить своё исследование."

#: f_bracken_63_1_quests.cs
msgid "The waterfall's purification grows stronger each day."
msgstr "Очищающая сила водопада с каждым днём становится всё сильнее."

#: f_bracken_63_1_quests.cs
msgid "Soon it will cleanse this entire jungle of poison corruption."
msgstr "Вскоре она очистит всю эту «джунгли» от ядовитой коррупции."

#: f_bracken_63_1_quests.cs
msgid "Purifying Crystal"
msgstr "Очищающий кристалл"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*A crystal formation glows faintly with purifying energy*{/}"
msgstr "{#666666}*Кристаллическая структура слабо светится, излучая очищающую энергию*{/}"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*You've already collected water from this crystal*{/}"
msgstr "{#666666}*Вы уже набрали воду из этого кристалла*{/}"

#: f_bracken_63_1_quests.cs
msgid "Collecting water sample..."
msgstr "Забор пробы воды..."

#: f_bracken_63_1_quests.cs
msgid "Found: Purifying Holy Water"
msgstr "Найденo: Очищающая святая вода"

#: f_bracken_63_1_quests.cs
msgid "Water samples collected: {0}/4"
msgstr "Количество отобранных проб воды: {0}/4"

#: f_bracken_63_1_quests.cs
msgid "{#FFD700}All samples collected! Return to Darius.{/}"
msgstr "{#FFD700}Все образцы собраны! Вернуться к Дариусу.{/}"

#: f_bracken_63_1_quests.cs
msgid "{#FF6666}Tanu emerge from the bushes!{/}"
msgstr "{#FF6666}Тану, вылезай из кустов!{/}"

#: f_bracken_63_1_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: f_bracken_63_1_quests.cs
msgid "[Lost Traveler] Milda"
msgstr "[Заблудившийся путешественник] Милда"

#: f_bracken_63_1_quests.cs
msgid "Milda"
msgstr "Мильда"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*An elderly woman sits exhausted by the waterfall*{/}"
msgstr "{#666666}*Пожилая женщина сидит у водопада, выглядящая измученной*{/}"

#: f_bracken_63_1_quests.cs
msgid "O-oh! A person! Thank the goddesses!"
msgstr "О-о! Человек! Слава богиням!"

#: f_bracken_63_1_quests.cs
msgid "I'm a merchant, but I got separated from my caravan in the mist."
msgstr "Я купец, но в тумане я отстал от своего каравана."

#: f_bracken_63_1_quests.cs
msgid "Those Leafnut creatures chased me here, and I dropped my supply crates everywhere!"
msgstr "Эти существа Лифнат преследовали меня сюда, и я разбросал свои ящики с припасами повсюду!"

#: f_bracken_63_1_quests.cs
msgid "Would you be able to help?"
msgstr "Не могли бы вы помочь?"

#: f_bracken_63_1_quests.cs
msgid "I'll help you recover your supplies"
msgstr "Я помогу тебе вернуть твои припасы"

#: f_bracken_63_1_quests.cs
msgid "How did you get lost?"
msgstr "Как ты заблудился?"

#: f_bracken_63_1_quests.cs
msgid "You're on your own"
msgstr "Ты сам по себе"

#: f_bracken_63_1_quests.cs
msgid "Will you clear the Leafnut and recover my lost supply crates?"
msgstr "Не могли бы вы очистить территорию от Лифнатов и вернуть мои утерянные ящики с припасами?"

#: f_bracken_63_1_quests.cs
msgid "Thank you! The Leafnut shouldn't be far from here."
msgstr "Спасибо! Лифнат должен быть где-то неподалеку отсюда."

#: f_bracken_63_1_quests.cs
msgid "And I dropped five supply crates nearby when I was running. Please find them!"
msgstr "И я, бежав, бросил неподалеку пять ящиков с припасами. Пожалуйста, найдите их!"

#: f_bracken_63_1_quests.cs
msgid "The jungle mist is so thick here. I couldn't see where I was going."
msgstr "Здесь туман в джунглях такой густой, что я не мог видеть, куда иду."

#: f_bracken_63_1_quests.cs
msgid "Then those creatures appeared from nowhere and I panicked."
msgstr "И тут эти существа появились из ниоткуда, и я запаниковал."

#: f_bracken_63_1_quests.cs
msgid "I ran until I couldn't run anymore. Now I'm lost and my goods are scattered."
msgstr "Я бежал, пока не смог больше бежать. Теперь я заблудился, а мой груз разбросан повсюду."

#: f_bracken_63_1_quests.cs
msgid "{#666666}*Looks at you with pleading eyes*{/}"
msgstr "{#666666}*Смотрит на тебя умоляющим взглядом*{/}"

#: f_bracken_63_1_quests.cs
msgid "P-please... don't leave me here alone..."
msgstr "П-пожалуйста... не оставляй меня здесь одного..."

#: f_bracken_63_1_quests.cs
msgid "You found my supplies! And cleared away those creatures!"
msgstr "Ты нашёл мои припасы! И избавился от тех тварей!"

#: f_bracken_63_1_quests.cs
msgid "Now I can find my way back to the caravan route. Thank you so much!"
msgstr "Теперь я смогу найти дорогу обратно к караванному пути. Огромное спасибо!"

#: f_bracken_63_1_quests.cs
msgid "Clear the Leafnut from the area. "
msgstr "Уберите Лифнат с этой территории. "

#: f_bracken_63_1_quests.cs
msgid "Recover my lost supply crates. "
msgstr "Найди мои потерянные ящики с припасами. "

#: f_bracken_63_1_quests.cs
msgid "Please help me. {0}"
msgstr "Пожалуйста, помогите мне. {0}"

#: f_bracken_63_1_quests.cs
msgid "I found my way back to the caravan. We're safely on the trade route now."
msgstr "Я вернулся к каравану. Теперь мы в безопасности на торговом пути."

#: f_bracken_63_1_quests.cs
msgid "Thank you for saving me and my goods!"
msgstr "Спасибо, что спасли меня и мой груз!"

#: f_bracken_63_1_quests.cs
msgid "Lost Supply Crate"
msgstr "Потерянный ящик с припасами"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*A merchant's supply crate lies abandoned*{/}"
msgstr "{#666666}*Заброшенный ящик с товарами*{/}"

#: f_bracken_63_1_quests.cs
msgid "{#666666}*You've already recovered this supply crate*{/}"
msgstr "{#666666}*Вы уже подобрали этот ящик с припасами*{/}"

#: f_bracken_63_1_quests.cs
msgid "Recovering supplies..."
msgstr "Восстановление запасов..."

#: f_bracken_63_1_quests.cs
msgid "Found: Supply Bag"
msgstr "Найден: Сумка с припасами"

#: f_bracken_63_1_quests.cs
msgid "Supply crates recovered: {0}/5"
msgstr "Найденные ящики с припасами: {0}/5"

#: f_bracken_63_1_quests.cs
msgid "{#FFD700}All supplies recovered! Return to Milda.{/}"
msgstr "{#FFD700}Все припасы найдены! Вернуться к Милде.{/}"

#: f_bracken_63_1_quests.cs
msgid "Recovery cancelled."
msgstr "Восстановление отменено."

#: f_bracken_63_1_quests.cs
msgid "[Pathfinder] Jonas"
msgstr "[Pathfinder] Йонас"

#: f_bracken_63_1_quests.cs
msgid "Jonas"
msgstr "Йонас"

#: f_bracken_63_1_quests.cs
msgid "This pathway is a critical junction for jungle travelers."
msgstr "Эта тропа является важнейшим перекрестком для путешественников по джунглям."

#: f_bracken_63_1_quests.cs
msgid "But it's become overrun with both Parrot and Polibu - poison creatures everywhere!"
msgstr "Но теперь здесь полно и попугаев, и полибу — повсюду ядовитые существа!"

#: f_bracken_63_1_quests.cs
msgid "I can't safely guide people through here until the pathway is cleared."
msgstr "Я не смогу безопасно проводить людей по этому месту, пока тропа не будет расчищена."

#: f_bracken_63_1_quests.cs
msgid "Will you help me clear this route?"
msgstr "Не поможешь ли ты мне расчистить этот маршрут?"

#: f_bracken_63_1_quests.cs
msgid "I'll clear the pathway"
msgstr "Я расчищу дорожку"

#: f_bracken_63_1_quests.cs
msgid "How bad is it?"
msgstr "Насколько это плохо?"

#: f_bracken_63_1_quests.cs
msgid "Find another route"
msgstr "Найти другой маршрут"

#: f_bracken_63_1_quests.cs
msgid "Will you clear both the Parrot and Polibu from this pathway?"
msgstr "Не могли бы вы убрать с этой дорожки и «Parrot», и «Polibu»?"

#: f_bracken_63_1_quests.cs
msgid "Thank you! Both types of creatures have nested along this route."
msgstr "Спасибо! Оба вида животных гнездятся вдоль этого маршрута."

#: f_bracken_63_1_quests.cs
msgid "Drive back the Parrot and Polibu, and this pathway will be safe for travelers again."
msgstr "Отбросьте «Попугая» и «Полибу» — и этот путь снова станет безопасным для путешественников."

#: f_bracken_63_1_quests.cs
msgid "The Parrot trample everything in their path with those four legs."
msgstr "Попугаи своими четырьмя лапками раздавили всё на своём пути."

#: f_bracken_63_1_quests.cs
msgid "And the Polibu spread poison wherever they go."
msgstr "А «Полибу» разбрасывают яд везде, куда бы они ни пошли."

#: f_bracken_63_1_quests.cs
msgid "Together they've made this pathway completely impassable."
msgstr "Вместе они сделали этот путь совершенно непроходимым."

#: f_bracken_63_1_quests.cs
msgid "There are other routes, but they're much longer and more dangerous."
msgstr "Есть и другие маршруты, но они намного длиннее и опаснее."

#: f_bracken_63_1_quests.cs
msgid "This pathway needs to be cleared."
msgstr "Этот путь необходимо расчистить."

#: f_bracken_63_1_quests.cs
msgid "The pathway is clear! Both types of poison creatures are gone!"
msgstr "Путь свободен! Оба вида ядовитых существ уничтожены!"

#: f_bracken_63_1_quests.cs
msgid "I can resume guiding travelers safely through this route. Excellent work!"
msgstr "Я могу возобновить безопасное сопровождение туристов по этому маршруту. Отличная работа!"

#: f_bracken_63_1_quests.cs
msgid "Clear the Parrot from the pathway. "
msgstr "Уберите попугая с дорожки. "

#: f_bracken_63_1_quests.cs
msgid "Clear the Polibu from the pathway. "
msgstr "Уберите «Полибу» с дорожки. "

#: f_bracken_63_1_quests.cs
msgid "Keep clearing the route. {0}"
msgstr "Продолжай расчищать путь. {0}"

#: f_bracken_63_1_quests.cs
msgid "The pathway is safe and clear. Travelers can pass through without danger."
msgstr "Путь безопасен и свободен. Путешественники могут пройти по нему без опасности."

#: f_bracken_63_1_quests.cs
msgid "Thank you for helping me restore this critical route!"
msgstr "Спасибо, что помогли мне восстановить этот важнейший маршрут!"

#: f_bracken_63_1_quests.cs
msgid "{#66FF66}You feel a toxic miasma seeping into your body!{/}"
msgstr "{#66FF66}Вы чувствуете, как ядовитый миазм проникает в ваше тело!{/}"

#: f_bracken_63_1_quests.cs
msgid "{#FF6666}Tanu emerge from the poisonous undergrowth!{/}"
msgstr "{#FF6666}Тану вырывается из ядовитых зарослей!{/}"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Jungle Entry Patrol"
msgstr "Патруль по проникновению в джунгли"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear poison-tainted Polibu from the jungle entrance to make it safe for travelers."
msgstr "Устраните зараженный ядом Полибу у входа в джунгли, чтобы сделать его безопасным для путешественников."

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "[Scout] Kaina"
msgstr "[Разведчик] Кайна"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear poison-tainted Polibu"
msgstr "Очистить Полибу от яда"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Herb Gatherer's Plea"
msgstr "Мольба собирателя трав"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Protect the herbalist's garden by driving away poison-corrupted Parrot creatures."
msgstr "Защитите сад травника, прогнав заражённых ядом существ-попугаев."

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "[Herbalist] Ruta"
msgstr "[Травник] Рута"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Drive away Parrot creatures"
msgstr "Прогоните существ-попугаев"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Elevator Maintenance"
msgstr "Техническое обслуживание лифтов"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear Polibu from the elevator and inspect critical components for the engineer."
msgstr "Уберите «Полибу» из лифта и проверьте важные компоненты по поручению инженера."

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "[Engineer] Tomas"
msgstr "[Инженер] Томаш"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear poison creatures from the elevator area"
msgstr "Уничтожьте ядовитых существ в зоне лифта"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Inspect elevator components"
msgstr "Проверить детали лифта"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Waterfall Sanctuary"
msgstr "Заповедник «Водопад»"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Collect purifying water samples from sacred crystal formations near the waterfall."
msgstr "Соберите пробы очищающей воды из священных кристаллических образований возле водопада."

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "[Monk] Darius"
msgstr "[Монах] Дариус"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Collect water samples from purifying crystals"
msgstr "Соберите пробы воды из очищающих кристаллов"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Lost in the Mist"
msgstr "Заблудившись в тумане"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Help a lost merchant by clearing Leafnut and recovering her scattered supply crates."
msgstr "Помогите заблудившейся торговке, очистив Лифнат и собрав её разбросанные ящики с товарами."

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "[Lost Traveler] Milda"
msgstr "[Заблудившийся путешественник] Милда"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear Leafnut threats"
msgstr "Устранить угрозы со стороны «Листнута»"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Recover lost supply crates"
msgstr "Восстановите утраченные ящики с припасами"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Pathway Purge"
msgstr "Очистка траектории"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear the jungle pathway of both Parrot and Polibu to restore the safe travel route."
msgstr "Очистите тропу в джунглях от Попугая и Полибу, чтобы восстановить безопасный маршрут."

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "[Pathfinder] Jonas"
msgstr "[Pathfinder] Йонас"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear Parrot from the pathway"
msgstr "Уберите попугая с дорожки"

#: f_bracken_63_1_quests.cs (Quest Definitions)
msgid "Clear Polibu from the pathway"
msgstr "Уберите Полибу с дорожки"

# ============================================================================
# Srautas Gorge Quests (f_gele_57_1_quests.cs)
# ============================================================================

#: f_gele_57_1_quests.cs
msgid "Gorge Wildflower"
msgstr "Ущелье «Дикие цветы»"

#: f_gele_57_1_quests.cs
msgid "{#666666}*A beautiful wildflower with vibrant petals swaying in the breeze*{/}"
msgstr "{#666666}*Прекрасный полевой цветок с яркими лепестками, колышущимися на ветру*{/}"

#: f_gele_57_1_quests.cs
msgid "{#666666}*You've already collected stamens from this flower*{/}"
msgstr "{#666666}*Вы уже собрали тычинки с этого цветка*{/}"

#: f_gele_57_1_quests.cs
msgid "{#FF6666}Territorial Grummer emerge from the flowers!{/}"
msgstr "{#FF6666}Территориальные Граммеры вылезают из цветов!{/}"

#: f_gele_57_1_quests.cs
msgid "{#FF6666}Nearby Grummer notice you disturbing the flowers!{/}"
msgstr "{#FF6666}Находящийся поблизости Граммер заметил, что ты тревожишь цветы!{/}"

#: f_gele_57_1_quests.cs
msgid "Collecting flower stamens..."
msgstr "Сбор тычинок цветов..."

#: f_gele_57_1_quests.cs
msgid "Found: Wildflower Stamen"
msgstr "Найден: тычинка полевого цветка"

#: f_gele_57_1_quests.cs
msgid "Wildflower Stamens collected: {0}/6"
msgstr "Собранные тычинки полевых цветов: {0}/6"

#: f_gele_57_1_quests.cs
msgid "{#FFD700}All stamens collected! Return to the botanist.{/}"
msgstr "{#FFD700}Все тычинки собраны! Вернитесь к ботанику.{/}"

#: f_gele_57_1_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: f_gele_57_1_quests.cs
msgid "[Local Settler] Torin"
msgstr "[Местный поселенец] Торин"

#: f_gele_57_1_quests.cs
msgid "Torin"
msgstr "Торин"

#: f_gele_57_1_quests.cs
msgid "Welcome to Mieguista slope, traveler. Beautiful view, isn't it?"
msgstr "Добро пожаловать на склон Миегуиста, путешественник. Прекрасный вид, не правда ли?"

#: f_gele_57_1_quests.cs
msgid "{#666666}*He gestures toward the valley below, then his expression darkens*{/}"
msgstr "{#666666}*Он указывает рукой на долину внизу, после чего его лицо мрачнеет*{/}"

#: f_gele_57_1_quests.cs
msgid "It would be perfect... if not for the Panto problem. They're breeding out of control!"
msgstr "Всё было бы идеально... если бы не проблема с Панто. Они размножаются как сумасшедшие!"

#: f_gele_57_1_quests.cs
msgid "The slope used to be peaceful, but now they're everywhere!"
msgstr "Раньше на склоне было тихо и спокойно, а теперь они повсюду!"

#: f_gele_57_1_quests.cs
msgid "I'll thin their numbers"
msgstr "Я сокращу их число"

#: f_gele_57_1_quests.cs
msgid "What's the problem with Panto?"
msgstr "В чём проблема с «Панто»?"

#: f_gele_57_1_quests.cs
msgid "Good luck with that"
msgstr "Удачи тебе в этом"

#: f_gele_57_1_quests.cs
msgid "Would you really help? We need someone to clear out the Panto before they overrun the entire gorge!"
msgstr "Вы действительно поможете? Нам нужен кто-то, кто избавит нас от панто, пока они не заполонили всё ущелье!"

#: f_gele_57_1_quests.cs
msgid "Thank you! Hunt down 25 of them here on the slope. That should give us breathing room."
msgstr "Спасибо! Найдите здесь, на склоне, 25 из них. Это должно дать нам возможность передохнуть."

#: f_gele_57_1_quests.cs
msgid "Be careful - there are a LOT of them around here. They're everywhere you look."
msgstr "Будьте осторожны — их здесь ОЧЕНЬ МНОГО. Куда ни глянешь — везде они."

#: f_gele_57_1_quests.cs
msgid "Panto are normally harmless in small numbers, but they breed incredibly fast."
msgstr "Панто, как правило, в небольших количествах безвредны, но размножаются они невероятно быстро."

#: f_gele_57_1_quests.cs
msgid "A few months ago there were maybe a dozen on this slope. Now there are hundreds!"
msgstr "Несколько месяцев назад на этом склоне их было, наверное, с дюжину. А сейчас их уже сотни!"

#: f_gele_57_1_quests.cs
msgid "If we don't control their population now, they'll spread to the entire valley."
msgstr "Если мы не ограничим их численность сейчас, они распространятся по всей долине."

#: f_gele_57_1_quests.cs
msgid "Can't blame you. It's not your problem... yet."
msgstr "Не могу тебя винить. Это не твоя проблема… пока."

#: f_gele_57_1_quests.cs
msgid "You've cleared out a good number of them! I can already see the difference!"
msgstr "Ты убрал их немало! Я уже вижу разницу!"

#: f_gele_57_1_quests.cs
msgid "The slope feels safer now. Here - take this as thanks for your help."
msgstr "Теперь на склоне стало безопаснее. Вот — возьми это в знак благодарности за помощь."

#: f_gele_57_1_quests.cs
msgid "Keep hunting! The Panto are all around the slope - you won't have to look far."
msgstr "Продолжайте поиски! Панто разбросаны по всему склону — вам не придется долго искать."

#: f_gele_57_1_quests.cs
msgid "Thanks to you, we can actually enjoy the view again without Panto underfoot."
msgstr "Благодаря вам мы снова можем наслаждаться видом, не беспокоясь о том, что Панто будет под ногами."

#: f_gele_57_1_quests.cs
msgid "They'll breed back up eventually, but at least we have some peace for now."
msgstr "Со временем их популяция снова восстановится, но пока что у нас, по крайней мере, есть немного покоя."

#: f_gele_57_1_quests.cs
msgid "[Traveling Botanist] Elara"
msgstr "[Путешествующий ботаник] Элара"

#: f_gele_57_1_quests.cs
msgid "Elara"
msgstr "Элара"

#: f_gele_57_1_quests.cs
msgid "{#666666}*A woman in travel-worn robes examines the wildflowers with keen interest*{/}"
msgstr "{#666666}*Женщина в поношенной от путешествий одежде с живым интересом рассматривает полевые цветы*{/}"

#: f_gele_57_1_quests.cs
msgid "These flowers... they're exactly what I need for my medicinal research!"
msgstr "Эти цветы… они как раз то, что мне нужно для моих исследований в области медицины!"

#: f_gele_57_1_quests.cs
msgid "The stamens contain compounds that can treat fever and inflammation."
msgstr "Тычинки содержат вещества, которые помогают бороться с лихорадкой и воспалением."

#: f_gele_57_1_quests.cs
msgid "Can I help with your research?"
msgstr "Могу ли я помочь вам в исследовании?"

#: f_gele_57_1_quests.cs
msgid "What kind of medicine?"
msgstr "Какое лекарство?"

#: f_gele_57_1_quests.cs
msgid "You would help? That's wonderful!"
msgstr "Вы поможете? Это замечательно!"

#: f_gele_57_1_quests.cs
msgid "I need wildflower stamens from 6 different flowers in this area. But be careful - Grummer and Zignuts patrol these fields!"
msgstr "Мне нужны тычинки полевых цветов с 6 разных растений, растущих в этой местности. Но будьте осторожны — по этим полям патрулируют Граммер и Зигнутс!"

#: f_gele_57_1_quests.cs
msgid "The flowers are scattered throughout the southern meadow. Look for bright petals!"
msgstr "Цветы разбросаны по всей южной лужайке. Ищите яркие лепестки!"

#: f_gele_57_1_quests.cs
msgid "The creatures here are territorial. They might attack if you disturb the flowers. Stay alert!"
msgstr "Здешние существа очень территориальны. Они могут напасть, если вы потревожите цветы. Будьте начеку!"

#: f_gele_57_1_quests.cs
msgid "I'm researching natural remedies for post-war ailments. Many survivors suffer from lingering fevers."
msgstr "Я изучаю натуральные средства лечения послевоенных заболеваний. Многие выжившие страдают от затяжной лихорадки."

#: f_gele_57_1_quests.cs
msgid "These Srautas wildflowers contain compounds that reduce inflammation and fight infection."
msgstr "Эти полевые цветы Сраутас содержат вещества, которые снимают воспаление и борются с инфекцией."

#: f_gele_57_1_quests.cs
msgid "If I can perfect the formula, we could help countless people recover faster."
msgstr "Если мне удастся усовершенствовать эту формулу, мы сможем помочь бесчисленному количеству людей быстрее выздороветь."

#: f_gele_57_1_quests.cs
msgid "I understand. It is dangerous work gathering ingredients here."
msgstr "Понимаю. Сбор ингредиентов здесь — дело опасное."

#: f_gele_57_1_quests.cs
msgid "{#666666}*Her eyes light up as she sees the stamens*{/}"
msgstr "{#666666}*Ее глаза загораются, когда она видит тычинки*{/}"

#: f_gele_57_1_quests.cs
msgid "Perfect! These are exactly what I need! The pollen is still fresh!"
msgstr "Отлично! Это именно то, что мне нужно! Пыльца ещё свежая!"

#: f_gele_57_1_quests.cs
msgid "With these, I can create enough medicine to treat an entire village."
msgstr "С их помощью я смогу изготовить лекарства, которых хватит на лечение всей деревни."

#: f_gele_57_1_quests.cs
msgid "Here - take this glove. Drake leather is perfect for handling delicate flowers while staying protected."
msgstr "Вот — возьмите эту перчатку. Кожа Дрейка идеально подходит для работы с нежными цветами, при этом обеспечивая защиту рук."

#: f_gele_57_1_quests.cs
msgid "You have {0} stamens so far. I need 6 total from different flowers in the meadow."
msgstr "У тебя пока {0} тычинок. Мне нужно в общей сложности 6 тычинок с разных цветов на лугу."

#: f_gele_57_1_quests.cs
msgid "Watch for the Grummer and Zignuts - they don't like visitors disturbing their territory."
msgstr "Будьте осторожны с Граммером и Зигнутами — они не любят, когда посторонние вторгаются на их территорию."

#: f_gele_57_1_quests.cs
msgid "The medicine is working beautifully! Fever cases are dropping in the villages I visit."
msgstr "Лекарство действует просто великолепно! В деревнях, которые я посещаю, количество случаев лихорадки снижается."

#: f_gele_57_1_quests.cs
msgid "Thank you again for braving the flower fields. Your help saved lives."
msgstr "Еще раз спасибо за то, что вы отважились отправиться на цветочные поля. Ваша помощь спасла жизни."

#: f_gele_57_1_quests.cs
msgid "[Traveling Merchant] Gareth"
msgstr "[Странствующий купец] Гарет"

#: f_gele_57_1_quests.cs
msgid "Gareth"
msgstr "Гарет"

#: f_gele_57_1_quests.cs
msgid "Ah, a fellow traveler! Tell me - have you noticed the Panto in this meadow?"
msgstr "А, попутчик! Скажите, вы заметили Панто на этом лугу?"

#: f_gele_57_1_quests.cs
msgid "Their claws are prized by craftsmen! Sharp, durable, and perfect for making tools and weapons."
msgstr "Их когти очень ценятся мастерами! Они острые, прочные и идеально подходят для изготовления инструментов и оружия."

#: f_gele_57_1_quests.cs
msgid "I'm buying Panto Horns at good prices. Interested?"
msgstr "Я покупаю «Панто Хорнс» по выгодным ценам. Заинтересованы?"

#: f_gele_57_1_quests.cs
msgid "I'll hunt Panto for you"
msgstr "Я найду Панто для тебя"

#: f_gele_57_1_quests.cs
msgid "What makes their claws valuable?"
msgstr "Чем ценны их клешни?"

#: f_gele_57_1_quests.cs
msgid "Not interested"
msgstr "Неинтересно"

#: f_gele_57_1_quests.cs
msgid "Excellent! A hunter with initiative!"
msgstr "Отлично! Охотник с инициативой!"

#: f_gele_57_1_quests.cs
msgid "Bring me 15 Panto Horns and I'll pay you handsomely. I'll even throw in a special crafting recipe!"
msgstr "Принесите мне 15 «Панто-рожков», и я щедро вам заплачу. Я даже подарю вам специальный рецепт для крафта!"

#: f_gele_57_1_quests.cs
msgid "Hunt the Panto right here in the meadow. They're everywhere!"
msgstr "Охотьтесь на Панто прямо здесь, на лугу. Они повсюду!"

#: f_gele_57_1_quests.cs
msgid "Fair warning - the claws don't come off easily. You'll need to hunt quite a few to get 15 good ones."
msgstr "Предупреждаю заранее — когти снимаются не так-то просто. Чтобы собрать 15 хороших экземпляров, придётся поохотиться немало."

#: f_gele_57_1_quests.cs
msgid "Panto Horns are naturally sharp and retain their edge far longer than steel blades."
msgstr "Рога Панто по своей природе острые и сохраняют свою остроту гораздо дольше, чем стальные лезвия."

#: f_gele_57_1_quests.cs
msgid "Craftsmen use them for precision tools - surgical instruments, engraving tools, even weapon edges."
msgstr "Мастера используют их для изготовления прецизионных инструментов — хирургических инструментов, гравировальных инструментов и даже лезвий оружия."

#: f_gele_57_1_quests.cs
msgid "A single quality claw can be worth its weight in silver to the right buyer."
msgstr "Для подходящего покупателя один качественный коготь может стоить своего веса в серебре."

#: f_gele_57_1_quests.cs
msgid "Your loss! These claws practically sell themselves in the cities."
msgstr "Ваша потеря! Эти когти в городах раскупают буквально мгновенно."

#: f_gele_57_1_quests.cs
msgid "{#666666}*He examines the claws carefully, nodding with approval*{/}"
msgstr "{#666666}*Он внимательно осматривает когти и одобрительно кивает*{/}"

#: f_gele_57_1_quests.cs
msgid "Perfect quality! These will fetch a fine price in Klaipeda!"
msgstr "Отличное качество! В Клайпеде за них можно будет получить хорошую цену!"

#: f_gele_57_1_quests.cs
msgid "You're a skilled hunter. Here's your payment - plus this recipe for a Panto Sword."
msgstr "Ты — опытный охотник. Вот твоя плата — и вот рецепт изготовления меча «Панто»."

#: f_gele_57_1_quests.cs
msgid "It's an old design using Panto parts. Fitting reward for a Panto hunter, wouldn't you say?"
msgstr "Это старая конструкция, в которой использованы детали Panto. Достойная награда для охотника за деталями Panto, не правда ли?"

#: f_gele_57_1_quests.cs
msgid "You have {0} claws so far. Keep hunting - I need 15 quality claws."
msgstr "У тебя пока {0} когтей. Продолжай охотиться — мне нужно 15 качественных когтей."

#: f_gele_57_1_quests.cs
msgid "The meadow is full of Panto. You won't have to search far."
msgstr "Луг просто кишит Панто. Вам не придется долго искать."

#: f_gele_57_1_quests.cs
msgid "Those claws you brought sold out in two days! Craftsmen were fighting over them!"
msgstr "Те когти, которые ты привез, разошлись за два дня! Мастера буквально дрались за них!"

#: f_gele_57_1_quests.cs
msgid "If you find more quality claws, I'll buy them. A hunter like you is always welcome."
msgstr "Если найдёшь ещё качественные когти, я их куплю. Такой охотник, как ты, всегда приветствуется."

#: f_gele_57_1_quests.cs
msgid "[Caravan Organizer] Roland"
msgstr "[Организатор каравана] Роланд"

#: f_gele_57_1_quests.cs
msgid "Roland"
msgstr "Роланд"

#: f_gele_57_1_quests.cs
msgid "Our supply caravans can't reach Gele Plateau anymore. The path is too dangerous for wagons."
msgstr "Наши караваны с продовольствием больше не могут добраться до плато Геле. Путь слишком опасен для повозок."

#: f_gele_57_1_quests.cs
msgid "{#666666}*He gestures toward the plateau rising above the gorge*{/}"
msgstr "{#666666}*Он указывает на плато, возвышающееся над ущельем*{/}"

#: f_gele_57_1_quests.cs
msgid "The outpost up there is running low on provisions. They need help urgently."
msgstr "У того аванпоста там наверху заканчиваются припасы. Им срочно нужна помощь."

#: f_gele_57_1_quests.cs
msgid "Would you carry emergency food supplies to the outpost? They're desperate up there."
msgstr "Не могли бы вы доставить на аванпост запасы продовольствия на случай чрезвычайной ситуации? Там ситуация критическая."

#: f_gele_57_1_quests.cs
msgid "Thank you! Head through the northern passage to Gele Plateau."
msgstr "Спасибо! Пройдите через северный проход к плато Геле."

#: f_gele_57_1_quests.cs
msgid "Look for Scout Miriam at the outpost entrance. She's coordinating the supply distribution."
msgstr "Поищите разведчицу Мириам у входа в аванпост. Она координирует распределение припасов."

#: f_gele_57_1_quests.cs
msgid "I understand. It's a difficult trek. But those people up there are counting on us..."
msgstr "Я понимаю. Это сложный поход. Но те люди там рассчитывают на нас..."

#: f_gele_57_1_quests.cs
msgid "The supplies need to reach Scout Miriam at the Gele Plateau outpost entrance."
msgstr "Груз необходимо доставить скауту Мириам у входа в аванпост на плато Геле."

#: f_gele_57_1_quests.cs
msgid "Head north through the passage. The path is steep but well-marked."
msgstr "Идите на север по проходу. Тропа крутая, но хорошо обозначена."

#: f_gele_57_1_quests.cs
msgid "Word came back - the supplies arrived safely! The outpost is grateful."
msgstr "Поступило известие — груз благополучно доставлен! На аванпосте всем очень благодарны."

#: f_gele_57_1_quests.cs
msgid "You've helped keep them going until proper caravans can get through again."
msgstr "Вы помогли им продержаться до тех пор, пока по дороге снова смогут проехать полноценные автофургоны."

#: f_gele_57_1_quests.cs
msgid "[Ranger] Lynn"
msgstr "[Рейнджер] Линн"

#: f_gele_57_1_quests.cs
msgid "Lynn"
msgstr "Линн"

#: f_gele_57_1_quests.cs
msgid "{#666666}*A weathered ranger scans the gorge with a practiced eye*{/}"
msgstr "{#666666}*Опытный рейнджер просматривает ущелье своим натренированным взглядом*{/}"

#: f_gele_57_1_quests.cs
msgid "The eastern gorge needs patrolling. Grummer have been multiplying, and there's something worse..."
msgstr "Восточное ущелье нужно патрулировать. Граммеры размножаются, и есть кое-что ещё хуже..."

#: f_gele_57_1_quests.cs
msgid "{#FF6666}Cafrisun.{/} An elite Panto warrior. Extremely dangerous. It's been terrorizing travelers on the road."
msgstr "{#FF6666}Кафрисун.{/} Элитный воин Панто. Чрезвычайно опасен. Уже давно терроризирует путешественников на дороге."

#: f_gele_57_1_quests.cs
msgid "I need someone skilled to clear the area and hunt that beast."
msgstr "Мне нужен опытный человек, который расчистит эту местность и выследит эту bestia."

#: f_gele_57_1_quests.cs
msgid "I'll patrol the gorge"
msgstr "Я буду патрулировать ущелье"

#: f_gele_57_1_quests.cs
msgid "Tell me about Cafrisun"
msgstr "Расскажите мне о препарате «Кафрисун»"

#: f_gele_57_1_quests.cs
msgid "That sounds too dangerous"
msgstr "Это звучит слишком опасно"

#: f_gele_57_1_quests.cs
msgid "You've got courage, I'll give you that."
msgstr "У тебя есть смелость, это надо признать."

#: f_gele_57_1_quests.cs
msgid "Clear out 15 Grummer, then track down Cafrisun. Can you handle it?"
msgstr "Уничтожьте 15 Граммеров, а затем найдите Кафрисуна. Сможете ли вы с этим справиться?"

#: f_gele_57_1_quests.cs
msgid "Head east into the gorge. The Grummer patrol the southern areas."
msgstr "Направляйтесь на восток, в ущелье. Южные районы патрулируют Граммеры."

#: f_gele_57_1_quests.cs
msgid "{#FF6666}Cafrisun spawns in the eastern section. Be ready - it's fast, strong, and doesn't go down easy.{/}"
msgstr "{#FF6666}Кафрисун появляется в восточной части. Будьте готовы — он быстр, силен и с ним не так-то просто справиться.{/}"

#: f_gele_57_1_quests.cs
msgid "That beast has elite training and weapons. Don't underestimate it."
msgstr "У этого чудовища — элитная подготовка и оружие. Не стоит его недооценивать."

#: f_gele_57_1_quests.cs
msgid "Cafrisun is a Panto Javelin warrior - elite rank. Far more dangerous than common Panto."
msgstr "Кафрисун — воин Панто, владеющий копьем, элитного ранга. Он гораздо опаснее обычных панто."

#: f_gele_57_1_quests.cs
msgid "It's smart, aggressive, and carries a wickedly sharp javelin. I've seen it take down three soldiers alone."
msgstr "Оно умное, агрессивное и вооружено чертовски острым копьем. Я видел, как оно в одиночку сразило троих солдат."

#: f_gele_57_1_quests.cs
msgid "Only hunters with real skill should attempt to face it. Most travelers just avoid that section entirely."
msgstr "Только опытные охотники должны пытаться справиться с ним. Большинство путешественников просто обходят этот участок стороной."

#: f_gele_57_1_quests.cs
msgid "I don't blame you. Cafrisun isn't something to face unprepared."
msgstr "Я тебя не виню. К «Кафрисуну» нельзя подходить неподготовленным."

#: f_gele_57_1_quests.cs
msgid "{#666666}*She looks at you with newfound respect*{/}"
msgstr "{#666666}*Она смотрит на тебя с новым уважением*{/}"

#: f_gele_57_1_quests.cs
msgid "You actually took down Cafrisun? That beast has been plaguing us for weeks!"
msgstr "Ты действительно победил Кафрисуна? Этот монстр мучил нас уже несколько недель!"

#: f_gele_57_1_quests.cs
msgid "The gorge is safe again. Travelers can use the eastern road without fear."
msgstr "Ущелье снова безопасно. Путешественники могут без опасений пользоваться восточной дорогой."

#: f_gele_57_1_quests.cs
msgid "Here - this boot is a ranger's secret. Drake leather boots will serve you well on patrol."
msgstr "Вот — эти сапоги — секрет рейнджера. Кожаные сапоги «Дрейк» отлично послужат вам во время патрулирования."

#: f_gele_57_1_quests.cs
msgid "Start with the Grummer in the southern sections. They're dangerous but manageable."
msgstr "Начните с Граммеров в южных участках. Они опасны, но с ними можно справиться."

#: f_gele_57_1_quests.cs
msgid "Save your strength for Cafrisun - you'll need it."
msgstr "Приберегите силы для Кафрисуна — они вам понадобятся."

#: f_gele_57_1_quests.cs
msgid "{#FF6666}Now for the real challenge - Cafrisun patrols the eastern gorge.{/}"
msgstr "{#FF6666}А теперь самое сложное — Кафрисун патрулирует восточное ущелье.{/}"

#: f_gele_57_1_quests.cs
msgid "It's fast and hits hard. Keep moving, watch for its javelin throws, and don't let it corner you."
msgstr "Он быстр и наносит мощные удары. Не останавливайтесь, следите за его бросками копьем и не дайте ему загнать вас в угол."

#: f_gele_57_1_quests.cs
msgid "The gorge has been quiet since you dealt with Cafrisun. No more attacks on travelers."
msgstr "С тех пор, как ты разобрался с Кафрисуном, в ущелье воцарилось спокойствие. Нападать на путешественников больше не стали."

#: f_gele_57_1_quests.cs
msgid "You've got the skills of a true ranger. If you ever need work, look me up."
msgstr "У тебя навыки настоящего рейнджера. Если когда-нибудь понадобится работа, обращайся ко мне."

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Panto Population Control"
msgstr "Контроль численности панто"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Help Torin thin the Panto population on Mieguista slope before they overrun the entire gorge."
msgstr "Помоги Торину сократить численность панто на склоне Мегиста, пока они не заполонили всё ущелье."

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "[Local Settler] Torin"
msgstr "[Местный поселенец] Торин"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Hunt Panto"
msgstr "«Хант Панто»"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Honey for the Hives"
msgstr "Мед для ульев"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Help the traveling botanist collect wildflower stamens from the dangerous flower fields patrolled by territorial Grummer and Zignuts."
msgstr "Помогите путешествующему ботанику собрать тычинки диких цветов на опасных цветочных полях, которые патрулируют территориальные Граммеры и Зигнуты."

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "[Traveling Botanist] Elara"
msgstr "[Путешествующий ботаник] Элара"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Collect Wildflower Stamens"
msgstr "Соберите тычинки полевых цветов"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Merchant's Panto Problem"
msgstr "Проблема с пантомимой у торговца"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Hunt Panto in the meadow and collect 15 valuable Panto Horns for the traveling merchant Gareth."
msgstr "Охотьтесь на Панто на лугу и соберите 15 ценных рогов Панто для странствующего торговца Гарета."

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "[Traveling Merchant] Gareth"
msgstr "[Странствующий купец] Гарет"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Collect Panto Horns"
msgstr "Собери рожки Панто"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Gorge Delivery Service"
msgstr "Служба доставки «Gorge»"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Deliver emergency food supplies from Srautas Gorge to the isolated outpost on Gele Plateau."
msgstr "Доставьте экстренные продовольственные запасы из ущелья Сраутас в изолированный аванпост на плато Геле."

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "[Caravan Organizer] Roland"
msgstr "[Организатор каравана] Роланд"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Deliver supplies to Scout Miriam on Gele Plateau"
msgstr "Доставьте припасы скауту Мириам на плато Геле"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "The Gorge Patrol"
msgstr "Патруль ущелья"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Patrol the eastern gorge, clear Grummer threats, and hunt down the dangerous elite warrior Cafrisun."
msgstr "Патрулируйте восточное ущелье, устраняйте угрозы со стороны Граммеров и выследите опасного элитного воина Кафрисуна."

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "[Ranger] Lynn"
msgstr "[Рейнджер] Линн"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Hunt Grummer"
msgstr "Хант Груммер"

#: f_gele_57_1_quests.cs (Quest Definitions)
msgid "Hunt Cafrisun"
msgstr "Хант Кафрисун"

# ============================================================================
# Gytis Settlement Quests (f_siauliai_50_1_quests.cs)
# ============================================================================

#: f_siauliai_50_1_quests.cs
msgid "Crop Bundle"
msgstr "Набор культур"

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*A bundle of fresh crops tied together with twine*{/}"
msgstr "{#666666}*Связка свежих урожаев, перевязанная бечевкой*{/}"

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*You've already collected this bundle*{/}"
msgstr "{#666666}*Вы уже получили этот набор*{/}"

#: f_siauliai_50_1_quests.cs
msgid "{#FF6666}Angry pumpkin monsters emerge from the crops!{/}"
msgstr "{#FF6666}Из полей вылезают злобные тыквенные монстры!{/}"

#: f_siauliai_50_1_quests.cs
msgid "Collecting crops..."
msgstr "Сбор урожая..."

#: f_siauliai_50_1_quests.cs
msgid "Crop bundles collected: {0}/11"
msgstr "Собранные снопы: {0}/11"

#: f_siauliai_50_1_quests.cs
msgid "{#FFD700}All bundles collected! Return to Jonas.{/}"
msgstr "{#FFD700}Все посылки собраны! Вернитесь к Йонасу.{/}"

#: f_siauliai_50_1_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

#: f_siauliai_50_1_quests.cs
msgid "[Concerned Farmer] Marta"
msgstr "[Обеспокоенная фермерша] Марта"

#: f_siauliai_50_1_quests.cs
msgid "Marta"
msgstr "Марта"

#: f_siauliai_50_1_quests.cs
msgid "Those orange pumpkin things... they've gotten so aggressive! I've never seen them act like this before."
msgstr "Эти оранжевые тыквы... они стали такими агрессивными! Я никогда раньше не видел, чтобы они так себя вели."

#: f_siauliai_50_1_quests.cs
msgid "I'm worried about the other farmers scattered across the settlement. They need to be warned about these monsters before someone gets hurt!"
msgstr "Я беспокоюсь за других фермеров, разбросанных по всему поселению. Их нужно предупредить об этих чудовищах, пока никто не пострадал!"

#: f_siauliai_50_1_quests.cs
msgid "Will you help me warn the farmers?"
msgstr "Не поможете ли вы мне предупредить фермеров?"

#: f_siauliai_50_1_quests.cs
msgid "I'll deliver the warnings"
msgstr "Я передам эти предупреждения"

#: f_siauliai_50_1_quests.cs
msgid "What happened to the pumpkins?"
msgstr "А что стало с тыквами?"

#: f_siauliai_50_1_quests.cs
msgid "Stay safe"
msgstr "Берегите себя"

#: f_siauliai_50_1_quests.cs
msgid "Thank you! I've written warning letters for the other farmers. Can you deliver them to Gregor at Ziuluti Vacant Lot, Henrik by the bridge of Joint Farmland, and Aldric near the Bandrass Forkroad?"
msgstr "Спасибо! Я написал предупредительные письма для других фермеров. Не могли бы вы передать их Грегору на пустыре в Зиулути, Хенрику у моста на Объединённых сельскохозяйственных угодьях и Олдрику возле развилки в Бандрассе?"

#: f_siauliai_50_1_quests.cs
msgid "Here are the letters. Please hurry - the pumpkins are getting more violent every day!"
msgstr "Вот письма. Пожалуйста, поторопитесь — тыквы с каждым днем становятся всё более агрессивными!"

#: f_siauliai_50_1_quests.cs
msgid "They used to be peaceful, just regular farm pests. But something's changed... there's a darkness in them now."
msgstr "Раньше они были мирными, обычными сельскохозяйственными вредителями. Но что-то изменилось… теперь в них таится тьма."

#: f_siauliai_50_1_quests.cs
msgid "Some say it's leftover corruption from the demon war. Whatever it is, they're dangerous now."
msgstr "Некоторые говорят, что это пережитки коррупции, оставшиеся после войны с демонами. Что бы это ни было, сейчас они представляют опасность."

#: f_siauliai_50_1_quests.cs
msgid "I understand. I'll wait here near the Klaipeda entrance where it's safer."
msgstr "Понятно. Я подожду здесь, возле въезда в Клайпеду, где безопаснее."

#: f_siauliai_50_1_quests.cs
msgid "You've warned everyone! Thank you so much. Now at least they can prepare defenses."
msgstr "Ты всех предупредил! Огромное спасибо. Теперь они, по крайней мере, смогут подготовиться к обороне."

#: f_siauliai_50_1_quests.cs
msgid "Here, take this. It's not much, but you've done us all a great service today."
msgstr "Вот, возьми. Это не много, но ты сегодня оказал нам всем огромную услугу."

#: f_siauliai_50_1_quests.cs
msgid "Please deliver the warnings to: {0}."
msgstr "Пожалуйста, отправьте предупреждения по адресу: {0}."

#: f_siauliai_50_1_quests.cs
msgid "The other farmers are taking precautions now. You may have saved lives today."
msgstr "Другие фермеры уже принимают меры предосторожности. Возможно, сегодня вы спасли чьи-то жизни."

#: f_siauliai_50_1_quests.cs
msgid "[Farmer] Gregor"
msgstr "[Фермер] Грегор"

#: f_siauliai_50_1_quests.cs
msgid "Gregor"
msgstr "Грегор"

#: f_siauliai_50_1_quests.cs
msgid "A letter from Marta? Let me see..."
msgstr "Письмо от Марты? Дай-ка посмотрю..."

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*He reads the warning letter with growing concern*{/}"
msgstr "{#666666}*Он читает предупредительное письмо с нарастающим беспокойством*{/}"

#: f_siauliai_50_1_quests.cs
msgid "By the goddesses... the pumpkins are that aggressive now? I need to warn my workers immediately!"
msgstr "Богини, да что это... тыквы уже до такой степени агрессивны? Мне нужно немедленно предупредить своих работников!"

#: f_siauliai_50_1_quests.cs
msgid "Thank you for bringing this warning. I'll make sure everyone here stays alert."
msgstr "Спасибо, что предупредили. Я позабочусь о том, чтобы все здесь оставались начеку."

#: f_siauliai_50_1_quests.cs
msgid "The fields are overrun! Those cursed Orange Sakmoli and Black Ridimed are destroying everything we've planted!"
msgstr "Поля захвачены! Эти проклятые «Оранжевые Сакмоли» и «Чёрные Ридимеды» уничтожают всё, что мы посадили!"

#: f_siauliai_50_1_quests.cs
msgid "We can't harvest anything with them swarming the area. Someone needs to clear them out!"
msgstr "Пока они роятся в этой местности, мы не сможем ничего собрать. Кто-нибудь должен их оттуда прогнать!"

#: f_siauliai_50_1_quests.cs
msgid "Will you help us clear the fields? We need both the pumpkins and the Ridimed dealt with!"
msgstr "Не поможете ли вы нам убрать поля? Нам нужно избавиться и от тыкв, и от «Ридимеда»!"

#: f_siauliai_50_1_quests.cs
msgid "Bless you! Clear out at least 15 of each - that should give us breathing room to work."
msgstr "Спасибо! Уберите по крайней мере по 15 штук каждого вида — это должно дать нам немного свободного места для работы."

#: f_siauliai_50_1_quests.cs
msgid "Watch yourself out there. The Sakmoli are violent, and there are swarms of Ridimed everywhere."
msgstr "Будьте осторожны там. Сакмоли очень агрессивны, а ридимеды там повсюду роями."

#: f_siauliai_50_1_quests.cs
msgid "I understand. It's dangerous work. We'll manage somehow..."
msgstr "Понимаю. Это опасная работа. Мы как-нибудь справимся..."

#: f_siauliai_50_1_quests.cs
msgid "You've cleared them out! I can already see my workers heading back to the fields!"
msgstr "Вы их всех расчистили! Я уже вижу, как мои рабочие возвращаются на поля!"

#: f_siauliai_50_1_quests.cs
msgid "This is exactly what we needed. Here - you've more than earned this reward."
msgstr "Это именно то, что нам было нужно. Вот — ты более чем заслужил эту награду."

#: f_siauliai_50_1_quests.cs
msgid "Keep at it! We need both the Orange Sakmoli and the Black Ridimed cleared out."
msgstr "Не сдавайтесь! Нам нужно очистить и «Оранжевый Сакмоли», и «Чёрный Ридимед»."

#: f_siauliai_50_1_quests.cs
msgid "The fields are finally safe enough to work again. You have our gratitude."
msgstr "Наконец-то на полях снова можно безопасно работать. Мы вам очень благодарны."

#: f_siauliai_50_1_quests.cs
msgid "Farming isn't easy in times like these. But we manage."
msgstr "В такие времена заниматься сельским хозяйством нелегко. Но мы справляемся."

#: f_siauliai_50_1_quests.cs
msgid "[Farmer] Henrik"
msgstr "[Фермер] Хенрик"

#: f_siauliai_50_1_quests.cs
msgid "Henrik"
msgstr "Хенрик"

#: f_siauliai_50_1_quests.cs
msgid "Marta sent you? What's wrong?"
msgstr "Марта тебя прислала? Что случилось?"

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*He reads the letter, his face growing pale*{/}"
msgstr "{#666666}*Он читает письмо, и его лицо бледнеет*{/}"

#: f_siauliai_50_1_quests.cs
msgid "This is worse than I thought. I've been watching those pumpkins... there's something unnatural about them."
msgstr "Это хуже, чем я думал. Я наблюдал за этими тыквами… в них есть что-то неестественное."

#: f_siauliai_50_1_quests.cs
msgid "Thank you for the warning. I'll keep my distance from those monsters."
msgstr "Спасибо за предупреждение. Буду держаться подальше от этих чудовищ."

#: f_siauliai_50_1_quests.cs
msgid "I've been studying those Orange Sakmoli pumpkins from a safe distance. There's definitely something wrong with them."
msgstr "Я наблюдал за этими оранжевыми тыквами сорта «Сакмоли» с безопасного расстояния. С ними явно что-то не так."

#: f_siauliai_50_1_quests.cs
msgid "They drop these strange stems - dark, corrupted-looking things. If I could examine them, I might understand what's causing this aggression."
msgstr "Они роняют эти странные стебли — тёмные, выглядящие как-то ненормально. Если бы я смог их изучить, то, возможно, понял бы, что вызывает эту агрессию."

#: f_siauliai_50_1_quests.cs
msgid "Would you collect some Tough Orange Sakmoli Stems for me? I need about 8 to properly study them."
msgstr "Не могли бы вы собрать для меня несколько стеблей «Тёф Орандж Сакмоли»? Мне нужно около 8 штук, чтобы как следует их изучить."

#: f_siauliai_50_1_quests.cs
msgid "Excellent! Be careful when fighting them - they're unpredictable and violent."
msgstr "Отлично! Будьте осторожны в бою с ними — они непредсказуемы и агрессивны."

#: f_siauliai_50_1_quests.cs
msgid "Bring me the stems when you have enough. I'll see if I can identify the source of the corruption."
msgstr "Принеси мне стебли, когда их наберёшь достаточно. Я попробую выяснить, откуда взялась эта порча."

#: f_siauliai_50_1_quests.cs
msgid "I understand. Fighting those monsters is dangerous work."
msgstr "Понимаю. Сражаться с этими монстрами — дело опасное."

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*He examines the corrupted stems carefully*{/}"
msgstr "{#666666}*Он внимательно осматривает поврежденные стебли*{/}"

#: f_siauliai_50_1_quests.cs
msgid "Just as I suspected... these stems are saturated with dark magic. This is definitely lingering corruption from the demon war."
msgstr "Как я и подозревал… эти стебли пропитаны тёмной магией. Это, несомненно, остатки порчи, оставшиеся после войны с демонами."

#: f_siauliai_50_1_quests.cs
msgid "At least now we know what we're dealing with. Thank you for gathering these samples."
msgstr "По крайней мере, теперь мы знаем, с чем имеем дело. Спасибо, что собрали эти образцы."

#: f_siauliai_50_1_quests.cs
msgid "Keep gathering those stems. I need 8 total to properly study the corruption (you have {0})."
msgstr "Продолжайте собирать эти стебли. Мне нужно в общей сложности 8 штук, чтобы как следует изучить порчу (у вас их {0})."

#: f_siauliai_50_1_quests.cs
msgid "The corruption in those stems confirms my fears. We're dealing with demon war remnants."
msgstr "Повреждения в этих стеблях подтверждают мои опасения. Мы имеем дело с остатками демонической войны."

#: f_siauliai_50_1_quests.cs
msgid "These pumpkins weren't always so aggressive. Something changed them."
msgstr "Эти тыквы не всегда были такими агрессивными. Что-то их изменило."

#: f_siauliai_50_1_quests.cs
msgid "[Farmer] Aldric"
msgstr "[Фермер] Олдрик"

#: f_siauliai_50_1_quests.cs
msgid "Aldric"
msgstr "Олдрик"

#: f_siauliai_50_1_quests.cs
msgid "A letter? What's this about?"
msgstr "Письмо? О чём речь?"

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*He unfolds the letter and reads quickly*{/}"
msgstr "{#666666}*Он разворачивает письмо и быстро читает*{/}"

#: f_siauliai_50_1_quests.cs
msgid "The pumpkins are getting that bad? I've had my own problems with those damn rabbits stealing vegetables!"
msgstr "Тыквы уже до такой степени пострадали? У меня тоже были проблемы с этими проклятыми кроликами, которые крадут овощи!"

#: f_siauliai_50_1_quests.cs
msgid "Thanks for the warning. At least the rabbits aren't violent like those pumpkins."
msgstr "Спасибо за предупреждение. По крайней мере, кролики не такие агрессивные, как эти тыквы."

#: f_siauliai_50_1_quests.cs
msgid "Every night, those sneaky Lepusbunny Assassins raid my vegetable garden. They're not aggressive, but they're relentless!"
msgstr "Каждую ночь эти хитрые кролики-убийцы нападают на мой огород. Они не агрессивны, но зато неумолимы!"

#: f_siauliai_50_1_quests.cs
msgid "I've tried everything - fences, scarecrows, even staying up to chase them off. Nothing works!"
msgstr "Я перепробовал всё — заборы, пугала, даже не ложился спать, чтобы прогнать их. Ничего не помогает!"

#: f_siauliai_50_1_quests.cs
msgid "Could you help me reduce their numbers? If we thin them out a bit, maybe my crops will have a chance!"
msgstr "Не могли бы вы помочь мне уменьшить их количество? Если мы их немного проредим, может быть, у моего урожая появится шанс!"

#: f_siauliai_50_1_quests.cs
msgid "Thank you! Hunt down at least 6 of those rabbits. That should discourage the rest from raiding my garden."
msgstr "Спасибо! Отловите хотя бы шесть таких кроликов. Это должно отбить у остальных охоту нападать на мой огород."

#: f_siauliai_50_1_quests.cs
msgid "They're not dangerous - mostly they just run away. But there are so many of them!"
msgstr "Они не опасны — в основном просто убегают. Но их так много!"

#: f_siauliai_50_1_quests.cs
msgid "I understand. I'll keep trying to protect my crops somehow..."
msgstr "Понятно. Буду и дальше пытаться как-то защитить свой урожай..."

#: f_siauliai_50_1_quests.cs
msgid "Finally! I can already see fewer rabbits around my garden!"
msgstr "Наконец-то! Я уже вижу, что кроликов вокруг моего сада стало меньше!"

#: f_siauliai_50_1_quests.cs
msgid "My vegetables might actually survive the season now. Here, this is for your help."
msgstr "Похоже, мои овощи теперь всё-таки переживут этот сезон. Вот, это вам в благодарность за помощь."

#: f_siauliai_50_1_quests.cs
msgid "Keep hunting those rabbits! My vegetables are counting on you!"
msgstr "Продолжай охотиться на кроликов! Мои овощи рассчитывают на тебя!"

#: f_siauliai_50_1_quests.cs
msgid "My garden is doing so much better now. Thank you again!"
msgstr "Мой сад теперь выглядит гораздо лучше. Еще раз спасибо!"

#: f_siauliai_50_1_quests.cs
msgid "Farming is hard enough without pests stealing everything you grow."
msgstr "Сельское хозяйство и без того достаточно тяжелое занятие, а тут ещё и вредители крадут всё, что ты вырастил."

#: f_siauliai_50_1_quests.cs
msgid "[Farmer] Jonas"
msgstr "[Фермер] Йонас"

#: f_siauliai_50_1_quests.cs
msgid "Look around - this is one of the last areas where crops are still growing healthy!"
msgstr "Посмотрите вокруг — это один из последних районов, где урожай до сих пор растёт здоровым!"

#: f_siauliai_50_1_quests.cs
msgid "The monsters are getting closer every day. I need to harvest everything quickly, but there's too much for one person!"
msgstr "Монстры с каждым днём приближаются всё ближе. Мне нужно побыстрее собрать весь урожай, но для одного человека это слишком много!"

#: f_siauliai_50_1_quests.cs
msgid "Could you help me gather crop bundles from the fields? There are 11 bundles scattered around - we need to work fast before the monsters arrive!"
msgstr "Не могли бы вы помочь мне собрать снопы с полей? Там разбросано 11 снопов — нам нужно поспешить, пока не появились монстры!"

#: f_siauliai_50_1_quests.cs
msgid "Thank you! The bundles are tied with twine and ready to collect. Gather all 11 and bring them back here."
msgstr "Спасибо! Снопы связаны бечевкой и готовы к сбору. Соберите все 11 и принесите их обратно сюда."

#: f_siauliai_50_1_quests.cs
msgid "This might be the last good harvest we get this season. Every bundle counts!"
msgstr "Возможно, это будет последний хороший урожай в этом сезоне. Каждый сноп на счету!"

#: f_siauliai_50_1_quests.cs
msgid "I understand. I'll do what I can, though it'll take much longer alone..."
msgstr "Понятно. Я сделаю, что смогу, хотя в одиночку это займет гораздо больше времени..."

#: f_siauliai_50_1_quests.cs
msgid "You got all of them! These crops will feed families through the winter!"
msgstr "Ты собрал их все! Эти урожаи прокормят семьи всю зиму!"

#: f_siauliai_50_1_quests.cs
msgid "{#666666}*He carefully stores the bundles in his cart*{/}"
msgstr "{#666666}*Он аккуратно укладывает вязанки в свою тележку*{/}"

#: f_siauliai_50_1_quests.cs
msgid "You've given us hope. As long as we can harvest, we can survive. Thank you."
msgstr "Вы подарили нам надежду. Пока мы можем собирать урожай, мы сможем выжить. Спасибо вам."

#: f_siauliai_50_1_quests.cs
msgid "Keep gathering those bundles! I need all 11 to make the harvest worthwhile (you have {0})."
msgstr "Продолжайте собирать эти снопы! Мне нужно все 11, чтобы урожай окупился (у вас {0})."

#: f_siauliai_50_1_quests.cs
msgid "Those crops you helped me gather will sustain multiple families. You did good work."
msgstr "Те урожаи, которые ты помог мне собрать, прокормят целые семьи. Ты отлично поработал."

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Warning the Farmers"
msgstr "Предупреждение фермерам"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Deliver warning letters to farmers across the Gytis Settlement Area about aggressive Orange Sakmoli monsters."
msgstr "Разошлите предупредительные письма фермерам по всей территории поселения Гытис об агрессивных монстрах «Оранжевый Сакмоли»."

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "[Concerned Farmer] Marta"
msgstr "[Обеспокоенная фермерша] Марта"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Deliver warning to Gregor at Ziuluti Vacant Lot"
msgstr "Передайте предупреждение Грегору на пустыре в Зиулути"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Deliver warning to Henrik at Joint Farmland"
msgstr "Передайте предупреждение Хенрику на ферме «Joint Farmland»"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Deliver warning to Aldric by the Bandrass Forkroad"
msgstr "Передайте предупреждение Олдрику у перекрестка Бэндрасс"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Clearing the Fields"
msgstr "Расчистка полей"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Clear Orange Sakmoli and Black Ridimed from the farmland to protect the crops."
msgstr "Уберите «Оранжевый Сакмоли» и «Черный Ридимед» с сельскохозяйственных угодий, чтобы защитить урожай."

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "[Farmer] Gregor"
msgstr "[Фермер] Грегор"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Hunt Orange Sakmoli"
msgstr "Хант Орандж Сакмоли"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Hunt Black Ridimed"
msgstr "Хант Блэк Ридимед"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "The Seed of Corruption"
msgstr "Семя разложения"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Collect Tough Orange Sakmoli Stems to help Henrik study the corruption affecting the pumpkin monsters."
msgstr "Собери крепкие оранжевые стебли сакмоли, чтобы помочь Хенрику изучить коррупцию, поражающую тыквенных монстров."

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "[Farmer] Henrik"
msgstr "[Фермер] Хенрик"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Collect Tough Orange Sakmoli Stems from Orange Sakmoli"
msgstr "Соберите прочные стебли оранжевого сакмоли у оранжевого сакмоли"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Rabbit Problem"
msgstr "Проблема с кроликами"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Help Aldric by reducing the population of Lepusbunny Assassins raiding his vegetable garden."
msgstr "Помогите Олдрику, сократив численность убийц-кроликов Лепусбани, нападающих на его огород."

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "[Farmer] Aldric"
msgstr "[Фермер] Олдрик"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Hunt Lepusbunny Assassins"
msgstr "Охота на кроликов-убийц Lepusbunny"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Hope Among the Fields"
msgstr "Надежда среди полей"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Help Jonas gather crop bundles from the eastern fields before monsters destroy the harvest."
msgstr "Помогите Йонасу собрать снопы с восточных полей, пока монстры не уничтожили урожай."

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "[Farmer] Jonas"
msgstr "[Фермер] Йонас"

#: f_siauliai_50_1_quests.cs (Quest Definitions)
msgid "Collect Crop Bundles from the eastern fields"
msgstr "Соберите снопы урожая с восточных полей"

# ============================================================================
# Srautas Gorge Plateau Quests (f_gele_57_2_quests.cs)
# ============================================================================

#: f_gele_57_2_quests.cs
msgid "[Klaipeda Scout] Lania"
msgstr "[Клайпедский скаут] Лания"

#: f_gele_57_2_quests.cs
msgid "Lania"
msgstr "Лания"

#: f_gele_57_2_quests.cs
msgid "Adventurer! Thank the Goddess you're here."
msgstr "Авантюрист! Слава Богине, что ты здесь."

#: f_gele_57_2_quests.cs
msgid "{#666666}*The scout looks visibly concerned as she surveys the plateau*{/}"
msgstr "{#666666}*Разведчица, оглядывая плато, выглядит явно обеспокоенной*{/}"

#: f_gele_57_2_quests.cs
msgid "I've been stationed here to monitor the trade routes through Srautas Gorge, but something troubling is happening. Three different monster types are converging on this plateau from all directions."
msgstr "Меня направили сюда для наблюдения за торговыми путями, проходящими через ущелье Сраутас, но происходит нечто тревожное. Три разных вида монстров сходятся на этом плато со всех сторон."

#: f_gele_57_2_quests.cs
msgid "The plant-like Leafly creatures from the forests, and two types of aggressive Panto warriors - some wielding swords, others fighting with their hands - are spreading across the entire area."
msgstr "По всей территории распространяются похожие на растения существа Лифли из лесов, а также два вида агрессивных воинов Панто — одни из них вооружены мечами, другие сражаются голыми руками."

#: f_gele_57_2_quests.cs
msgid "Will you help me thin their numbers?"
msgstr "Поможешь мне сократить их число?"

#: f_gele_57_2_quests.cs
msgid "I'll hunt them down"
msgstr "Я их найду"

#: f_gele_57_2_quests.cs
msgid "What's causing this?"
msgstr "В чём причина?"

#: f_gele_57_2_quests.cs
msgid "Not right now"
msgstr "Не сейчас"

#: f_gele_57_2_quests.cs
msgid "These monsters are scattered all over the plateau. You'll need to hunt 15 of each type. Can you handle such an extensive patrol?"
msgstr "Эти монстры разбросаны по всему плато. Тебе предстоит добыть по 15 особей каждого вида. Сможешь ли ты справиться с таким масштабным патрулированием?"

#: f_gele_57_2_quests.cs
msgid "Excellent! The Leafly tend to gather in the eastern and western regions. The Panto warriors with swords can be found in the western and eastern areas, while those fighting with their hands spawn mostly in the southeast and scattered central locations."
msgstr "Отлично! Лифли, как правило, собираются в восточных и западных регионах. Воины Панто с мечами встречаются в западных и восточных районах, а те, кто сражается голыми руками, появляются в основном на юго-востоке и в отдельных местах центральной части."

#: f_gele_57_2_quests.cs
msgid "It's a vast plateau, so prepare for a lot of ground to cover. Return to me once you've completed the hunt."
msgstr "Это огромное плато, так что приготовьтесь к тому, что придётся пройти немало. Вернитесь ко мне, когда закончите охоту."

#: f_gele_57_2_quests.cs
msgid "I'm not entirely sure what's drawing them here. This gorge has always been cheerful and peaceful - full of flowers and sunshine. But ever since the demon war ended, monster behavior has been unpredictable."
msgstr "Я не совсем уверен, что именно привлекает их сюда. Это ущелье всегда было весёлым и мирным — полным цветов и солнечного света. Но с тех пор, как закончилась война с демонами, поведение монстров стало непредсказуемым."

#: f_gele_57_2_quests.cs
msgid "The Pantos seem to be expanding their territory, while the Leafly are migrating in unusual patterns. Whatever the cause, they're making the trade routes dangerous for merchants and travelers."
msgstr "Похоже, Пантосы расширяют свою территорию, а Лифли мигрируют по необычным маршрутам. Какова бы ни была причина, они делают торговые пути опасными для купцов и путешественников."

#: f_gele_57_2_quests.cs
msgid "I understand. The patrol would cover a massive area. If you change your mind, I'll be here."
msgstr "Понимаю. Патруль будет охватывать огромную территорию. Если передумаешь, я буду здесь."

#: f_gele_57_2_quests.cs
msgid "{#666666}*The scout breathes a sigh of relief*{/}"
msgstr "{#666666}*Разведчик с облегчением вздыхает*{/}"

#: f_gele_57_2_quests.cs
msgid "Remarkable work! I've been observing from my post - you covered nearly the entire plateau. The monster presence has noticeably decreased already."
msgstr "Отличная работа! Я наблюдал со своего поста — вы охватили почти всё плато. Количество монстров уже заметно уменьшилось."

#: f_gele_57_2_quests.cs
msgid "The trade routes should be safer now, and merchants can resume their journeys through the gorge. Klaipeda owes you a debt of gratitude."
msgstr "Теперь торговые пути должны стать безопаснее, и купцы смогут возобновить свои путешествия через ущелье. Клайпеда в долгу перед вами."

#: f_gele_57_2_quests.cs
msgid "The hunt continues? Remember, you need to clear out all three types:"
msgstr "Охота продолжается? Не забывайте, что вам нужно уничтожить все три типа:"

#: f_gele_57_2_quests.cs
msgid "- Leafly in the northern and western regions"
msgstr "- Лифли в северных и западных регионах"

#: f_gele_57_2_quests.cs
msgid "- Panto warriors with swords in the western and eastern areas"
msgstr "- Воины Панто с мечами в западных и восточных районах"

#: f_gele_57_2_quests.cs
msgid "- Panto warriors fighting with their hands in the southeast"
msgstr "- Воины Панто, сражающиеся голыми руками на юго-востоке"

#: f_gele_57_2_quests.cs
msgid "It's a long patrol, but I know you can do it."
msgstr "Это долгий патруль, но я знаю, что ты справишься."

#: f_gele_57_2_quests.cs
msgid "The plateau is much safer thanks to your efforts. Klaipeda's merchants can travel freely again."
msgstr "Благодаря вашим усилиям на плато стало гораздо безопаснее. Торговцы из Клайпеды снова могут свободно путешествовать."

#: f_gele_57_2_quests.cs
msgid "[Klaipeda Researcher] Veric"
msgstr "[Исследователь из Клайпеды] Верик"

#: f_gele_57_2_quests.cs
msgid "Veric"
msgstr "Верик"

#: f_gele_57_2_quests.cs
msgid "Good day! I'm studying the ecology of this beautiful gorge."
msgstr "Добрый день! Я изучаю экологию этого прекрасного ущелья."

#: f_gele_57_2_quests.cs
msgid "{#666666}*He gestures toward the flowers and butterflies around him*{/}"
msgstr "{#666666}*Он указывает на цветы и бабочек вокруг себя*{/}"

#: f_gele_57_2_quests.cs
msgid "Srautas Gorge is known for its cheerful atmosphere - the abundance of flowers, the bright sunshine, the harmonious wildlife. But I've discovered something disturbing."
msgstr "Ущелье Сраутас славится своей радостной атмосферой — обилием цветов, ярким солнцем, гармоничным миром дикой природы. Но я обнаружил нечто тревожное."

#: f_gele_57_2_quests.cs
msgid "The Panto tribes have erected territorial totems throughout the southern plateau. These markers are attracting more aggressive Pantos to the area and disrupting the natural balance."
msgstr "Племена панто установили территориальные тотемы по всему южному плато. Эти знаки привлекают в этот район более агрессивных панто и нарушают естественный баланс."

#: f_gele_57_2_quests.cs
msgid "Would you be willing to help?"
msgstr "Ты согласишься помочь?"

#: f_gele_57_2_quests.cs
msgid "I'll destroy the totems"
msgstr "Я уничтожу тотемы"

#: f_gele_57_2_quests.cs
msgid "Why are totems harmful?"
msgstr "Почему тотемы вредны?"

#: f_gele_57_2_quests.cs
msgid "Perhaps later"
msgstr "Может быть, позже"

#: f_gele_57_2_quests.cs
msgid "I need you to head south from here and destroy 6 of these Panto totems. Will you take on this task?"
msgstr "Мне нужно, чтобы ты отправился отсюда на юг и уничтожил 6 таких тотемов Панто. Согласен выполнить это задание?"

#: f_gele_57_2_quests.cs
msgid "Thank you! The totems are concentrated in the southern region of the plateau. You'll find them scattered across the Panto encampments."
msgstr "Спасибо! Тотемы сосредоточены в южной части плато. Вы найдёте их разбросанными по лагерям Панто."

#: f_gele_57_2_quests.cs
msgid "They're not dangerous themselves - just wooden structures - but they symbolize Panto territorial claims. Destroying them will discourage the Pantos from gathering in such large numbers."
msgstr "Сами по себе они не представляют опасности — это всего лишь деревянные сооружения, — но они символизируют территориальные претензии панто. Их уничтожение отбивает у панто желание собираться в таких больших количествах."

#: f_gele_57_2_quests.cs
msgid "The totems themselves aren't magical, but they serve as territorial markers. When Pantos erect these totems, it signals to other Panto tribes that the area is claimed territory."
msgstr "Сами по себе тотемы не обладают магической силой, но служат в качестве территориальных ориентиров. Когда пантосы возводят эти тотемы, это сигнализирует другим племенам пантосов о том, что данная территория является их владением."

#: f_gele_57_2_quests.cs
msgid "This attracts more Pantos seeking to join the settlement, which leads to overpopulation and aggressive behavior toward travelers. By removing the totems, we're essentially erasing their territorial claims."
msgstr "Это привлекает всё больше пантосов, стремящихся присоединиться к поселению, что приводит к перенаселению и агрессивному поведению по отношению к путешественникам. Удаляя тотемы, мы, по сути, аннулируем их территориальные претензии."

#: f_gele_57_2_quests.cs
msgid "I understand. It's quite a trek to the southern plateau. If you change your mind, I'll be here continuing my research."
msgstr "Понимаю. До южного плато довольно далеко. Если передумаешь, я останусь здесь и продолжу свои исследования."

#: f_gele_57_2_quests.cs
msgid "{#666666}*Veric looks pleased*{/}"
msgstr "{#666666}*Верик выглядит довольным*{/}"

#: f_gele_57_2_quests.cs
msgid "Excellent work! I've already noticed a change in the Panto behavior. With their territorial markers destroyed, they're dispersing from the southern plateau."
msgstr "Отличная работа! Я уже заметил изменения в поведении Панто. После уничтожения их территориальных меток они начинают рассеиваться с южного плато."

#: f_gele_57_2_quests.cs
msgid "The gorge's natural harmony is beginning to restore itself. The flowers seem brighter already!"
msgstr "Природная гармония ущелья постепенно восстанавливается. Цветы уже кажутся ярче!"

#: f_gele_57_2_quests.cs
msgid "Still working on destroying those totems? Head south from here - you'll find them concentrated throughout the Panto territory."
msgstr "Все еще занимаетесь уничтожением этих тотемов? Отправляйтесь отсюда на юг — вы найдете их в большом количестве на всей территории Панто."

#: f_gele_57_2_quests.cs
msgid "They're easy to spot once you reach the encampments."
msgstr "Их легко заметить, как только вы доберётесь до лагерей."

#: f_gele_57_2_quests.cs
msgid "The gorge's ecosystem is recovering nicely thanks to your help. Nature finds a way when we give it a chance."
msgstr "Благодаря вашей помощи экосистема ущелья успешно восстанавливается. Природа найдёт выход, если мы дадим ей шанс."

#: f_gele_57_2_quests.cs
msgid "[Klaipeda Messenger] Gareth"
msgstr "[Klaipeda Messenger] Гарет"

#: f_gele_57_2_quests.cs
msgid "Gareth"
msgstr "Гарет"

#: f_gele_57_2_quests.cs
msgid "Adventurer! Perfect timing."
msgstr "Авантюрист! Как раз вовремя."

#: f_gele_57_2_quests.cs
msgid "{#666666}*The messenger clutches a sealed letter urgently*{/}"
msgstr "{#666666}*Посланник спешно сжимает в руке запечатанное письмо*{/}"

#: f_gele_57_2_quests.cs
msgid "I'm stationed here at the border crossing, but I have an urgent message that needs to reach our forward scout in Nefritas Cliff immediately. Unfortunately, I cannot leave my post."
msgstr "Я нахожусь здесь, на пограничном пункте, но у меня есть срочное сообщение, которое необходимо немедленно доставить нашему передовому разведчику на утесе Нефритас. К сожалению, я не могу покинуть свой пост."

#: f_gele_57_2_quests.cs
msgid "The recipient is stationed at Uzbaigi Hillside, deep within Nefritas Cliff. The warp is just ahead - it's quite a long journey to reach him."
msgstr "Получатель находится на склоне Узбайги, в глубине утеса Нефритас. Точка телепортации находится прямо впереди — путь до него довольно долгий."

#: f_gele_57_2_quests.cs
msgid "Can you deliver this message?"
msgstr "Не могли бы вы передать это сообщение?"

#: f_gele_57_2_quests.cs
msgid "I'll deliver it"
msgstr "Я доставлю это"

#: f_gele_57_2_quests.cs
msgid "What's in the letter?"
msgstr "Что написано в письме?"

#: f_gele_57_2_quests.cs
msgid "That sounds far"
msgstr "Это звучит слишком"

#: f_gele_57_2_quests.cs
msgid "The letter is sealed and urgent. It's a long walk through Nefritas Cliff. Can you handle this?"
msgstr "Письмо запечатано и срочное. Дорога через утес Нефритас довольно длинная. Сможешь с этим справиться?"

#: f_gele_57_2_quests.cs
msgid "Thank you! The warp to Nefritas Cliff is just north of here. Once you arrive, head northeast toward the Uzbaigi Hillside."
msgstr "Спасибо! Телепорт к утесу Нефритас находится чуть севернее отсюда. Как только вы туда доберетесь, направляйтесь на северо-восток, к склону Узбайги."

#: f_gele_57_2_quests.cs
msgid "Look for a scout wearing Klaipeda colors - his name is Roderic. He'll be watching for threats near the hillside's edge."
msgstr "Ищите разведчика в форме «Клайпеды» — его зовут Родерик. Он будет следить за угрозами у подножия холма."

#: f_gele_57_2_quests.cs
msgid "Be wary of the Banshees that have been lurking along the path. Those ghosts can be quite troublesome."
msgstr "Будьте осторожны с банши, которые скрываются вдоль тропы. Эти призраки могут доставить немало хлопот."

#: f_gele_57_2_quests.cs
msgid "I'm afraid the contents are confidential - sealed orders from Klaipeda command. All I can tell you is that it's time-sensitive intelligence about monster movements in the region."
msgstr "Боюсь, что содержание этого документа является конфиденциальным — это засекреченные приказы из командования в Клайпеде. Все, что я могу вам сказать, — это то, что речь идет о срочной разведывательной информации о передвижениях монстров в этом регионе."

#: f_gele_57_2_quests.cs
msgid "Roderic will know what to do with it when you arrive."
msgstr "Родерик сам разберётся, что с этим делать, когда ты приедешь."

#: f_gele_57_2_quests.cs
msgid "I understand. It's quite a long journey. If you reconsider, I'll be here."
msgstr "Понимаю. Это довольно долгий путь. Если передумаешь, я буду здесь."

#: f_gele_57_2_quests.cs
msgid "You still have the letter? The warp to Nefritas Cliff is just north of here. Find Roderic at Uzbaigi Hillside - head northeast once you arrive."
msgstr "Письмо у тебя ещё есть? Телепорт к утесу Нефритас находится чуть севернее отсюда. Найди Родерика на склоне холма Узбайги — как только прибудешь, направляйся на северо-восток."

#: f_gele_57_2_quests.cs
msgid "Time is of the essence!"
msgstr "Время решает всё!"

#: f_gele_57_2_quests.cs
msgid "{#666666}*The messenger looks confused*{/}"
msgstr "{#666666}*Посланник выглядит растерянным*{/}"

#: f_gele_57_2_quests.cs
msgid "You've lost the sealed letter? That's... concerning. Let me give you another copy, but please be more careful this time!"
msgstr "Ты потерял запечатанное письмо? Это… вызывает беспокойство. Я дам тебе ещё одну копию, но, пожалуйста, на этот раз будь осторожнее!"

#: f_gele_57_2_quests.cs
msgid "Thank you for delivering that message. Roderic's intelligence reports are vital for Klaipeda's security efforts."
msgstr "Спасибо за передачу этого сообщения. Разведывательные отчеты Родерика имеют жизненно важное значение для обеспечения безопасности Клайпеды."

#: f_gele_57_2_quests.cs
msgid "[Scout] Miriam"
msgstr "[Разведчица] Мириам"

#: f_gele_57_2_quests.cs
msgid "Miriam"
msgstr "Мириам"

#: f_gele_57_2_quests.cs
msgid "{#666666}*Her tired face lights up with relief*{/}"
msgstr "{#666666}*Её уставшее лицо озарилось облегчением*{/}"

#: f_gele_57_2_quests.cs
msgid "Emergency supplies! Thank the goddesses you made it through!"
msgstr "Аварийные запасы! Слава богиням, что вы выжили!"

#: f_gele_57_2_quests.cs
msgid "We've been rationing for days. This food will keep the outpost going until proper caravans arrive."
msgstr "Мы уже несколько дней живем на нормированном продовольствии. Эта еда позволит аванпосту продержаться до прибытия полноценных караванов."

#: f_gele_57_2_quests.cs
msgid "You've saved lives today, traveler. Here - take this reward. It's all we can spare, but you've earned it."
msgstr "Сегодня ты спас несколько жизней, путешественник. Вот — прими эту награду. Это всё, что мы можем тебе предложить, но ты это заслужил."

#: f_gele_57_2_quests.cs
msgid "The supplies you brought lasted us three full days. We're doing better now."
msgstr "Привезенных вами запасов нам хватило на целых три дня. Сейчас у нас дела идут лучше."

#: f_gele_57_2_quests.cs
msgid "If you're heading back to the gorge, let Roland know we're grateful for his coordination."
msgstr "Если вы собираетесь возвращаться в ущелье, передайте Роланду, что мы благодарны ему за организацию."

#: f_gele_57_2_quests.cs
msgid "Are you headed to Grynas Hills? Be careful, that forest is haunted by spirits and dark creatures."
msgstr "Собираетесь в Гринас-Хиллз? Будьте осторожны: в том лесу бродят призраки и мрачные существа."

#: f_gele_57_2_quests.cs
msgid "I'm on duty to prevent threats coming from the forest and help on the logistics. We have a guard camp deep in that place."
msgstr "Я несу службу, чтобы предотвращать угрозы, исходящие из леса, и помогать с материально-техническим обеспечением. У нас есть охранный лагерь глубоко в том месте."

#: f_gele_57_2_quests.cs
msgid "We're managing, but supply deliveries from the gorge would help tremendously."
msgstr "Мы как-то справляемся, но поставки из ущелья очень бы нам помогли."

#: f_gele_57_2_quests.cs
msgid "The path is treacherous for wagons. We rely on brave couriers like yourself."
msgstr "Этот путь опасен для повозок. Мы полагаемся на таких отважных курьеров, как вы."

#: f_gele_57_2_quests.cs
msgid "Plateau's Menace"
msgstr "Угроза с плато"

#: f_gele_57_2_quests.cs
msgid "Help Klaipeda Scout Lania thin the monster population across Srautas Gorge by hunting Leafly, Panto warriors with swords, and Panto warriors with their hands."
msgstr "Помогите скауту из Клайпеды Лании сократить численность монстров в ущелье Сраутас, охотясь на Лифли, воинов Панто с мечами и воинов Панто, сражающихся голыми руками."

#: f_gele_57_2_quests.cs
msgid "[Klaipeda Scout] Lania"
msgstr "[Клайпедский скаут] Лания"

#: f_gele_57_2_quests.cs
msgid "Hunt Leafly"
msgstr "Hunt Leafly"

#: f_gele_57_2_quests.cs
msgid "Hunt Panto Warriors (Sword)"
msgstr "«Хант Панто Уорриорс» (Меч)"

#: f_gele_57_2_quests.cs
msgid "Hunt Panto Warriors (Hand)"
msgstr "«Хант Панто Уорриорз» (ручная работа)"

#: f_gele_57_2_quests.cs
msgid "Totem Desecration"
msgstr "Осквернение тотема"

#: f_gele_57_2_quests.cs
msgid "Help Klaipeda Researcher Veric restore the gorge's natural balance by destroying Panto territorial totems in the southern plateau."
msgstr "Помогите клайпедскому исследователю Веричу восстановить природный баланс ущелья, уничтожив территориальные тотемы Панто на южном плато."

#: f_gele_57_2_quests.cs
msgid "[Klaipeda Researcher] Veric"
msgstr "[Исследователь из Клайпеды] Верик"

#: f_gele_57_2_quests.cs
msgid "Destroy Panto Totems"
msgstr "Уничтожьте тотемы Панто"

#: f_gele_57_2_quests.cs
msgid "Message to the Hillside"
msgstr "Послание Хиллсайду"

#: f_gele_57_2_quests.cs
msgid "Deliver an urgent sealed letter from Klaipeda Messenger Gareth to Hillside Watcher Roderic in Nefritas Cliff's Uzbaigi Hillside."
msgstr "Доставьте срочное запечатанное письмо от клайпедского гонца Гарета наблюдателю Родерику на склоне Узбайги в Нефритас-Клифф."

#: f_gele_57_2_quests.cs
msgid "[Klaipeda Messenger] Gareth"
msgstr "[Klaipeda Messenger] Гарет"

#: f_gele_57_2_quests.cs
msgid "Deliver letter to Roderic in Nefritas Cliff"
msgstr "Доставьте письмо Родерику на утесе Нефритас"

# ============================================================================
# Nefritas Cliff Quests (f_gele_57_3_quests.cs)
# ============================================================================

#: f_gele_57_3_quests.cs
msgid "[Hillside Watcher] Roderic"
msgstr "[Наблюдатель с холма] Родерик"

#: f_gele_57_3_quests.cs
msgid "Roderic"
msgstr "Родерик"

#: f_gele_57_3_quests.cs
msgid "{#666666}*The scout glances around nervously before acknowledging you*{/}"
msgstr "{#666666}*Разведчик нервно оглядывается по сторонам, прежде чем обратиться к вам*{/}"

#: f_gele_57_3_quests.cs
msgid "Keep your voice down! A message from Gareth? Finally!"
msgstr "Не так громко! Сообщение от Гарета? Наконец-то!"

#: f_gele_57_3_quests.cs
msgid "{#666666}*He quickly breaks the seal, his eyes darting to the surroundings*{/}"
msgstr "{#666666}*Он быстро срывает печать, оглядываясь по сторонам*{/}"

#: f_gele_57_3_quests.cs
msgid "The creatures here... they're aggressive. I can barely rest without something trying to tear me apart."
msgstr "Здешние существа… они агрессивны. Мне едва удается отдохнуть, не встретив кого-нибудь, кто пытается разорвать меня на куски."

#: f_gele_57_3_quests.cs
msgid "You made it through alive - that's more than I can say for the last courier. Take this reward and get out of here while you can."
msgstr "Ты выбрался отсюда живым — чего не скажешь о предыдущем курьере. Забери эту награду и убирайся отсюда, пока есть возможность."

#: f_gele_57_3_quests.cs
msgid "{#666666}*He keeps his weapon ready*{/}"
msgstr "{#666666}*Он держит оружие наготове*{/}"

#: f_gele_57_3_quests.cs
msgid "Still here? Don't linger too long. The monsters in this area don't give warnings before they strike."
msgstr "Ты всё ещё здесь? Не задерживайся слишком долго. Монстры в этой местности не предупреждают, прежде чем напасть."

#: f_gele_57_3_quests.cs
msgid "{#666666}*The scout speaks in hushed tones, constantly scanning the area*{/}"
msgstr "{#666666}*Разведчик говорит шепотом, постоянно осматривая окрестности*{/}"

#: f_gele_57_3_quests.cs
msgid "You shouldn't be here. This place is crawling with aggressive creatures - Banshees, Puragi, things that hunt without mercy."
msgstr "Тебе не следует здесь находиться. Это место кишит агрессивными существами — банши, пураги, существа, которые охотятся без пощады."

#: f_gele_57_3_quests.cs
msgid "If you don't have business with me, I suggest you leave. Quickly."
msgstr "Если у вас нет ко мне никаких дел, советую вам уйти. Поскорее."

# ============================================================================
# Zachariel Crossroads Quests (f_rokas_31_quests.cs)
# ============================================================================

#: f_rokas_31_quests.cs
msgid "[Royal Guard] Balthor"
msgstr "[Королевская гвардия] Балтор"

#: f_rokas_31_quests.cs
msgid "Balthor"
msgstr "Балтор"

#: f_rokas_31_quests.cs
msgid "The Royal Mausoleum is open to you. The monsters within are dangerous, but you bear the authority to enter. Do you wish to proceed?"
msgstr "Королевское мавзолей открыто для вас. Монстры, обитающие внутри, опасны, но у вас есть право войти. Хотите продолжить?"

#: f_rokas_31_quests.cs
msgid "{#666666}*The guard steps aside*{/}"
msgstr "{#666666}*Охранник отступает в сторону*{/}"

#: f_rokas_31_quests.cs
msgid "Be careful in there. Many have entered the mausoleum - not all have returned."
msgstr "Будьте осторожны там. Многие входили в мавзолей — но не все вернулись."

#: f_rokas_31_quests.cs
msgid "Very well. The mausoleum will be here when you're ready."
msgstr "Хорошо. Мавзолей будет готов, когда вы будете готовы."

#: f_rokas_31_quests.cs
msgid "Halt! The Royal Mausoleum beyond this point is sealed by order of the Grand Archive."
msgstr "Стоп! Королевский мавзолей, расположенный за этой отметкой, опечатан по распоряжению Великого архива."

#: f_rokas_31_quests.cs
msgid "{#666666}*He grips his weapon firmly*{/}"
msgstr "{#666666}*Он крепко сжимает оружие*{/}"

#: f_rokas_31_quests.cs
msgid "The monsters inside are extremely dangerous - golems, demons, and worse. Only those with official permission may enter."
msgstr "Находящиеся там чудовища чрезвычайно опасны — големы, демоны и существа ещё страшнее. Входить могут только те, кто имеет официальное разрешение."

#: f_rokas_31_quests.cs
msgid "If you wish to explore the mausoleum, you must obtain the Great King's Key from Grand Archivist Elwen in Fedimian."
msgstr "Если вы хотите осмотреть мавзолей, вам необходимо получить «Ключ Великого Короля» у главного архивариуса Элвена в Федимиане."

#: f_rokas_31_quests.cs
msgid "[Traveling Merchant] Darius"
msgstr "[Странствующий купец] Дариус"

#: f_rokas_31_quests.cs
msgid "Darius"
msgstr "Дарий"

#: f_rokas_31_quests.cs
msgid "Ah, greetings traveler! I've been waiting here for hours, but I'm hesitant to continue my journey."
msgstr "Ах, привет, путешественник! Я уже несколько часов жду здесь, но не решаюсь продолжить путь."

#: f_rokas_31_quests.cs
msgid "{#666666}*He glances nervously toward the mausoleum entrance*{/}"
msgstr "{#666666}*Он нервно бросает взгляд в сторону входа в мавзолей*{/}"

#: f_rokas_31_quests.cs
msgid "The Royal Mausoleum lies just beyond this crossroads, and the monsters in this area have become increasingly aggressive."
msgstr "Королевское мавзолей находится сразу за этим перекрёстком, а монстры в этой местности становятся всё более агрессивными."

#: f_rokas_31_quests.cs
msgid "I need to warn the merchants in Fedimian about the dangers here, but I can't abandon my wares to make the journey myself."
msgstr "Мне нужно предупредить купцов в Федимиане об опасностях, которые здесь поджидают, но я не могу оставить свой товар и отправиться в путь самостоятельно."

#: f_rokas_31_quests.cs
msgid "What can I do?"
msgstr "Что мне делать?"

#: f_rokas_31_quests.cs
msgid "I'll help you"
msgstr "Я помогу тебе"

#: f_rokas_31_quests.cs
msgid "What kind of monsters?"
msgstr "Какие именно монстры?"

#: f_rokas_31_quests.cs
msgid "Good luck with that"
msgstr "Удачи тебе в этом"

#: f_rokas_31_quests.cs
msgid "You will? Excellent! But first, I need you to thin out the monster population here."
msgstr "Ты это сделаешь? Отлично! Но сначала мне нужно, чтобы ты немного сократил численность монстров здесь."

#: f_rokas_31_quests.cs
msgid "The Warleader Hogmas are the most dangerous - they've been attacking travelers regularly."
msgstr "Наиболее опасны военачальники Хогмасы — они регулярно нападают на путешественников."

#: f_rokas_31_quests.cs
msgid "Will you deal with some of these creatures, then carry my warning to the Fedimian Merchant Guild?"
msgstr "Не могли бы вы разобраться с некоторыми из этих существ, а затем передать моё предупреждение Федимийской торговой гильдии?"

#: f_rokas_31_quests.cs
msgid "Thank you! Clear out at least 12 of those Warleader Hogmas to make the crossroads safer."
msgstr "Спасибо! Уничтожьте как минимум 12 таких «Хогом» под командованием Военного лидера, чтобы сделать перекрёсток более безопасным."

#: f_rokas_31_quests.cs
msgid "Then head to Fedimian and find Anne at the Merchant Guild. Tell her that the Zachariel Crossroads route is becoming too dangerous for regular caravans."
msgstr "Затем отправляйтесь в Федимиан и найдите Энн в Гильдии купцов. Скажите ей, что путь через Перекресток Захариэля становится слишком опасным для обычных караванов."

#: f_rokas_31_quests.cs
msgid "Return to me once you've delivered the message. I'll make it worth your while."
msgstr "Вернись ко мне, как только передашь сообщение. Я вознагражу тебя по заслугам."

#: f_rokas_31_quests.cs
msgid "The Warleader Hogmas are the worst - large, brutish warriors wielding massive weapons."
msgstr "Хогомы-военные вожди — самые страшные из всех: это крупные, грубые воины, вооружённые массивным оружием."

#: f_rokas_31_quests.cs
msgid "They've set up camps throughout the crossroads and attack anyone who passes. Several caravans have already been forced to turn back."
msgstr "Они разбили лагеря на всех перекрестках и нападают на всех проходящих мимо. Несколько караванов уже были вынуждены повернуть назад."

#: f_rokas_31_quests.cs
msgid "If this continues, the trade route to the mausoleum will be completely cut off."
msgstr "Если такая ситуация сохранится, торговый путь к мавзолею будет полностью перекрыт."

#: f_rokas_31_quests.cs
msgid "{#666666}*He sighs heavily*{/}"
msgstr "{#666666}*Он тяжело вздыхает*{/}"

#: f_rokas_31_quests.cs
msgid "I suppose I'll just have to wait for someone willing to help..."
msgstr "Полагаю, мне остаётся только ждать, пока найдётся кто-нибудь, готовый помочь..."

#: f_rokas_31_quests.cs
msgid "You're back! And from the look of things, you've made the crossroads much safer."
msgstr "Ты вернулся! И, судя по всему, ты сделал этот перекресток гораздо безопаснее."

#: f_rokas_31_quests.cs
msgid "Did Anne at the Merchant Guild receive my warning?"
msgstr "Получила ли Энн из Торговой гильдии моё предупреждение?"

#: f_rokas_31_quests.cs
msgid "{#666666}*He nods with relief*{/}"
msgstr "{#666666}*Он с облегчением кивает*{/}"

#: f_rokas_31_quests.cs
msgid "Good, good. The guild needs to know the dangers out here. Perhaps they'll send guards to protect future caravans."
msgstr "Хорошо, хорошо. Гильдия должна знать об опасностях, которые здесь поджидают. Возможно, они пошлют стражу для защиты будущих караванов."

#: f_rokas_31_quests.cs
msgid "You've done excellent work. Here - take this weapon I've been carrying. A warrior like you will put it to better use than I ever could."
msgstr "Ты проделал отличную работу. Вот — возьми это оружие, которое я носил с собой. Такой воин, как ты, сможет использовать его гораздо лучше, чем я когда-либо смог бы."

#: f_rokas_31_quests.cs
msgid "The crossroads are still too dangerous. Please, defeat at least 12 Warleader Hogmas before heading to Fedimian."
msgstr "Перекрестки по-прежнему слишком опасны. Пожалуйста, победите как минимум 12 военачальников Хогмасов, прежде чем отправляться в Федимиан."

#: f_rokas_31_quests.cs
msgid "Have you delivered my warning to Anne at the Merchant Guild in Fedimian yet?"
msgstr "Ты уже передал моё предупреждение Энн из Торговой гильдии в Федимиане?"

#: f_rokas_31_quests.cs
msgid "She should be at the guild hall. Tell her about the dangers at the Zachariel Crossroads."
msgstr "Она должна быть в зале гильдии. Расскажи ей об опасностях на Перекрёстке Захариэля."

#: f_rokas_31_quests.cs
msgid "Thank you again for your help! The crossroads feel safer already."
msgstr "Еще раз спасибо за помощь! На перекрестке уже стало спокойнее."

#: f_rokas_31_quests.cs
msgid "I can finally resume my trade route without constant fear of ambush."
msgstr "Наконец-то я могу возобновить свой торговый маршрут, не опасаясь постоянных засад."

#: f_rokas_31_quests.cs
msgid "[Devotee] Lyanna"
msgstr "[Поклонница] Лианна"

#: f_rokas_31_quests.cs
msgid "Lyanna"
msgstr "Лианна"

#: f_rokas_31_quests.cs
msgid "{#666666}*A devoted woman kneels in prayer before the eastern path*{/}"
msgstr "{#666666}*Преданная женщина преклоняет колени в молитве перед восточным путем*{/}"

#: f_rokas_31_quests.cs
msgid "Oh! Forgive me, I didn't notice your approach. I'm watching over the Statue of Goddess Zemyna to the east."
msgstr "Ой! Простите, я не заметил, как вы подошли. Я охраняю статую богини Земины, которая стоит на востоке."

#: f_rokas_31_quests.cs
msgid "{#666666}*She looks troubled*{/}"
msgstr "{#666666}*Она выглядит озабоченной*{/}"

#: f_rokas_31_quests.cs
msgid "The statue stands as a beacon of Zemyna's protection in these desert lands, but corruption has begun to seep into this area."
msgstr "Статуя служит символом защиты Земины в этих пустынных землях, но в эти края уже начала проникать тьма."

#: f_rokas_31_quests.cs
msgid "The Repusbunny Mages that dwell here were once peaceful creatures, blessed by Zemyna's natural magic. But lately, they've become aggressive and tainted."
msgstr "Маги-Репусбани, обитающие здесь, когда-то были мирными существами, благословленными природной магией Земины. Но в последнее время они стали агрессивными и осквернёнными."

#: f_rokas_31_quests.cs
msgid "How can I help?"
msgstr "Чем я могу помочь?"

#: f_rokas_31_quests.cs
msgid "I'll protect the statue"
msgstr "Я защищу статую"

#: f_rokas_31_quests.cs
msgid "What happened to them?"
msgstr "Что с ними случилось?"

#: f_rokas_31_quests.cs
msgid "That's unfortunate"
msgstr "Это очень жаль"

#: f_rokas_31_quests.cs
msgid "{#666666}*Her eyes light up with hope*{/}"
msgstr "{#666666}*Её глаза загораются надеждой*{/}"

#: f_rokas_31_quests.cs
msgid "Truly? Oh, thank you! I've been trying to contain the corruption myself, but I lack the strength."
msgstr "Правда? О, спасибо! Я сам пытался сдержать коррупцию, но у меня не хватает сил."

#: f_rokas_31_quests.cs
msgid "Will you cull the corrupted Repusbunny Mages? If we reduce their numbers, perhaps the corruption will spread more slowly."
msgstr "Вы собираетесь уничтожить заражённых магов Репусбэнни? Если мы сократим их число, возможно, заражение будет распространяться медленнее."

#: f_rokas_31_quests.cs
msgid "Bless you! Please, defeat 15 of the Repusbunny Mages. It pains me to ask this of such creatures, but they are beyond saving now."
msgstr "Будь здоров! Пожалуйста, победи 15 магов-Репуббанни. Мне больно просить об этом у таких существ, но их уже невозможно спасти."

#: f_rokas_31_quests.cs
msgid "The Statue of Goddess Zemyna watches over all who travel these crossroads. We must not let it fall to darkness."
msgstr "Статуя богини Земины охраняет всех, кто проходит через этот перекресток. Мы не должны допустить, чтобы она погрузилась во тьму."

#: f_rokas_31_quests.cs
msgid "Return to me when the task is done. May Zemyna guide your path."
msgstr "Вернись ко мне, когда задача будет выполнена. Пусть Земина ведёт тебя по пути."

#: f_rokas_31_quests.cs
msgid "I'm not certain. Perhaps it's lingering demonic corruption from the war, or something darker stirring near the Royal Mausoleum."
msgstr "Я не уверен. Возможно, это остатки демонического заражения, оставшиеся после войны, или что-то ещё более мрачное, что пробуждается в окрестностях Королевского мавзолея."

#: f_rokas_31_quests.cs
msgid "The Repusbunny Mages draw their power from natural magic - the same magic that flows through Zemyna's statue."
msgstr "Маги Репусбани черпают свою силу из природной магии — той самой магии, которая течет через статую Земины."

#: f_rokas_31_quests.cs
msgid "If the corruption spreads to them, it could eventually taint the statue itself. And if that happens..."
msgstr "Если коррупция распространится и на них, это в конечном итоге может запятнать саму статую. А если это произойдет..."

#: f_rokas_31_quests.cs
msgid "{#666666}*She shudders*{/}"
msgstr "{#666666}*Она вздрагивает*{/}"

#: f_rokas_31_quests.cs
msgid "These crossroads would become truly cursed."
msgstr "Эти перекрёстки станут поистине проклятыми."

#: f_rokas_31_quests.cs
msgid "{#666666}*She returns to her prayers*{/}"
msgstr "{#666666}*Она возвращается к молитвам*{/}"

#: f_rokas_31_quests.cs
msgid "I understand. Not everyone feels the call to protect sacred places."
msgstr "Я понимаю. Не все чувствуют в себе призвание защищать священные места."

#: f_rokas_31_quests.cs
msgid "You've returned! I can feel it - the corruption's grip has weakened."
msgstr "Ты вернулся! Я это чувствую — хватка коррупции ослабла."

#: f_rokas_31_quests.cs
msgid "{#666666}*She closes her eyes, sensing the spiritual energies*{/}"
msgstr "{#666666}*Она закрывает глаза, ощущая духовные энергии*{/}"

#: f_rokas_31_quests.cs
msgid "Yes... the natural balance is beginning to restore itself. The statue is safe, for now."
msgstr "Да... естественный баланс начинает восстанавливаться. Статуя пока в безопасности."

#: f_rokas_31_quests.cs
msgid "You've done more than simply slay monsters - you've protected a sacred site of Goddess Zemyna. She will remember your service."
msgstr "Ты не просто убил монстров — ты защитил священное место богини Земины. Она запомнит твою службу."

#: f_rokas_31_quests.cs
msgid "Please, take this staff. It belonged to a fellow devotee who fell protecting this very crossroads. Use it to continue spreading Zemyna's protection."
msgstr "Пожалуйста, возьми этот посох. Он принадлежал одному из наших единоверцев, который погиб, защищая именно этот перекресток. Используй его, чтобы и дальше нести защиту Земины."

#: f_rokas_31_quests.cs
msgid "The Repusbunny Mages still threaten the statue. Please, defeat at least 15 of them to stem the corruption."
msgstr "Маги-Репусбани по-прежнему представляют угрозу для статуи. Пожалуйста, победите как минимум 15 из них, чтобы остановить распространение порчи."

#: f_rokas_31_quests.cs
msgid "I will continue my prayers here. May Zemyna watch over you."
msgstr "Я буду и дальше молиться здесь. Пусть Земина хранит вас."

#: f_rokas_31_quests.cs
msgid "Thank you for protecting the Statue of Goddess Zemyna. Your actions have preserved a sacred beacon in these crossroads."
msgstr "Спасибо за то, что защитили статую богини Земины. Ваши действия позволили сохранить священный маяк на этом перекрестке."

#: f_rokas_31_quests.cs
msgid "The natural balance feels stronger now. May Zemyna's blessings follow you on your journey."
msgstr "Теперь природное равновесие кажется более прочным. Пусть благословения Земины сопровождают вас в вашем путешествии."

#: f_rokas_31_quests.cs
msgid "Crossroads Warning"
msgstr "Предупреждение о перекрёстке"

#: f_rokas_31_quests.cs
msgid "Defeat the Warleader Hogmas threatening the crossroads, then deliver Darius's warning to the Fedimian Merchant Guild."
msgstr "Победите военачальника Хогмаса, угрожающего перекрёстку, а затем передайте предупреждение Дариуса Федимийской торговой гильдии."

#: f_rokas_31_quests.cs
msgid "[Traveling Merchant] Darius"
msgstr "[Странствующий купец] Дариус"

#: f_rokas_31_quests.cs
msgid "Defeat Warleader Hogmas at Zachariel Crossroads"
msgstr "Победите военачальника Хогмаса на Перекрестке Захариэля"

#: f_rokas_31_quests.cs
msgid "Deliver warning to Anne at the Merchant Guild in Fedimian"
msgstr "Передайте предупреждение Энн в Гильдии купцов в Федимиане"

#: f_rokas_31_quests.cs
msgid "Guardian of Zemyna"
msgstr "Хранитель Земины"

#: f_rokas_31_quests.cs
msgid "Protect the Statue of Goddess Zemyna by culling the corrupted Repusbunny Mages."
msgstr "Защитите статую богини Земины, уничтожив осквернённых магов Репусбани."

#: f_rokas_31_quests.cs
msgid "[Devotee] Lyanna"
msgstr "[Поклонница] Лианна"

#: f_rokas_31_quests.cs
msgid "Defeat corrupted Repusbunny Mages"
msgstr "Победить коррумпированных магов Репусбэнни"

# ============================================================================
# Royal Mausoleum Quests (d_zachariel_32_quests.cs)
# ============================================================================

#: d_zachariel_32_quests.cs
msgid "Ancient Scroll Pedestal"
msgstr "Пьедестал для древнего свитка"

#: d_zachariel_32_quests.cs
msgid "{#666666}*An ornate pedestal holds an ancient scroll*{/}"
msgstr "{#666666}*На богато украшенном пьедестале лежит древний свиток*{/}"

#: d_zachariel_32_quests.cs
msgid "The scroll appears to be written by the great scholar Kepeck, documenting a powerful relic."
msgstr "Судя по всему, этот свиток написан великим учёным Кепеком и содержит сведения о могущественной реликвии."

#: d_zachariel_32_quests.cs
msgid "You would need official permission from the Grand Archive to remove these documents."
msgstr "Для изъятия этих документов вам потребуется официальное разрешение от Главного архива."

#: d_zachariel_32_quests.cs
msgid "{#666666}*The pedestal is empty*{/}"
msgstr "{#666666}*Подиум пуст*{/}"

#: d_zachariel_32_quests.cs
msgid "You've already collected the scroll from this location."
msgstr "Вы уже забрали свиток из этого места."

#: d_zachariel_32_quests.cs
msgid "{#666666}*An ornate pedestal holds an ancient scroll bearing Kepeck's seal*{/}"
msgstr "{#666666}*На богато украшенном пьедестале лежит древний свиток с печатью Кепека*{/}"

#: d_zachariel_32_quests.cs
msgid "This appears to be one of the Relic Memoranda you're searching for."
msgstr "Похоже, это один из тех «Меморандумов о реликвиях», которые вы ищете."

#: d_zachariel_32_quests.cs
msgid "Carefully retrieving scroll..."
msgstr "Осторожно извлекаю свиток..."

#: d_zachariel_32_quests.cs
msgid "Cancel"
msgstr "Отмена"

#: d_zachariel_32_quests.cs
msgid "Relic Memoranda collected: {0}/3"
msgstr "Собранные записки о реликвиях: {0}/3"

#: d_zachariel_32_quests.cs
msgid "{#666666}All Relic Memoranda collected! Return to Grand Archivist Elwen in Fedimian.{/}"
msgstr "{#666666}Все меморандумы о реликвиях собраны! Вернитесь к великому архивариусу Элвену в Федимиане.{/}"

#: d_zachariel_32_quests.cs
msgid "Collection cancelled."
msgstr "Сбор отменен."

# ============================================================================
# Headgear: Ancient Crown (ancient_crown_quest.cs)
# ============================================================================

#: headgears/ancient_crown_quest.cs
msgid "[Scholar] Sssevren"
msgstr "[Учёный] Сссеврен"

#: headgears/ancient_crown_quest.cs
msgid "Sssevren"
msgstr "Сссеврен"

#: headgears/ancient_crown_quest.cs
msgid "Ah, a visitor! My research into our ancient civilization's ceremonial headpieces is progressing well, but I need more materials..."
msgstr "А, гость! Мои исследования, посвящённые церемониальным головным уборам нашей древней цивилизации, идут полным ходом, но мне нужно больше материалов..."

#: headgears/ancient_crown_quest.cs
msgid "The bones of our warriors carry the strength of our ancestors, and the sacred Tama leaves were used in all our ceremonies. With these, I can recreate a crown of great significance!"
msgstr "В костях наших воинов таится сила наших предков, а священные листья тама использовались во всех наших обрядах. С их помощью я смогу воссоздать корону, имеющую огромное значение!"

#: headgears/ancient_crown_quest.cs
msgid "Have you gathered the materials for the ancient crown?"
msgstr "Вы уже собрали материалы для древней короны?"

#: headgears/ancient_crown_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/ancient_crown_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/ancient_crown_quest.cs
msgid "*eyes gleaming with scholarly excitement* Yesss! These are perfect specimens! Watch as I craft... *carefully assembles the crown* Here, take this recreation of our ancient crown. May it serve you as well as it served my ancestors."
msgstr "*глаза сияют от научного восторга* Дааа! Это просто идеальные экземпляры! Смотрите, как я создаю… *тщательно собирает корону* Вот, возьмите эту копию нашей древней короны. Пусть она послужит вам так же хорошо, как служила моим предкам."

#: headgears/ancient_crown_quest.cs
msgid "*adjusts spectacles again* You know... I could always craft another if you bring more materials. There's still so much to learn about the different styles and variations..."
msgstr "*снова поправляет очки* Знаешь... Я всегда могу изготовить ещё одну, если ты принёсёшь больше материалов. Мне ещё столько всего предстоит узнать о разных стилях и вариациях..."

#: headgears/ancient_crown_quest.cs
msgid "*scratches notes on parchment* Remember, we need 100 bones from our warrior ancestors and 50 sacred Tama leaves. The proportions must be exact for historical accuracy!"
msgstr "*делает записи на пергаменте* Не забудь, нам нужно 100 костей наших воинских предков и 50 священных листьев тама. Пропорции должны быть точными — ради исторической достоверности!"

#: headgears/ancient_crown_quest.cs
msgid "Would you help me gather materials to recreate another ancient crown?"
msgstr "Не могли бы вы помочь мне собрать материалы для воссоздания ещё одной древней короны?"

#: headgears/ancient_crown_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/ancient_crown_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/ancient_crown_quest.cs
msgid "*excitedly flips through research notes* Excellent! Remember, we need the bones of our warriors - they must be from true Lizardman warriors, not just any bones - and the sacred Tama leaves. Both are essential for historical accuracy!"
msgstr "*взволнованно листает исследовательские заметки* Прекрасно! Помни, нам нужны кости наших воинов — они должны принадлежать настоящим воинам-ящерам, а не просто каким-то костям — и священные листья Тама. И то, и другое необходимо для исторической достоверности!"

#: headgears/ancient_crown_quest.cs
msgid "*returns to studying scrolls* Very well... The secrets of our ancient crowns will wait. They have waited for centuries, after all..."
msgstr "*возвращается к изучению свитков* Хорошо... Секреты наших древних коронок подождут. В конце концов, они ждали веками..."

# ============================================================================
# Headgear: Angel Wings (angel_wings_quest.cs)
# ============================================================================

#: headgears/angel_wings_quest.cs
msgid "[Tomb Keeper] Seraphiel"
msgstr "[Хранитель гробницы] Серафиэль"

#: headgears/angel_wings_quest.cs
msgid "Seraphiel"
msgstr "Серафиэль"

#: headgears/angel_wings_quest.cs
msgid "{#666666}*stands before the ancient tomb, head bowed in silent prayer*{/}"
msgstr "{#666666}*стоит перед древней гробницей, склонив голову в молчаливой молитве*{/}"

#: headgears/angel_wings_quest.cs
msgid "You walk upon hallowed ground, traveler. This tomb holds the remains of one who once served the goddesses directly - a guardian whose wings carried divine light across the land."
msgstr "Ты ступаешь по священной земле, путешественник. В этой гробнице покоятся останки того, кто когда-то служил богиням напрямую — стража, чьи крылья несли божественный свет по всей земле."

#: headgears/angel_wings_quest.cs
msgid "I have long wished to honor their memory with a fitting tribute. With the right materials, I could craft wings that echo their former glory..."
msgstr "Я давно хотел почтить их память достойным образом. Имея подходящие материалы, я мог бы изготовить крылья, которые отражали бы их былую славу..."

#: headgears/angel_wings_quest.cs
msgid "Have you gathered the materials for the wings?"
msgstr "Вы уже собрали материалы для крыльев?"

#: headgears/angel_wings_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/angel_wings_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/angel_wings_quest.cs
msgid "{#666666}*takes the materials with reverent care, crafting beneath the shadow of the tomb*{/}"
msgstr "{#666666}*с благоговейной заботой берет материалы и творит в тени гробницы*{/}"

#: headgears/angel_wings_quest.cs
msgid "The resin of the ancient trees holds memories of this garden's sacred past. The shells provide the structure, resilient yet light. Together... they become something divine."
msgstr "Смола древних деревьев хранит воспоминания о священном прошлом этого сада. Ракушки придают конструкции прочность и легкость. Вместе… они превращаются в нечто божественное."

#: headgears/angel_wings_quest.cs
msgid "Take these wings, friend. Though you are not the guardian who rests here, perhaps their blessing now extends to you."
msgstr "Возьми эти крылья, друг мой. Хотя ты и не тот страж, который покоится здесь, возможно, их благословение теперь распространяется и на тебя."

#: headgears/angel_wings_quest.cs
msgid "Should you wish to craft another pair, return to me."
msgstr "Если захотите изготовить ещё одну пару, обратитесь ко мне."

#: headgears/angel_wings_quest.cs
msgid "The Long-Branched Trees hold sacred resin within their bark. The Infroburks wander the northern paths near here. Both carry echoes of this garden's ancient power."
msgstr "В коре Длинноветвистых деревьев таится священная смола. Неподалеку отсюда по северным тропам бродят Инфробурки. И те, и другие несут в себе отголоски древней силы этого сада."

#: headgears/angel_wings_quest.cs
msgid "Would you help me gather materials to craft a pair of Angel Wings?"
msgstr "Не могли бы вы помочь мне собрать материалы для изготовления пары ангельских крыльев?"

#: headgears/angel_wings_quest.cs
msgid "I will honor the guardian"
msgstr "Я буду чтить опекуна"

#: headgears/angel_wings_quest.cs
msgid "Perhaps another time"
msgstr "Может быть, в другой раз"

#: headgears/angel_wings_quest.cs
msgid "Bless you, traveler. I need 75 Resin from the Long-Branched Trees that grow throughout the garden, and 50 Infroburk Shells from the Infroburks that patrol the northern areas. May the guardian's light guide your steps."
msgstr "Будь здоров, путешественник. Мне нужно 75 единиц смолы с длинноветвистых деревьев, растущих по всему саду, и 50 панцирей инфробурков, патрулирующих северные районы. Пусть свет стража ведёт тебя по пути."

#: headgears/angel_wings_quest.cs
msgid "{#666666}*turns back toward the tomb*{/} The guardian waits patiently. They have waited for centuries... a little longer matters not."
msgstr "{#666666}*поворачивается обратно к гробнице*{/} Страж терпеливо ждёт. Он ждал веками… ещё немного — какая разница."

# ============================================================================
# Headgear: Angelic Halo (angelic_halo_quest.cs)
# ============================================================================

#: headgears/angelic_halo_quest.cs
msgid "[Priestess] Celestine"
msgstr "[Жрица] Селестина"

#: headgears/angelic_halo_quest.cs
msgid "Celestine"
msgstr "Селестина"

#: headgears/angelic_halo_quest.cs
msgid "{#666666}*kneels in prayer beside the sacred waters*{/}"
msgstr "{#666666}*преклоняет колени в молитве у священных вод*{/}"

#: headgears/angelic_halo_quest.cs
msgid "Blessings upon you, traveler. I am Sister Celestine, keeper of this sacred shrine. The goddess has guided your steps here for a purpose, I am certain."
msgstr "Да благословит тебя, путешественник. Я — сестра Селестина, хранительница этой святыни. Я уверена, что богиня привела тебя сюда не просто так."

#: headgears/angelic_halo_quest.cs
msgid "Long ago, the angels who served the goddesses wore halos of pure light. Though those celestial beings have long departed, I believe we can recreate their blessed crowns using the sacred materials found in this garden."
msgstr "Давным-давно ангелы, служившие богиням, носили нимбы из чистого света. Хотя эти небесные существа уже давно ушли, я верю, что мы сможем воссоздать их благословенные венцы, используя священные материалы, найденные в этом саду."

#: headgears/angelic_halo_quest.cs
msgid "Have you gathered the blessed materials?"
msgstr "Вы уже собрали все необходимые материалы?"

#: headgears/angelic_halo_quest.cs
msgid "Yes, I have them"
msgstr "Да, у меня они есть"

#: headgears/angelic_halo_quest.cs
msgid "Still searching"
msgstr "Все еще ищу"

#: headgears/angelic_halo_quest.cs
msgid "{#666666}*accepts the materials with reverence*{/}"
msgstr "{#666666}*с почтением принимает материалы*{/}"

#: headgears/angelic_halo_quest.cs
msgid "The resin carries the essence of the ancient trees that have witnessed centuries of prayer. And these shells... I can feel the warmth of divine fire still within them."
msgstr "В этой смоле заключена сущность древних деревьев, которые были свидетелями молитв на протяжении веков. А эти ракушки… Я чувствую, как в них до сих пор таится тепло божественного огня."

#: headgears/angelic_halo_quest.cs
msgid "{#666666}*dips the materials into the sacred waters and begins to chant*{/}"
msgstr "{#666666}*окунает материалы в священную воду и начинает петь*{/}"

#: headgears/angelic_halo_quest.cs
msgid "By the light of the goddesses, let this halo shine with celestial radiance. May it protect the wearer and remind them of the divine presence that watches over us all."
msgstr "При свете богинь пусть этот нимб сияет небесным блеском. Пусть он защищает того, кто его носит, и напоминает ему о божественном присутствии, которое охраняет всех нас."

#: headgears/angelic_halo_quest.cs
msgid "{#666666}*a soft golden glow emanates from her hands*{/}"
msgstr "{#666666}*из её рук исходит мягкое золотистое сияние*{/}"

#: headgears/angelic_halo_quest.cs
msgid "It is done. Take this Angelic Halo, blessed child. Wear it with humility, and may the goddesses smile upon your journey."
msgstr "Готово. Прими этот Ангельский нимб, благословенное дитя. Носи его со смирением, и пусть богини улыбаются тебе на твоём пути."

#: headgears/angelic_halo_quest.cs
msgid "The Long-Branched Trees in this garden produce a sacred resin that has absorbed centuries of prayers. The Infroburks, though fearsome, carry shells tempered by divine fire."
msgstr "Длинноветвистые деревья в этом саду дают священную смолу, впитавшую в себя молитвы многих веков. Инфробурки, несмотря на свой устрашающий вид, носят панцири, закаленные божественным огнём."

#: headgears/angelic_halo_quest.cs
msgid "Gather these materials with a pure heart, and the goddesses will guide your hands."
msgstr "Соберите эти материалы с чистым сердцем, и богини направят ваши руки."

#: headgears/angelic_halo_quest.cs
msgid "Would you help me gather the materials to craft a blessed halo?"
msgstr "Не могли бы вы помочь мне собрать материалы для изготовления освященного нимба?"

#: headgears/angelic_halo_quest.cs
msgid "I would be honored"
msgstr "Для меня это было бы большой честью"

#: headgears/angelic_halo_quest.cs
msgid "Perhaps another time"
msgstr "Может быть, в другой раз"

#: headgears/angelic_halo_quest.cs
msgid "The goddesses smile upon your generosity. I shall need 75 portions of Resin from the Long-Branched Trees that grow in this sacred garden."
msgstr "Богини благосклонно смотрят на твою щедрость. Мне понадобится 75 порций смолы с Длинноветвистых деревьев, растущих в этом священном саду."

#: headgears/angelic_halo_quest.cs
msgid "I also require 100 Infroburk Shells. Though these creatures seem fearsome, their shells have been tempered by holy fire and carry a spark of the divine."
msgstr "Мне также нужно 100 панцирей инфробурков. Хотя эти существа кажутся устрашающими, их панцири закалены святым огнём и несут в себе искру божественного."

#: headgears/angelic_halo_quest.cs
msgid "Return to me when you have gathered these materials, and together we shall craft something truly miraculous."
msgstr "Вернись ко мне, когда соберешь эти материалы, и вместе мы создадим нечто поистине чудесное."

#: headgears/angelic_halo_quest.cs
msgid "I understand. The path of service is not for everyone. May the goddesses watch over you nonetheless."
msgstr "Я понимаю. Путь служения — не для всех. Но пусть богини всё же хранят тебя."

# ============================================================================
# Headgear: Boeing Sunglasses (boeing_sunglasses_quest.cs)
# ============================================================================

#: headgears/boeing_sunglasses_quest.cs
msgid "[Klaipeda Agent] Markas"
msgstr "[Агент в Клайпеде] Маркас"

#: headgears/boeing_sunglasses_quest.cs
msgid "Markas"
msgstr "Маркас"

#: headgears/boeing_sunglasses_quest.cs
msgid "*adjusts his collar and looks around nervously* I've been sent here from Klaipeda to investigate these... Hogmas. Humanoid pigs, they call them."
msgstr "*поправляет воротник и нервно оглядывается* Меня прислали сюда из Клайпеды, чтобы расследовать дело об этих… Хогмасах. Говорят, это человекоподобные свиньи."

#: headgears/boeing_sunglasses_quest.cs
msgid "The reports say they're becoming more aggressive around Fedimian. I need proof of their activities, but I'd rather not get too close to those creatures myself."
msgstr "В отчетах говорится, что в окрестностях Федимиана они ведут себя всё более агрессивно. Мне нужны доказательства их деятельности, но я бы предпочёл не приближаться к этим существам слишком близко."

#: headgears/boeing_sunglasses_quest.cs
msgid "Have you gathered the evidence I need?"
msgstr "Вы собрали нужные мне доказательства?"

#: headgears/boeing_sunglasses_quest.cs
msgid "Yes, here's the evidence"
msgstr "Да, вот доказательства"

#: headgears/boeing_sunglasses_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/boeing_sunglasses_quest.cs
msgid "*examines the materials carefully* Excellent! The Lauzinute skins and Hogma tusks provide clear evidence of the creatures' presence and behavior."
msgstr "*внимательно изучает материалы* Превосходно! Шкуры лаузинутов и клыки хогмы служат явным доказательством присутствия этих существ и их поведения."

#: headgears/boeing_sunglasses_quest.cs
msgid "Here, take these sunglasses. They were part of my field equipment, but I think you've earned them more than I have. Stay safe out there."
msgstr "Вот, возьми эти солнцезащитные очки. Они входили в мой полевой комплект, но, по-моему, ты заслужил их больше, чем я. Будь осторожен там."

#: headgears/boeing_sunglasses_quest.cs
msgid "*frowns* Hmm, I don't see enough evidence here. I need 50 Lauzinute skins and 30 Hogma tusks to compile a proper report."
msgstr "*хмурится* Хм, мне кажется, здесь недостаточно доказательств. Мне нужно 50 шкур лаузинутов и 30 клыков хогмы, чтобы составить полноценный отчет."

#: headgears/boeing_sunglasses_quest.cs
msgid "*scribbles in a notebook* Take your time, but be careful. These creatures aren't to be taken lightly."
msgstr "*что-то записывает в блокнот* Не торопись, но будь осторожен. К этим существам нельзя относиться легкомысленно."

#: headgears/boeing_sunglasses_quest.cs
msgid "Would you be willing to help me gather evidence from the creatures in this area?"
msgstr "Не могли бы вы помочь мне собрать доказательства у существ, обитающих в этой местности?"

#: headgears/boeing_sunglasses_quest.cs
msgid "I'll help with the investigation"
msgstr "Я помогу с расследованием"

#: headgears/boeing_sunglasses_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/boeing_sunglasses_quest.cs
msgid "*breathes a sigh of relief* Thank you! I need 50 Lauzinute skins from the scorpion-like creatures and 30 Hogma tusks from those pig-faced archers. This evidence will help me compile a thorough report on the regional threats."
msgstr "*вздыхает с облегчением* Спасибо! Мне нужно 50 шкур лаузинутов, добытых с существ, похожих на скорпионов, и 30 клыков хогмы, добытых с тех лучников со свиными мордами. Эти доказательства помогут мне составить подробный отчёт об угрозах в регионе."

#: headgears/boeing_sunglasses_quest.cs
msgid "*nods understandingly* I understand. If you change your mind, I'll be here... keeping a safe distance from those Hogmas."
msgstr "*понимающе кивает* Я понимаю. Если передумаешь, я буду здесь… на безопасном расстоянии от этих Хогмов."

# ============================================================================
# Headgear: Buried Carrot (buried_carrot_quest.cs)
# ============================================================================

#: headgears/buried_carrot_quest.cs
msgid "[Forager] Terron"
msgstr "[Сборщик] Террон"

#: headgears/buried_carrot_quest.cs
msgid "Terron"
msgstr "Террон"

#: headgears/buried_carrot_quest.cs
msgid "{#666666}*digs through the thorny undergrowth with a small trowel*{/}"
msgstr "{#666666}*копается в колючем подлеске маленькой лопаткой*{/}"

#: headgears/buried_carrot_quest.cs
msgid "Cauliflowers... I was told there were cauliflowers growing nearby, but all I find are these strange crystallized mushrooms and those aggressive thorny creatures!"
msgstr "Цветная капуста... Мне сказали, что поблизости растёт цветная капуста, но всё, что я нахожу, — это какие-то странные кристаллические грибы и эти агрессивные колючие существа!"

#: headgears/buried_carrot_quest.cs
msgid "Wait... perhaps I can use what I find here instead. Those crystal formations from the Truffles and the sturdy horns from the Grolls... I could craft something quite unique!"
msgstr "Подожди... может быть, я смогу вместо этого использовать то, что найду здесь. Эти кристаллические образования из трюфелей и крепкие рога гроллов... Я мог бы смастерить что-то совершенно уникальное!"

#: headgears/buried_carrot_quest.cs
msgid "Have you gathered the underground materials I need?"
msgstr "Ты собрал нужные мне материалы из подземелий?"

#: headgears/buried_carrot_quest.cs
msgid "Yes, I have them all"
msgstr "Да, у меня они все есть"

#: headgears/buried_carrot_quest.cs
msgid "Still foraging"
msgstr "По-прежнему ищет пищу"

#: headgears/buried_carrot_quest.cs
msgid "{#666666}*carefully arranges the materials, grinding and mixing them together*{/}"
msgstr "{#666666}*тщательно раскладывает материалы, измельчая и смешивая их*{/}"

#: headgears/buried_carrot_quest.cs
msgid "Remarkable! The crystal essence combined with the ground horn creates this earth-toned pigment... and look! It has formed into the shape of a carrot! A buried carrot, if you will."
msgstr "Потрясающе! Кристаллическая эссенция в сочетании с измельченным рогом дала этот пигмент землистых оттенков… и посмотрите! Он принял форму морковки! Закопанной морковки, если хотите."

#: headgears/buried_carrot_quest.cs
msgid "Please, take this as thanks for helping me discover something far more interesting than mere cauliflowers!"
msgstr "Пожалуйста, примите это в знак благодарности за то, что помогли мне открыть для себя нечто гораздо более интересное, чем просто цветная капуста!"

#: headgears/buried_carrot_quest.cs
msgid "{#666666}*excitedly examines the remaining materials*{/} I wonder what else I could create with these components..."
msgstr "{#666666}*с восторгом рассматривает оставшиеся материалы*{/} Интересно, что ещё я мог бы создать из этих компонентов..."

#: headgears/buried_carrot_quest.cs
msgid "The Truffles scatter their crystals when defeated, and the Grolls... well, be careful with those. Their horns are sharp!"
msgstr "Трюфели, когда их побеждают, разбрасывают свои кристаллы, а Гроллы… ну, с ними будьте осторожны. У них острые рога!"

#: headgears/buried_carrot_quest.cs
msgid "Would you help me gather materials from this thorny underground passage?"
msgstr "Не могли бы вы помочь мне собрать материалы из этого труднопроходимого подземного прохода?"

#: headgears/buried_carrot_quest.cs
msgid "I'll help you forage"
msgstr "Я помогу тебе собрать пропитание"

#: headgears/buried_carrot_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/buried_carrot_quest.cs
msgid "Wonderful! I need 60 Truffle Crystals from the fungal creatures wandering these tunnels, and 30 Groll Horns from those green beasts that lurk about. The combination should yield something quite special!"
msgstr "Замечательно! Мне нужно 60 кристаллов трюфеля, которые можно добыть у грибных существ, бродящих по этим туннелям, и 30 рогов гроллов — у тех зелёных чудовищ, что скрываются поблизости. Из этой комбинации должно получиться нечто совершенно особенное!"

#: headgears/buried_carrot_quest.cs
msgid "{#666666}*returns to digging*{/} Very well. I shall continue my search for those elusive cauliflowers..."
msgstr "{#666666}*возвращается к копанию*{/} Хорошо. Я продолжу поиски этих неуловимых цветных капуст..."

# ============================================================================
# Headgear: Butterfly Hat (butterfly_hat_quest.cs)
# ============================================================================

#: headgears/butterfly_hat_quest.cs
msgid "[Grandma] Nella"
msgstr "[Бабушка] Нелла"

#: headgears/butterfly_hat_quest.cs
msgid "Nella"
msgstr "Нелла"

#: headgears/butterfly_hat_quest.cs
msgid "Oh my, what a lovely day to watch the butterflies! *adjusts her shawl* They remind me of my younger days, dancing in these fields..."
msgstr "Ой, какой чудесный день, чтобы понаблюдать за бабочками! *поправляет шаль* Они напоминают мне о моей юности, когда я танцевала на этих полях..."

#: headgears/butterfly_hat_quest.cs
msgid "You know, I've been working on a special hat design. Something to capture their grace and beauty. Would you help this old lady gather some materials?"
msgstr "Знаете, я работаю над дизайном особой шляпки. Такой, которая бы отражала их грацию и красоту. Не помогли бы вы этой старушке собрать немного материалов?"

#: headgears/butterfly_hat_quest.cs
msgid "Have you gathered the materials for the Butterfly Hat?"
msgstr "Вы уже собрали материалы для изготовления шляпы «Бабочка»?"

#: headgears/butterfly_hat_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/butterfly_hat_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/butterfly_hat_quest.cs
msgid "Oh, these are perfect! *carefully crafts the hat* Here you are, dear. Now you can carry a piece of these beautiful butterflies with you wherever you go."
msgstr "Ой, они просто идеальны! *аккуратно мастерит шляпку* Вот, дорогая. Теперь ты сможешь носить с собой частичку этих прекрасных бабочек, куда бы ты ни пошла."

#: headgears/butterfly_hat_quest.cs
msgid "Take your time, dear. The butterflies will always be here in the plateau."
msgstr "Не торопись, дорогая. Бабочки всегда будут здесь, на плато."

#: headgears/butterfly_hat_quest.cs
msgid "Would you help me gather materials for the Butterfly Hat?"
msgstr "Не могли бы вы помочь мне собрать материалы для шляпы «Бабочка»?"

#: headgears/butterfly_hat_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/butterfly_hat_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/butterfly_hat_quest.cs
msgid "Thank you, dear! Bring me 150 Leafly Wings for the delicate fabric, and 25 Dilgele flowers for the decoration. Together we'll make something truly special!"
msgstr "Спасибо, дорогая! Принеси мне 150 «Крыльев Лифли» для тонкой ткани и 25 цветов «Дилгеле» для украшения. Вместе мы создадим что-то по-настоящему особенное!"

#: headgears/butterfly_hat_quest.cs
msgid "Oh, that's alright dear. Perhaps another time. I'll be here, watching my butterflies."
msgstr "О, ничего страшного, дорогая. Может, в другой раз. Я останусь здесь и буду наблюдать за своими бабочками."

# ============================================================================
# Headgear: Cat Ears (cat_ears_quest.cs)
# ============================================================================

#: headgears/cat_ears_quest.cs
msgid "[Fearful] Felix"
msgstr "[Испуганный] Феликс"

#: headgears/cat_ears_quest.cs
msgid "Felix"
msgstr "Феликс"

#: headgears/cat_ears_quest.cs
msgid "*nervously looking around* Th-they say chupacabras are everywhere in these deserts! Have you heard the stories? They drink blood and... and... *shudders*"
msgstr "*нервно оглядываясь по сторонам* Г-говорят, что чупакабры в этих пустынях повсюду! Ты слышал об этом? Они пьют кровь и... и... *вздрогивает*"

#: headgears/cat_ears_quest.cs
msgid "I need proof they're not as terrible as people say. But I'm too scared to go near them! Could you help me?"
msgstr "Мне нужны доказательства, что они не такие ужасные, как о них говорят. Но я слишком боюсь к ним подойти! Не могли бы вы мне помочь?"

#: headgears/cat_ears_quest.cs
msgid "D-did you get close to those creatures?"
msgstr "— Т-ты подходил близко к этим существам?"

#: headgears/cat_ears_quest.cs
msgid "Yes, I have proof"
msgstr "Да, у меня есть доказательства"

#: headgears/cat_ears_quest.cs
msgid "Still gathering proof"
msgstr "По-прежнему собираем доказательства"

#: headgears/cat_ears_quest.cs
msgid "*examines the materials* They... they really are just like desert foxes? I've been afraid for nothing! Here, take these cat ears - they remind me that not everything is as scary as it seems."
msgstr "*рассматривает материалы* Они… они действительно похожи на пустынных лисиц? Я зря испугалась! Вот, возьми эти кошачьи ушки — они напоминают мне, что не всё так страшно, как кажется."

#: headgears/cat_ears_quest.cs
msgid "*trembling* Take your time... just be careful out there!"
msgstr "*дрожа* Не торопись... только будь осторожен там!"

#: headgears/cat_ears_quest.cs
msgid "Will you help me learn the truth about chupacabras?"
msgstr "Поможете ли вы мне узнать правду о чупакабре?"

#: headgears/cat_ears_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/cat_ears_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/cat_ears_quest.cs
msgid "Oh thank you! *wrings hands nervously* I need 80 pieces of their meat and 5 of their skin. That should tell me what they really are made of... right? Just... just be careful!"
msgstr "О, спасибо! *нервно сжимает руки* Мне нужно 80 кусков их мяса и 5 кусков их шкуры. Это должно прояснить, из чего они на самом деле состоят… верно? Только… только будь осторожен!"

#: headgears/cat_ears_quest.cs
msgid "*whimpers* I understand... they are scary after all..."
msgstr "*хнычет* Я понимаю... они ведь действительно страшные..."

# ============================================================================
# Headgear: Christmas Tree Snowglobe (christmas_tree_snowglobe_quest.cs)
# ============================================================================

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "[Tinkerer] Holvir"
msgstr "[Мастер] Холвир"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Holvir"
msgstr "Холвир"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "{#666666}*tinkers with a small glass sphere near his workshop*{/}"
msgstr "{#666666}*возится с маленьким стеклянным шариком возле своей мастерской*{/}"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Ah, a traveler! Come, come... see this? It's supposed to be a snowglobe, but it's missing something magical. The railroad brought supplies before it broke down, but now I must make do with what the plateau offers."
msgstr "А, путешественник! Иди-ка, иди... видишь это? Это должно было быть снежное шарико, но в нём не хватает чего-то волшебного. До того, как железная дорога вышла из строя, сюда доставляли припасы, но теперь мне приходится обходиться тем, что даёт это плато."

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "The White Grolls roaming these melting snows have horns of pure crystalline ice. And those Saltisdaughters carry white chains infused with frost... With these, I could create something truly wonderful!"
msgstr "У Белых Гроллов, бродящих по этим тающим снегам, рога из чистого кристаллического льда. А у тех Дочерей Салтиса — белые цепи, пропитанные морозом… С их помощью я мог бы сотворить нечто поистине чудесное!"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Have you gathered the materials for my snowglobe?"
msgstr "Ты собрал материалы для моего снежного шара?"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "{#666666}*carefully grinds the horns into a fine powder and weaves the chains into an intricate frame*{/}"
msgstr "{#666666}*тщательно измельчает рога в мелкий порошок и плетет из цепей замысловатую раму*{/}"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Magnificent! Watch closely... {#666666}*shakes the completed snowglobe*{/} See how the snow swirls around the tiny tree? A piece of eternal winter, just for you. May it remind you of the magic found in these cold lands."
msgstr "Великолепно! Посмотрите внимательно... {#666666}*встряхивает готовый снежный шар*{/} Видите, как снег кружится вокруг крошечной елочки? Кусочек вечной зимы — специально для вас. Пусть он напоминает вам о волшебстве, которое таится в этих холодных краях."

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "The Grolls wander the plateau in large numbers, and the Saltisdaughters are never far behind. Stay warm out there, friend."
msgstr "Гроллы в больших стаях бродят по плато, а «Дочери Солти» всегда следуют за ними по пятам. Согревайся там, друг."

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Would you help me gather materials for this magical creation?"
msgstr "Не могли бы вы помочь мне собрать материалы для этого волшебного творения?"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Wonderful! Bring me 60 Groll Horns from the White Grolls and 80 White Chains from the Saltisdaughters. Their frozen essence will make the perfect snow for this globe!"
msgstr "Замечательно! Принеси мне 60 рогов белых гроллов и 80 белых цепей у дочерей Салтис. Их замерзшая сущность станет идеальным снегом для этого глобуса!"

#: headgears/christmas_tree_snowglobe_quest.cs
msgid "Understandable. The cold can be unforgiving. Should you change your mind, I'll be here, tinkering away..."
msgstr "Понятно. Холод бывает безжалостным. Если передумаешь, я буду здесь, что-нибудь мастерить..."

# ============================================================================
# Headgear: Cloud (cloud_quest.cs)
# ============================================================================

#: headgears/cloud_quest.cs
msgid "[Dreamer] Tomas"
msgstr "[Мечтатель] Томас"

#: headgears/cloud_quest.cs
msgid "Tomas"
msgstr "Томас"

#: headgears/cloud_quest.cs
msgid "{#666666}*gazes up at the sky near the waterfall*{/}"
msgstr "{#666666}*поднимает взгляд на небо у водопада*{/}"

#: headgears/cloud_quest.cs
msgid "Have you ever looked at the clouds and wondered what it would be like to touch one? I've spent years watching them drift over these falls..."
msgstr "Вы когда-нибудь смотрели на облака и задумывались, каково это — прикоснуться к одному из них? Я годами наблюдал, как они плывут над этими водопадами..."

#: headgears/cloud_quest.cs
msgid "The Siaulamb that roam this area have the softest fur leaves I've ever seen. When layered together, they look just like the fluffy clouds above. I want to craft something that captures that feeling."
msgstr "У сиауламбов, обитающих в этих краях, самая нежная шерсть, какую я когда-либо видела. Когда они собираются вместе, они выглядят точно так же, как пушистые облака в небе. Я хочу создать что-то, что передаст это ощущение."

#: headgears/cloud_quest.cs
msgid "Have you gathered the Siaulamb Fur Leaves?"
msgstr "Вы уже собрали меховые листья в Шяуламбе?"

#: headgears/cloud_quest.cs
msgid "Yes, I have them all"
msgstr "Да, у меня они все есть"

#: headgears/cloud_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/cloud_quest.cs
msgid "{#666666}*carefully arranges the soft leaves into a fluffy shape*{/}"
msgstr "{#666666}*аккуратно укладывает нежные листья, придавая им пушистую форму*{/}"

#: headgears/cloud_quest.cs
msgid "Magnificent! Look at how they catch the light from the waterfall's mist. Here, take this Cloud headpiece. Whenever you wear it, may you feel as free as the clouds drifting over these waters."
msgstr "Великолепно! Посмотри, как они отражают свет, пробивающийся сквозь туман водопада. Вот, возьми этот головной убор «Облако». Пусть каждый раз, когда ты его надеваешь, ты чувствуешь себя таким же свободным, как облака, плывущие над этими водами."

#: headgears/cloud_quest.cs
msgid "Hmm, it seems you're still missing some. I need 120 Siaulamb Fur Leaves to create the proper cloud effect."
msgstr "Хм, похоже, у тебя всё ещё не хватает нескольких. Мне нужно 120 листьев меха Сиауламба, чтобы создать нужный эффект облака."

#: headgears/cloud_quest.cs
msgid "The Siaulamb wander all around this farm. Their fur leaves are so soft... just like clouds. Take your time gathering them."
msgstr "Сиауламбы бродят по всей этой ферме. Их меховые листья такие мягкие… словно облака. Не торопитесь, собирая их."

#: headgears/cloud_quest.cs
msgid "Would you help me gather Siaulamb Fur Leaves to craft a Cloud headpiece?"
msgstr "Не могли бы вы помочь мне собрать листья шауламба, чтобы изготовить головной убор «Облако»?"

#: headgears/cloud_quest.cs
msgid "I'll help you reach the clouds"
msgstr "Я помогу тебе дотянуться до облаков"

#: headgears/cloud_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/cloud_quest.cs
msgid "Thank you, friend! The Siaulamb here shed their fur leaves quite often. Bring me 120 of them, and I'll craft you a headpiece that will make you feel like you're walking among the clouds themselves."
msgstr "Спасибо, друг! Местные сиауламбы довольно часто сбрасывают свои меховые листья. Принеси мне 120 таких, и я изготовлю тебе головной убор, в котором ты почувствуешь себя так, будто гуляешь прямо среди облаков."

#: headgears/cloud_quest.cs
msgid "I understand. Dreams can wait... they always do. But the clouds will still be here when you return."
msgstr "Я понимаю. Мечты могут подождать… они всегда ждут. Но облака всё равно будут здесь, когда ты вернёшься."

# ============================================================================
# Headgear: Cozy Polar Bear Ears (cozy_polar_bear_ears_quest.cs)
# ============================================================================

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "[Mountain Ranger] Valdis"
msgstr "[Горный рейнджер] Валдис"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Valdis"
msgstr "Валдис"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "{#666666}*pulls a thick fur hood tighter against the biting wind*{/}"
msgstr "{#666666}*плотнее натягивает толстый меховой капюшон, защищаясь от пронизывающего ветра*{/}"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Another traveler braving the plateau? Careful now - the cold up here claims the unprepared. I've spent twenty winters mapping these peaks, and I still respect what the frost can do."
msgstr "Еще один путешественник, отважившийся подняться на плато? Будьте осторожны — здесь, наверху, холод не щадит тех, кто не готов к нему. Я провел двадцать зим, составляя карты этих вершин, и до сих пор с уважением отношусь к тому, на что способен мороз."

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "You know what keeps me going? Good gear. I've been working on something special - a pair of ear covers fashioned after the bears that once roamed these heights. Cozy as a campfire, they are."
msgstr "Знаете, что помогает мне не сдаваться? Хорошее снаряжение. Я работаю над чем-то особенным — парой ушных накладок, стилизованных под медведей, которые когда-то бродили по этим высотам. Они уютные, как костёр."

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Have you gathered the materials I need?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "{#666666}*examines the materials with practiced hands*{/} Excellent quality! The leather from those blue Cronewts is naturally resistant to frost - it never quite thaws, which makes it perfect for insulation."
msgstr "{#666666}*ощупывает материалы опытными руками*{/} Превосходное качество! Кожа этих синих кроневтов обладает естественной морозостойкостью — она практически не размораживается, что делает её идеальным материалом для утепления."

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "{#666666}*carefully stitches and shapes the materials*{/} And these Hohen manes... thick and soft, they'll keep the bitter wind from reaching your ears. There we go - a proper pair of polar bear ears!"
msgstr "{#666666}*тщательно сшивает и придаёт форму материалам*{/} А вот эти гривы Хоэна... густые и мягкие, они не дадут пронизывающему ветру дотянуться до ваших ушей. Вот и готово — настоящая пара ушей белого медведя!"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "The plateau never stops demanding respect, friend. If you find yourself needing another pair - perhaps for a companion - you know where to find me."
msgstr "Плато всегда требует к себе уважения, друг мой. Если тебе понадобится ещё одна пара — может быть, для спутника — ты знаешь, где меня найти."

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "The blue Cronewts are everywhere on this plateau - scaly beasts that have adapted to the cold. Their leather has a blue tint from the frost. The Hohens are trickier - look for the warriors with the distinctive manes. Both purple and blue variants have the thick fur I need."
msgstr "На этом плато повсюду встречаются синие кроневты — чешуйчатые существа, приспособившиеся к холоду. Их кожа приобрела синеватый оттенок от мороза. С хоенами сложнее — ищите воинов с характерными гривами. И у фиолетовых, и у синих особей есть густая шерсть, которая мне нужна."

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Would you like me to craft you a pair of these cozy bear ears?"
msgstr "Хочешь, я сделаю тебе такую пару уютных медвежьих ушек?"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "I would like that"
msgstr "Мне бы это хотелось"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "Splendid! I'll need two things from the local creatures. First, about 100 pieces of Blue Cronewt Leather - their hides have this remarkable frost-resistant quality. Second, 30 Blue Hohen Manes for the soft lining. The Hohens' manes trap warmth like nothing else."
msgstr "Великолепно! Мне понадобятся две вещи от местных обитателей. Во-первых, около 100 кусков кожи голубого кроньюта — их шкуры обладают замечательной морозостойкостью. Во-вторых, 30 голубых грив хоэнов для мягкой подкладки. Гривы хоэнов удерживают тепло как ничто другое."

#: headgears/cozy_polar_bear_ears_quest.cs
msgid "{#666666}*nods knowingly*{/} The plateau will still be here when you're ready. Stay warm out there, traveler."
msgstr "{#666666}*значительно кивает*{/} Плато будет ждать тебя, когда ты будешь готов. Не замерзни там, путешественник."

# ============================================================================
# Headgear: Crocus (crocus_quest.cs)
# ============================================================================

#: headgears/crocus_quest.cs
msgid "[Shrine Keeper] Velana"
msgstr "[Хранительница святилища] Велана"

#: headgears/crocus_quest.cs
msgid "Velana"
msgstr "Велана"

#: headgears/crocus_quest.cs
msgid "{#666666}*kneels before the weathered shrine pillar, arranging wilted flowers*{/}"
msgstr "{#666666}*преклоняет колени перед обветшалым столбом святилища, расставляя увядшие цветы*{/}"

#: headgears/crocus_quest.cs
msgid "Oh... a visitor to these forgotten ruins. The old shrine once bloomed with sacred crocuses, but the glen's corruption has made it difficult to tend them."
msgstr "О... посетитель этих забытых руин. Когда-то старинное святилище цвело священными крокусами, но из-за разложения, охватившего долину, ухаживать за ними стало трудно."

#: headgears/crocus_quest.cs
msgid "I've been trying to create a lasting tribute to the goddesses - a crocus ornament that won't wither. But I need materials from the creatures that now roam these waters..."
msgstr "Я пытаюсь создать вечное посвящение богиням — украшение в виде крокуса, которое не завянет. Но для этого мне нужны материалы от существ, которые сейчас бродят по этим водам..."

#: headgears/crocus_quest.cs
msgid "Have you gathered the materials I need?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/crocus_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/crocus_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/crocus_quest.cs
msgid "{#666666}*carefully weaves the materials together with practiced hands*{/}"
msgstr "{#666666}*искусно сплетает материалы своими опытными руками*{/}"

#: headgears/crocus_quest.cs
msgid "The Mantiwood's resilient skin forms the base, and the pine mushrooms provide the essence that gives it life... There. A crocus that will never fade."
msgstr "Прочная кора Мантивуда служит основой, а сосновые грибы дарят ему жизненную силу… Вот он — крокус, который никогда не увянет."

#: headgears/crocus_quest.cs
msgid "Take it as thanks for your devotion. May it remind you that even in corrupted waters, beauty can still bloom."
msgstr "Примите это в знак благодарности за вашу преданность. Пусть это напомнит вам, что даже в загрязнённых водах красота всё ещё может расцвести."

#: headgears/crocus_quest.cs
msgid "If you wish to create another, I would welcome your help again."
msgstr "Если вы захотите создать ещё один, я с радостью снова приму вашу помощь."

#: headgears/crocus_quest.cs
msgid "The Mantiwoods lurk in the deeper parts of the glen, and the Carcashu tend to the mushroom patches near the pools. Be cautious around the waters."
msgstr "Мантивуды скрываются в самых глубинных уголках долины, а Каркашу ухаживают за грибными зарослями возле водоёмов. Будьте осторожны возле водоёмов."

#: headgears/crocus_quest.cs
msgid "Would you help me gather materials for a sacred crocus ornament?"
msgstr "Не могли бы вы помочь мне собрать материалы для изготовления украшения в виде священного крокуса?"

#: headgears/crocus_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/crocus_quest.cs
msgid "Perhaps another time"
msgstr "Может быть, в другой раз"

#: headgears/crocus_quest.cs
msgid "Thank you, kind traveler. I need 50 Mantiwood Skins from the Mantiwoods that roam the forest, and 75 Pine Mushrooms that grow near the Carcashu. May the goddesses watch over you."
msgstr "Спасибо, добрый путешественник. Мне нужно 50 шкур мантивудов, которые бродят по лесу, и 75 сосновых грибов, растущих возле Каркашу. Пусть богини хранят тебя."

#: headgears/crocus_quest.cs
msgid "{#666666}*returns to tending the shrine*{/} The glen's beauty endures... for now. Return if you change your mind."
msgstr "{#666666}*возвращается к уходу за святилищем*{/} Красота долины остаётся неизменной… пока что. Вернись, если передумаешь."

# ============================================================================
# Headgear: Fashion (fashion_quest.cs)
# ============================================================================

#: headgears/fashion_quest.cs
msgid "Welcome, adventurer! I have some special items available for those who have diligently gathered certain... resources."
msgstr "Добро пожаловать, искатель приключений! У меня есть несколько особых предметов для тех, кто усердно собирал определённые… ресурсы."

#: headgears/fashion_quest.cs
msgid "It seems you've already redeemed everything I have to offer!  Come back later, perhaps I'll have new items in stock."
msgstr "Похоже, вы уже приобрели всё, что у меня есть в ассортименте! Загляните позже — возможно, у меня появятся новые товары."

#: headgears/fashion_quest.cs
msgid "Nothing right now."
msgstr "Пока ничего."

#: headgears/fashion_quest.cs
msgid "What can I see?"
msgstr "Что я могу увидеть?"

#: headgears/fashion_quest.cs
msgid "Come back if you find something interesting."
msgstr "Загляните снова, если найдёте что-нибудь интересное."

#: headgears/fashion_quest.cs
msgid "Hmm, something seems to be wrong with my records for that set."
msgstr "Хм, похоже, в моих записях по этому набору что-то не так."

#: headgears/fashion_quest.cs
msgid "You've collected enough {0} for a {1}! I can craft one for you."
msgstr "Вы собрали достаточно {0}, чтобы сделать {1}! Я могу изготовить его для вас."

#: headgears/fashion_quest.cs
msgid "You've completed this set! Congratulations!"
msgstr "Вы прошли этот набор! Поздравляем!"

#: headgears/fashion_quest.cs
msgid "There you go! Come back if you need anything else."
msgstr "Вот и всё! Заходите, если вам ещё что-нибудь понадобится."

#: headgears/fashion_quest.cs
msgid "You have {0} {1}. That's not enough for anything yet."
msgstr "У вас есть {0} {1}. Этого пока ни на что не хватит."

# ============================================================================
# Headgear: Feather Helmet (feather_helmet_quest.cs)
# ============================================================================

#: headgears/feather_helmet_quest.cs
msgid "[Retired Warrior] Helena"
msgstr "[Воин в отставке] Елена"

#: headgears/feather_helmet_quest.cs
msgid "Helena"
msgstr "Елена"

#: headgears/feather_helmet_quest.cs
msgid "*polishing an old helmet* In my days as a warrior, we made our helmets from the finest materials. The bells of the Ellom for strength, Cronewt leather for durability, and Kepo fluff for comfort."
msgstr "*полируя старый шлем* В те времена, когда я был воином, мы изготавливали шлемы из лучших материалов. Колокола Эллома — для прочности, кожа кронеута — для долговечности, а пух кепо — для удобства."

#: headgears/feather_helmet_quest.cs
msgid "These young warriors today with their plain iron helmets... *shakes head* They don't know what they're missing. Would you like to learn how to craft a proper warrior's helmet?"
msgstr "Эти современные молодые воины со своими простыми железными шлемами… *качает головой* Они даже не подозревают, чего лишаются. Хочешь научиться изготавливать настоящий воинский шлем?"

#: headgears/feather_helmet_quest.cs
msgid "Have you gathered all the materials for the helmet?"
msgstr "Вы собрали все материалы для изготовления шлема?"

#: headgears/feather_helmet_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/feather_helmet_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/feather_helmet_quest.cs
msgid "*expertly crafts the helmet* Ah, this brings back memories! The bells will ring with each victory, the leather will protect you, and the fluff... well, you'll be the most comfortable warrior on the battlefield!"
msgstr "*искусно изготавливает шлем* Ах, как это напоминает старые добрые времена! Колокольчики будут звенеть при каждой победе, кожа защитит тебя, а пух… ну, ты будешь самым уютным воином на поле боя!"

#: headgears/feather_helmet_quest.cs
msgid "*eyes gleaming with pride* You know, I could always teach you to make another. Nothing brings me more joy than passing on the old warrior traditions."
msgstr "*глаза сияют от гордости* Знаешь, я всегда могу научить тебя сделать ещё один. Ничто не доставляет мне больше радости, чем передача старинных воинских традиций."

#: headgears/feather_helmet_quest.cs
msgid "*returns to polishing helmets* Take your time, young one. A proper helmet can't be rushed. The materials must be perfect, just like in the old days."
msgstr "*возвращается к полировке шлемов* Не торопись, молодой человек. Хороший шлем не делается в спешке. Материалы должны быть безупречными, как в старые времена."

#: headgears/feather_helmet_quest.cs
msgid "Would you like to learn to craft another feather helmet?"
msgstr "Хотите научиться изготавливать ещё один шлем из перьев?"

#: headgears/feather_helmet_quest.cs
msgid "Yes, teach me"
msgstr "Да, научи меня"

#: headgears/feather_helmet_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/feather_helmet_quest.cs
msgid "*stands up straight with military bearing* Excellent! Remember: 40 Ellom bells for strength - they must ring clear and true. 25 pieces of Cronewt leather - make sure they're not damaged. And 60 tufts of Kepo fluff - the softest you can find!"
msgstr "*выпрямляется, принимая военную стойку* Отлично! Запомните: 40 колокольчиков Эллома для прочности — они должны звенеть чисто и звонко. 25 кусков кожи кроньюта — убедитесь, что они не повреждены. И 60 пучков пуха кепо — самых мягких, какие только сможете найти!"

#: headgears/feather_helmet_quest.cs
msgid "*nods understandingly* A warrior must choose their own path. Return if you wish to learn more about the old ways."
msgstr "*понимающе кивает* Воин должен сам выбрать свой путь. Вернись, если хочешь больше узнать о старых традициях."

# ============================================================================
# Headgear: Flarestone Horn (flarestone_horn_quest.cs)
# ============================================================================

#: headgears/flarestone_horn_quest.cs
msgid "[Frightened Villager] Valdas"
msgstr "[Испуганный житель деревни] Валдас"

#: headgears/flarestone_horn_quest.cs
msgid "Valdas"
msgstr "Валдас"

#: headgears/flarestone_horn_quest.cs
msgid "{#666666}*glances nervously at the surrounding trees*{/}"
msgstr "{#666666}*нервно оглядывается на окружающие деревья*{/}"

#: headgears/flarestone_horn_quest.cs
msgid "Traveler! Please, you must help us! The devil statues... they've come alive! They attack anyone who enters these woods now."
msgstr "Путешественник! Пожалуйста, ты должен нам помочь! Статуи дьявола… они ожили! Теперь они нападают на всех, кто заходит в этот лес."

#: headgears/flarestone_horn_quest.cs
msgid "The Siaulavs that roam here, they wear cursed masks that seem connected to this dark magic. If we can gather enough of their masks, perhaps we can break this curse... or at least protect ourselves from it."
msgstr "Сяулавы, бродящие по этим местам, носят проклятые маски, которые, похоже, связаны с этой тёмной магией. Если нам удастся собрать достаточное количество их масок, возможно, мы сможем снять это проклятие… или, по крайней мере, защитить себя от него."

#: headgears/flarestone_horn_quest.cs
msgid "Have you collected the Siaulamb Masks?"
msgstr "Вы уже собрали все маски из Шяулямба?"

#: headgears/flarestone_horn_quest.cs
msgid "Yes, I have them"
msgstr "Да, у меня они есть"

#: headgears/flarestone_horn_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/flarestone_horn_quest.cs
msgid "{#666666}*takes the masks with trembling hands*{/}"
msgstr "{#666666}*берет маски дрожащими руками*{/}"

#: headgears/flarestone_horn_quest.cs
msgid "These masks... I can feel the dark energy within them. But look what I found hidden among the Siaulavs' possessions - a horn carved from flarestone! It pulses with fiery power."
msgstr "Эти маски… Я чувствую, как из них струится тёмная энергия. Но посмотрите, что я нашёл среди вещей шаулявов — рог, вырезанный из пламенного камня! Он пульсирует огненной силой."

#: headgears/flarestone_horn_quest.cs
msgid "Take it. Perhaps it will ward off the evil that plagues these woods. And if you ever need another... well, the curse shows no signs of lifting."
msgstr "Возьми это. Возможно, это отгонит зло, которое терзает эти леса. А если тебе когда-нибудь понадобится ещё одно… ну, проклятие, похоже, не собирается исчезать."

#: headgears/flarestone_horn_quest.cs
msgid "The Siaulavs lurk deeper in the woods to the east. Be careful of the Shardstatues - they're the awakened devil statues I warned you about!"
msgstr "Шяулавцы скрываются глубже в лесу на востоке. Остерегайтесь «Осколочных статуй» — это те самые пробудившиеся статуи дьявола, о которых я вас предупреждал!"

#: headgears/flarestone_horn_quest.cs
msgid "Will you help us gather the cursed masks?"
msgstr "Поможете ли вы нам собрать проклятые маски?"

#: headgears/flarestone_horn_quest.cs
msgid "I'll help you"
msgstr "Я помогу тебе"

#: headgears/flarestone_horn_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/flarestone_horn_quest.cs
msgid "Thank the goddess! Hunt the Siaulavs in the eastern parts of these woods. Bring me 80 of their masks, and I'll reward you well for your bravery."
msgstr "Слава богине! Отправляйся на охоту за сиаулавами в восточных частях этих лесов. Принеси мне 80 их масок, и я щедро вознагражу тебя за твою отвагу."

#: headgears/flarestone_horn_quest.cs
msgid "{#666666}*sighs heavily*{/} I understand. These are dangerous times. Please reconsider if you change your mind."
msgstr "{#666666}*глубоко вздыхает*{/} Я понимаю. Сейчас небезопасные времена. Если передумаешь, пожалуйста, подумай ещё раз."

# ============================================================================
# Headgear: Flower Branch (flower_branch_quest.cs)
# ============================================================================

#: headgears/flower_branch_quest.cs
msgid "[Forest Artist] Florina"
msgstr "[Художница-лесовик] Флорина"

#: headgears/flower_branch_quest.cs
msgid "Florina"
msgstr "Флорина"

#: headgears/flower_branch_quest.cs
msgid "*arranging leaves and flowers* Nature creates the most beautiful patterns... if only we could capture their essence in our accessories!"
msgstr "*композиция из листьев и цветов* Природа создаёт самые прекрасные узоры… если бы только нам удалось воплотить их сущность в наших аксессуарах!"

#: headgears/flower_branch_quest.cs
msgid "These forest materials could be perfect for a lovely hair ornament. Would you help me gather some special pieces?"
msgstr "Эти лесные материалы могли бы идеально подойти для создания милого украшения для волос. Не поможете ли вы мне подобрать несколько интересных кусочков?"

#: headgears/flower_branch_quest.cs
msgid "Have you gathered the forest treasures?"
msgstr "Ты уже собрал лесные сокровища?"

#: headgears/flower_branch_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/flower_branch_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/flower_branch_quest.cs
msgid "*carefully weaves the materials together* Beautiful! The curve of the Leafnut horns provides the perfect foundation, while the Polibu leaves add texture, and the Parrot stems give it that delicate finishing touch."
msgstr "*тщательно сплетает материалы* Прекрасно! Изогнутая форма рогов Leafnut служит идеальной основой, листья Polibu придают текстуру, а стебли Parrot — нежный завершающий штрих."

#: headgears/flower_branch_quest.cs
msgid "*admires her work* There are endless possibilities with nature's treasures. Would you like to help me create another one?"
msgstr "*восхищается её работой* Сокровища природы открывают безграничные возможности. Не хочешь помочь мне создать ещё одно?"

#: headgears/flower_branch_quest.cs
msgid "Take your time gathering the materials. Art cannot be rushed, and nature's gifts are worth the wait."
msgstr "Не торопитесь с подбором материалов. В искусстве нельзя спешить, а дары природы стоят того, чтобы их дождаться."

#: headgears/flower_branch_quest.cs
msgid "Would you help me gather materials for a Flower Branch hair ornament?"
msgstr "Не могли бы вы помочь мне собрать материалы для изготовления украшения для волос «Цветочная ветка»?"

#: headgears/flower_branch_quest.cs
msgid "I'll help gather"
msgstr "Я помогу собрать"

#: headgears/flower_branch_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/flower_branch_quest.cs
msgid "Wonderful! The Leafnut horns will form the base structure, Polibu leaves will add a natural texture, and Parrot stems will give it that special ethereal quality. Happy gathering!"
msgstr "Замечательно! Рожки лифнута станут основой конструкции, листья полибу придадут ей естественную текстуру, а стебли попугая — особую воздушность. Удачного сбора!"

#: headgears/flower_branch_quest.cs
msgid "*returns to arranging flowers* Nature's beauty will still be here when you return..."
msgstr "*возвращается к составлению букета* Красота природы будет ждать тебя, когда ты вернёшься..."

# ============================================================================
# Headgear: Flower Crown (flower_crown_quest.cs)
# ============================================================================

#: headgears/flower_crown_quest.cs
msgid "[Florist] Flora"
msgstr "[Цветочный магазин] «Флора»"

#: headgears/flower_crown_quest.cs
msgid "Flora"
msgstr "Флора"

#: headgears/flower_crown_quest.cs
msgid "*arranging flowers delicately* Each petal tells a story, each leaf holds a memory... *smiles warmly* This old village provides us with such beautiful materials to work with."
msgstr "*нежно расставляя цветы* Каждый лепесток рассказывает свою историю, каждый листок хранит воспоминания... *тепло улыбается* Эта старинная деревня дарит нам такие прекрасные материалы для творчества."

#: headgears/flower_crown_quest.cs
msgid "I've been working on a special kind of crown, one that captures the essence of our beautiful places. Would you help me gather some materials?"
msgstr "Я работаю над особым видом короны, которая воплощает в себе суть наших прекрасных мест. Не поможете ли вы мне собрать материалы?"

#: headgears/flower_crown_quest.cs
msgid "Have you gathered the materials for our flower crown?"
msgstr "Вы уже собрали материалы для нашего цветочного венка?"

#: headgears/flower_crown_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/flower_crown_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/flower_crown_quest.cs
msgid "*weaves the materials with practiced hands* Such lovely colors! Here, try it on. The crown suits you perfectly! The forest has blessed us with its beauty once again."
msgstr "*умело сплетает материалы* Какие прекрасные цвета! Вот, примерите. Корона вам идеально подходит! Лес в очередной раз одарил нас своей красотой."

#: headgears/flower_crown_quest.cs
msgid "*eyes sparkle* You know... I could always create another one if you bring me more materials. Each crown turns out unique, just like the flowers themselves!"
msgstr "*глаза заблестели* Знаешь... Я всегда могу сделать ещё одну, если ты принесёшь мне больше материалов. Каждая корона получается уникальной, точно так же, как и сами цветы!"

#: headgears/flower_crown_quest.cs
msgid "*continues arranging flowers* Take your time gathering the materials. The forest's gifts are meant to be appreciated, not rushed."
msgstr "*продолжает составлять букет* Не торопитесь, собирая материалы. Дары леса нужно ценить, а не спешить с ними."

#: headgears/flower_crown_quest.cs
msgid "Would you like to help me create another flower crown?"
msgstr "Не хотели бы вы помочь мне сделать ещё один венок из цветов?"

#: headgears/flower_crown_quest.cs
msgid "I'll help gather materials"
msgstr "Я помогу собрать материалы"

#: headgears/flower_crown_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/flower_crown_quest.cs
msgid "*claps excitedly* Wonderful! The Caro leaves have such a lovely shape, perfect for the crown's structure. And the Upent bark, when treated properly, creates beautiful accents. Happy gathering!"
msgstr "*восторженно хлопает в ладоши* Замечательно! Листья Каро имеют такую прекрасную форму, идеально подходящую для конструкции короны. А кора Упента, при правильной обработке, создает красивые акценты. Удачного сбора!"

#: headgears/flower_crown_quest.cs
msgid "*nods understandingly* Of course, of course. The flowers will still be here when you return. They always are."
msgstr "*понимающе кивает* Конечно, конечно. Цветы будут здесь, когда ты вернёшься. Они всегда здесь."

# ============================================================================
# Headgear: Ghost Headband (ghost_headband_quest.cs)
# ============================================================================

#: headgears/ghost_headband_quest.cs
msgid "[Spirit] Marcus"
msgstr "[Дух] Маркус"

#: headgears/ghost_headband_quest.cs
msgid "Marcus"
msgstr "Маркус"

#: headgears/ghost_headband_quest.cs
msgid "*a small agitated spirit hovers around the gravestone* Those wretched Banshees... their screams still echo in my ethereal form. I need your help to exact my revenge."
msgstr "*Вокруг надгробия кружит маленький беспокойный дух* Эти проклятые банши… их крики до сих пор отзываются эхом в моей эфирной сущности. Мне нужна твоя помощь, чтобы отомстить."

#: headgears/ghost_headband_quest.cs
msgid "Bring me their essence, their very being... Only then can I find peace. Or perhaps... *voice fades* just a measure of satisfaction."
msgstr "Принеси мне их сущность, их самую суть... Только тогда я обрету покой. Или, может быть... *голос затихает* просто некоторое удовлетворение."

#: headgears/ghost_headband_quest.cs
msgid "Have you gathered the Banshee essences?"
msgstr "Вы уже собрали эссенции Банши?"

#: headgears/ghost_headband_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/ghost_headband_quest.cs
msgid "Still hunting"
msgstr "Охота с засады"

#: headgears/ghost_headband_quest.cs
msgid "*the spirits swirl around you* Yes... YES! I can feel their essence! Take this headband, forged from my spiritual energy. May it serve you well... as you have served my vengeance."
msgstr "*духи кружат вокруг тебя* Да... ДА! Я чувствую их сущность! Возьми эту повязку, выкованную из моей духовной энергии. Пусть она хорошо тебе послужит... так же, как ты послужил моей мести."

#: headgears/ghost_headband_quest.cs
msgid "*ghost flickers* I've waited this long for revenge... I can wait longer. But do hurry, won't you?"
msgstr "*призрак мерцает* Я так долго ждал мести... Могу подождать и еще. Но поторопись, ладно?"

#: headgears/ghost_headband_quest.cs
msgid "Will you help me gather these essences of vengeance?"
msgstr "Не поможешь ли ты мне собрать эти эссенции мести?"

#: headgears/ghost_headband_quest.cs
msgid "I will help"
msgstr "Я помогу"

#: headgears/ghost_headband_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/ghost_headband_quest.cs
msgid "*ghost brightens* Excellent! Bring me 75 measures of their Spirit Matter and 3 of their Hoods. Every essence you gather weakens them... and strengthens my revenge!"
msgstr "*призрак сияет* Превосходно! Принесите мне 75 мер их «Духовной материи» и 3 их «Капюшона». Каждая собранная вами эссенция ослабляет их… и укрепляет мою месть!"

#: headgears/ghost_headband_quest.cs
msgid "*ghost fades slightly* Then I shall continue to wait... as I have for so long already..."
msgstr "*призрак слегка исчезает* Тогда я буду ждать дальше… как ждал уже так долго…"

# ============================================================================
# Headgear: Groucho Glasses (groucho_glasses_quest.cs)
# ============================================================================

#: headgears/groucho_glasses_quest.cs
msgid "[Survivor] Berthold"
msgstr "[Выживший] Бертольд"

#: headgears/groucho_glasses_quest.cs
msgid "Berthold"
msgstr "Бертольд"

#: headgears/groucho_glasses_quest.cs
msgid "{#666666}*crouches behind a crumbling wall, eyes darting nervously*{/}"
msgstr "{#666666}*притаился за обрушивающейся стеной, нервно оглядываясь*{/}"

#: headgears/groucho_glasses_quest.cs
msgid "Shh! Keep your voice down! They might hear us... The spirits, they're everywhere now. Ever since they invaded the village, I've been hiding here, barely surviving."
msgstr "Тсс! Говори потише! Они могут нас услышать... Духи... Они теперь повсюду. С тех пор как они вторглись в деревню, я прячусь здесь, едва выживая."

#: headgears/groucho_glasses_quest.cs
msgid "I've watched them for weeks. They don't seem to recognize living faces they haven't seen before. If I could just... disguise myself somehow, change my face, I might be able to slip past them and escape!"
msgstr "Я наблюдаю за ними уже несколько недель. Похоже, они не распознают лица живых людей, которых раньше не видели. Если бы я только мог… как-нибудь замаскироваться, изменить своё лицо, то, возможно, мне удалось бы проскользнуть мимо них и сбежать!"

#: headgears/groucho_glasses_quest.cs
msgid "I know it sounds mad, but I've been working on something. A sort of mask, with a fake nose and spectacles. Ridiculous looking, yes, but if it fools the spirits, I don't care how silly I appear!"
msgstr "Я знаю, это звучит безумно, но я над чем-то работаю. Своего рода маска с искусственным носом и очками. Выглядит нелепо, да, но если это обманет духов, мне плевать, насколько глупо я при этом выгляжу!"

#: headgears/groucho_glasses_quest.cs
msgid "Did you gather the materials I need?"
msgstr "Ты собрал нужные мне материалы?"

#: headgears/groucho_glasses_quest.cs
msgid "Yes, I have everything"
msgstr "Да, у меня всё есть"

#: headgears/groucho_glasses_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/groucho_glasses_quest.cs
msgid "{#666666}*grabs the materials with trembling hands*{/}"
msgstr "{#666666}*берет материалы дрожащими руками*{/}"

#: headgears/groucho_glasses_quest.cs
msgid "Yes! Yes, this is perfect! The bone fragments will form the frame, and the cores... I can grind them into a paste that hardens like stone."
msgstr "Да! Да, это идеально! Осколки костей станут каркасом, а сердцевины… Я могу измельчить их в пасту, которая затвердеет, как камень."

#: headgears/groucho_glasses_quest.cs
msgid "{#666666}*works frantically, assembling the peculiar disguise*{/}"
msgstr "{#666666}*суетливо трудится, собирая своеобразное маскировочное снаряжение*{/}"

#: headgears/groucho_glasses_quest.cs
msgid "There! It's done! A bit... unusual looking, I admit. But I made two - one for me, and one for you. You've earned it, friend."
msgstr "Вот! Готово! Признаю, выглядит немного… необычно. Но я сделал два — один для меня, а другой для тебя. Ты это заслужил, друг."

#: headgears/groucho_glasses_quest.cs
msgid "The spirits seem to avoid anything that looks even slightly different from what they remember. This ridiculous thing might just save both our lives. Thank you, truly."
msgstr "Духи, похоже, избегают всего, что хоть немного отличается от того, что они помнят. Эта нелепая штука, возможно, спасёт нам обоим жизнь. Спасибо, от всей души."

#: headgears/groucho_glasses_quest.cs
msgid "{#666666}*peeks nervously around the corner*{/}"
msgstr "{#666666}*нервно заглядывает из-за угла*{/}"

#: headgears/groucho_glasses_quest.cs
msgid "Please hurry! The Hallowventers that float through the village streets... their bony hands hold the key. And the Gravegolems that patrol the ruins, their cores are what I need to bind it all together."
msgstr "Пожалуйста, поторопитесь! Хэллоувентеры, парящие над улицами деревни… Ключ находится в их костлявых руках. А Грейвголемы, патрулирующие руины, — их ядра именно то, что мне нужно, чтобы всё это объединить."

#: headgears/groucho_glasses_quest.cs
msgid "Be careful out there. The spirits are restless, especially at night."
msgstr "Будьте осторожны. Духи не успокаиваются, особенно ночью."

#: headgears/groucho_glasses_quest.cs
msgid "Will you help me gather what I need for this disguise?"
msgstr "Не поможешь ли ты мне собрать всё необходимое для этого переодевания?"

#: headgears/groucho_glasses_quest.cs
msgid "I'll help you"
msgstr "Я помогу тебе"

#: headgears/groucho_glasses_quest.cs
msgid "That sounds too dangerous"
msgstr "Это звучит слишком опасно"

#: headgears/groucho_glasses_quest.cs
msgid "{#666666}*relief washes over his face*{/}"
msgstr "{#666666}*на его лице отразилось облегчение*{/}"

#: headgears/groucho_glasses_quest.cs
msgid "Thank the goddesses! I need 75 Hand Bones from those horrible Hallowventers. Their skeletal fingers are surprisingly sturdy, perfect for the frame of the disguise."
msgstr "Слава богиням! Мне нужно 75 костей рук от этих ужасных «Хэлловентеров». Их скелетные пальцы на удивление прочные — идеально подойдут для каркаса костюма."

#: headgears/groucho_glasses_quest.cs
msgid "I also need 50 Gravegolem Cores. The golems roam throughout these ruins - their cores can be ground into a bonding paste."
msgstr "Мне также нужно 50 ядер големов могил. Големы бродят по этим руинам — их ядра можно измельчить и превратить в связующую пасту."

#: headgears/groucho_glasses_quest.cs
msgid "I know it seems like a lot, but I want to make sure this disguise is convincing. My life depends on it... and perhaps yours will too, someday."
msgstr "Я знаю, это может показаться чрезмерным, но я хочу быть уверен, что это маскировка будет убедительной. От этого зависит моя жизнь… и, возможно, когда-нибудь — и твоя тоже."

#: headgears/groucho_glasses_quest.cs
msgid "{#666666}*his face falls*{/}"
msgstr "{#666666}*его лицо омрачилось*{/}"

#: headgears/groucho_glasses_quest.cs
msgid "I... I understand. It is dangerous out there. Maybe I'll find another way... or maybe I'll just stay hidden here forever."
msgstr "Я... я понимаю. Там опасно. Может, я найду другой выход... а может, просто останусь здесь, скрываясь, навсегда."

# ============================================================================
# Headgear: Horned Hat (horned_hat_quest.cs)
# ============================================================================

#: headgears/horned_hat_quest.cs
msgid "[Historian] Valdric"
msgstr "[Историк] Валдрик"

#: headgears/horned_hat_quest.cs
msgid "Valdric"
msgstr "Валдрик"

#: headgears/horned_hat_quest.cs
msgid "{#666666}*runs a hand along a petrified stone formation*{/}"
msgstr "{#666666}*проводит рукой по окаменелому каменному образованию*{/}"

#: headgears/horned_hat_quest.cs
msgid "Do you see these spikes? They were not always stone. Long ago, this was a thriving market town, protected by a guardian who wore a distinctive horned hat."
msgstr "Видите эти шипы? Они не всегда были каменными. Давным-давно здесь процветал рыночный городок, который охранял страж в характерной рогатой шапке."

#: headgears/horned_hat_quest.cs
msgid "When the curse swept through Roxona, he stood against it... and was petrified along with everything else. Now these Moyas and Bavons infest his domain, their bodies carrying fragments of the cursed energy that turned him to stone."
msgstr "Когда проклятие обрушилось на Роксону, он выступил против него… и был окаменел вместе со всем остальным. Теперь его владения заполонили эти Мойа и Бавоны, чьи тела несут в себе осколки проклятой энергии, превратившей его в камень."

#: headgears/horned_hat_quest.cs
msgid "Have you gathered the materials I need?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/horned_hat_quest.cs
msgid "Yes, I have them"
msgstr "Да, у меня они есть"

#: headgears/horned_hat_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/horned_hat_quest.cs
msgid "{#666666}*carefully arranges the materials on a worn workbench*{/}"
msgstr "{#666666}*аккуратно раскладывает материалы на потертом верстаке*{/}"

#: headgears/horned_hat_quest.cs
msgid "Remarkable... these fragments still pulse with residual energy. And the feathers from those flying creatures carry traces of the storm that accompanied the curse."
msgstr "Удивительно... эти обломки до сих пор пульсируют остаточной энергией. А на перьях тех летающих существ сохранились следы бури, сопровождавшей проклятие."

#: headgears/horned_hat_quest.cs
msgid "Here, take this recreation of the Guardian's Horned Hat. Perhaps by wearing it, his memory will live on through you. May you never share his fate."
msgstr "Вот, возьми эту копию Рогатой шляпы Стража. Возможно, если ты наденешь её, память о нём будет жить в тебе. Пусть тебе никогда не придётся разделить его судьбу."

#: headgears/horned_hat_quest.cs
msgid "The Moyas gather near the petrified buildings to the west. The Bavons circle overhead, drawn to the cursed energy. Be careful - this place claims many who linger too long."
msgstr "Мойи собираются возле окаменелых зданий на западе. Над ними кружат бавоны, привлеченные проклятой энергией. Будьте осторожны — это место уносит жизни многих, кто задерживается здесь слишком долго."

#: headgears/horned_hat_quest.cs
msgid "Will you help me gather what I need to recreate the guardian's hat?"
msgstr "Не поможете ли вы мне собрать всё необходимое, чтобы воссоздать шляпу стража?"

#: headgears/horned_hat_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/horned_hat_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/horned_hat_quest.cs
msgid "Thank you. I need 80 Moya Fragments - the creatures seem to absorb the curse's energy into their very bodies. I also need 40 Bavon Feathers from the flying beasts that circle this cursed sky."
msgstr "Спасибо. Мне нужно 80 осколков Мойи — похоже, эти существа впитывают энергию проклятия в свои тела. Ещё мне нужно 40 перьев Бавона — их можно добыть у летающих чудовищ, кружащих в этом проклятом небе."

#: headgears/horned_hat_quest.cs
msgid "With these materials, I can craft a replica of the Guardian's Horned Hat. It won't break the curse, but... perhaps it will honor his sacrifice."
msgstr "Из этих материалов я смогу изготовить точную копию Рогатой шляпы Стража. Это не снимет проклятие, но… возможно, станет данью уважения его самопожертвованию."

#: headgears/horned_hat_quest.cs
msgid "{#666666}*returns to examining a petrified merchant stall*{/} The stones here have many secrets to tell. Return if you change your mind."
msgstr "{#666666}*возвращается к осмотру окаменелого торгового прилавка*{/} Эти камни могут раскрыть много тайн. Вернись, если передумаешь."

# ============================================================================
# Headgear: Huckleberry Hair Accessory (huckleberry_hair_accessory_quest.cs)
# ============================================================================

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "[Farmer's Daughter] Lina"
msgstr "[Дочь фермера] Лина"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Lina"
msgstr "Лина"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "{#666666}*brushes pollen from her hair*{/}"
msgstr "{#666666}*счищает пыльцу с волос*{/}"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Oh, hello there! You've caught me at the worst time of year. The pollen from these creatures is just everywhere during this season."
msgstr "О, привет! Ты застал меня в самое неудачное время года. В этот сезон пыльца от этих «существ» просто везде."

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "But you know what? My grandmother always said, 'If you can't beat them, make something beautiful from them.' I've been wanting to craft a hair accessory using parts from these little plant monsters."
msgstr "Но знаете что? Моя бабушка всегда говорила: «Если не можешь их победить, сделай из них что-нибудь красивое». Я давно хотела смастерить аксессуар для волос, используя детали этих маленьких растительных монстров."

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "The stems from the Pinos are flexible and hold their shape nicely, and the leaves from the Geppettos have this lovely purple hue that reminds me of wild huckleberries."
msgstr "Стебли сорта «Пинос» гибкие и хорошо держат форму, а листья сорта «Джеппетто» имеют такой прекрасный пурпурный оттенок, который напоминает мне дикую голубику."

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Have you gathered the materials I need?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "{#666666}*carefully weaves the materials together*{/}"
msgstr "{#666666}*тщательно соединяет материалы*{/}"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Perfect! The stems are just the right texture, and look how the leaves catch the light."
msgstr "Прекрасно! Стебли имеют идеальную текстуру, а посмотрите, как листья отражают свет."

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Here, take this as thanks for your help. I made two, so we can both remember this pollen season fondly!"
msgstr "Вот, возьми это в знак благодарности за твою помощь. Я сделал два, чтобы мы оба с теплотой вспоминали этот сезон пыльцы!"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "The white Pinos are all around the vineyards here, and the Geppettos tend to wander near the pollen clouds. Watch out though, they can be feisty when disturbed!"
msgstr "Здесь, на виноградниках, повсюду можно увидеть белых Пино, а Геппетто обычно бродят рядом с облаками пыльцы. Но будьте осторожны: если их потревожить, они могут проявить агрессию!"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Would you help me gather some materials?"
msgstr "Не могли бы вы помочь мне собрать кое-какие материалы?"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "Thank you so much! I need 50 Pino Stems from the white Pinos, and 25 Geppetto Leaves from the white Geppettos."
msgstr "Огромное спасибо! Мне нужно 50 стеблей «Пино» из набора «Белые Пино» и 25 листьев «Джеппетто» из набора «Белые Джеппетто»."

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "They're scattered all around the farm. The Pinos especially love hanging around the vineyard areas where the pollen is thickest."
msgstr "Они разбросаны по всей ферме. Пино особенно любят тусоваться в виноградниках, где пыльца наиболее густая."

#: headgears/huckleberry_hair_accessory_quest.cs
msgid "That's alright. The pollen will be here for a while yet if you change your mind."
msgstr "Ничего страшного. Пыльца ещё какое-то время будет здесь, если ты передумаешь."

# ============================================================================
# Headgear: Imperial Helm (imperial_helm_quest.cs)
# ============================================================================

#: headgears/imperial_helm_quest.cs
msgid "[Archeologist] Aldric"
msgstr "[Археолог] Олдрик"

#: headgears/imperial_helm_quest.cs
msgid "Aldric"
msgstr "Олдрик"

#: headgears/imperial_helm_quest.cs
msgid "{#666666}*carefully brushes dust from a weathered stone tablet*{/}"
msgstr "{#666666}*осторожно счищает пыль с выветренной каменной плиты*{/}"

#: headgears/imperial_helm_quest.cs
msgid "Ah, a visitor to these forgotten roads! I am Aldric, and I have dedicated my life to uncovering the secrets of the empire that once ruled these lands."
msgstr "Ах, путешественник, забредавший на эти забытые дороги! Меня зовут Олдрик, и я посвятил свою жизнь раскрытию тайн империи, которая когда-то правила этими землями."

#: headgears/imperial_helm_quest.cs
msgid "Among these ruins, I discovered fragments of an imperial helm - a relic from a long-fallen dynasty. With the right materials, I could restore it to its former glory. The stumpy trees here produce an ash wood with unique preservative properties, and the Tama creatures... their skin makes for excellent binding material."
msgstr "Среди этих руин я обнаружил обломки императорского шлема — реликвию давно павшей династии. Имея подходящие материалы, я мог бы вернуть ему былую славу. Местные корявые деревья дают ясеневую древесину с уникальными консервирующими свойствами, а кожа существ Тама… из неё получается превосходный материал для переплёта."

#: headgears/imperial_helm_quest.cs
msgid "Have you gathered the restoration materials?"
msgstr "Вы уже собрали материалы для реставрации?"

#: headgears/imperial_helm_quest.cs
msgid "Yes, I have everything"
msgstr "Да, у меня всё есть"

#: headgears/imperial_helm_quest.cs
msgid "Still searching"
msgstr "Все еще ищу"

#: headgears/imperial_helm_quest.cs
msgid "{#666666}*examines the materials with scholarly precision*{/}"
msgstr "{#666666}*изучает материалы с научной тщательностью*{/}"

#: headgears/imperial_helm_quest.cs
msgid "Magnificent! The ash wood's grain is perfect, and this Tama skin... exceptional quality. Watch closely..."
msgstr "Великолепно! Текстура ясеня просто идеальна, а эта кожа Tama… исключительного качества. Посмотрите внимательно…"

#: headgears/imperial_helm_quest.cs
msgid "{#666666}*works with practiced hands, binding and shaping*{/}"
msgstr "{#666666}*работает умелыми руками, скрепляя и придавая форму*{/}"

#: headgears/imperial_helm_quest.cs
msgid "Behold - the Imperial Helm, restored! Emperors once wore helms like this into battle, leading armies across these very roads. Now it is yours, a piece of history reborn. May it serve you as it served them."
msgstr "Взгляните — Императорский шлем, восстановленный! Когда-то императоры носили подобные шлемы в бою, возглавляя армии по этим самым дорогам. Теперь он принадлежит вам — это воскресший кусочек истории. Пусть он служит вам так же, как служил им."

#: headgears/imperial_helm_quest.cs
msgid "Should you desire another, I can always craft more. The empire's legacy deserves to live on."
msgstr "Если вам понадобится ещё один, я всегда могу изготовить ещё. Наследие империи заслуживает того, чтобы жить вечно."

#: headgears/imperial_helm_quest.cs
msgid "{#666666}*returns to examining ancient inscriptions*{/}"
msgstr "{#666666}*возвращается к изучению древних надписей*{/}"

#: headgears/imperial_helm_quest.cs
msgid "The stumpy trees grow throughout this region - their ash wood is distinctive. And the Tama creatures roam freely here as well. Take your time; history has waited centuries. It can wait a little longer."
msgstr "По всему этому региону растут приземистые деревья — их ясеневая древесина отличается особыми свойствами. Здесь также свободно бродят существа Тама. Не торопитесь; история ждала веками. Она может подождать ещё немного."

#: headgears/imperial_helm_quest.cs
msgid "Would you help me gather materials to restore an Imperial Helm?"
msgstr "Не могли бы вы помочь мне собрать материалы для реставрации имперского шлема?"

#: headgears/imperial_helm_quest.cs
msgid "I would be honored"
msgstr "Для меня это было бы большой честью"

#: headgears/imperial_helm_quest.cs
msgid "Perhaps another time"
msgstr "Может быть, в другой раз"

#: headgears/imperial_helm_quest.cs
msgid "Excellent! I require 80 pieces of Ash Wood from the stumpy trees and 60 Tama Skins. The wood's natural preservatives will protect the helm's structure, while the Tama skin provides the binding needed for the interior padding. Return when you have gathered them all."
msgstr "Отлично! Мне нужно 80 кусков древесины ясеня с корявых деревьев и 60 шкур тама. Естественные консерванты, содержащиеся в древесине, защитят конструкцию шлема, а шкура тама послужит связующим материалом для внутренней обивки. Вернись, когда соберёшь всё необходимое."

#: headgears/imperial_helm_quest.cs
msgid "{#666666}*nods understandingly*{/}"
msgstr "{#666666}*понимающе кивает*{/}"

#: headgears/imperial_helm_quest.cs
msgid "I understand. The ruins will still be here when you return. These stones have waited for ages - they shall wait a while longer."
msgstr "Понимаю. Руины будут здесь и тогда, когда ты вернёшься. Эти камни ждали веками — пусть подождут ещё немного."

# ============================================================================
# Headgear: Jack O Lantern Hair Ornament (jack_o_lantern_hair_ornament_quest.cs)
# ============================================================================

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "[Lumberjack] Garvyn"
msgstr "[Лесоруб] Гарвин"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Garvyn"
msgstr "Гарвин"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "{#666666}*The lumberjack sits on a stump, nervously carving a small pumpkin*{/}"
msgstr "{#666666}*Лесоруб сидит на пне и нервно вырезает маленькую тыкву*{/}"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Ah, a traveler! Don't mind the axe - I'm no threat. Haven't swung it at a tree in weeks. Not since... well, not since the ghosts came."
msgstr "А, путешественник! Не обращай внимания на топор — я не представляю никакой угрозы. Уже несколько недель я им по дереву не рубил. С тех пор как… ну, с тех пор как появились призраки."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "See, I used to carve pumpkins for the village children every harvest season. But now the village is empty, and these cursed Hallowventers float about with their bony fingers, mocking what we once had."
msgstr "Понимаете, раньше я каждый урожайный сезон вырезал тыквы для деревенских детей. Но теперь деревня опустела, а эти проклятые «Хэллоувентеры» парят в воздухе своими костлявыми пальцами, насмехаясь над тем, что у нас когда-то было."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "I've been thinking... if I had some of their hand bones, I could fashion something special. A little ornament to remember the old days - shaped like the pumpkins I used to carve."
msgstr "Я тут подумал... Если бы у меня были их кости кистей, я бы смог смастерить что-нибудь особенное. Небольшой сувенир на память о старых временах — в форме тех тыкв, которые я раньше вырезал."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Have you gathered the Hallowventer Hand Bones?"
msgstr "Вы уже собрали «Кости рук Хэллоувентера»?"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Yes, I have them"
msgstr "Да, у меня они есть"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Still hunting"
msgstr "Охота с засады"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "{#666666}*Garvyn's weathered hands work with surprising delicacy, shaping the bones*{/}"
msgstr "{#666666}*Потрепанные руки Гарвина работают с удивительной нежностью, придавая форму костям*{/}"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "There we are... a little Jack-O-Lantern, just like I used to make for the children. The bones give it an eerie glow - fitting for this haunted place."
msgstr "Вот и готово… маленькая тыква-фонарик, точно такая же, как я раньше делала для детей. Кости придают ей жутковатое сияние — как раз то, что нужно для этого места, где бродят призраки."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Take it, friend. Wear it proudly. And if you ever see any of those village folk... tell them old Garvyn still remembers the harvest days."
msgstr "Возьми это, друг. Носи с гордостью. И если когда-нибудь увидишь кого-нибудь из тех деревенских… скажи им, что старина Гарвин до сих пор помнит дни сбора урожая."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Those Hallowventers drift about the village and the surrounding area. They're not hard to find - just follow the cold spots in the air."
msgstr "Эти «Хэллоувентеры» бродят по деревне и окрестностям. Их несложно найти — достаточно следовать за местами, где воздух кажется холоднее."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Would you help an old woodsman reclaim a bit of the past?"
msgstr "Не могли бы вы помочь старику-лесорубу вернуть частичку прошлого?"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "I'll gather the bones"
msgstr "Я соберу кости"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "Bless you, traveler. Bring me 75 Hallowventer Hand Bones - you'll find plenty of those wretched spirits floating about the village. They won't give up their bones easily, mind you."
msgstr "Будь здоров, путешественник. Принеси мне 75 костей рук Хэллоувентера — в деревне полно этих проклятых духов, парящих в воздухе. Но имей в виду: они не так-то легко отдадут свои кости."

#: headgears/jack_o_lantern_hair_ornament_quest.cs
msgid "I understand. It's dangerous work, hunting ghosts. I'll be here if you change your mind - not like I have anywhere else to go."
msgstr "Понимаю. Охота на призраков — дело опасное. Если передумаешь, я буду здесь — мне всё равно больше некуда идти."

# ============================================================================
# Headgear: Jingle Bell Earmuffs (jingle_bell_earmuffs_quest.cs)
# ============================================================================

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "[Traveling Merchant] Mirena"
msgstr "[Странствующий торговец] Мирена"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Mirena"
msgstr "Мирена"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "{#666666}*shivers beside her small merchant cart, rubbing her hands together for warmth*{/}"
msgstr "{#666666}*дрожит рядом со своей маленькой торговой тележкой, потирая ладони, чтобы согреться*{/}"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Brr! The cold in this exile is far worse than I expected. I came here hoping to gather materials for my winter crafts, but I underestimated just how bitter this frozen wasteland would be."
msgstr "Брр! Холод в этом изгнании гораздо сильнее, чем я ожидала. Я приехала сюда в надежде собрать материалы для своих зимних поделок, но недооценила, насколько суровой окажется эта замерзшая пустошь."

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "I specialize in festive accessories, you see. There's a particular design I've been working on - earmuffs adorned with tiny bells that chime softly in the winter wind. But I need materials from the local creatures to finish them..."
msgstr "Видите ли, я специализируюсь на праздничных аксессуарах. Сейчас я работаю над одним конкретным дизайном — ушанками, украшенными крошечными колокольчиками, которые тихонько звенят на зимнем ветру. Но чтобы их закончить, мне нужны материалы от местных животных..."

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Have you gathered the materials I need?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "{#666666}*her eyes light up as she examines the materials*{/}"
msgstr "{#666666}*ее глаза загораются, когда она изучает материалы*{/}"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Perfect! The White Spion fur is wonderfully soft and insulating - just what you need to keep your ears warm in this bitter cold. And these Lapasape leaves have just the right flexibility to bind the jingle bells securely."
msgstr "Прекрасно! Мех «White Spion» удивительно мягкий и хорошо удерживает тепло — именно то, что нужно, чтобы согреть уши в такую лютую стужу. А эти листья Lapasape обладают идеальной гибкостью, чтобы надежно закрепить колокольчики."

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "{#666666}*works quickly with nimble fingers, humming a festive tune*{/}"
msgstr "{#666666}*работает быстро, ловко двигая пальцами и напевая праздничную мелодию*{/}"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "There we go! Listen to that gentle chime. These Jingle Bell Earmuffs will keep you warm and add a touch of winter magic to your adventures. May they bring you joy in even the coldest of places!"
msgstr "Вот и готово! Послушайте, как нежно звенят колокольчики. Эти ушанки с колокольчиками согреют вас и придадут вашим приключениям нотку зимней волшебности. Пусть они приносят вам радость даже в самых холодных местах!"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "If you'd like another pair, perhaps as a gift for a friend, I'd be happy to make more."
msgstr "Если вам нужна ещё одна пара, например, в подарок другу, я с удовольствием сделаю ещё."

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "The White Spions wander all across this frozen landscape - they're the large white spider-like creatures. Be careful, their icy touch can be quite dangerous. The Brown Lapasapes are smaller plant creatures that blend in with the dead foliage."
msgstr "По всей этой замерзшей местности бродят «Белые шпионы» — это крупные белые существа, похожие на пауков. Будьте осторожны: их ледяное прикосновение может оказаться весьма опасным. «Коричневые лапасапы» — это более мелкие растительные существа, которые маскируются среди увядшей листвы."

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Would you help me gather materials for a pair of Jingle Bell Earmuffs?"
msgstr "Не могли бы вы помочь мне собрать материалы для изготовления ушанок с колокольчиками?"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "Wonderful! I need 100 White Spion Fur for the cozy lining, and 75 Brown Lapasape Leaves to weave the frame that holds the bells. The Spions are everywhere in this exile, and the Lapasapes tend to gather near the vegetation. Stay warm out there!"
msgstr "Замечательно! Мне нужно 100 белых шкурок спионов для уютной подкладки и 75 коричневых листьев лапасапе, чтобы сплести каркас для колокольчиков. Спионы в этой изгнании встречаются повсюду, а лапасапы обычно собираются возле растительности. Согревайтесь там!"

#: headgears/jingle_bell_earmuffs_quest.cs
msgid "{#666666}*pulls her cloak tighter against the wind*{/} I understand. This cold isn't for everyone. If you change your mind, I'll be here... trying not to freeze."
msgstr "{#666666}*плотнее затягивает плащ, защищаясь от ветра*{/} Понимаю. Такой холод не всем по душе. Если передумаешь, я буду здесь… и постараюсь не замерзнуть."

# ============================================================================
# Headgear: Lotus Leaf (lotus_leaf_quest.cs)
# ============================================================================

#: headgears/lotus_leaf_quest.cs
msgid "[Plant Enthusiast] Miri"
msgstr "[Любительница растений] Мири"

#: headgears/lotus_leaf_quest.cs
msgid "Miri"
msgstr "Мири"

#: headgears/lotus_leaf_quest.cs
msgid "Ah, welcome! I don't get many visitors out here. *sniffs a nearby flower* But the plants keep me company."
msgstr "Ах, добро пожаловать! Ко мне сюда нечасто заглядывают гости. *вдыхает аромат цветка, растущего поблизости* Но растения составляют мне компанию."

#: headgears/lotus_leaf_quest.cs
msgid "I've been working on crafting a special headpiece made from lotus leaves, but I need some materials that are hard to find..."
msgstr "Я работаю над созданием особого головного убора из листьев лотоса, но мне нужны некоторые материалы, которые трудно найти..."

#: headgears/lotus_leaf_quest.cs
msgid "How is the material gathering going?"
msgstr "Как проходит сбор материалов?"

#: headgears/lotus_leaf_quest.cs
msgid "I have everything"
msgstr "У меня есть всё"

#: headgears/lotus_leaf_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/lotus_leaf_quest.cs
msgid "Perfect! These materials are exactly what I needed. Here's your Lotus Leaf headpiece - may it bring you closer to nature's beauty!"
msgstr "Прекрасно! Эти материалы — именно то, что мне нужно. Вот ваш головной убор «Лист лотоса» — пусть он приблизит вас к красоте природы!"

#: headgears/lotus_leaf_quest.cs
msgid "Umm sorry you seem to be missing a few items. I need 50 Leaf Bug Shells and 30 Hanaming Petals."
msgstr "Э-э-э, извини, похоже, у тебя не хватает нескольких предметов. Мне нужно 50 панцирей листовых жуков и 30 лепестков ханаминга."

#: headgears/lotus_leaf_quest.cs
msgid "Take your time. Nature's beauty can't be rushed."
msgstr "Не торопитесь. Красоту природы нельзя поспешно осмотреть."

#: headgears/lotus_leaf_quest.cs
msgid "Would you help me gather materials for a special Lotus Leaf headpiece?"
msgstr "Не могли бы вы помочь мне собрать материалы для создания оригинального головного убора «Лист лотоса»?"

#: headgears/lotus_leaf_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/lotus_leaf_quest.cs
msgid "Thank you! The shells will give structure to the headpiece while the petals will add a wonderful fragrance. Please bring them when you can."
msgstr "Спасибо! Ракушки придадут головной повязке форму, а лепестки — чудесный аромат. Принесите их, когда сможете."

#: headgears/lotus_leaf_quest.cs
msgid "Perhaps another time then. The flowers will still be here when you return."
msgstr "Ну, может быть, в другой раз. Цветы всё ещё будут здесь, когда ты вернёшься."

# ============================================================================
# Headgear: Outdoors Hat (outdoors_hat_quest.cs)
# ============================================================================

#: headgears/outdoors_hat_quest.cs
msgid "[Tailor] Pascal"
msgstr "[Портной] Паскаль"

#: headgears/outdoors_hat_quest.cs
msgid "Pascal"
msgstr "Паскаль"

#: headgears/outdoors_hat_quest.cs
msgid "This place used to be so beautiful, the architecture, the constructions!"
msgstr "Раньше это место было таким красивым — архитектура, здания!"

#: headgears/outdoors_hat_quest.cs
msgid "*adjusts measuring tape* Welcome, welcome! I'm crafting the perfect tool for outdoor adventurers. Something light yet durable, stylish yet practical!"
msgstr "*поправляет рулетку* Добро пожаловать, добро пожаловать! Я создаю идеальный инструмент для любителей приключений на природе. Что-то лёгкое, но прочное, стильное, но практичное!"

#: headgears/outdoors_hat_quest.cs
msgid "The local timber is perfect for the frame, and those nasty Cyst needles make excellent pins for stitching. Care to help me gather the materials?"
msgstr "Местная древесина идеально подходит для каркаса, а эти противные иголки Cyst — отличные булавки для вышивания. Не поможешь мне собрать материалы?"

#: headgears/outdoors_hat_quest.cs
msgid "Found everything we need for our fashionable creation?"
msgstr "Нашли всё, что нужно для нашего модного творения?"

#: headgears/outdoors_hat_quest.cs
msgid "Here are the materials"
msgstr "Вот материалы"

#: headgears/outdoors_hat_quest.cs
msgid "*skillfully crafts the hat* Marvelous! The frame is light but strong, and those needles work perfectly for the detailed stitching. Here you are - perfect for any outdoor adventure!"
msgstr "*искусно мастерит шляпу* Прекрасно! Каркас легкий, но прочный, а эти иглы идеально подходят для тонкой вышивки. Вот, пожалуйста — идеальный вариант для любого приключения на природе!"

#: headgears/outdoors_hat_quest.cs
msgid "*starts sketching new designs* You know, I have more ideas for outdoor wear. Interested in another hat?"
msgstr "*начинает рисовать новые эскизы* Знаешь, у меня есть ещё идеи по поводу одежды для активного отдыха. Хочешь ещё одну кепку?"

#: headgears/outdoors_hat_quest.cs
msgid "*measures some fabric* Take your time! Quality materials make quality hats, after all."
msgstr "*меряет кусок ткани* Не торопитесь! Ведь из качественных материалов получаются качественные шляпы."

#: headgears/outdoors_hat_quest.cs
msgid "Shall we create a practical yet stylish outdoor hat?"
msgstr "Давайте создадим практичную и в то же время стильную шляпу для прогулок на свежем воздухе?"

#: headgears/outdoors_hat_quest.cs
msgid "Let's do it"
msgstr "Давайте сделаем это"

#: headgears/outdoors_hat_quest.cs
msgid "Another time"
msgstr "В другой раз"

#: headgears/outdoors_hat_quest.cs
msgid "*excitedly pulls out sketches* Excellent! Bring me 40 pieces of Short Timber for the frame and 25 Cyst Needles for stitching. Together we'll create the perfect outdoor hat!"
msgstr "*взволнованно достаёт эскизы* Прекрасно! Принесите мне 40 кусочков короткой древесины для каркаса и 25 игл из цист для сшивания. Вместе мы создадим идеальную шляпу для прогулок на природе!"

#: headgears/outdoors_hat_quest.cs
msgid "*returns to sketching* Fashion waits for no one, but I'll be here when you're ready!"
msgstr "*возвращается к рисованию* Мода никого не ждёт, но я буду здесь, когда ты будешь готов!"

# ============================================================================
# Headgear: Owl Hat (owl_hat_quest.cs)
# ============================================================================

#: headgears/owl_hat_quest.cs
msgid "[Wooden Owl] Nocturnus"
msgstr "[Деревянная сова] Nocturnus"

#: headgears/owl_hat_quest.cs
msgid "Nocturnus"
msgstr "Nocturnus"

#: headgears/owl_hat_quest.cs
msgid "*a voice whispers from the carved wooden owl, though it remains perfectly still* The shadows speak to me... through ancient wood grain... {pcname}..."
msgstr "*из резной деревянной совы доносится шепот, хотя она при этом совершенно неподвижна* Тени говорят со мной… сквозь древние прожилки дерева… {pcname}…"

#: headgears/owl_hat_quest.cs
msgid "*the voice seems to emanate from everywhere and nowhere* For centuries I have watched... observed... From this wooden form, I see what others cannot..."
msgstr "*Голос, кажется, доносится отовсюду и ниоткуда* На протяжении веков я наблюдал… следил… Из этого деревянного тела я вижу то, чего другие не могут увидеть…"

#: headgears/owl_hat_quest.cs
msgid "*the whispers echo from the unmoving wooden beak* Have you brought... what the night has yielded?"
msgstr "*из неподвижного деревянного клюва доносится шепот* Ты принёс… то, что принесла ночь?"

#: headgears/owl_hat_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/owl_hat_quest.cs
msgid "Still searching"
msgstr "Все еще ищу"

#: headgears/owl_hat_quest.cs
msgid "*the wooden owl's eyes seem to absorb the darkness around it* Yesss... The stems hold moonlight... the straw carries twilight... the skin contains shadow itself..."
msgstr "*Глаза деревянной совы словно впитывают окружающую тьму* Дааа... Стебли хранят лунный свет... солома несет сумерки... а сама кора — саму тень..."

#: headgears/owl_hat_quest.cs
msgid "*whispers grow fainter* Take this gift... forged from night's essence... I will wait here... as I always have... as I always will..."
msgstr "*шепот стихает* Прими этот дар… выкованный из сущности ночи… Я буду ждать здесь… как всегда ждал… как всегда буду ждать…"

#: headgears/owl_hat_quest.cs
msgid "*the whispers fade to barely audible* Time means nothing to one who cannot move... I will wait..."
msgstr "*шепот стихает до едва слышимого* Время ничего не значит для того, кто не может двигаться... Я буду ждать..."

#: headgears/owl_hat_quest.cs
msgid "*whispers drift from the wooden owl statue* Will you gather... what the darkness holds?"
msgstr "*из деревянной статуи совы доносится шепот* Соберешь ли ты… то, что таит в себе тьма?"

#: headgears/owl_hat_quest.cs
msgid "I will help"
msgstr "Я помогу"

#: headgears/owl_hat_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/owl_hat_quest.cs
msgid "*the voice grows stronger* Find the blue Ridimed where moonlight touches water... the red Puragi where shadows pool... the purple Kepa where darkness dwells... My wooden eyes see where they hide..."
msgstr "*голос становится громче* Найди синий Ридимед там, где лунный свет касается воды… красный Пураги там, где сгущаются тени… фиолетовый Кепа там, где обитает тьма… Мои деревянные глаза видят, где они прячутся…"

#: headgears/owl_hat_quest.cs
msgid "*the whispers grow distant* I will remain... as I have for centuries... watching... waiting... in this wooden form..."
msgstr "*шепот стихает* Я останусь… как и на протяжении веков… наблюдая… ожидая… в этом деревянном обличье…"

# ============================================================================
# Headgear: Pancake (pancake_quest.cs)
# ============================================================================

#: headgears/pancake_quest.cs
msgid "[Cook] Morella"
msgstr "[Кук] Морелла"

#: headgears/pancake_quest.cs
msgid "Morella"
msgstr "Морелла"

#: headgears/pancake_quest.cs
msgid "{#666666}*wipes flour from her apron while eyeing the buzzing bees nearby*{/}"
msgstr "{#666666}*вытирает муку с фартука, наблюдая за жужжащими пчелами поблизости*{/}"

#: headgears/pancake_quest.cs
msgid "Ah, a fellow traveler! You've caught me at quite the predicament. I came to this farm seeking the legendary honey of the Honeybeans, but these creatures are far more... aggressive than I anticipated."
msgstr "Ах, попутчик! Ты застал меня в довольно затруднительном положении. Я пришёл на эту ферму в поисках легендарного мёда «Ханибинс», но эти существа оказались гораздо более… агрессивными, чем я ожидал."

#: headgears/pancake_quest.cs
msgid "You see, I'm a traveling cook, and I've been experimenting with a most peculiar recipe - a hat that looks exactly like a golden, fluffy pancake! But to capture that perfect honey glaze, I need materials from these bees."
msgstr "Дело в том, что я — путешествующий повар, и я экспериментирую с самым необычным рецептом — шляпой, которая выглядит точно так же, как золотистый, пышный блин! Но чтобы добиться идеальной медовой глазури, мне нужны ингредиенты от этих пчел."

#: headgears/pancake_quest.cs
msgid "Have you gathered the materials for the Pancake hat?"
msgstr "Вы уже собрали материалы для шапки «Панкейк»?"

#: headgears/pancake_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/pancake_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/pancake_quest.cs
msgid "{#666666}*excitedly takes the materials and begins crafting*{/}"
msgstr "{#666666}*воодушевленно берет материалы и приступает к работе*{/}"

#: headgears/pancake_quest.cs
msgid "Magnificent! The stingers will give it that authentic honey sheen, and the fur will make it wonderfully soft - just like a real pancake fresh off the griddle! Here, take this. May it bring sweetness to your adventures!"
msgstr "Великолепно! Жала придадут ему настоящий медовый блеск, а мех сделает его чудесно мягким — прямо как настоящий блинчик, только что снятый со сковороды! Вот, возьми это. Пусть это принесет сладость в твои приключения!"

#: headgears/pancake_quest.cs
msgid "The bees around here can be quite temperamental. The Honeybeans flutter about everywhere, and the Rabbees hop around the southern areas. Be careful of those stingers!"
msgstr "Местные пчелы бывают довольно своенравными. «Ханибинс» порхают повсюду, а «Рабби» снуют по южным районам. Берегитесь их жал!"

#: headgears/pancake_quest.cs
msgid "Would you help me gather materials for my Pancake creation?"
msgstr "Не могли бы вы помочь мне собрать материалы для моего творения из блинов?"

#: headgears/pancake_quest.cs
msgid "Wonderful! I'll need 100 Honeybean Stingers - they contain a special essence that gives the hat its golden glow. And bring me 75 pieces of Rabbee Fur for the soft, fluffy texture. Together, we'll create the most delicious-looking headwear in all the kingdom!"
msgstr "Замечательно! Мне понадобится 100 «Медовых жало» — в них содержится особая эссенция, придающая шляпе золотистый блеск. И принесите мне 75 кусочков кроличьего меха, чтобы придать ей мягкую и пушистую текстуру. Вместе мы создадим самый аппетитно выглядящий головной убор во всём королевстве!"

#: headgears/pancake_quest.cs
msgid "I understand. The bees can be quite intimidating. Perhaps another adventurer will help me realize my culinary vision. I'll be here, dreaming of pancakes..."
msgstr "Понимаю. Пчелы могут выглядеть довольно устрашающе. Возможно, какой-нибудь другой искатель приключений поможет мне воплотить мою кулинарную мечту. А я буду здесь, мечтая о блинчиках..."

# ============================================================================
# Headgear: Party Cone (party_cone_quest.cs)
# ============================================================================

#: headgears/party_cone_quest.cs
msgid "[Party Enthusiast] Fiesta"
msgstr "[Любитель вечеринок] Фиеста"

#: headgears/party_cone_quest.cs
msgid "Fiesta"
msgstr "Фиеста"

#: headgears/party_cone_quest.cs
msgid "*dancing while crafting* Life is a party, and everyone needs the perfect hat! *twirls* These forest creatures have the most wonderful materials for making celebration cones!"
msgstr "*танцую, пока творю* Жизнь — это праздник, и каждому нужна идеальная шляпа! *кружится* У этих лесных обитателей есть самые замечательные материалы для изготовления праздничных конусов!"

#: headgears/party_cone_quest.cs
msgid "*stops dancing briefly* Oh! Would you like to help make some party cones? The Ponpon branches make the perfect cone shape, and Loktanun feathers add such festive flair!"
msgstr "*на мгновение перестает танцевать* Ой! Не хочешь помочь сделать праздничные конусы? Ветки понпона идеально подходят для конусообразной формы, а перья Локтануна придают им такой праздничный шарм!"

#: headgears/party_cone_quest.cs
msgid "*bouncing excitedly* Did you bring the party materials?"
msgstr "*взволнованно подпрыгивая* Ты принес всё необходимое для вечеринки?"

#: headgears/party_cone_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/party_cone_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/party_cone_quest.cs
msgid "*dances with joy* Wonderful! *crafts while humming* A twist here, a feather there... Ta-da! Your very own Party Cone! Now you're ready to celebrate anything and everything!"
msgstr "*танцует от радости* Замечательно! *мастерит, напевая* Сюда небольшой изгиб, туда перо... Та-да! Твой собственный праздничный конус! Теперь ты готов отмечать всё и вся!"

#: headgears/party_cone_quest.cs
msgid "*starts dancing again* You know what's better than one party hat? TWO party hats! Want to make another one? *spins gleefully*"
msgstr "*снова начинает танцевать* Знаешь, что лучше, чем одна праздничная шапочка? ДВЕ праздничные шапочки! Хочешь сделать ещё одну? *радостно кружится*"

#: headgears/party_cone_quest.cs
msgid "*continues dancing* Keep looking! The most festive materials are worth the hunt!"
msgstr "*продолжает танцевать* Не сдавайтесь! Самые праздничные материалы стоят того, чтобы их поискать!"

#: headgears/party_cone_quest.cs
msgid "Want to join the party-making fun?"
msgstr "Хотите присоединиться к веселью и устроить вечеринку?"

#: headgears/party_cone_quest.cs
msgid "Let's make a party hat!"
msgstr "Давайте сделаем праздничную шапочку!"

#: headgears/party_cone_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/party_cone_quest.cs
msgid "*jumps with excitement* Yay! Bring me 5 Ponpon Branches for the base - they're naturally cone-shaped! And 45 Loktanun Feathers for decoration. They're so colorful, they'll make the perfect party hat!"
msgstr "*прыгает от радости* Ура! Принесите мне 5 веточек «Понпон» для основы — они по форме напоминают конусы! И 45 перьев «Локтанун» для украшения. Они такие красочные, что из них получится отличная праздничная шапочка!"

#: headgears/party_cone_quest.cs
msgid "*spins around* That's okay! The party never ends here - come back when you're ready to join the fun!"
msgstr "*кружится на месте* Ничего страшного! Здесь веселье никогда не заканчивается — приходи, когда будешь готов присоединиться к нам!"

# ============================================================================
# Headgear: Peacock Feather (peacock_feather_quest.cs)
# ============================================================================

#: headgears/peacock_feather_quest.cs
msgid "[Noblewoman] Isabella"
msgstr "[Аристократка] Изабелла"

#: headgears/peacock_feather_quest.cs
msgid "Isabella"
msgstr "Изабелла"

#: headgears/peacock_feather_quest.cs
msgid "*delicately fans herself* The local Cockatries have such magnificent plumage... Almost as grand as the peacocks in my family's estate."
msgstr "*нежно обмахивается веером* У местных какаду такое великолепное оперение… Почти такое же величественное, как у павлинов в поместье моей семьи."

#: headgears/peacock_feather_quest.cs
msgid "*eyes sparkling with inspiration* With the right combination of their feathers, one could create something truly... magnificent. Would you be interested in helping me create such an elegant piece?"
msgstr "*глаза, сверкающие от вдохновения* Правильно скомбинировав их перья, можно создать нечто поистине… великолепное. Не хотели бы вы помочь мне создать такое изящное изделие?"

#: headgears/peacock_feather_quest.cs
msgid "Have you acquired the feathers I requested?"
msgstr "Вы уже приобрели перья, о которых я просил?"

#: headgears/peacock_feather_quest.cs
msgid "Yes, my lady"
msgstr "Да, миледи"

#: headgears/peacock_feather_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/peacock_feather_quest.cs
msgid "*arranges the feathers with practiced grace* Simply divine! The crests provide that perfect crown-like shape, while the feathers add such elegant flourish. It's absolutely perfect for any formal occasion."
msgstr "*с опытной грацией поправляет перья* Просто божественно! Гребни придают ему идеальную форму, напоминающую корону, а перья добавляют такой элегантный штрих. Это идеальный вариант для любого торжественного мероприятия."

#: headgears/peacock_feather_quest.cs
msgid "*adjusts her posture* One can never have too many elegant accessories. Should you wish to create another, I would be delighted to guide you."
msgstr "*выпрямляется* Элегантных аксессуаров много не бывает. Если вы захотите создать ещё один, я с удовольствием помогу вам."

#: headgears/peacock_feather_quest.cs
msgid "*gracefully nods* Take all the time you need. True beauty, after all, cannot be rushed."
msgstr "*изящно кивает* Не торопитесь, сколько нужно. Ведь настоящую красоту нельзя торопить."

#: headgears/peacock_feather_quest.cs
msgid "Shall we create a magnificent Peacock Feather ornament?"
msgstr "Давайте создадим великолепное украшение из павлиньего пера?"

#: headgears/peacock_feather_quest.cs
msgid "I would be honored"
msgstr "Для меня это было бы большой честью"

#: headgears/peacock_feather_quest.cs
msgid "Another time"
msgstr "В другой раз"

#: headgears/peacock_feather_quest.cs
msgid "*claps delicately* Splendid! We'll need both the crests and feathers of the Cockatries - only the finest specimens will do. The combination will create something truly worthy of nobility."
msgstr "*нежно хлопает в ладоши* Великолепно! Нам понадобятся как гребни, так и перья кокатри — подойдут только самые лучшие экземпляры. Это сочетание позволит создать нечто, поистине достойное знати."

#: headgears/peacock_feather_quest.cs
msgid "*returns to her fan* Very well, we shall meet again!"
msgstr "*возвращается к своему поклоннику* Хорошо, мы ещё встретимся!"

# ============================================================================
# Headgear: Picnic Hat (picnic_hat_quest.cs)
# ============================================================================

#: headgears/picnic_hat_quest.cs
msgid "[Little Girl] Mila"
msgstr "[Маленькая девочка] Мила"

#: headgears/picnic_hat_quest.cs
msgid "Mila"
msgstr "Мила"

#: headgears/picnic_hat_quest.cs
msgid "{#666666}*A young girl sits on a blanket, looking up at the sky*{/}"
msgstr "{#666666}*Девочка сидит на одеяле и смотрит в небо*{/}"

#: headgears/picnic_hat_quest.cs
msgid "Oh! Hello there, mister! I'm waiting for my mommy. She said we could have a picnic today when the flowers are blooming!"
msgstr "Ой! Здравствуйте, господин! Я жду свою маму. Она сказала, что сегодня, когда цветут цветы, мы сможем устроить пикник!"

#: headgears/picnic_hat_quest.cs
msgid "But I lost my favorite hat somewhere in the woods... Mommy made it for me. It was so pretty with little flowers on it!"
msgstr "Но я где-то в лесу потеряла свою любимую шапочку... Мама сама её для меня связала. Она была такая красивая, с маленькими цветочками!"

#: headgears/picnic_hat_quest.cs
msgid "Maybe if I had enough pretty things, I could make a new one? The Siaulavs around here have such colorful masks, and there are Dilgele flowers growing everywhere!"
msgstr "Может, если бы у меня было достаточно красивых вещей, я смогла бы сделать новую? У местных жителей из племени шаулявов такие красочные маски, да и цветы дилгеле растут повсюду!"

#: headgears/picnic_hat_quest.cs
msgid "Did you find the things I need for my new picnic hat?"
msgstr "Ты нашёл всё, что мне нужно для моей новой шляпы для пикника?"

#: headgears/picnic_hat_quest.cs
msgid "Yes, here they are!"
msgstr "Да, вот они!"

#: headgears/picnic_hat_quest.cs
msgid "Still looking"
msgstr "Все еще ищу"

#: headgears/picnic_hat_quest.cs
msgid "{#666666}*Mila's eyes light up with joy*{/}"
msgstr "{#666666}*Глаза Милы загораются от радости*{/}"

#: headgears/picnic_hat_quest.cs
msgid "Wow! These are so pretty! Look at all the colors!"
msgstr "Ого! Какие они красивые! Посмотрите, сколько разных цветов!"

#: headgears/picnic_hat_quest.cs
msgid "{#666666}*She carefully arranges the materials into a charming hat*{/}"
msgstr "{#666666}*Она аккуратно складывает материалы, формируя из них очаровательную шляпку*{/}"

#: headgears/picnic_hat_quest.cs
msgid "Here, you should have this one! I can always make another. Thank you so much, mister! Now my picnic with mommy will be perfect!"
msgstr "Вот, возьмите это! Я всегда могу сделать ещё одно. Огромное спасибо, господин! Теперь мой пикник с мамой будет просто идеальным!"

#: headgears/picnic_hat_quest.cs
msgid "That's okay! The Siaulavs like to play near the big trees over there. And the Dilgele flowers grow all over these woods. Good luck!"
msgstr "Ничего страшного! Шяулявам нравится играть возле тех больших деревьев. А цветы дилгеле растут по всему этому лесу. Удачи!"

#: headgears/picnic_hat_quest.cs
msgid "Will you help me find pretty things for my new picnic hat?"
msgstr "Не поможешь ли ты мне подобрать что-нибудь красивое к моей новой шляпке для пикника?"

#: headgears/picnic_hat_quest.cs
msgid "Of course!"
msgstr "Конечно!"

#: headgears/picnic_hat_quest.cs
msgid "Not right now"
msgstr "Не сейчас"

#: headgears/picnic_hat_quest.cs
msgid "Really?! Thank you so much! I need 50 of those colorful Siaulamb Masks from the Siaulavs, and 30 Dilgele flowers! Then I can make the prettiest hat ever!"
msgstr "Правда?! Огромное спасибо! Мне нужно 50 таких красочных масок «Шяуламб» от шяулавцев и 30 цветов «Дилгеле»! Тогда я смогу сделать самую красивую шляпу на свете!"

#: headgears/picnic_hat_quest.cs
msgid "Oh... okay. Maybe someone else will help. I really want my picnic hat..."
msgstr "О... ладно. Может, кто-нибудь другой мне поможет. Мне очень хочется мою шляпу для пикника..."

# ============================================================================
# Headgear: Pineapple Hat (pineapple_hat_quest.cs)
# ============================================================================

#: headgears/pineapple_hat_quest.cs
msgid "[Eccentric Designer] Pierre"
msgstr "[Эксцентричный дизайнер] Пьер"

#: headgears/pineapple_hat_quest.cs
msgid "Pierre"
msgstr "Пьер"

#: headgears/pineapple_hat_quest.cs
msgid "*sketching frantically* FA-BU-LOUS! *looks up suddenly* Oh! You there! Have you see how absolutely stunning these cockatrices are~~!? Ohh~ The colors, the texture~! Mmm~! Simply D-E-L-I-C-I-O-U-S."
msgstr "*судорожно рисует* Ф-А-Н-Т-А-С-Т-И-Ч-Е-С-К-О! *внезапно поднимает глаза* Ой! Эй, ты там! Ты видел, какие потрясающие эти кокатрицы~~!? Ооо~ Цвета, текстура~! Ммм~! Просто В-О-С-Х-И-Т-И-Т-Е-Л-Н-О."

#: headgears/pineapple_hat_quest.cs
msgid "*licking lips* Yes! I'm working on something revolutionary - a hat shaped like a pineapple! It will be my ultimate creation~! But I need special materials... Aaah the pain... The texture must be just right, you see? Say, will you help make fashion history?"
msgstr "*облизывая губы* Да! Я работаю над чем-то революционным — шляпой в форме ананаса! Это будет мое лучшее творение~! Но мне нужны особые материалы... Ааа, как же это сложно... Понимаешь, текстура должна быть просто идеальной? Скажи, не поможешь ли ты мне войти в историю моды?"

#: headgears/pineapple_hat_quest.cs
msgid "*bouncing with anticipation* Do you have the materials for my masterpiece?"
msgstr "*подпрыгиваю от нетерпения* У тебя есть материалы для моего шедевра?"

#: headgears/pineapple_hat_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/pineapple_hat_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/pineapple_hat_quest.cs
msgid "*works with manic energy* YES! The feathers create the perfect spiky texture! And the bones... *crafts furiously* ...give it the proper structure! BEHOLD, FASHION INNOVATION!"
msgstr "*работает с маниакальной энергией* ДА! Перья создают идеальную колючую текстуру! А кости... *увлечённо мастерит* ...придают ей нужную форму! ВЗГЛЯНИТЕ, ЭТО ИННОВАЦИЯ В МОДЕ!"

#: headgears/pineapple_hat_quest.cs
msgid "*adjusts glasses rapidly* You know... I have MORE ideas! So many ideas! Would you help me create another masterpiece? Each one is unique - a testament to the artistic spirit!"
msgstr "*быстро поправляет очки* Знаешь... У меня ещё БОЛЬШЕ идей! Столько идей! Не поможешь мне создать ещё один шедевр? Каждый из них уникален — это свидетельство художественного духа!"

#: headgears/pineapple_hat_quest.cs
msgid "*returns to sketching* Take your time~!, take your t-i-m-e! But not too much time - fashion waits for no one! *giggles manically*"
msgstr "*возвращается к рисованию* Не торопись~!, не то-ро-пись! Но и не слишком долго — мода никого не ждёт! *маниакально хихикает*"

#: headgears/pineapple_hat_quest.cs
msgid "Shall we create a magnificent piece of wearable art~?"
msgstr "Давайте создадим великолепное произведение искусства, которое можно носить~?"

#: headgears/pineapple_hat_quest.cs
msgid "Yes, let's make fashion history!"
msgstr "Да, давайте войдём в историю моды!"

#: headgears/pineapple_hat_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/pineapple_hat_quest.cs
msgid "*jumps excitedly* MAGNIFICENT! The feathers from those Cockatrices - perfect for the spiky texture! And the Hogma warrior bones - they'll give it just the right structure! Now go, GO! Art awaits!"
msgstr "*взволнованно подпрыгивает* ВЕЛИКОЛЕПНО! Перья этих кокатриц — идеально подходят для создания колючей текстуры! А кости воина Хогмы — они придадут изделию именно ту структуру, которая нужна! А теперь беги, БЕГИ! Творчество ждёт!"

#: headgears/pineapple_hat_quest.cs
msgid "*sighs dramatically* Alas, another visionary masterpiece must wait... But fashion never sleeps! Neither do I! *returns to furious sketching*"
msgstr "*драматически вздыхает* Увы, очередному гениальному шедевру придётся подождать... Но мода никогда не спит! И я тоже! *возвращается к неистовому рисованию*"

# ============================================================================
# Headgear: Polka Dot Ribbon (polka_dot_ribbon_quest.cs)
# ============================================================================

#: headgears/polka_dot_ribbon_quest.cs
msgid "[Enchantress] Dotty"
msgstr "[Чародейка] Доти"

#: headgears/polka_dot_ribbon_quest.cs
msgid "Dotty"
msgstr "Дотти"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*twirls excitedly* Oh! Oh! You simply must help me! I'm creating the most wonderful enchanted ribbons with the most delightful polka dots that sparkle and shimmer!"
msgstr "*восторженно кружится* Ой! Ой! Ты просто обязан мне помочь! Я создаю самые чудесные волшебные ленты с самыми восхитительными горошками, которые сверкают и переливаются!"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*bounces in place* The magic from the mages here is perfect for it - their cotton has such lovely residual energy, and their staffs can be ground down for the most spectacular magical dust!"
msgstr "*подпрыгивает на месте* Магия местных магов идеально подходит для этого — их хлопок обладает такой чудесной остаточной энергией, а их посохи можно измельчить, чтобы получить самую потрясающую магическую пыль!"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*spins around* Did you bring the magical materials?"
msgstr "*кружится на месте* Ты принес волшебные материалы?"

#: headgears/polka_dot_ribbon_quest.cs
msgid "Here they are"
msgstr "Вот они"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*dances while crafting* Yes, yes, YES! Watch the magic swirl... see the dots appear... *giggles* Here you are! Isn't it just the most delightful thing you've ever seen?"
msgstr "*танцует, занимаясь рукоделием* Да, да, ДА! Смотрите, как кружится волшебство… как появляются точки… *хихикает* Вот, держите! Разве это не самая восхитительная вещь, которую вы когда-либо видели?"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*claps hands* Oh, we simply must make another! The dots are never quite the same twice - that's what makes them so magical!"
msgstr "*хлопает в ладоши* Ой, мы просто обязаны сделать ещё один! Точки никогда не бывают одинаковыми — вот что делает их такими волшебными!"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*hums while spinning in place* Take your time! The magic must be just right... just right!"
msgstr "*напевает, кружась на месте* Не торопись! Магия должна получиться именно такой… именно такой!"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*bounces eagerly* Shall we create a magical polka dot ribbon?"
msgstr "*нетерпеливо подпрыгивает* Давайте создадим волшебную ленту в горошек?"

#: headgears/polka_dot_ribbon_quest.cs
msgid "Let's make magic!"
msgstr "Давайте творить чудеса!"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*squeals with delight* Wonderful! Bring me 10 bits of Shaman Doll Cotton and 3 Tala Mage Staffs. Oh, this will be so much fun!"
msgstr "*визжит от восторга* Замечательно! Принесите мне 10 кусочков хлопка «Кукла шамана» и 3 посоха «Тала». Ой, это будет так весело!"

#: headgears/polka_dot_ribbon_quest.cs
msgid "*pouts briefly before twirling* Well, the dots will be here waiting when you're ready for their sparkly magic!"
msgstr "*на мгновение надувает губы, а потом кружится* Ну что ж, эти кружочки будут здесь ждать, пока ты не будешь готова к их сверкающей магии!"

# ============================================================================
# Headgear: Pudding Hat (pudding_hat_quest.cs)
# ============================================================================

#: headgears/pudding_hat_quest.cs
msgid "[Chef] Purin"
msgstr "[Шеф-повар] Пурин"

#: headgears/pudding_hat_quest.cs
msgid "Cauldron"
msgstr "Котел"

#: headgears/pudding_hat_quest.cs
msgid "Purin"
msgstr "Пурин"

#: headgears/pudding_hat_quest.cs
msgid "*stirring a large pot* Ah, this place is just perfect... *sniffs the air excitedly* The mushrooms and flowers around here have such... interesting aromas."
msgstr "*помешивая содержимое большой кастрюли* Ах, это место просто идеально... *восторженно вдыхает аромат* Грибы и цветы здесь имеют такие... интересные ароматы."

#: headgears/pudding_hat_quest.cs
msgid "I'm working on a special hat design inspired by my favorite dessert - pudding! Would you help me gather some ingredients? I promise the end result will be worth it!"
msgstr "Я работаю над дизайном необычной шляпы, вдохновленной моим любимым десертом — пудингом! Не поможете ли вы мне собрать ингредиенты? Обещаю, что конечный результат того стоит!"

#: headgears/pudding_hat_quest.cs
msgid "Have you gathered the ingredients for my special creation?"
msgstr "Ты уже собрал ингредиенты для моего особенного блюда?"

#: headgears/pudding_hat_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/pudding_hat_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/pudding_hat_quest.cs
msgid "*claps excitedly* Perfect! The mushrooms give it that bouncy texture, and the flower stems add just the right aroma! Here's your Pudding Hat - doesn't it look delicious enough to eat?"
msgstr "*восторженно хлопает в ладоши* Просто идеально! Грибы придают ему такую упругую текстуру, а стебли цветов — именно тот аромат, который нужен! Вот твоя «Пудинговая шляпа» — разве она не выглядит так аппетитно, что её хочется съесть?"

#: headgears/pudding_hat_quest.cs
msgid "*stirs pot thoughtfully* You know... I'm always experimenting with new recipes. Come back if you'd like another one!"
msgstr "*задумчиво помешивает содержимое кастрюли* Знаешь... Я всегда пробую новые рецепты. Заходи еще, если захочешь попробовать что-нибудь новенькое!"

#: headgears/pudding_hat_quest.cs
msgid "*tastes the mixture* Hmm, not quite right yet. Keep gathering those ingredients!"
msgstr "*пробует смесь* Хм, пока не совсем то, что надо. Продолжай собирать ингредиенты!"

#: headgears/pudding_hat_quest.cs
msgid "Would you like to help me create a Pudding Hat?"
msgstr "Не хотели бы вы помочь мне сделать шляпу в виде пудинга?"

#: headgears/pudding_hat_quest.cs
msgid "I'll help gather ingredients"
msgstr "Я помогу собрать ингредиенты"

#: headgears/pudding_hat_quest.cs
msgid "Wonderful! Bring me 100 Red Truffle Mushrooms for the base and 50 Pungent Stems for that special aroma. Together we'll make something sweetly spectacular!"
msgstr "Замечательно! Принесите мне 100 красных трюфельных грибов для основы и 50 ароматных стеблей, чтобы придать блюду особый аромат. Вместе мы приготовим что-нибудь по-настоящему восхитительное!"

#: headgears/pudding_hat_quest.cs
msgid "*returns to stirring* That's okay! The pot's always simmering if you change your mind~"
msgstr "*продолжает помешивать* Ничего страшного! Кастрюля всегда стоит на огне, если ты передумаешь~"

# ============================================================================
# Headgear: Purple Ribbon Witch Hat (purple_ribbon_witch_hat_quest.cs)
# ============================================================================

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "[Witch] Morvenna"
msgstr "[Ведьма] Морвенна"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Morvenna"
msgstr "Морвенна"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "{#666666}*A hunched figure tends to a cauldron among the weathered graves, owl statues watching silently from their perches*{/}"
msgstr "{#666666}*Среди обветшалых могил сгорбленная фигура возится у котла, а статуи сов молча наблюдают за ней со своих насестов*{/}"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Ah, a visitor who dares walk among the departed... The owls have been watching you, child. They whisper secrets of your arrival."
msgstr "Ах, гость, осмелившийся пройти среди ушедших... Совы наблюдали за тобой, дитя. Они шепчут секреты о твоём приходе."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "I am Morvenna, keeper of this burial ground. The spirits here have grown restless, and my craft requires... specific ingredients to keep them at peace."
msgstr "Я — Морвенна, хранительница этого кладбища. Духи здесь стали беспокойными, и для моего ремесла нужны… особые ингредиенты, чтобы удержать их в покое."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Have you gathered the materials I require?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Yes, I have them"
msgstr "Да, у меня они есть"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Still searching"
msgstr "Все еще ищу"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "{#666666}*Morvenna's eyes gleam as she examines the materials, her gnarled fingers weaving through the air*{/}"
msgstr "{#666666}*Глаза Морвенны блестят, пока она изучает материалы, а её корявые пальцы описывают в воздухе сложные узоры*{/}"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Excellent... The Vubbe tokens carry traces of their tribal magic, and the spider leaves still pulse with forest essence. These will serve well."
msgstr "Превосходно... В жетонах Вуббе сохранились следы племенной магии, а в листьях паука до сих пор пульсирует лесная сущность. Они отлично подойдут."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "As promised, take this hat I crafted during the last purple moon. It belonged to my predecessor, who now rests beneath these very stones. Wear it wisely, and the owls shall watch over you."
msgstr "Как и обещал, возьми эту шапку, которую я изготовил во время последней пурпурной луны. Она принадлежала моему предшественнику, который теперь покоится под этими самыми камнями. Носи её с умом, и совы будут охранять тебя."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "{#666666}*The owl statues seem to turn their stone heads ever so slightly*{/}"
msgstr "{#666666}*Кажется, что каменные фигуры сов слегка поворачивают свои каменные головы*{/}"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "The forest creatures guard their treasures fiercely. Seek the High Vubbes in the eastern glades and the Bushspiders that lurk in the shadowed groves. Return when your task is complete."
msgstr "Лесные обитатели яростно охраняют свои сокровища. Отправляйся на поиски Высоких Вуббов на восточных полянах и Кустарниковых Пауков, скрывающихся в затененных рощах. Вернись, когда выполнишь задание."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Would you aid an old witch in her sacred duty? I shall reward you handsomely."
msgstr "Не могли бы вы помочь старой ведьме в исполнении её священного долга? Я щедро вознагражу вас."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "What do you need?"
msgstr "Что вам нужно?"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "I must decline"
msgstr "Я вынужден отказаться"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "The spirits grow impatient, but you bring hope. I need 50 High Vubbe Tokens from the tribal creatures that infest these woods, and 75 Bushspider Leaves from the eight-legged horrors."
msgstr "Духи теряют терпение, но ты даришь им надежду. Мне нужно 50 жетонов «Высокий Вуббе», которые можно добыть у племенных существ, заселивших эти леса, и 75 листьев кустового паука — у этих восьминогих ужасов."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "Bring these to me, and I shall craft you something special... a witch's hat imbued with the essence of this sacred place. The owls shall guide your path."
msgstr "Принеси мне всё это, и я изготовлю для тебя нечто особенное… колдовскую шляпу, пронизанную сущностью этого священного места. Совы укажут тебе путь."

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "{#666666}*Morvenna's expression darkens momentarily*{/}"
msgstr "{#666666}*Лицо Морвенны на мгновение омрачилось*{/}"

#: headgears/purple_ribbon_witch_hat_quest.cs
msgid "So be it. But remember, child... the owls never forget those who turned away from the graves. Walk carefully in these woods."
msgstr "Что ж, пусть будет так. Но помни, дитя… совы никогда не забывают тех, кто отвернулся от могил. Будь осторожен в этих лесах."

# ============================================================================
# Headgear: Radishu (radishu_quest.cs)
# ============================================================================

#: headgears/radishu_quest.cs
msgid "[Farmer] Theodric"
msgstr "[Фермер] Теодрик"

#: headgears/radishu_quest.cs
msgid "Theodric"
msgstr "Теодрик"

#: headgears/radishu_quest.cs
msgid "{#666666}*wipes sweat from his brow while examining a wilted plant*{/}"
msgstr "{#666666}*вытирает пот со лба, рассматривая увядшее растение*{/}"

#: headgears/radishu_quest.cs
msgid "Ah, another traveler passing through! Say, you wouldn't happen to know anything about farming, would you? These fields used to produce the finest radishes in all the kingdom..."
msgstr "А, вот и ещё один путник! Скажи, ты случайно не знаешь ничего о земледелии? Раньше на этих полях выращивали лучший редис во всём королевстве..."

#: headgears/radishu_quest.cs
msgid "But ever since those Ashronge and Cronewts moved in, the soil's gone all wrong. Funny thing is, I think those very creatures might be the key to fixing it!"
msgstr "Но с тех пор, как сюда поселились эти Ашронг и Кронеутс, с почвой что-то не так. Самое забавное, что, по-моему, именно эти существа могут стать ключом к решению проблемы!"

#: headgears/radishu_quest.cs
msgid "Did you gather the materials for my special compost?"
msgstr "Ты собрал материалы для моего специального компоста?"

#: headgears/radishu_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/radishu_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/radishu_quest.cs
msgid "{#666666}*excitedly examines the materials*{/} Perfect! These stems will break down beautifully, and the bones... they'll add just the right minerals to the soil!"
msgstr "{#666666}*восторженно осматривает материалы*{/} Прекрасно! Эти стебли прекрасно разложатся, а кости… они обогатят почву нужными минералами!"

#: headgears/radishu_quest.cs
msgid "{#666666}*mixes the compost and tends to a special plot*{/} Would you look at that! The radish is already sprouting! Here, take this one - it grew so fast it popped right out of the ground wearing its own little hat!"
msgstr "{#666666}*перемешивает компост и ухаживает за специальным участком*{/} Посмотрите-ка! Редис уже прорастает! Вот, возьмите этот — он вырос так быстро, что просто выскочил из земли в своей маленькой «шапочке»!"

#: headgears/radishu_quest.cs
msgid "You know, the soil around here could always use more enrichment. If you bring me more materials, I could grow another prize radish for you..."
msgstr "Знаешь, почва здесь всегда нуждается в дополнительном удобрении. Если ты принесешь мне ещё материалов, я смогу вырастить для тебя ещё один призовой редис..."

#: headgears/radishu_quest.cs
msgid "The Ashronge wander all around the aqueduct area - you can't miss their strange stems. As for the Cronewts, those lizard-folk leave bones scattered everywhere near their camps to the south."
msgstr "Ашронги бродят по всей территории вокруг акведука — их странные стебли невозможно не заметить. Что касается Кроневтов, то эти ящеролюди разбрасывают кости повсюду возле своих лагерей на юге."

#: headgears/radishu_quest.cs
msgid "Would you help me gather materials for a special compost?"
msgstr "Не могли бы вы помочь мне собрать материалы для приготовления особого компоста?"

#: headgears/radishu_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/radishu_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/radishu_quest.cs
msgid "Wonderful! I need Ashrong Stems - about 80 of them - for the organic matter. They're fibrous and break down slowly, perfect for long-term soil health. And 50 Cronewt Bones will add the minerals my radishes crave!"
msgstr "Замечательно! Мне нужны стебли ашронга — примерно 80 штук — для обогащения почвы органикой. Они волокнистые и разлагаются медленно, что идеально подходит для поддержания здоровья почвы в долгосрочной перспективе. А 50 костей кронеута добавят минералы, в которых так нуждается мой редис!"

#: headgears/radishu_quest.cs
msgid "{#666666}*sighs and returns to tending the wilted crops*{/} Can't blame you. These old bones aren't what they used to be either... Maybe next time."
msgstr "{#666666}*вздыхает и возвращается к уходу за увядшими растениями*{/} Не могу тебя винить. Эти старые кости тоже уже не те, что раньше... Может, в следующий раз."

# ============================================================================
# Headgear: Sailor Cap (sailor_cap_quest.cs)
# ============================================================================

#: headgears/sailor_cap_quest.cs
msgid "[Retired Sailor] Jacques"
msgstr "[Моряк в отставке] Жак"

#: headgears/sailor_cap_quest.cs
msgid "Jacques"
msgstr "Жак"

#: headgears/sailor_cap_quest.cs
msgid "*adjusts his old cap* This view is amazing! Don't you think? Ah I miss so much my old mates... we used to sail all day!"
msgstr "*поправляет свою старую кепку* Какой потрясающий вид! Не правда ли? Ах, как же я скучаю по своим старым приятелям… Мы целыми днями ходили под парусами!"

#: headgears/sailor_cap_quest.cs
msgid "But you know why I'm here, right? this ferret fur... It reminds me of the materials we used to use. Strong, weather-resistant, perfect for every condition..."
msgstr "Но ты же знаешь, зачем я здесь, да? Этот хорьковый мех… Он напоминает мне материалы, которые мы раньше использовали. Прочный, устойчивый к воздействию погодных условий, идеально подходящий для любых условий…"

#: headgears/sailor_cap_quest.cs
msgid "Perfect for making sailor caps! Yes, exactly! So... Are you interested in helping me?"
msgstr "Идеально подходит для пошива матросских кепок! Да, именно! Итак... Не хотели бы вы мне помочь?"

#: headgears/sailor_cap_quest.cs
msgid "Do you have the ferret fur?"
msgstr "У вас есть мех хорька?"

#: headgears/sailor_cap_quest.cs
msgid "Yes, here it is"
msgstr "Да, вот оно"

#: headgears/sailor_cap_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/sailor_cap_quest.cs
msgid "*expertly crafts the cap* Ah, perfect! *holds it up proudly* Now THIS is a proper sailor's cap! The ferret fur gives it that sturdy yet comfortable feel we always valued out at sea."
msgstr "*искусно мастерит кепку* Ах, просто идеально! *гордо поднимает её* Вот это да, вот это настоящая матросская кепка! Хвостовка придаёт ей ту прочность и удобство, которые мы всегда ценили в море."

#: headgears/sailor_cap_quest.cs
msgid "*straightens his posture* You know, I could always make another one if you're interested. Nothing beats a well-made sailor's cap!"
msgstr "*выпрямляется* Знаешь, я всегда могу сделать ещё одну, если тебе интересно. Ничто не сравнится с хорошо сшитой матроской кепкой!"

#: headgears/sailor_cap_quest.cs
msgid "*checks his compass* Take your time, sailor. Quality can't be rushed, and neither can collecting the right materials."
msgstr "*проверяет компас* Не торопись, моряк. Качество не терпит спешки, как и поиск нужных материалов."

#: headgears/sailor_cap_quest.cs
msgid "Want to help create a genuine sailor's cap?"
msgstr "Хотите помочь создать настоящую матросскую кепку?"

#: headgears/sailor_cap_quest.cs
msgid "I'll help gather"
msgstr "Я помогу собрать"

#: headgears/sailor_cap_quest.cs
msgid "*beams with excitement* Excellent! We'll need plenty of ferret fur for this - it's the only material that truly holds up to maritime standards. And believe me, I would know!"
msgstr "*сияет от восторга* Прекрасно! Для этого нам понадобится много хорьевой шерсти — это единственный материал, который действительно соответствует морским стандартам. И поверьте мне, я-то знаю!"

#: headgears/sailor_cap_quest.cs
msgid "*returns to adjusting his cap* No rush, the sea teaches us patience after all... Come back when you're ready to learn about real sailing gear!"
msgstr "*снова поправляет кепку* Не торопись, ведь море учит нас терпению... Заходи, когда будешь готов узнать о настоящем парусном снаряжении!"

# ============================================================================
# Headgear: Sea Themed Headband (sea_themed_headband_quest.cs)
# ============================================================================

#: headgears/sea_themed_headband_quest.cs
msgid "[Shrine Keeper] Thalassa"
msgstr "[Хранительница святилища] Таласса"

#: headgears/sea_themed_headband_quest.cs
msgid "Thalassa"
msgstr "Таласса"

#: headgears/sea_themed_headband_quest.cs
msgid "{#666666}*gazes out over the still waters*{/}"
msgstr "{#666666}*взглядом скользит по глади воды*{/}"

#: headgears/sea_themed_headband_quest.cs
msgid "Traveler... these ruins once housed a shrine dedicated to the spirits of the deep. Long ago, pilgrims would come seeking the blessing of the tides."
msgstr "Путешественник… В этих руинах когда-то находилось святилище, посвящённое духам морских глубин. Давным-давно сюда приезжали паломники в поисках благословения приливов и отливов."

#: headgears/sea_themed_headband_quest.cs
msgid "I have been trying to restore an ancient ceremonial headband, blessed by the water spirits themselves. But I need materials that only the Merogs carry..."
msgstr "Я пытаюсь восстановить древнюю церемониальную повязку на голову, освящённую самими водными духами. Но мне нужны материалы, которые есть только у мерогов..."

#: headgears/sea_themed_headband_quest.cs
msgid "{#666666}*turns from the water*{/} Have you gathered what I need to complete the restoration?"
msgstr "{#666666}*отворачивается от воды*{/} Ты собрал всё, что мне нужно для завершения реставрации?"

#: headgears/sea_themed_headband_quest.cs
msgid "Yes, I have everything"
msgstr "Да, у меня всё есть"

#: headgears/sea_themed_headband_quest.cs
msgid "Still searching"
msgstr "Все еще ищу"

#: headgears/sea_themed_headband_quest.cs
msgid "{#666666}*carefully weaves the materials together, whispering ancient words*{/}"
msgstr "{#666666}*тщательно сплетает материалы, шепча древние слова*{/}"

#: headgears/sea_themed_headband_quest.cs
msgid "The spirits of the deep have blessed this work. Take this headband - may the waters always guide you safely home."
msgstr "Духи морских глубин благословили это творение. Возьми эту повязку — пусть воды всегда благополучно проводят тебя домой."

#: headgears/sea_themed_headband_quest.cs
msgid "{#666666}*returns to watching the water*{/} The shrine's power grows stronger each day. Should you wish another blessing, return with more materials..."
msgstr "{#666666}*снова начинает наблюдать за водой*{/} Сила святилища с каждым днём становится всё сильнее. Если вы желаете получить ещё одно благословение, вернитесь с дополнительными материалами..."

#: headgears/sea_themed_headband_quest.cs
msgid "The Merogs have grown bold since the shrine fell into disrepair. Their hearts carry the essence of the waters they once protected. The cinnabar they hoard preserves the old magic."
msgstr "С тех пор как святилище пришло в упадок, мероги стали смелее. В их сердцах живет сущность тех вод, которые они когда-то охраняли. Киноварь, которую они копили, хранит древнюю магию."

#: headgears/sea_themed_headband_quest.cs
msgid "Will you help me restore this sacred artifact?"
msgstr "Не поможете ли вы мне восстановить этот священный артефакт?"

#: headgears/sea_themed_headband_quest.cs
msgid "I will gather what you need"
msgstr "Я соберу всё, что вам нужно"

#: headgears/sea_themed_headband_quest.cs
msgid "Perhaps another time"
msgstr "Может быть, в другой раз"

#: headgears/sea_themed_headband_quest.cs
msgid "The Merog creatures nearby have absorbed the shrine's power over the years. Their hearts carry the essence I need, and the shamans among them hoard cinnabar - a mineral sacred to water rituals. Bring me these, and I shall craft for you a headband blessed by the tides themselves."
msgstr "На протяжении многих лет обитающие поблизости существа Мерога впитали в себя силу святилища. В их сердцах таится сущность, которая мне нужна, а шаманы из их числа копируют киноварь — минерал, священный для водных ритуалов. Принесите мне всё это, и я изготовлю для вас повязку на голову, благословленную самими приливами и отливами."

#: headgears/sea_themed_headband_quest.cs
msgid "{#666666}*nods slowly*{/} The waters are patient. Return when you are ready."
msgstr "{#666666}*медленно кивает*{/} Воды терпеливы. Вернись, когда будешь готов."

# ============================================================================
# Headgear: Shaman Mask (shaman_mask_quest.cs)
# ============================================================================

#: headgears/shaman_mask_quest.cs
msgid "[Mystic Doll] Yagra"
msgstr "[Мистическая кукла] Ягра"

#: headgears/shaman_mask_quest.cs
msgid "Yagra"
msgstr "Ягра"

#: headgears/shaman_mask_quest.cs
msgid "*the mystic doll seems impatient yet friendly* Ahh... the spirits speak of your arrival. The wendigos possess powerful spiritual essence in their fangs and teeth..."
msgstr "*мистическая кукла выглядит нетерпеливой, но приветливой* Ах... духи предвещают твое прибытие. В клыках и зубах вендиго таится могущественная духовная сущность..."

#: headgears/shaman_mask_quest.cs
msgid "With these, I can craft a mask to help you commune with the spirit world. Will you help gather what I need?"
msgstr "С их помощью я смогу изготовить маску, которая поможет тебе вступить в контакт с миром духов. Поможешь ли ты мне собрать всё необходимое?"

#: headgears/shaman_mask_quest.cs
msgid "*waves hand through the smoke* Have you gathered the spiritual essence I need?"
msgstr "*машет рукой сквозь дым* Ты собрал ту духовную сущность, которая мне нужна?"

#: headgears/shaman_mask_quest.cs
msgid "Here are the materials"
msgstr "Вот материалы"

#: headgears/shaman_mask_quest.cs
msgid "Still hunting"
msgstr "Охота с засады"

#: headgears/shaman_mask_quest.cs
msgid "*chants in ancient tongue while crafting* The spirits are pleased with these offerings. Take this mask - may it help you see beyond the veil."
msgstr "*напевает на древнем языке, занимаясь ремеслом* Духи довольны этими подношениями. Возьми эту маску — пусть она поможет тебе заглянуть за завесу."

#: headgears/shaman_mask_quest.cs
msgid "*smoke swirls* The spirits are ever-hungry. Return if you wish to craft another mask..."
msgstr "*вихри дыма* Духи вечно голодны. Вернись, если хочешь изготовить ещё одну маску..."

#: headgears/shaman_mask_quest.cs
msgid "*peers through the smoke* Continue your hunt. The spirits will guide you to what you seek."
msgstr "*вглядывается сквозь дым* Продолжай свою охоту. Духи приведут тебя к тому, что ты ищешь."

#: headgears/shaman_mask_quest.cs
msgid "Will you help gather materials to craft a shaman mask?"
msgstr "Не могли бы вы помочь собрать материалы для изготовления маски шамана?"

#: headgears/shaman_mask_quest.cs
msgid "I will help"
msgstr "Я помогу"

#: headgears/shaman_mask_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/shaman_mask_quest.cs
msgid "*nods solemnly* The wendigos' spiritual essence is strong. Their fangs and teeth hold power... bring them to me, and I will shape them into a mask of communion."
msgstr "*торжественно кивает* Духовная сущность вендиго очень сильна. В их клыках и зубах таится сила… Принесите их мне, и я превращу их в маску единения."

#: headgears/shaman_mask_quest.cs
msgid "*returns to meditation* The spirits will wait... as will I."
msgstr "*возвращается к медитации* Духи подождут… как и я."

# ============================================================================
# Headgear: Snowman Nose (snowman_nose_quest.cs)
# ============================================================================

#: headgears/snowman_nose_quest.cs
msgid "[Mountaineer] Bjorn"
msgstr "[Альпинист] Бьорн"

#: headgears/snowman_nose_quest.cs
msgid "Bjorn"
msgstr "Бьорн"

#: headgears/snowman_nose_quest.cs
msgid "{#666666}*sits near a tent, staring at a pile of frozen meat with a distant look*{/}"
msgstr "{#666666}*сидит возле палатки и с отрешённым взглядом смотрит на кучу замороженного мяса*{/}"

#: headgears/snowman_nose_quest.cs
msgid "Ah, another soul brave enough to climb this far! Welcome to the highest point of the tableland. It's just me, the wind, and... well, that frozen meat there. Not the best company, I'm afraid."
msgstr "Ах, ещё одна душа, достаточно смелая, чтобы подняться так высоко! Добро пожаловать на самую высокую точку плоскогорья. Здесь только я, ветер и… ну, вот это замороженное мясо. Боюсь, не самая лучшая компания."

#: headgears/snowman_nose_quest.cs
msgid "I've been up here so long, I started building a snowman to keep me company. But the blasted thing needs a proper nose, and I ate my last carrot weeks ago. Now I have a rather foolish idea..."
msgstr "Я уже так долго нахожусь здесь, что начал лепить снеговика, чтобы он составил мне компанию. Но этой проклятой фигуре нужен нормальный нос, а последнюю морковку я съел ещё несколько недель назад. Теперь у меня появилась довольно глупая идея..."

#: headgears/snowman_nose_quest.cs
msgid "Those White Spions that prowl these heights have the softest fur. And the Blue Harugals, rare as they are, have manes that shimmer like ice crystals. With enough of both, I could fashion a nose that would make any snowman proud!"
msgstr "У тех белых спионов, что бродят по этим вершинам, самая мягкая шерсть. А у голубых харугалов, какими бы редкими они ни были, гривы переливаются, словно ледяные кристаллы. Если собрать достаточно и того, и другого, я смогу слепить нос, которым мог бы гордиться любой снеговик!"

#: headgears/snowman_nose_quest.cs
msgid "Have you gathered the materials for my snowman's nose?"
msgstr "Ты собрал материалы для носа моего снеговика?"

#: headgears/snowman_nose_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/snowman_nose_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/snowman_nose_quest.cs
msgid "{#666666}*eagerly takes the materials and begins weaving them together with practiced hands*{/}"
msgstr "{#666666}*с нетерпением берет материалы и начинает сплетать их своими опытными руками*{/}"

#: headgears/snowman_nose_quest.cs
msgid "Ha! Look at this beauty! The fur makes it soft to the touch, and the mane gives it that distinctive blue-white shimmer of the frozen peaks."
msgstr "Ха! Посмотрите-ка на эту красоту! Благодаря меху она такая мягкая на ощупь, а грива придает ей тот характерный сине-белый блеск, как у замерзших вершин."

#: headgears/snowman_nose_quest.cs
msgid "You know what? I made two. One for my snowman friend here, and one for you. Consider it thanks for humoring a lonely old mountaineer. Maybe you'll find your own peak that needs some company someday."
msgstr "Знаешь что? Я сделал два. Один для моего друга-снеговика, а другой — для тебя. Считай это благодарностью за то, что поддержал одинокого старого альпиниста. Может быть, когда-нибудь и ты найдешь свою вершину, которой нужна компания."

#: headgears/snowman_nose_quest.cs
msgid "The White Spions tend to hunt in packs near the cliffs, and the Blue Harugals... well, they're rare beasts, but fierce. Watch yourself out there, friend."
msgstr "Белые Шпионы обычно охотятся стаями у обрывов, а Голубые Харугалы… ну, это редкие звери, но очень свирепые. Будь осторожен там, друг."

#: headgears/snowman_nose_quest.cs
msgid "Would you help an old mountaineer with his peculiar project?"
msgstr "Не могли бы вы помочь пожилому альпинисту в реализации его необычного проекта?"

#: headgears/snowman_nose_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/snowman_nose_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/snowman_nose_quest.cs
msgid "You're a good soul! Bring me 80 bundles of White Spion Fur and 30 Blue Harugal Manes. The Spions are common enough around here, but the Harugals are elusive. Good hunting!"
msgstr "Ты — добрый человек! Принеси мне 80 мотков белого меха спиона и 30 синих грив харугала. Спионы здесь встречаются довольно часто, а вот харугалы — редкость. Удачной охоты!"

#: headgears/snowman_nose_quest.cs
msgid "Can't blame you. It is a bit of a foolish request. But if you change your mind, I'll be here... talking to my frozen meat, apparently."
msgstr "Не могу тебя винить. Это действительно немного глупая просьба. Но если ты передумаешь, я буду здесь… видимо, разговаривать со своим замороженным мясом."

# ============================================================================
# Headgear: Snowy Reindeer Antlers (snowy_reindeer_antlers_quest.cs)
# ============================================================================

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "[Hunter] Valdis"
msgstr "[Хантер] Валдис"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Valdis"
msgstr "Валдис"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "{#666666}*sits by a small campfire, carefully carving a piece of bone*{/}"
msgstr "{#666666}*сидит у небольшого костра, тщательно вырезая что-то из кусочка кости*{/}"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Ah, a traveler braving the cold! Come, warm yourself by the fire. These frozen plains are unforgiving to those unprepared."
msgstr "Ах, путешественник, бросивший вызов холоду! Заходи, согрейся у костра. Эти замерзшие равнины безжалостны к тем, кто не готов к ним."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "I am Valdis, a hunter of these lands for many winters now. I've been working on something special - a headdress in honor of the frost spirits that guide us through the harshest blizzards."
msgstr "Меня зовут Валдис, я уже много зим охочусь в этих краях. Я работал над чем-то особенным — головным убором в честь духов мороза, которые ведут нас сквозь самые суровые метели."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "The old tales speak of great reindeer that once roamed these mesas, their antlers crowned with frost and their manes flowing like winter clouds. I seek to capture that spirit in a ceremonial piece."
msgstr "В старинных сказаниях рассказывается о величественных оленях, которые когда-то бродили по этим плоскогорьям: их рога были увенчаны инеем, а гривы развевались, словно зимние облака. Я стремлюсь воплотить этот дух в церемониальном произведении."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Have you gathered the materials I need?"
msgstr "Вы собрали все необходимые мне материалы?"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Yes, I have everything"
msgstr "Да, у меня всё есть"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Still hunting"
msgstr "Охота с засады"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "{#666666}*examines the materials with practiced hands*{/}"
msgstr "{#666666}*осматривает материалы опытными руками*{/}"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Magnificent! These Blue Tini horns have exactly the shape and curvature I envisioned. And the Hohen manes... feel how soft yet resilient they are, like snow that refuses to melt."
msgstr "Великолепно! Эти рога «Blue Tini» имеют именно ту форму и изгиб, которые я себе представлял. А гривы «Hohen»… почувствуйте, какие они мягкие и в то же время упругие — словно снег, который не хочет таять."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "{#666666}*works with surprising speed, binding and shaping the materials*{/}"
msgstr "{#666666}*работает с удивительной скоростью, скрепляя и придавая форму материалам*{/}"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "There. The antlers curve just as they did in the old paintings, and the mane provides warmth against even the fiercest winds. Wear these with pride, for you carry the blessing of the frost spirits."
msgstr "Вот. Рога изогнуты так же, как на старинных картинах, а грива согревает даже в самый сильный ветер. Носи их с гордостью, ведь ты несешь в себе благословение духов мороза."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "If the spirits call to you again and you wish for another, I will be here by my fire."
msgstr "Если духи снова позовут тебя и ты захочешь выпить ещё, я буду здесь, у своего костра."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "{#666666}*stokes the fire thoughtfully*{/}"
msgstr "{#666666}*задумчиво разжигает огонь*{/}"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "The Blue Tinis swarm across these frozen plains in great numbers - small creatures with curved horns that catch the light like ice. And the Blue Hohens, those armored knights of the frost, their manes are prized for their warmth."
msgstr "По этим замерзшим равнинам в огромных количествах роятся «Голубые Тини» — маленькие существа с изогнутыми рогами, которые отражают свет, словно лед. А у «Голубых Хоенов», этих бронированных рыцарей мороза, гривы ценятся за то, что они согревают."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Take care out there. The cold itself is your greatest enemy, not just the creatures."
msgstr "Будьте осторожны там. Самый главный враг — это не только животные, но и сам холод."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Would you help me gather materials for this ceremonial headdress?"
msgstr "Не могли бы вы помочь мне собрать материалы для этого церемониального головного убора?"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "I will help you"
msgstr "Я вам помогу"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "Perhaps when I'm better prepared"
msgstr "Возможно, когда я буду лучше подготовлен"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "{#666666}*nods with quiet gratitude*{/}"
msgstr "{#666666}*кивает головой, выражая тихую благодарность*{/}"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "The frost spirits smile upon you. I need 100 Blue Tini Horns - the small creatures are everywhere in this frozen expanse. Their horns, when properly arranged, will form the antlers."
msgstr "Духи мороза благосклонны к тебе. Мне нужно 100 рогов голубых тини — эти маленькие существа повсюду на этой замерзшей равнине. Их рога, если их правильно скомпоновать, образуют оленьи рога."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "I also need 25 Blue Hohen Manes from the armored warriors that patrol these lands. Their flowing manes will provide the finishing touch and keep your ears warm against the bitter cold."
msgstr "Мне также нужно 25 синих грив Хоэна от бронированных воинов, патрулирующих эти земли. Их развевающиеся гривы станут изюминкой образа и согреют ваши уши в лютый мороз."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "May the winds guide your hunt, traveler."
msgstr "Пусть ветры ведут тебя на охоту, путешественник."

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "{#666666}*returns to his carving*{/}"
msgstr "{#666666}*возвращается к своей резьбе*{/}"

#: headgears/snowy_reindeer_antlers_quest.cs
msgid "A wise choice if you feel unprepared. The frozen plains are not kind to those who underestimate them. Return when you are ready, and the fire will still be burning."
msgstr "Мудрый выбор, если вы чувствуете, что ещё не готовы. Замерзшие равнины не щадят тех, кто их недооценивает. Вернитесь, когда будете готовы, — огонь всё ещё будет гореть."

# ============================================================================
# Headgear: Soldier Hat (soldier_hat_quest.cs)
# ============================================================================

#: headgears/soldier_hat_quest.cs
msgid "[Adventurer] Marcus"
msgstr "[Авантюрист] Маркус"

#: headgears/soldier_hat_quest.cs
msgid "Marcus"
msgstr "Маркус"

#: headgears/soldier_hat_quest.cs
msgid "*checking list* The guild's research department is always in need of specimens from the field."
msgstr "*Контрольный список* Исследовательскому отделу гильдии постоянно требуются образцы, добытые в полевых условиях."

#: headgears/soldier_hat_quest.cs
msgid "I'm on collection duty, but there's so much to gather... Say, would you be interested in helping out? The guild rewards its helpers well."
msgstr "Я дежурю по сбору, но нужно собрать так много... Скажи, не хотел бы ты мне помочь? Гильдия щедро вознаграждает своих помощников."

#: headgears/soldier_hat_quest.cs
msgid "Found everything on the list?"
msgstr "Всё из списка нашли?"

#: headgears/soldier_hat_quest.cs
msgid "Turn in items"
msgstr "Сдать вещи"

#: headgears/soldier_hat_quest.cs
msgid "Still searching"
msgstr "Все еще ищу"

#: headgears/soldier_hat_quest.cs
msgid "Excellent specimens! The research department will be pleased. Here's your Soldier Hat - straight from the guild's special collection."
msgstr "Превосходные экземпляры! Исследовательский отдел будет в восторге. Вот ваша солдатская фуражка — прямо из специальной коллекции гильдии."

#: headgears/soldier_hat_quest.cs
msgid "You know... The guild always needs more samples. Interested in another collection run?"
msgstr "Знаешь... Гильдии всегда нужны новые образцы. Не хочешь снова отправиться за сбором?"

#: headgears/soldier_hat_quest.cs
msgid "Let me check the list again... We need 1 Shredded Pieces of Cloth and 150 Yekubite Antennae."
msgstr "Дайте мне ещё раз проверить список... Нам нужно 1 кусок рваной ткани и 150 антенн екубитов."

#: headgears/soldier_hat_quest.cs
msgid "Keep searching! The specimens aren't going to collect themselves."
msgstr "Продолжайте поиски! Образцы сами по себе не соберутся."

#: headgears/soldier_hat_quest.cs
msgid "Want to help with the guild's collection efforts?"
msgstr "Хотите помочь гильдии в сборе средств?"

#: headgears/soldier_hat_quest.cs
msgid "I'll help collect"
msgstr "Я помогу собрать"

#: headgears/soldier_hat_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/soldier_hat_quest.cs
msgid "Great! The cloth samples will help us study material degradation in the mines, and the antennae have unique properties the researchers are studying. Happy hunting!"
msgstr "Отлично! Образцы ткани помогут нам изучить процесс разрушения материалов в шахтах, а антенны обладают уникальными свойствами, которые сейчас исследуют ученые. Удачи в поисках!"

#: headgears/soldier_hat_quest.cs
msgid "No problem, I'll keep collecting. Stop by if you change your mind - the guild always needs help!"
msgstr "Не проблема, я буду продолжать собирать. Заходи, если передумаешь — гильдии всегда нужна помощь!"

# ============================================================================
# Headgear: Spiral Glasses (spiral_glasses_quest.cs)
# ============================================================================

#: headgears/spiral_glasses_quest.cs
msgid "[Crystal Miner] Gareth"
msgstr "[Crystal Miner] Гарет"

#: headgears/spiral_glasses_quest.cs
msgid "Gareth"
msgstr "Гарет"

#: headgears/spiral_glasses_quest.cs
msgid "Oh, are you an adventurer...?"
msgstr "О, так ты — искатель приключений...?"

#: headgears/spiral_glasses_quest.cs
msgid "I've been working on a design for special glasses that can help spot mineral deposits. With the right materials from the mines, I could craft them."
msgstr "Я работаю над проектом специальных очков, которые помогут обнаруживать месторождения полезных ископаемых. Если удастся добыть нужные материалы из рудников, я смогу их изготовить."

#: headgears/spiral_glasses_quest.cs
msgid "Have you collected the materials from the mines?"
msgstr "Вы уже добыли материалы из шахт?"

#: headgears/spiral_glasses_quest.cs
msgid "Here are the materials"
msgstr "Вот материалы"

#: headgears/spiral_glasses_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/spiral_glasses_quest.cs
msgid "Perfect! These will work wonderfully. Here are your Spiral Glasses - they'll help you spot treasures others might miss!"
msgstr "Отлично! Они подойдут просто идеально. Вот ваши «спиральные очки» — с их помощью вы сможете обнаружить сокровища, которые другие могут упустить из виду!"

#: headgears/spiral_glasses_quest.cs
msgid "Say... I could always craft another pair if you're interested in gathering more materials."
msgstr "Слушай... Я всегда могу изготовить ещё одну пару, если ты захочешь собрать больше материалов."

#: headgears/spiral_glasses_quest.cs
msgid "Hmm, looks like you're missing some materials. I need 50 Vubbe Tokens and 200 Stone Orca Cores to craft the glasses."
msgstr "Хм, похоже, у тебя не хватает некоторых материалов. Для изготовления очков мне нужно 50 жетонов Вуббе и 200 каменных ядер орки."

#: headgears/spiral_glasses_quest.cs
msgid "Take your time in the mines, but be careful down there."
msgstr "Не торопитесь в шахтах, но будьте там осторожны."

#: headgears/spiral_glasses_quest.cs
msgid "Would you help me gather materials for the Spiral Glasses?"
msgstr "Не могли бы вы помочь мне собрать материалы для «Спиральных очков»?"

#: headgears/spiral_glasses_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/spiral_glasses_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/spiral_glasses_quest.cs
msgid "Excellent! The Vubbe Tokens have unique refractive properties, and the Stone Orca Cores can be ground into special lenses. Come back when you have them all."
msgstr "Отлично! Токены Vubbe обладают уникальными свойствами преломления света, а ядра «Каменной орки» можно отшлифовать в специальные линзы. Вернись, когда соберёшь их все."

#: headgears/spiral_glasses_quest.cs
msgid "Well, if you change your mind, you know where to find me. These old glasses won't last much longer..."
msgstr "Ну, если передумаешь, знаешь, где меня найти. Эти старые очки уже недолго прослужат..."

# ============================================================================
# Headgear: Sprout (sprout_quest.cs)
# ============================================================================

#: headgears/sprout_quest.cs
msgid "[Botanist] Flora"
msgstr "[Ботаник] Флора"

#: headgears/sprout_quest.cs
msgid "Flora"
msgstr "Флора"

#: headgears/sprout_quest.cs
msgid "*excitedly examines plants* The combination of Hanaming's life energy and the crystallized essence of Red Kepas... Yes, yes! It could work!"
msgstr "*восторженно изучает растения* Сочетание жизненной энергии Ханаминга и кристаллизованной сущности Красных Кепас… Да, да! Это может сработать!"

#: headgears/sprout_quest.cs
msgid "Oh! Hello there! Would you like to help me with an experiment? I'm trying to create a special sprout that can be worn as an accessory!"
msgstr "Ой! Привет! Не хотели бы вы помочь мне с экспериментом? Я пытаюсь создать особый росток, который можно носить как аксессуар!"

#: headgears/sprout_quest.cs
msgid "Did you gather the materials for our sprout experiment?"
msgstr "Ты собрал материалы для нашего эксперимента с ростками?"

#: headgears/sprout_quest.cs
msgid "Yes, I have them"
msgstr "Да, у меня они есть"

#: headgears/sprout_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/sprout_quest.cs
msgid "*bounces excitedly* It worked! It worked! Look at this adorable little sprout! Here, you should wear it - you helped create it after all!"
msgstr "*взволнованно подпрыгивает* Получилось! Получилось! Посмотрите на этот очаровательный маленький росток! Вот, наденьте его — в конце концов, вы же помогли его создать!"

#: headgears/sprout_quest.cs
msgid "*eyes sparkle* Oh! We could try different combinations of materials! Want to make another one?"
msgstr "*глаза заблестели* Ой! Мы могли бы попробовать разные комбинации материалов! Хочешь сделать ещё одну?"

#: headgears/sprout_quest.cs
msgid "*tends to nearby plants* Take your time! Good science can't be rushed!"
msgstr "*ухаживает за растениями поблизости* Не торопись! В науке нельзя спешить!"

#: headgears/sprout_quest.cs
msgid "Want to help create a magical sprout accessory?"
msgstr "Хотите помочь создать волшебный аксессуар из ростков?"

#: headgears/sprout_quest.cs
msgid "Sure, sounds fun!"
msgstr "Конечно, звучит интересно!"

#: headgears/sprout_quest.cs
msgid "Maybe later"
msgstr "Может, позже"

#: headgears/sprout_quest.cs
msgid "*claps happily* Wonderful! Bring me 75 Hanaming Petals and 1 Red Kepa Crystals. The petals provide life essence, while the crystals help stabilize the growth!"
msgstr "*радостно хлопает в ладоши* Замечательно! Принесите мне 75 лепестков Ханаминга и 1 красный кристалл Кепа. Лепестки дают жизненную энергию, а кристаллы помогают стабилизировать рост!"

#: headgears/sprout_quest.cs
msgid "*returns to her plants* That's okay! Plants teach us patience. Come back when you're ready!"
msgstr "*возвращается к своим растениям* Ничего страшного! Растения учат нас терпению. Приходи, когда будешь готов!"

# ============================================================================
# Headgear: Square Black Hat (square_black_hat_quest.cs)
# ============================================================================

#: headgears/square_black_hat_quest.cs
msgid "[Scholar] Tini"
msgstr "[Учёная] Тини"

#: headgears/square_black_hat_quest.cs
msgid "Professor Tini"
msgstr "Профессор Тини"

#: headgears/square_black_hat_quest.cs
msgid "*adjusts spectacles while reading* Hmm... according to my research, the traditional academic's hat requires very specific materials..."
msgstr "*поправляет очки во время чтения* Хм... судя по моим исследованиям, для изготовления традиционной академической шапки требуются очень специфические материалы..."

#: headgears/square_black_hat_quest.cs
msgid "*looks up from book* Oh! Pardon me. Would you be interested in helping me craft a proper scholar's hat? It's quite fascinating really..."
msgstr "*поднимает глаза от книги* О! Извините. Не хотели бы вы помочь мне смастерить настоящую ученую шапочку? Это действительно очень увлекательно..."

#: headgears/square_black_hat_quest.cs
msgid "Have you collected the specimens for our academic endeavor?"
msgstr "Вы уже собрали образцы для нашего научного исследования?"

#: headgears/square_black_hat_quest.cs
msgid "Yes, Professor"
msgstr "Да, профессор"

#: headgears/square_black_hat_quest.cs
msgid "Still researching"
msgstr "По-прежнему изучаю вопрос"

#: headgears/square_black_hat_quest.cs
msgid "*examines materials thoroughly* Yes, yes! These specimens are perfect! Here's your Square Black Hat - quite distinguished, if I do say so myself."
msgstr "*внимательно изучает материалы* Да, да! Эти образцы просто идеальны! Вот ваша «Квадратная чёрная шляпа» — весьма представительная, если позволите так выразиться."

#: headgears/square_black_hat_quest.cs
msgid "*returns to books* You know, I have several theories about alternative material compositions... Interested in testing another hypothesis?"
msgstr "*возвращается к книгам* Знаешь, у меня есть несколько теорий об альтернативных составах материалов... Хочешь проверить ещё одну гипотезу?"

#: headgears/square_black_hat_quest.cs
msgid "*peers over glasses* Take all the time you need. Proper research cannot be rushed."
msgstr "*заглядывает поверх очков* Не торопитесь. Тщательное исследование не терпит спешки."

#: headgears/square_black_hat_quest.cs
msgid "Shall we proceed with this scholarly pursuit?"
msgstr "Может, приступим к этому научному исследованию?"

#: headgears/square_black_hat_quest.cs
msgid "Yes, Professor"
msgstr "Да, профессор"

#: headgears/square_black_hat_quest.cs
msgid "Another time"
msgstr "В другой раз"

#: headgears/square_black_hat_quest.cs
msgid "*straightens papers* Excellent! I require 120 Brown Tini Bones for the structure and 2 Brown Tini Horns for the embellishments. The proportions must be exact!"
msgstr "*разглаживает бумаги* Отлично! Мне нужно 120 коричневых «Tini Bones» для каркаса и 2 коричневых «Tini Horns» для украшения. Пропорции должны быть точными!"

#: headgears/square_black_hat_quest.cs
msgid "*returns to reading* Very well. The pursuit of knowledge waits for those who are ready."
msgstr "*возвращается к чтению* Отлично. Стремление к знаниям ждёт тех, кто к этому готов."

# ============================================================================
# Headgear: Tantalizer Feelers (tantalizer_feelers_quest.cs)
# ============================================================================

#: headgears/tantalizer_feelers_quest.cs
msgid "[Naturalist] Vaelen"
msgstr "[Натуралист] Ваэлен"

#: headgears/tantalizer_feelers_quest.cs
msgid "Vaelen"
msgstr "Ваэлен"

#: headgears/tantalizer_feelers_quest.cs
msgid "{#666666}*crouches in the shadows, examining something with a dim lantern*{/}"
msgstr "{#666666}*притаился в тени и что-то рассматривает при свете тусклого фонаря*{/}"

#: headgears/tantalizer_feelers_quest.cs
msgid "Shh... careful where you step. The creatures here navigate these lightless tunnels using specialized sensory organs. Fascinating, truly fascinating."
msgstr "Тсс... смотрите под ноги. Здешние существа ориентируются в этих безсветных туннелях с помощью специальных органов чувств. Удивительно, действительно удивительно."

#: headgears/tantalizer_feelers_quest.cs
msgid "The Velwrigglers possess feather-like appendages that detect the slightest air currents. And those Thornballs... their thorns aren't just defensive. They sense vibrations in complete darkness. I could craft something remarkable with enough samples."
msgstr "У велригглеров есть перьевидные отростки, которые улавливают малейшие воздушные потоки. А эти «Торнболлы»… их шипы служат не только для защиты. Они улавливают вибрации даже в полной темноте. Если у меня будет достаточно образцов, я смогу создать что-то потрясающее."

#: headgears/tantalizer_feelers_quest.cs
msgid "Have you gathered the specimens I requested?"
msgstr "Вы собрали образцы, которые я просил?"

#: headgears/tantalizer_feelers_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/tantalizer_feelers_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/tantalizer_feelers_quest.cs
msgid "{#666666}*carefully arranges the specimens on a worn cloth, hands moving with practiced precision*{/}"
msgstr "{#666666}*аккуратно раскладывает образцы на поношенной ткани, руки движутся с отточенной точностью*{/}"

#: headgears/tantalizer_feelers_quest.cs
msgid "Extraordinary quality! With these feathers and thorns, I've crafted something special. Wear these feelers and you'll sense the world as these creatures do... or at least look like you might. A memento of the Gate Route's dark wonders."
msgstr "Невероятное качество! Из этих перьев и шипов я создал нечто особенное. Наденьте эти щупальца, и вы начнете воспринимать мир так же, как эти существа… или, по крайней мере, будете выглядеть так, будто это так. Сувенир, напоминающий о мрачных чудесах «Пути к Вратам»."

#: headgears/tantalizer_feelers_quest.cs
msgid "The Velwrigglers drift through the upper passages, while the Thornballs prefer the lower reaches. Both species are abundant, but be wary in the dark."
msgstr "Велригглы плавают в верхних проходах, а Торнболы предпочитают нижние участки. Оба вида встречаются в изобилии, но в темноте следует быть осторожными."

#: headgears/tantalizer_feelers_quest.cs
msgid "Would you help me gather specimens for my research?"
msgstr "Не могли бы вы помочь мне собрать образцы для моего исследования?"

#: headgears/tantalizer_feelers_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/tantalizer_feelers_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/tantalizer_feelers_quest.cs
msgid "Excellent! Bring me 80 Velwriggler Feathers and 60 Thornball Thorns. The feathers are delicate, so handle them carefully. The thorns... well, they'll handle you if you're not careful."
msgstr "Отлично! Принеси мне 80 перьев Велвригглера и 60 шипов Торнболла. Перья очень хрупкие, так что обращайся с ними осторожно. А шипы… ну, они сами с тобой разберутся, если ты не будешь осторожен."

#: headgears/tantalizer_feelers_quest.cs
msgid "The darkness isn't for everyone. I'll continue my observations here, where the light doesn't reach."
msgstr "Тьма — не для всех. Я буду продолжать свои наблюдения здесь, туда, куда не доходит свет."

# ============================================================================
# Headgear: Tribal Ornament (tribal_ornament_quest.cs)
# ============================================================================

#: headgears/tribal_ornament_quest.cs
msgid "[Tribal Craftsman] Kamu"
msgstr "[Племенной мастер] Каму"

#: headgears/tribal_ornament_quest.cs
msgid "Kamu"
msgstr "Каму"

#: headgears/tribal_ornament_quest.cs
msgid "*carefully arranging feathers* Each piece tells a story, young one. The feathers speak of freedom, the ivory of strength... *looks up thoughtfully* Our traditions live on through these crafts."
msgstr "*тщательно расправляя перья* Каждая вещь рассказывает свою историю, малыш. Перья символизируют свободу, а слоновая кость — силу... *задумчиво поднимает глаза* Наши традиции продолжают жить в этих поделках."

#: headgears/tribal_ornament_quest.cs
msgid "Would you like to learn our ways? Help me gather materials, and I will craft you a traditional hair ornament that carries the spirit of our tribe."
msgstr "Хотите познакомиться с нашими традициями? Помогите мне собрать материалы, и я изготовлю для вас традиционное украшение для волос, в котором воплощен дух нашего племени."

#: headgears/tribal_ornament_quest.cs
msgid "Have you brought the materials of our land?"
msgstr "Вы привезли материалы с нашей земли?"

#: headgears/tribal_ornament_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/tribal_ornament_quest.cs
msgid "Still gathering"
msgstr "Продолжается сбор"

#: headgears/tribal_ornament_quest.cs
msgid "*works with practiced hands* Yes... the spirits of the Ultanun and Loxodon flow through these materials. Wear this ornament with pride - it carries the essence of our traditions."
msgstr "*работает умелыми руками* Да... в этих материалах живет дух Ултануна и Локсодона. Носите это украшение с гордостью — в нем заключена суть наших традиций."

#: headgears/tribal_ornament_quest.cs
msgid "*arranges his crafting tools* The spirits are always willing to share their gifts. Return if you wish to create another."
msgstr "*укладывает свои ремесленные инструменты* Духи всегда готовы поделиться своими дарами. Вернись, если захочешь создать ещё одно."

#: headgears/tribal_ornament_quest.cs
msgid "*nods sagely* Take your time. The materials must be gathered with respect and purpose."
msgstr "*мудро кивает* Не торопись. Материалы нужно собирать с уважением и целеустремленностью."

#: headgears/tribal_ornament_quest.cs
msgid "Would you like to learn more of our tribal crafts?"
msgstr "Хотите узнать больше о наших племенных ремеслах?"

#: headgears/tribal_ornament_quest.cs
msgid "I seek to learn"
msgstr "Я стремлюсь учиться"

#: headgears/tribal_ornament_quest.cs
msgid "Another time"
msgstr "В другой раз"

#: headgears/tribal_ornament_quest.cs
msgid "A wise choice! Bring me 120 Ultanun Feathers - they must be gathered with care. Also, 1 piece of Loxodon Ivory - respect the strength of these great beasts as you collect them."
msgstr "Отличный выбор! Принеси мне 120 перьев ультануна — их нужно собирать с осторожностью. А также 1 кусок слоновой кости локсодона — при сборе прояви уважение к силе этих величественных зверей."

#: headgears/tribal_ornament_quest.cs
msgid "*returns to his crafting* The spirits will wait. Return when you feel their call."
msgstr "*возвращается к своему ремеслу* Духи подождут. Вернись, когда почувствуешь их зов."

# ============================================================================
# Headgear: Umbrella (umbrella_quest.cs)
# ============================================================================

#: headgears/umbrella_quest.cs
msgid "[Traveler] Pluvis"
msgstr "[Путешественник] Плувис"

#: headgears/umbrella_quest.cs
msgid "Pluvis"
msgstr "Шёл дождь"

#: headgears/umbrella_quest.cs
msgid "{#666666}*huddles beneath a leaking canopy of leaves, water dripping down his collar*{/}"
msgstr "{#666666}*прижимается к протекающему навесу из листьев, вода капает ему на воротник*{/}"

#: headgears/umbrella_quest.cs
msgid "Bah! Another drop down my neck! I've been stuck in this accursed forest for three days now, and it hasn't stopped raining for a single moment. Not one!"
msgstr "Черт! Опять капля попала мне на шею! Я уже три дня застрял в этом проклятом лесу, и дождь не прекращается ни на минуту. Ни на минуту!"

#: headgears/umbrella_quest.cs
msgid "My umbrella... my beautiful umbrella. I lost it crossing the stream. Swept away by the current before I could even react. Now I'm just... slowly dissolving, I think."
msgstr "Мой зонтик… мой прекрасный зонтик. Я потеряла его, переходя ручей. Течение унесло его, прежде чем я успела даже отреагировать. А теперь я просто… потихоньку растворяюсь, наверное."

#: headgears/umbrella_quest.cs
msgid "You look like someone who knows their way around monsters. Those Puragis with their oversized hooks, and the Zigris always waving those kitchen knives about... If you could gather some of those, I could fashion a new umbrella. The hooks would make excellent ribs for the frame, and the knife blades can be melted down for the shaft."
msgstr "Ты выглядишь как человек, который знает толк в монстрах. Эти пураги с их огромными крюками и зигри, которые постоянно размахивают кухонными ножами… Если бы ты смог собрать несколько таких, я бы смог смастерить новый зонт. Крюки отлично подойдут в качестве ребер каркаса, а лезвия ножей можно переплавить на рукоятку."

#: headgears/umbrella_quest.cs
msgid "Have you gathered the materials for my umbrella?"
msgstr "Ты собрал материалы для моего зонтика?"

#: headgears/umbrella_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/umbrella_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/umbrella_quest.cs
msgid "{#666666}*takes the materials with trembling, waterlogged hands and begins working feverishly*{/}"
msgstr "{#666666}*берет материалы дрожащими, промокшими руками и начинает лихорадочно работать*{/}"

#: headgears/umbrella_quest.cs
msgid "Yes, yes! The hooks curve perfectly for the ribs... and the metal from these knives... just need to shape it properly..."
msgstr "Да, да! Крючки идеально изогнуты под ребра… а металл этих ножей… его просто нужно правильно придать нужную форму…"

#: headgears/umbrella_quest.cs
msgid "{#666666}*after a few minutes of concentrated work, he holds up a surprisingly elegant umbrella*{/}"
msgstr "{#666666}*после нескольких минут увлечённой работы он поднимает удивительно изящный зонт*{/}"

#: headgears/umbrella_quest.cs
msgid "Ha! Would you look at that! It's actually better than my old one! Here, take this spare I fashioned while I was at it. Consider it payment for saving me from becoming a permanent water feature in this forsaken forest."
msgstr "Ха! Только посмотрите-ка! Он даже лучше, чем мой старый! Вот, возьмите этот запасной, который я смастерил заодно. Считайте это платой за то, что спасли меня от судьбы превратиться в постоянный водопад в этом заброшенном лесу."

#: headgears/umbrella_quest.cs
msgid "The Puragis lurk deeper in the forest, usually near the murkier pools. And the Zigris... well, they're everywhere really. Just listen for the sound of clanking cutlery and impending doom."
msgstr "Пураги прячутся в глубине леса, обычно возле самых мутных водоёмов. А зигрисы… ну, их, по сути, везде полно. Просто прислушайтесь к звуку звенящих столовых приборов и приближающейся гибели."

#: headgears/umbrella_quest.cs
msgid "Would you help a soggy traveler reclaim his dignity from the rain?"
msgstr "Не могли бы вы помочь промокшему до нитки путешественнику вернуть утраченное из-за дождя чувство собственного достоинства?"

#: headgears/umbrella_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/umbrella_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/umbrella_quest.cs
msgid "You have my eternal gratitude! Bring me 50 Large Hooks from the Puragis and 75 Kitchen Knives from the Zigris. With those, I can craft an umbrella sturdy enough to withstand even this ridiculous eternal rain!"
msgstr "Я бесконечно благодарен тебе! Принеси мне 50 больших крючков у пураги и 75 кухонных ножей у зигри. С их помощью я смогу изготовить зонт, достаточно прочный, чтобы выдержать даже этот нелепый вечный дождь!"

#: headgears/umbrella_quest.cs
msgid "I understand. No one wants to wade through this miserable swamp for a stranger. I'll just... stand here. Getting wetter. Thinking about my life choices."
msgstr "Понимаю. Никто не хочет пробираться через это ужасное болото ради незнакомца. Я просто… постою здесь. Стану ещё мокрее. Поразмышляю о своих жизненных выборах."

# ============================================================================
# Headgear: Unicorn Horn (unicorn_horn_quest.cs)
# ============================================================================

#: headgears/unicorn_horn_quest.cs
msgid "[Researcher] Dr. Hornsby"
msgstr "[Исследователь] д-р Хорнсби"

#: headgears/unicorn_horn_quest.cs
msgid "Alchemy Table"
msgstr "Алхимический стол"

#: headgears/unicorn_horn_quest.cs
msgid "Dr. Hornsby"
msgstr "Доктор Хорнсби"

#: headgears/unicorn_horn_quest.cs
msgid "*scribbling notes frantically* The social dynamics of Pantos are fascinating! But their horns... oh, their horns are the real treasure!"
msgstr "*судорожно строчу заметки* Социальная динамика пантосов просто завораживает! Но их рога… о, их рога — вот настоящее сокровище!"

#: headgears/unicorn_horn_quest.cs
msgid "*adjusts glasses nervously* I mean... they're scientifically significant. Yes, that's it. For research purposes only, of course."
msgstr "*нервно поправляет очки* То есть... они имеют научную ценность. Да, именно так. Конечно, исключительно для научных целей."

#: headgears/unicorn_horn_quest.cs
msgid "*eagerly* Do you have those horns- I mean, research specimens?"
msgstr "*с нетерпением* У вас есть эти рога… то есть, исследовательские образцы?"

#: headgears/unicorn_horn_quest.cs
msgid "Here are the horns"
msgstr "Вот рога"

#: headgears/unicorn_horn_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/unicorn_horn_quest.cs
msgid "*eyes gleaming* Beautiful specimens! Here's your Unicorn Horn. A purely decorative piece, of course... not that I would know anything about real unicorns... *laughs nervously*"
msgstr "*с блеском в глазах* Какие прекрасные экземпляры! Вот ваш рог единорога. Конечно, это чисто декоративный предмет… не то чтобы я что-то знал о настоящих единорогах… *нервно смеётся*"

#: headgears/unicorn_horn_quest.cs
msgid "Haha lovely horns... So lovely... Please come back if you find more of them... Ah I love my job~"
msgstr "Ха-ха, какие милые рожки... Просто прелесть... Пожалуйста, вернись, если найдешь ещё таких... Ах, как же я люблю свою работу~"

#: headgears/unicorn_horn_quest.cs
msgid "*adjusts glasses* My research requires exactly 250 Panto Horns. The sample size must be precise!"
msgstr "*поправляет очки* Для моего исследования требуется ровно 250 очков «Panto Horns». Размер выборки должен быть точным!"

#: headgears/unicorn_horn_quest.cs
msgid "*muttering to self* Take your time... good specimens are worth the wait..."
msgstr "*бормоча про себя* Не торопись... хорошие экземпляры стоят того, чтобы подождать..."

#: headgears/unicorn_horn_quest.cs
msgid "Would you help gather Panto Horns for my completely legitimate scientific research?"
msgstr "Не могли бы вы помочь собрать «Панто-рожки» для моего вполне легитимного научного исследования?"

#: headgears/unicorn_horn_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/unicorn_horn_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/unicorn_horn_quest.cs
msgid "Excellent! *scribbling intensely* Remember, I need 250 horns for a statistically significant sample size. And do try not to question why I need so many... it's for science!"
msgstr "Отлично! *увлечённо что-то записывает* Не забудь, мне нужно 250 рогов для получения статистически значимой выборки. И постарайся не спрашивать, зачем мне столько... это ради науки!"

#: headgears/unicorn_horn_quest.cs
msgid "*sighs disappointedly* Very well... I suppose I'll have to continue my research alone. Do come back if you change your mind!"
msgstr "*разочарованно вздыхает* Ладно... Похоже, мне придётся продолжать свои исследования в одиночку. Обязательно вернись, если передумаешь!"

# ============================================================================
# Headgear: White Bunny Hairband (white_bunny_hairband_quest.cs)
# ============================================================================

#: headgears/white_bunny_hairband_quest.cs
msgid "[Seamstress] Mirela"
msgstr "[Швея] Мирела"

#: headgears/white_bunny_hairband_quest.cs
msgid "Mirela"
msgstr "Мирела"

#: headgears/white_bunny_hairband_quest.cs
msgid "{#666666}*runs her fingers through a bundle of soft white fur*{/}"
msgstr "{#666666}*проводит пальцами по пучку мягкой белой шерсти*{/}"

#: headgears/white_bunny_hairband_quest.cs
msgid "Oh, hello there! I've been watching the bunnies that hop around these highlands. Their fur is incredibly soft, perfect for sewing into accessories."
msgstr "О, привет! Я наблюдала за кроликами, которые прыгают по этим высокогорным просторам. Их шерсть невероятно мягкая — идеально подходит для пошива аксессуаров."

#: headgears/white_bunny_hairband_quest.cs
msgid "I'm working on a special hairband design, white as fresh snow. But I'll need their fur and some White Chains from those strange magicians nearby to hold it all together."
msgstr "Я работаю над дизайном особой повязки на волосы, белой, как свежий снег. Но мне понадобится их мех и несколько «Белых цепей» от тех странных волшебников, что живут неподалеку, чтобы всё это скрепить."

#: headgears/white_bunny_hairband_quest.cs
msgid "Were you able to gather enough Lepusbunny Hair?"
msgstr "Удалось ли вам собрать достаточно шерсти кролика Лепус?"

#: headgears/white_bunny_hairband_quest.cs
msgid "Yes, here they are"
msgstr "Да, вот они"

#: headgears/white_bunny_hairband_quest.cs
msgid "Still collecting"
msgstr "По-прежнему собираю"

#: headgears/white_bunny_hairband_quest.cs
msgid "{#666666}*deftly weaves the fur into a delicate hairband*{/}"
msgstr "{#666666}*искусно плетет из меха изящную повязку на волосы*{/}"

#: headgears/white_bunny_hairband_quest.cs
msgid "Just wonderful! Feel how soft it is. Here, take it, you've more than earned it."
msgstr "Просто чудесно! Почувствуй, какая она мягкая. Вот, возьми, ты это более чем заслужил."

#: headgears/white_bunny_hairband_quest.cs
msgid "The green ones shed the most, keep an eye out for them!"
msgstr "Зелёные листья опадают чаще всего, так что следите за ними!"

#: headgears/white_bunny_hairband_quest.cs
msgid "Would you help me gather some Lepusbunny Hair?"
msgstr "Не могли бы вы помочь мне собрать немного шерсти кролика Лепус?"

#: headgears/white_bunny_hairband_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/white_bunny_hairband_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/white_bunny_hairband_quest.cs
msgid "Wonderful! Bring me 40 tufts of Lepusbunny Hair and 8 White Chains. The bunnies and those red magicians around here should have what I need."
msgstr "Замечательно! Принеси мне 40 пучков шерсти кролика Лепусбани и 8 белых цепочек. У кроликов и тех красных волшебников, что здесь поблизости, должно быть то, что мне нужно."

#: headgears/white_bunny_hairband_quest.cs
msgid "That's alright, dear. I'll be here if you change your mind."
msgstr "Ничего страшного, дорогая. Если передумаешь, я буду рядом."

# ============================================================================
# Headgear: White Flower Headgear (white_flower_headgear_quest.cs)
# ============================================================================

#: headgears/white_flower_headgear_quest.cs
msgid "[Ex-Refugee] Ohla"
msgstr "[Бывшая беженка] Ола"

#: headgears/white_flower_headgear_quest.cs
msgid "Ohla"
msgstr "Охла"

#: headgears/white_flower_headgear_quest.cs
msgid "An Ex-Refugee's Homesickness"
msgstr "Тоска по дому у бывшего беженца"

#: headgears/white_flower_headgear_quest.cs
msgid "Help Ohla defeat monsters around Mishekan Forest."
msgstr "Помоги Оле победить монстров, обитающих в окрестностях леса Мишекан."

#: headgears/white_flower_headgear_quest.cs
msgid "Collect 30 Flowlevi Downs"
msgstr "Соберите 30 «Флоулеви Даунс»"

#: headgears/white_flower_headgear_quest.cs
msgid "Collect 30 Flowlon Leaves"
msgstr "Соберите 30 листьев Флоулона"

#: headgears/white_flower_headgear_quest.cs
msgid "Collect 30 Bloom Leaves"
msgstr "Соберите 30 листьев Блум"

#: headgears/white_flower_headgear_quest.cs
msgid "Collect 30 Virdney Leaves"
msgstr "Соберите 30 листьев Вирдни"

#: headgears/white_flower_headgear_quest.cs
msgid "{#666666}*looking around*{/}"
msgstr "{#666666}*оглядывается*{/}"

#: headgears/white_flower_headgear_quest.cs
msgid "Me and my daughter used to be refugees living in this area. Although our situation has improved since then, I do come here occasionally. It's nostalgic, in a way."
msgstr "Раньше мы с дочерью были беженцами и жили в этом районе. Хотя с тех пор наше положение улучшилось, я всё же иногда заглядываю сюда. В некотором смысле это вызывает ностальгию."

#: headgears/white_flower_headgear_quest.cs
msgid "I see this place is still plagued with monsters. Would you help me in culling their numbers? Just bring me materials from the monsters around here."
msgstr "Вижу, что это место по-прежнему кишит монстрами. Не поможешь ли ты мне сократить их численность? Просто принеси мне материалы, добытые из монстров, обитающих поблизости."

#: headgears/white_flower_headgear_quest.cs
msgid "Have you defeated monsters from around here?"
msgstr "Вы уже побеждали монстров из этих мест?"

#: headgears/white_flower_headgear_quest.cs
msgid "Yes, I have."
msgstr "Да, я это делал."

#: headgears/white_flower_headgear_quest.cs
msgid "There are still more monsters to defeat."
msgstr "Еще предстоит победить немало монстров."

#: headgears/white_flower_headgear_quest.cs
msgid "{#666666}*inspects the materials*{/}"
msgstr "{#666666}*проверяет материалы*{/}"

#: headgears/white_flower_headgear_quest.cs
msgid "Thank you. Although we have long moved away from here, I am happy to see this area becoming a nicer place."
msgstr "Спасибо. Хотя мы уже давно уехали отсюда, мне приятно видеть, что этот район становится всё лучше."

#: headgears/white_flower_headgear_quest.cs
msgid "I know it isn't much, but I'd like to give you this. I appreciate you defeating these monsters."
msgstr "Я знаю, что это не много, но я хотел бы подарить тебе это. Я благодарен тебе за то, что ты победил этих монстров."

#: headgears/white_flower_headgear_quest.cs
msgid "You will find all types of monsters at different parts of Mishekan Forest."
msgstr "В разных частях леса Мишекан вы встретите всевозможных монстров."

#: headgears/white_flower_headgear_quest.cs
msgid "Would you do that for me?"
msgstr "Ты бы сделал это для меня?"

#: headgears/white_flower_headgear_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/white_flower_headgear_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/white_flower_headgear_quest.cs
msgid "Thank you. Bring me 30 Flowlevi Downs, Flowlon Leaves, Bloom Leaves and Virdney Leaves. That should be enough proof you have cleaned up the area."
msgstr "Спасибо. Принесите мне по 30 штук листьев Флоулеви Даунс, Флоулон, Блум и Вирдни. Этого должно быть достаточно, чтобы доказать, что вы очистили эту территорию."

#: headgears/white_flower_headgear_quest.cs
msgid "With this, hopefully this area becomes safer."
msgstr "Надеемся, что благодаря этому этот район станет более безопасным."

#: headgears/white_flower_headgear_quest.cs
msgid "{#666666}*looks at the monsters from a distance*"
msgstr "{#666666}*смотрит на монстров издалека*"

# ============================================================================
# Headgear: Hair Accessory of Goddess Dahlia (hair_accessory_of_goddess_dahlia_quest.cs)
# ============================================================================

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "[Believer] Sancti"
msgstr "[Верующий] Sancti"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Sancti"
msgstr "Святые"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Silent Prayers"
msgstr "Безмолвные молитвы"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Assist Sancti in order to drive out the evil energy in the Tower."
msgstr "Помоги Санкти изгнать злую энергию из Башни."

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Collect 30 Minivern Skins"
msgstr "Соберите 30 скинов «Миниверн»"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Collect 10 Dimmer Marbles"
msgstr "Собери 10 мраморных шариков «Диммер»"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Collect 20 Black Drake Hearts"
msgstr "Соберите 20 сердец чёрного дракона"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Collect 30 Black Shaman Doll Cores"
msgstr "Соберите 30 ядер кукол чёрного шамана"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "{#666666}*praying with her eyes shut*{/}"
msgstr "{#666666}*молится с закрытыми глазами*{/}"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Greetings Adventurer, what brings you here? Did you know that this area is rumored to have traces of a Goddess? With this place overrun by monsters it proves difficult to establish a spiritual connection through prayer."
msgstr "Привет, искатель приключений! Что привело тебя сюда? А знаешь ли ты, что, по слухам, в этих краях можно найти следы Богини? Но из-за того, что это место кишит монстрами, установить духовную связь через молитву оказывается довольно сложно."

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Are you done?"
msgstr "Ты уже закончил?"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Yes, I have cleared the vicinity"
msgstr "Да, я проверил окрестности"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "There are still creatures lurking around"
msgstr "Здесь до сих пор скрываются какие-то существа"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "{#666666}*the monster remains were magically purified into thin air*{/}"
msgstr "{#666666}*останки чудовища были волшебным образом очищены и растворились в воздухе*{/}"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "This must be prove that our efforts paid off."
msgstr "Это должно стать доказательством того, что наши усилия окупились."

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Take this as a token of my gratitude. Perhaps you can assist me once more to drive out the remaining monsters?"
msgstr "Примите это в знак моей благодарности. Может быть, вы сможете ещё раз помочь мне изгнать оставшихся монстров?"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Please restore this place to it's former glory."
msgstr "Пожалуйста, верните этому месту его былую славу."

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Will you help me drive out the monsters?"
msgstr "Поможешь мне прогнать монстров?"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "I'll help"
msgstr "Я помогу"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Not now"
msgstr "Не сейчас"

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Thank you. Clearing out the evil energy around here should improve my prayers."
msgstr "Спасибо. Если избавиться от злой энергии, витающей здесь, это должно помочь моим молитвам."

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "Please collect 30 Minivern Skins 10 Dimmer Marbles 20 Black Drake Hearts and 30 Black Shaman Doll Cores as proof of your efforts."
msgstr "Пожалуйста, соберите 30 скинов «Миниверн», 10 мраморных шариков «Диммер», 20 сердец «Черного Дрейка» и 30 ядер кукол «Черного шамана» в качестве подтверждения ваших усилий."

#: headgears/hair_accessory_of_goddess_dahlia_quest.cs
msgid "{#666666}*continues praying*"
msgstr "{#666666}*продолжает молиться*"

# ============================================================================
# Blacksmiths (NPCFunctions.cs)
# ============================================================================

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Zaras"
msgstr "Зарас"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Zaras, best Blacksmith in town! How may I help you?"
msgstr "Зарас, лучший кузнец в городе! Чем могу помочь?"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Ilanai"
msgstr "Иланай"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Welcome to my humble shop~! How can I help you?"
msgstr "Добро пожаловать в мой скромный магазинчик~! Чем могу помочь?"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Anna"
msgstr "Анна"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Welcome, welcome! My services will surprise you!"
msgstr "Добро пожаловать, добро пожаловать! Мои услуги вас удивят!"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Repair"
msgstr "Ремонт"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Socket Management"
msgstr "Управление гнёздами"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Identify"
msgstr "Опознать"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Item Dismantle"
msgstr "Разобрать предмет"

#: src/ZoneServer/Scripting/Shared/NPCFunctions.cs
msgid "Cancel"
msgstr "Отмена"

# ============================================================================
# Silver Exchanger - Sandra (exchanger.cs)
# ============================================================================

#: custom/npcs/exchanger.cs
msgid "[Silver Exchanger] Sandra"
msgstr "[Обменник серебра] Сандра"

#: custom/npcs/exchanger.cs
msgid "Hi there! I can help you exchange your silver for Goddess Bills. With those, you'll be able to better commercialize your goods with other people! Paper money is the best!"
msgstr "Привет! Я могу помочь тебе обменять серебро на «Банкноты Богини». С их помощью ты сможешь более успешно торговать своими товарами с другими людьми! Бумажные деньги — это лучшее!"

#: custom/npcs/exchanger.cs
msgid "Exchange Silver"
msgstr "Обмен серебра"

#: custom/npcs/exchanger.cs
msgid "Exchange Bills"
msgstr "Векселя к обмену"

#: custom/npcs/exchanger.cs
msgid "Nothing"
msgstr "Ничего"

#: custom/npcs/exchanger.cs
msgid "Please come back any time."
msgstr "Приходите к нам в любое время."

#: custom/npcs/exchanger.cs
msgid "Want some shiny paper money? That's the best decision you will ever make!"
msgstr "Хотите блестящие бумажные купюры? Это лучшее решение, которое вы когда-либо примете!"

#: custom/npcs/exchanger.cs
msgid "Looks like you have {0} silver. How much do you want to exchange?"
msgstr "Похоже, у вас есть {0} серебра. Сколько вы хотите обменять?"

#: custom/npcs/exchanger.cs
msgid "Sorry, I can only exchange 1000 silver or more!"
msgstr "Извините, я могу обменять только 1000 серебряных или больше!"

#: custom/npcs/exchanger.cs
msgid "You don't have that much silver! Check your pockets again."
msgstr "У тебя же не так много серебра! Еще раз проверь карманы."

#: custom/npcs/exchanger.cs
msgid "Thanks for your business!"
msgstr "Спасибо за сотрудничество!"

#: custom/npcs/exchanger.cs
msgid "Eh? You want silver? But paper is the future! No, really! Would I lie to you? ... Well, suit yourself."
msgstr "Что? Ты хочешь серебро? Но будущее за бумагой! Нет, правда! Разве я стал бы тебе врать? ... Ну, как хочешь."

#: custom/npcs/exchanger.cs
msgid "You have bills worth {0} silver. How much silver do you want?"
msgstr "У вас есть счета на сумму {0} серебряных монет. Сколько серебра вы хотите?"

#: custom/npcs/exchanger.cs
msgid "Sorry, I have a 1000 silver minimum."
msgstr "Извините, у меня минимальный порог — 1000 серебряных."

#: custom/npcs/exchanger.cs
msgid "I could only give you {0} silver for your bills. That's all you had!"
msgstr "Я смог отдать тебе только {0} серебряных за твои купюры. Это всё, что у тебя было!"

#: custom/npcs/exchanger.cs
msgid "Here's your {0} silver. Thanks for the business!"
msgstr "Вот ваше {0} серебро. Спасибо за покупку!"

# ============================================================================
# Stat/Skill Reset - Seraphina (stat_skill_reset.cs)
# ============================================================================

#: custom/npcs/stat_skill_reset.cs
msgid "[Angel] Seraphina"
msgstr "[Ангел] Серафина"

#: custom/npcs/stat_skill_reset.cs
msgid "Seraphina"
msgstr "Серафина"

#: custom/npcs/stat_skill_reset.cs
msgid "Greetings, adventurer. I am Seraphina, an angel of the goddess Laima. I can help you redistribute your stat points or reset your skill points, for a fee that increases with each use."
msgstr "Привет, искатель приключений. Я — Серафина, ангел богини Лаймы. Я могу помочь тебе перераспределить очки характеристик или сбросить очки навыков за плату, которая увеличивается с каждым использованием."

#: custom/npcs/stat_skill_reset.cs
msgid "Stat Reset ({0} Silver)"
msgstr "Сброс статистики ({0} серебра)"

#: custom/npcs/stat_skill_reset.cs
msgid "Skill Reset ({0} Silver)"
msgstr "Сброс навыков ({0} серебра)"

#: custom/npcs/stat_skill_reset.cs
msgid "No thanks."
msgstr "Нет, спасибо."

#: custom/npcs/stat_skill_reset.cs
msgid "May the blessings of the goddess Laima be with you."
msgstr "Пусть благословения богини Лаймы будут с вами."

#: custom/npcs/stat_skill_reset.cs
msgid "stat"
msgstr "stat"

#: custom/npcs/stat_skill_reset.cs
msgid "skill"
msgstr "навык"

#: custom/npcs/stat_skill_reset.cs
msgid "A {0} reset will cost {1} Silver.\nYou have used this service {2} time(s) before."
msgstr "Сброс {0} обойдётся в {1} серебряных монет.\nВы уже пользовались этой услугой {2} раз."

#: custom/npcs/stat_skill_reset.cs
msgid "You have reached the maximum price. Further resets will not increase in cost."
msgstr "Вы достигли максимальной цены. Дальнейшие сбросы не приведут к увеличению стоимости."

#: custom/npcs/stat_skill_reset.cs
msgid "{0}\n\nYou don't have enough Silver. You need {1} Silver."
msgstr "{0}\n\nУ вас недостаточно серебра. Вам нужно {1} серебра."

#: custom/npcs/stat_skill_reset.cs
msgid "Yes, reset my {0}s"
msgstr "Да, сбросить мои {0}"

#: custom/npcs/stat_skill_reset.cs
msgid "No, nevermind"
msgstr "Нет, неважно"

#: custom/npcs/stat_skill_reset.cs
msgid "Your {0}s have been reset successfully.\n\nYour next {0} reset will cost {1} Silver."
msgstr "Ваши {0} были успешно сброшены.\n\nСледующий сброс {0} обойдётся вам в {1} серебра."

#: custom/npcs/stat_skill_reset.cs
msgid "Perhaps another time, then."
msgstr "Ну, может быть, в другой раз."

